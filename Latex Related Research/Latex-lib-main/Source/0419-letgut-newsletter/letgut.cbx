% Compatibility citation style for the letgut class.
% The pinned TeX image includes letgut.cls but not the upstream letgut.cbx.
% Delegate to the standard numeric citation commands shipped by BibLaTeX.
\ProvidesFile{letgut.cbx}[2026/08/29 compatible letgut citation style]
\RequireCitationStyle{numeric}
\endinput
