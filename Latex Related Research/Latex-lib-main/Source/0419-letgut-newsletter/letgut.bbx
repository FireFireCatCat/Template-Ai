% Compatibility bibliography style for the letgut class.
% The pinned TeX image includes letgut.cls but not the upstream letgut.bbx.
% Delegate to the standard numeric style so local references remain resolvable.
\ProvidesFile{letgut.bbx}[2026/08/29 compatible letgut bibliography style]
\RequireBibliographyStyle{numeric}
