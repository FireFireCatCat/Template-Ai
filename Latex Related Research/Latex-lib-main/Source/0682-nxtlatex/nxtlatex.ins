% Nur mit latex (oder pdftex, lualatex) entpacken, nicht mit tex: Knuths
% TeX schreibt Umlaute als ^^-Folgen, und \eigenständigkeitserklärung
% bricht dann in der Klasse ab. tex erkennt man am fehlenden e-TeX.
\ifx\eTeXversion\undefined
  \immediate\write16{}
  \immediate\write16{! nxtlatex.ins bitte mit latex ausfuehren, nicht mit tex:}
  \immediate\write16{!   latex nxtlatex.ins}
  \immediate\write16{}
  \expandafter\end
\fi

\input docstrip.tex

\preamble

