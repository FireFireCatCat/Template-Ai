\Msg{* Um die Dokumentation zu erzeugen:}
\Msg{*   pdflatex nxtlatex.dtx}
\Msg{*   makeindex -s gind.ist nxtlatex.idx}
\Msg{*   makeindex -s gglo.ist -o nxtlatex.gls nxtlatex.glo}
\Msg{*   pdflatex nxtlatex.dtx}
\Msg{*}
\Msg{* Erzeugte Dateien:}
\Msg{*   nxtlatexcolors.sty -- Farb-Palette}
\Msg{*   nxtlatexlogos.sty  -- Logo-Makros}
\Msg{*   nxtthesis.cls    -- Thesis-Klasse}
\Msg{*   nxtbrief.lco     -- Brief-Layout (scrlttr2)}
\Msg{*   beamerthemeNXT.sty -- Beamer-Thema}
\Msg{*}
\Msg{* Zusaetzlich benoetigt: NXT_Logo.otf}
