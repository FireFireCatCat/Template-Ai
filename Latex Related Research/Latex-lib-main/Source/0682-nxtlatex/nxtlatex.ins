   https://www.latex-project.org/lppl.txt
and version 1.3c or later is part of all distributions of LaTeX
version 2008 or later.

\endpreamble

\askforoverwritefalse

\generate{
  \file{nxtlatexcolors.sty}{\from{nxtlatex.dtx}{nxtlatexcolors}}
  \file{nxtlatexlogos.sty}{\from{nxtlatex.dtx}{nxtlatexlogos}}
  \file{nxtthesis.cls}{\from{nxtlatex.dtx}{nxtthesis}}
  \file{nxtbrief.lco}{\from{nxtlatex.dtx}{nxtbrief}}
  \file{beamerthemeNXT.sty}{\from{nxtlatex.dtx}{beamerthemenxt}}
}

\obeyspaces
