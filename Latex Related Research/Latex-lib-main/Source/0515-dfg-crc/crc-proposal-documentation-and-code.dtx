% \subsection{ORCiD display commands}
%
% Two commands render ORCiD identifiers:
% \begin{description}
%   \item[\cs{ORCiD}\marg{0000-0000-0000-0000}] Inline use: renders
%         the ORCiD icon followed by the ID as a hyperlink.
%         Intended for manual insertion in text.
%   \item[\cs{getORCiD}\oarg{db}\marg{id}] Database-driven use: looks up
%         the |orcid| field from the |person| database for the given person
%         ID and renders \cs{ORCiD} automatically.  If the field is missing,
%         a |missing-orcid| warning is raised instead of silently omitting
%         the identifier.  The warning is suppressed during the tabularray
%         measuring pass (\cs{lTblrMeasuringBool}) to avoid duplicates.
% \end{description}
% The ORCiD brand green (|orcid| colour) is defined in the colour palette
% section above.  The icon uses the \pkg{academicons} \cs{aiOrcid} glyph.
%    \begin{macrocode}
\RequirePackage{pifont}
\RequirePackage{academicons}
% =============================================================================
% ORCiD commands
% =============================================================================

% Store the ORCiD value pulled from the database.
\providecommand{\theORCiDValue}{}

% --- Icon ---------------------------------------------------------------------
\NewDocumentCommand{\orcidIcon}{}
{{\sffamily\textcolor{orcid}{\aiOrcid}}}

% --- Pure value-only lookup (no immediate output) ---------------------------
% Fetch the ORCiD value from the database into \theORCiDValue.
% Useful when the value has already been loaded by a previous multi-fetch step,
% or when formatting is needed later.
\NewDocumentCommand{\getORCiDvalue}{O{person} m}
{%
  % #1: Database (default is person)
  % #2: Person id
  \bool_if:NTF \l_@@_class_fastcompile_project_bool
  { \cs_set:Npn \theORCiDValue { } }
  { \DTLgetvalueforkey{\theORCiDValue}{orcid}{#1}{id}{#2} }%
}

% --- Formatting a preloaded ORCiD value ------------------------------------
% Expects \theORCiDValue to be set (for example via \getORCiDvalue or
% per \getEntry*[...]{id}{\theORCiDValue=orcid, ...}).
\NewDocumentCommand{\formatORCiD}{O{person} m}
{%
  % #1: Database (for warnings / tag overlay)
  % #2: Person id (for warnings / tag overlay)
  \DTLifnullorempty{\theORCiDValue}
  {%
  	\bool_if:NF \lTblrMeasuringBool
  	{ \msg_warning:nnee {dfg}{missing-orcid}{#1}{#2} }%
  	\mbox{~} % if no orcid present
  }
  {%
  	\orcidIcon\,%
  	\dfgShowTag{#2}{orcid}
  	{\href{https://orcid.org/\theORCiDValue}{\theORCiDValue}}[#1]%
  }%
}

% --- Convenience command: fetch + format in a single call -------------------
% Keep the same API as the original \getORCiD so existing calls continue
% to work.
\NewDocumentCommand{\getORCiD}{O{person} m}
{%
  % #1: Database (default is person)
  % #2: Person id
  \bool_if:NF \l_@@_class_fastcompile_project_bool
  {
    \getORCiDvalue[#1]{#2}%
    \formatORCiD[#1]{#2}%
  }
}

% --- Inline variant for literal ORCiD values --------------------------------
% For direct values without database lookup.
\NewDocumentCommand{\ORCiD}{m}
{(\raisebox{-1pt}{\orcidIcon}\,\href{https://orcid.org/#1}{#1})}
%    \end{macrocode}
% \subsection{siunitx configuration}
%
% \pkg{siunitx} options must be forwarded with \cs{PassOptionsToPackage}
% \emph{before} the package is implicitly loaded by
% |\UseTblrLibrary{siunitx}|, otherwise they arrive too late.
%
% Key choices:
%  |group-minimum-digits=4|: numbers with 4+ digits get a thousands
%  separator (so |90600| formats as |90,600| EUR).
%  |group-separator={,}|: European style comma separator.
%  |table-auto-round=true|: silently rounds values to fit the
%  |table-format| without requiring \cs{num} wrappers everywhere.
%  |drop-zero-decimal=true|: suppresses redundant decimal zeros in numeric
%  and EUR cells while retaining genuinely fractional values such as explicit
%  animal-housing rates.
%  |mode=match|: inherits the surrounding text font, so numbers
%  in tables match the |\footnotesize| row font automatically.
%  |text-family-to-math=true|, |text-series-to-math=true|: pass
%  the current font family and series into math mode, keeping
%  bold/italic numbers consistent with their surrounding text.
%    \begin{macrocode}
\PassOptionsToPackage{
  mode =  match,
  propagate-math-font = true,
  % reset-math-version  = false,
  % reset-text-family   = false,
  % reset-text-series   = false,
  % reset-text-shape    = false,
