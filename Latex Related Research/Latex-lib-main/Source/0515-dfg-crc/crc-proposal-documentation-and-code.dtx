\cs_new_protected:Npn \@@_collaboration_plot_heatmap_picture:
{
    % Use the widest project area as the shared column grid.  Each column gets
    % a dynamic box width, and the final cell reaches the right edge of the
    % text block instead of leaving a large unused strip before the caption.
    \dim_zero:N \l_@@_collaboration_plot_area_label_width_dim
    \seq_map_inline:Nn \l_@@_collaboration_plot_areas_seq
      {
        \hbox_set:Nn \l_@@_collaboration_plot_area_label_box
          { \scriptsize\bfseries Project~area~##1 }
        \dim_compare:nNnT
          { \box_wd:N \l_@@_collaboration_plot_area_label_box }
          >
          { \l_@@_collaboration_plot_area_label_width_dim }
          {
            \dim_set:Nn \l_@@_collaboration_plot_area_label_width_dim
              { \box_wd:N \l_@@_collaboration_plot_area_label_box }
          }
      }
    \dim_set:Nn \l_@@_collaboration_plot_content_start_dim
      { \l_@@_collaboration_plot_area_label_width_dim + 4mm }
  \begin{tikzpicture}
    \int_zero:N \l_@@_collaboration_plot_node_count_int
    \seq_map_inline:Nn \l_@@_collaboration_plot_areas_seq
      {
        \prop_get:NnN \l_@@_collaboration_plot_area_nodes_prop {##1}
          \l_tmpa_tl
        \clist_set:NV \l_tmpa_clist \l_tmpa_tl
        \int_set:Nn \l_tmpa_int { \clist_count:N \l_tmpa_clist }
        \int_set:Nn \l_@@_collaboration_plot_node_count_int
          { \int_max:nn { \l_@@_collaboration_plot_node_count_int }
            { \l_tmpa_int } }
      }
    \dim_set:Nn \l_@@_collaboration_plot_box_gap_dim { 1mm }
    \int_compare:nNnTF
      { \l_@@_collaboration_plot_node_count_int } > { 0 }
      {
        \dim_set:Nn \l_@@_collaboration_plot_box_width_dim
        {
          ( \l_@@_collaboration_plot_width_dim
            - \l_@@_collaboration_plot_content_start_dim
            - \l_@@_collaboration_plot_box_gap_dim *
              \int_eval:n
                { \l_@@_collaboration_plot_node_count_int - 1 }
          ) / \l_@@_collaboration_plot_node_count_int
        }
        \dim_set:Nn \l_@@_collaboration_plot_x_step_dim
        {
          \l_@@_collaboration_plot_box_width_dim
          + \l_@@_collaboration_plot_box_gap_dim
        }
      }
      {
        \dim_zero:N \l_@@_collaboration_plot_box_width_dim
        \dim_zero:N \l_@@_collaboration_plot_x_step_dim
      }
    \int_zero:N \l_@@_collaboration_plot_row_index_int
    \seq_map_inline:Nn \l_@@_collaboration_plot_areas_seq
      {
        \prop_get:NnN \l_@@_collaboration_plot_area_nodes_prop {##1}
          \l_tmpa_tl
        \prop_get:NnN \l_@@_collaboration_plot_area_color_prop {##1}
          \l_@@_collaboration_plot_color_tl
        \@@_collaboration_plot_heatmap_row:VVn
          \l_tmpa_tl \l_@@_collaboration_plot_color_tl {##1}
      }
  \end{tikzpicture}
}

