      {Job~descriptions~of~staff~for~the~proposed~funding~period~
        (supported~through~existing~funds):}
    \tl_set:Nn \l_@@_rfs_requested_description_heading_tl
      {Job~descriptions~of~staff~for~the~proposed~funding~period~
        (requested~funds):}
  }
  \seq_clear:N \l_@@_rfs_existing_research_seq
  \seq_clear:N \l_@@_rfs_existing_nonresearch_seq
  \seq_clear:N \l_@@_rfs_requested_research_seq
  \seq_clear:N \l_@@_rfs_requested_nonresearch_seq
  \seq_clear:N \l_@@_rfs_institution_seq
  \seq_clear:N \l_@@_rfs_affiliation_seq
  \prop_clear:N \l_@@_rfs_duplicate_prop
  \prop_clear:N \l_@@_rfs_institution_name_prop
  \prop_clear:N \l_@@_rfs_institution_abbreviation_prop
  \prop_clear:N \l_@@_rfs_institution_affiliation_abbreviation_prop
  \prop_clear:N \l_@@_rfs_affiliation_abbreviation_prop
  \prop_clear:N \l_@@_rfs_affiliation_name_prop
