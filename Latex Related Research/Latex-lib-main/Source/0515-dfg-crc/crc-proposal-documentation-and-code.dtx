\cs_new_protected:Npn \@@_project_count_build:
{
  \int_gzero:N \g_@@_project_count_all_int
  \prop_gclear:N \g_@@_project_count_area_prop
  \DTLifdbexists{project}
  {
    \DTLifhaskey { project } { project-area }
      { }
      { \DTLaddcolumn { project } { project-area } }
    \DTLforeach*{project}
    {
      \l_@@_project_count_id_tl                 = id,
      \l_@@_project_count_area_tl               = project-area,
      \l_@@_project_count_status_tl             = project-status,
      \l_@@_project_count_consider_for_lists_tl = consider-for-lists,
      \l_@@_project_count_reference_only_tl     = reference-only
    }
    {
      \bool_lazy_all:nT
      {
        { \str_if_eq_p:Vn \l_@@_project_count_consider_for_lists_tl { true } }
        { \str_if_eq_p:Vn \l_@@_project_count_reference_only_tl { false } }
        {
          \bool_lazy_or_p:nn
            { \str_if_eq_p:Vn \l_@@_project_count_status_tl { C } }
            { \str_if_eq_p:Vn \l_@@_project_count_status_tl { N } }
        }
      }
      {
        \DTLifnullorempty{\l_@@_project_count_area_tl}
          {
            \tl_set:Nx \l_@@_project_count_area_tl
              { \tl_head:V \l_@@_project_count_id_tl }
          }
          { }
        \tl_trim_spaces:N \l_@@_project_count_area_tl
        \exp_args:NV \@@_project_count_increment:n
          \l_@@_project_count_area_tl
      }
    }
  }
  { \msg_warning:nnn { dfg } { database-not-found } { project } }
  \bool_gset_true:N \g_@@_project_count_ready_bool
}

