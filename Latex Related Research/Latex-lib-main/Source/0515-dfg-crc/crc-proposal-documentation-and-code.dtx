% Resolve example-project preview pages by named PDF destinations. This keeps
% the excerpts correct when earlier proposal pages change length.
\directlua{
  local function register_pages(filename, pattern, prefix)
  local pdf = pdfe.open(filename)
  if pdf then
    local pages = {}
    for number, entry in ipairs(pdfe.pagestotable(pdf)) do
      pages[entry[3]] = number
    end
    local function value(entry)
      if entry[1] == 10 then
        local kind, result = pdfe.getfromreference(entry[2])
        return result
      end
      return entry[2]
    end
    local function visit(node)
      local names = pdfe.getarray(node, 'Names')
      if names then
        local entries = pdfe.arraytotable(names)
        for index, entry in ipairs(entries) do
          if math.fmod(index, 2) == 1 then
            local id = value(entry):match(pattern)
            if id then
              local destination = pdfe.getarray(value(entries[index+1]), 'D')
              local page = pages[pdfe.arraytotable(destination)[1][3]]
              if page then
                token.set_macro(prefix .. id, tostring(page), 'global')
              end
            end
          end
        end
      end
      local children = pdfe.getarray(node, 'Kids')
      if children then
        for _, entry in ipairs(pdfe.arraytotable(children)) do visit(value(entry)) end
      end
    end
    local names = pdfe.getdictionary(pdfe.getcatalog(pdf), 'Names')
    if names then
      local destinations = pdfe.getdictionary(names, 'Dests')
      if destinations then visit(destinations) end
    end
    pdfe.close(pdf)
  end
  end
  register_pages('dfg-crc-proposal-example.pdf', '^project:(.+)$', 'dfgDocProjectPage')
  register_pages('dfg-crc-cv-example.pdf', '^doc[-]cv:(.+)$', 'dfgDocCVPage')
}
