% \subsection{Data tables}
%
% All tables follow the same three-phase pattern:
%   \textbf{Body accumulation:} A \cs{DTLforeach*} loop iterates
%   over the relevant database (filtered and sorted as required) and
%   appends one tblr row to the token list \cs{l\_tblr\_body\_tl}
%   via \cs{tl\_gput\_right:Nx}.  Using a global token list and
%   \texttt{:Nx} (full expansion) ensures that database values are
%   resolved at loop time rather than at tblr rendering time.
%   \textbf{Table opening:} \cs{begin}|{tblr}| with the |main| theme,
%   |expand=|\cs{l\_tblr\_body\_tl}, |long| (for page-breaking), and a
%   column spec tailored to the specific table.
%   \textbf{Header row + body:} A literal first row provides column
%         headings; \cs{l\_tblr\_body\_tl} follows as the data rows.
%
% \paragraph{ProjectLeadersTable}
% Lists all PIs who are active in the current funding period
% (\cs{theFundingPeriodNumeral}), sorted by last name.  The filter
% applies two conditions simultaneously: \refKey{period} must contain the current
% numeral and \refKey{role} must contain |PI|.  The first cell of every row
% defines the hyperlink destination |pi:<id>| used by \cs{getPI}.
%    \begin{macrocode}

% Use the same institution formatter as the CV section.  The public
% \InstitutionsList maps institution ids through \_@@_one_institution:n
% and uses \par\medskip between multiple institutions in the standard layout.
% Keep the institution label in sync with the ProjectsTable display setting.
\NewDocumentCommand{\dfgPLInstitutionList}{m}{%
  \bool_if:NTF \l_@@_custom_projects_table_institution_abbreviations_bool
    { \printList[abbreviation]{{Institutions}{#1}} }
    { \printList{{Institutions}{#1}} }
}

