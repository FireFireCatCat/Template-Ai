\tl_new:N   \l_@@_aff_label_tl
\int_new:N  \l_@@_seq_counter_int
\cs_generate_variant:Nn \seq_set_from_clist:Nn { Ne , NV }

% Append an institution name to the per-affiliation seq.
% Lazily creates the seq on first use and stores its name in the prop.
\cs_new_protected:Npn \@@_append_inst:nn #1#2 {
  \prop_get:NnNTF \l_@@_aff_to_insts_prop {#1} \l_tmpd_tl
  {%
  	% \l_tmpd_tl now holds the seq's csname; append to it
  	\seq_put_right:cn { \l_tmpd_tl } {#2}%
  }
  {%
  	\int_incr:N \l_@@_seq_counter_int
  	\tl_set:Nx \l_tmpd_tl
  	{ l_@@_inst_seq_ \int_use:N \l_@@_seq_counter_int _seq }%
    \seq_clear_new:c { \l_tmpd_tl }%
  	\seq_put_right:cn { \l_tmpd_tl } {#2}%
  	\prop_put:NnV \l_@@_aff_to_insts_prop {#1} \l_tmpd_tl
  }
}
\cs_generate_variant:Nn \@@_append_inst:nn { VV }

\cs_new_protected:Npn \@@_collect_pi_institution:n #1
{
  \tl_if_blank:nF {#1}
  {
  	\prop_if_in:NnF \l_@@_inst_seen_prop {#1}
  	{%
  		\prop_put:Nnn \l_@@_inst_seen_prop {#1} {1}%
  		\prop_get:NnNT \l_@@_inst_to_aff_prop {#1} \l_tmpb_tl
  		{%
  			\prop_get:NnNT \l_@@_inst_name_prop {#1} \l_tmpc_tl
        {
          \tl_set:Ne \l_tmpe_tl
          {
            \exp_not:N \dfgShowTag {#1}{name}
              {\exp_not:V \l_tmpc_tl}[institution]
          }
          \@@_append_inst:VV \l_tmpb_tl \l_tmpe_tl
        }%
  			\prop_if_in:NVF \l_@@_aff_seen_prop \l_tmpb_tl
  			{%
  				\prop_put:NVn \l_@@_aff_seen_prop \l_tmpb_tl {1}%
  				\seq_put_right:NV \l_@@_affiliations_seq \l_tmpb_tl
  			}%
  		}%
  	}%
  }
}

\int_new:N \l_@@_participating_columns_int
\dim_new:N \l_@@_participating_column_sep_dim
\tl_new:N \l_@@_participating_order_tl
\tl_new:N \l_@@_participating_raster_options_tl
\keys_define:nn { @@ / participating-institutions }
{
  columns .int_set:N = \l_@@_participating_columns_int,
  columns .value_required:n = true,
  column~sep .dim_set:N = \l_@@_participating_column_sep_dim,
  column~sep .value_required:n = true,
  order .choice:,
  order / alpha .code:n =
    { \tl_set:Nn \l_@@_participating_order_tl {alpha} },
  order / count .code:n =
    { \tl_set:Nn \l_@@_participating_order_tl {count} },
  order / unknown .code:n =
    {
      \msg_warning:nnn { dfg } { unknown-institution-order } {#1}
      \tl_set:Nn \l_@@_participating_order_tl {alpha}
    },
  alpha .meta:n = { order=alpha },
  count .meta:n = { order=count },
}

\cs_new_protected:Npn \@@_participating_institutions_raster:n #1
{
  \begin{tcbraster}[
    raster~ columns=1,
    raster~ equal~ height=rows,
    raster~ column~ skip=12pt,
    raster~ row~ skip=10pt,
    #1]
    \tl_use:N \l_@@_output_tl
  \end{tcbraster}
}

% Flow whole affiliation boxes down balanced columns without equal-height rows.
\cs_new_protected:Npn \@@_participating_institutions_columns:
{
  \par\addvspace{\medskipamount}
  \setlength{\columnsep}{\l_@@_participating_column_sep_dim}
  \setlength{\multicolsep}{0pt}
  \int_compare:nNnTF {\l_@@_participating_columns_int} > {1}
  {
    \begin{multicols}{\int_use:N \l_@@_participating_columns_int}
      \raggedcolumns
      \tl_use:N \l_@@_output_tl
    \end{multicols}
  }
  { \tl_use:N \l_@@_output_tl }
}

\NewDocumentCommand{\ParticipatingInstitutionsList}{ O{count} }
{%
  \group_begin:
  % Zero selects the existing raster; columns=1,2,... selects flowing columns.
  \int_zero:N \l_@@_participating_columns_int
  \dim_set:Nn \l_@@_participating_column_sep_dim {12pt}
  % Accept the legacy alpha/count options as well as order and raster keys.
  \tl_set:Nn \l_@@_participating_order_tl {count}
  \keys_set_known:nnN { @@ / participating-institutions } {#1}
    \l_@@_participating_raster_options_tl
  \prop_clear:N \l_@@_inst_to_aff_prop
  \prop_clear:N \l_@@_inst_name_prop
  \prop_clear:N \l_@@_inst_seen_prop
  \prop_clear:N \l_@@_aff_seen_prop
  \prop_clear:N \l_@@_aff_to_insts_prop
  \seq_clear:N  \l_@@_affiliations_seq
  \tl_clear:N   \l_@@_output_tl
  \int_zero:N   \l_@@_seq_counter_int

  % --- 1. One pass over institution: id -> aff-id, id -> name ---------
  \DTLforeach*{institution}{
  	\l_tmpa_tl = id,
  	\l_tmpb_tl = ref-affiliation-id,
  	\l_tmpc_tl = name
  }{%
  	\prop_put:NVV \l_@@_inst_to_aff_prop \l_tmpa_tl \l_tmpb_tl
  	\prop_put:NVV \l_@@_inst_name_prop   \l_tmpa_tl \l_tmpc_tl
  }

  % --- 2. One pass over person: collect active PI institutions --------
  \DTLforeach*[
  	\DTLisinlist{\theFundingPeriodNumeral}{\pPeriod} \and
  	\DTLisinlist{PI}{\pRole}
  ]{person}{ \l_tmpa_tl = ref-institution-id ,\pPeriod=period,\pRole=role}{%
  	\seq_set_from_clist:NV \l_tmpa_seq \l_tmpa_tl
  	\seq_map_inline:Nn \l_tmpa_seq
  	{ \@@_collect_pi_institution:n {##1} }%
  }

  % --- 3a. Precompute affiliation display names ----------------------
  \prop_clear:N \l_@@_aff_name_prop
  \seq_map_inline:Nn \l_@@_affiliations_seq {%
  	\getEntry*[affiliation]{##1}{ \l_tmpa_tl = name }%
  	\prop_put:NnV \l_@@_aff_name_prop {##1} \l_tmpa_tl
  }

  % --- 3b. Sort affiliations according to requested order ------------
  \str_case:VnF \l_@@_participating_order_tl
  {
  	{ alpha }
  	{%
  		\seq_sort:Nn \l_@@_affiliations_seq
  		{%
  			\prop_get:NnN \l_@@_aff_name_prop {##1} \l_tmpa_tl
  			\prop_get:NnN \l_@@_aff_name_prop {##2} \l_tmpb_tl
  			\str_compare:eNeTF { \l_tmpa_tl } < { \l_tmpb_tl }
  				{ \sort_return_same: }
  				{ \sort_return_swapped: }%
  		}%
  	}
  	{ count }
  	{%
  		\seq_sort:Nn \l_@@_affiliations_seq
  		{%
  			\prop_get:NnN \l_@@_aff_to_insts_prop {##1} \l_tmpc_tl
  			\prop_get:NnN \l_@@_aff_to_insts_prop {##2} \l_tmpd_tl
  			\int_compare:nNnTF
  			{ \seq_count:c { \l_tmpc_tl } } > { \seq_count:c { \l_tmpd_tl } }
  				{ \sort_return_same: }
  				{%
  					\int_compare:nNnTF
  					{ \seq_count:c { \l_tmpc_tl } } < { \seq_count:c { \l_tmpd_tl } }
  						{ \sort_return_swapped: }
  						{%
  							% equal counts → alphabetical tiebreak
  							\prop_get:NnN \l_@@_aff_name_prop {##1} \l_tmpa_tl
  							\prop_get:NnN \l_@@_aff_name_prop {##2} \l_tmpb_tl
  							\str_compare:eNeTF { \l_tmpa_tl } < { \l_tmpb_tl }
  								{ \sort_return_same: }
  								{ \sort_return_swapped: }%
  						}%
  				}%
  		}%
  	}
  }
  {%
    \msg_warning:nne { dfg } { unknown-institution-order }
    { \l_@@_participating_order_tl }%
  	\seq_sort:Nn \l_@@_affiliations_seq
  	{%
  		\prop_get:NnN \l_@@_aff_name_prop {##1} \l_tmpa_tl
  		\prop_get:NnN \l_@@_aff_name_prop {##2} \l_tmpb_tl
  		\str_compare:eNeTF { \l_tmpa_tl } < { \l_tmpb_tl }
  			{ \sort_return_same: }
  			{ \sort_return_swapped: }%
  	}%
  }

  % --- 4. Emit output -------------------------------------------------
  \seq_map_inline:Nn \l_@@_affiliations_seq {%
    \int_compare:nNnTF {\l_@@_participating_columns_int} > {0}
    {
      \tl_put_right:Nn \l_@@_output_tl
      {
        \begin{tcolorbox}[blankest,before~upper=\RaggedRight,
          before={\par\noindent},after={\par\addvspace{10pt}}]
      }
    }
    {
      % Preserve the raster's own before/after hooks for row placement.
      \tl_put_right:Nn \l_@@_output_tl
        {\begin{tcolorbox}[blankest,before~upper=\RaggedRight]}
    }%
  	\getEntry*[affiliation]{##1}{
  		\theAffName     = name,
  		\theAffLocation = location
  	}%
  	\prop_get:NnN \l_@@_aff_to_insts_prop {##1} \l_tmpd_tl
  	\seq_set_eq:Nc \l_@@_inst_sort_seq { \l_tmpd_tl }%
  	\seq_sort:Nn \l_@@_inst_sort_seq
  	{%
  		\str_compare:nNnTF {####1} < {####2}
  			{ \sort_return_same: }
  			{ \sort_return_swapped: }%
  	}%
  	\tl_set:Nx \l_@@_aff_label_tl { \seq_use:Nn \l_@@_inst_sort_seq {\\} }%
  	\tl_put_right:Nx \l_@@_output_tl {%
  		{ \exp_not:N \usekomafont{subsubsection}
        \exp_not:N \textbf{%
          \exp_not:N \dfgShowTag {##1}{name}
            {\exp_not:V \theAffName}[affiliation]}
        \exp_not:n {\space(}
        \exp_not:N \dfgShowTag {##1}{location}
          {\exp_not:V \theAffLocation}[affiliation]
        \exp_not:n {)\\} }%
    \exp_not:V \l_@@_aff_label_tl
  	}%
    \tl_put_right:Nn \l_@@_output_tl {\end{tcolorbox}}%
  }
  \seq_if_empty:NF \l_@@_affiliations_seq
  {
    \int_compare:nNnTF {\l_@@_participating_columns_int} > {0}
      { \@@_participating_institutions_columns: }
      {
        \exp_args:NV \@@_participating_institutions_raster:n
          \l_@@_participating_raster_options_tl
      }
  }
  \group_end:
}

