%   Typesets a single signature block for person |#2| in db |#1|
%   with description |#3|. Sets |\theAffiliationOfRoleID| from the
%   row's |ref-institution-id| before expanding |#3|.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_signature_block:nnn #1 #2 #3
{
  \DTLgetvalueforkey{\theAffiliationOfRoleID}{ref-affiliation-id}{#1}{id}{#2}
  \DTLgetvalueforkey{\@@tmpDegree}   {academicdegree}{#1}{id}{#2}
  \DTLgetvalueforkey{\@@tmpFirst}    {firstname}     {#1}{id}{#2}
  \DTLgetvalueforkey{\@@tmpLast}     {lastname}      {#1}{id}{#2}
  \begin{tblr}{
  	            width=\linewidth,
  	            colspec={@{}b{3cm}b{1cm}X[b]@{}},
              }
              {\theCRCaffiliationLocation \\ \dfgDate} &  & \faFileSignature                                       \\
              \SetHline{3-3}{tableOuterLines,1pt}
                                                       &  & {
                                                            \dfgShowTag{#2}{academicdegree}{\@@tmpDegree}[#1]\space
                                                              \textcolor{referencePI}{
                                                              \dfgShowTag{#2}{firstname}{\@@tmpFirst}[#1]\space
                                                              \dfgShowTag{#2}{lastname}{\@@tmpLast}[#1]} \\
  	                                                          #3 } \\
  \end{tblr}
  \par\bigskip
}
