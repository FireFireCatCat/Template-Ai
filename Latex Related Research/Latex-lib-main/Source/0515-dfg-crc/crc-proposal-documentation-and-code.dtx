% We turn now to the part to get the research areas aggregated.
%    \begin{macrocode}
\clist_new:N \l_@@_research_area_clist   % new clist name
\clist_new:N \l_@@_research_area_final_clist   % new clist name
\NewDocumentCommand{\ResearchAreasFromProjectsList}{o}{
  % #1: IDs of project to be excluded
  \clist_clear:N \l_@@_research_area_clist
  \tl_clear:N \l_tmpa_tl

  \DTLforeach[
  	% exclude mentioned projects (for whatsoever reason)
  	\not\DTLisinlist{\pNumber}{#1}% 1st condition
    \and
    \not\DTLiseq{\pConsiderForLists}{false}
  ]
  {project}{%
  	\pNumber       =number,
  	\pType         =project-type,
    \pConsiderForLists=consider-for-lists,
  	\l_tmpa_tl     =research-area%
  }{%
  	% Quite heavy but it works to skip the research area for non-research projects
  	\bool_set_false:N \l_@@_project_type_research_bool
  	\bool_set_false:N \l_@@_project_type_service_bool
  	\bool_set_false:N \l_@@_project_type_mgk_bool
  	\bool_set_false:N \l_@@_project_type_admin_bool

  	\str_case:Vn {\pType}{
  		{research}{ \bool_set_true:N \l_@@_project_type_research_bool }
  		{service} { \bool_set_true:N \l_@@_project_type_service_bool  }
  		{mgk}     { \bool_set_true:N \l_@@_project_type_mgk_bool      }
  		{admin}   { \bool_set_true:N \l_@@_project_type_admin_bool    }
  	}
  	\bool_lazy_any:nT {{ \l_@@_project_type_research_bool}}
  	{\clist_put_right:NV \l_@@_research_area_clist { \l_tmpa_tl }}%
  }
  \clist_remove_duplicates:N \l_@@_research_area_clist
  % Sort the fixed-width classification code numerically after removing
  % punctuation; treating `2.21-02` as an fp expression would parse the
  % hyphen as subtraction.
  \clist_sort:Nn \l_@@_research_area_clist
  {
    \tl_set:Nn \l_tmpa_tl {##1}
    \tl_set:Nn \l_tmpb_tl {##2}
    \regex_replace_all:nnN { [-.] } {} \l_tmpa_tl
    \regex_replace_all:nnN { [-.] } {} \l_tmpb_tl
    \exp_args:NnV \regex_match:nnTF { \A \d+ \Z } \l_tmpa_tl
      {
        \exp_args:NnV \regex_match:nnTF { \A \d+ \Z } \l_tmpb_tl
          {
            \int_compare:nNnTF { \l_tmpa_tl } < { \l_tmpb_tl }
              { \sort_return_same: }
              { \sort_return_swapped: }
          }
          { \sort_return_same: }
      }
      {
        \exp_args:NnV \regex_match:nnTF { \A \d+ \Z } \l_tmpb_tl
          { \sort_return_swapped: }
          { \sort_return_same: }
      }
  }

  \clist_map_inline:Nn \l_@@_research_area_clist {
  	\clist_put_right:NV \l_@@_research_area_final_clist { \dfgResearchAreasList{##1}}
  }

  \dfgShowCalculatedTag{ResearchAreasFromProjectsList}{project}
  {
    \clist_use:Nnnn \l_@@_research_area_final_clist {,~}{,~}{,~and~}%
    .%final dot.
  }
}
%    \end{macrocode}
% \subsection{DFG research area classification}
% \label{sec:research-areas}
% The DFG publishes an official hierarchical subject classification list;
% a project must declare which areas its work belongs to.  The global
% property list \cs{g\_@@\_dfg\_research\_areas\_prop} maps every
% classification code (e.g.\ |2.11-01|) to its English label.
%
% Usage: supply one or more codes as a comma-separated value in the
% |research-area| key of an \refCom{addEntry}|{project}| block.
% \cs{printResearchAreas} then looks up and formats them as a
% natural-language list.
%
% \textbf{Sorting note:} the codes are numeric strings with a hyphen
% (|2.11-01|), which cannot be compared as plain integers.  The sort
% in \cs{printResearchAreas} uses \cs{fp\_compare:nTF} after stripping
% the hyphen suffix — a known workaround for the absence of a
% lexicographic sort in expl3 for this mixed format.
%    \begin{macrocode}
\prop_new:N \g_@@_dfg_research_areas_prop
\prop_gset_from_keyval:Nn \g_@@_dfg_research_areas_prop
{
  1.11-01 = {Prehistory~and~World~Archaeology},
  1.11-02 = {Greek~and~Latin~Philology},
  1.11-03 = {Ancient~History},
  1.11-04 = {Classical,~Roman,~Christian~and~Islamic~Archaeology},
  1.11-05 = {Egyptology~and~Ancient~Near~Eastern~Studies},

  1.12-01 = {Medieval~History},
  1.12-02 = {Early~Modern~History},
  1.12-03 = {Modern~and~Contemporary~History},
  1.12-04 = {History~of~Science},

  1.13-01 = {Art~History},
  1.13-02 = {Musicology},
  1.13-03 = {Theatre~and~Media~Studies},

  1.14-01 = {General~and~Comparative~Linguistics,~Experimental~Linguistics,~Typology,~Non-European~Languages},
  1.14-02 = {Individual~Linguistics,~Historical~Linguistics},
  1.14-03 = {Applied~Linguistics,~Computational~Linguistics},

  1.15-01 = {German~Medieval~Studies~(Medieval~German~Literature)},
  1.15-02 = {German~Literary~and~Cultural~Studies~(Modern~German~Literature)},
  1.15-03 = {European~and~American~Literary~and~Cultural~Studies},
  1.15-04 = {General~and~Comparative~Literary~Studies;~Cultural~Studies},

  1.16-01 = {Social~and~Cultural~Anthropology~and~Ethnology},
  1.16-02 = {Asian~Studies},
  1.16-03 = {African,~American~and~Oceania~Studies},
  1.16-04 = {Islamic~Studies,~Arabian~Studies,~Semitic~Studies},
  1.16-05 = {Religious~Studies~and~Jewish~Studies},

  1.17-01 = {Protestant~Theology},
  1.17-02 = {Roman~Catholic~Theology},

  1.18-01 = {History~of~Philosophy},
  1.18-02 = {Theoretical~Philosophy},
  1.18-03 = {Practical~Philosophy},

  1.21-01 = {General~Education~and~History~of~Education},
