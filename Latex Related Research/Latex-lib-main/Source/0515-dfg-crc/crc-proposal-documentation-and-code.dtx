    \l_@@_requested_funding_staff_validate_type_tl,
  ref-person-id .tl_set:N =
    \l_@@_requested_funding_staff_validate_person_tl,
  lastname .tl_set:N =
    \l_@@_requested_funding_staff_validate_lastname_tl,
  ref-institution-id .tl_set:N =
    \l_@@_requested_funding_staff_validate_institution_tl,
  unknown .code:n = { }
}

\cs_new_protected:Npn
  \@@_requested_funding_staff_warn_missing_institution:
{
  \msg_warning:nne { dfg } { requested-staff-institution-required }
    { \l_@@_requested_funding_staff_validate_project_tl }
}

\cs_new_protected:Npn \@@_requested_funding_staff_validate:n #1
{
  \tl_clear:N \l_@@_requested_funding_staff_validate_project_tl
  \tl_clear:N \l_@@_requested_funding_staff_validate_status_tl
