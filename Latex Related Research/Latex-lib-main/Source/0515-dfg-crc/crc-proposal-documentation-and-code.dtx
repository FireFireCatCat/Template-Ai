%
%   Pops |{id}{desc}| pairs off |\l_@@_sig_pairs_seq| until empty,
%   typesetting one block per pair.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_signature_consume_pairs:n #1
{
  \seq_pop_left:NN \l_@@_sig_pairs_seq \l_@@_sig_id_tl
  \seq_pop_left:NNTF \l_@@_sig_pairs_seq \l_@@_sig_desc_tl
  {
  	\@@_signature_block:nVV {#1} \l_@@_sig_id_tl \l_@@_sig_desc_tl
  	\seq_if_empty:NF \l_@@_sig_pairs_seq
  	{ \@@_signature_consume_pairs:n {#1} }
  }
  {
  	\msg_warning:nnn { crc-proposal } { signature-odd-args } {#1}
  }
}
\msg_new:nnn { crc-proposal } { signature-odd-args }
{ \printSignature\ in\ db\ '#1':\ odd\ number\ of\ tokens,\ %
  expected\ {id}{desc}\ pairs. }
