\cs_new_protected:Npn \@@_get_project_compact:nn #1#2 {
  % #1: id of project
  % #2: optional text, or \newline/\\ for a stacked project list
  \bool_set_false:N \l_@@_project_newline_separator_bool
  \bool_set_false:N \l_@@_project_custom_text_bool
  \IfNoValueF{#2}
    {
      \bool_set_true:N \l_@@_project_custom_text_bool
      \tl_if_eq:nnT {#2} {\newline}
        { \bool_set_false:N \l_@@_project_custom_text_bool
          \bool_set_true:N \l_@@_project_newline_separator_bool }
      \tl_if_eq:nnT {#2} {\\}
        { \bool_set_false:N \l_@@_project_custom_text_bool
          \bool_set_true:N \l_@@_project_newline_separator_bool }
    }
  \bool_if:NTF \l_@@_class_fastcompile_project_bool
  {
    \seq_set_from_clist:Nn \l_tmpa_seq {#1}
    \seq_set_map:NNn \l_tmpb_seq \l_tmpa_seq
    {
      \exp_not:n
      {
        \bool_if:NTF \l_@@_project_custom_text_bool
          {#2}
          {
            \dfgShowTag {##1}{number}
              {\@@_fast_project_reference:n {##1}}[project]
          }
      }
    }
    \@@_project_reference_seq_use:N \l_tmpb_seq
  }
  {
  \seq_clear:N \l_tmpa_seq
  \seq_set_from_clist:Nn \l_tmpa_seq {#1}%
  \seq_set_map:NNn \l_tmpb_seq \l_tmpa_seq {
  	\exp_not:n {
  		\group_begin:
  		\DTLgetvalueforkey{\theProjectNumber}{number}{project}{id}{##1}
  		\datatool_if_null:NTF {\theProjectNumber}
  		{ \getEntry[project]{##1}{number} %<- just to get the error message 
  			\textcolor{error}{\texttt{<##1>}}
  		}{
  			\bfseries%
  			\getProjectColor{##1}%
        \@@_project_if_reference_only:nTF {##1}
        {
          \bool_if:NTF \l_@@_project_custom_text_bool
            {#2}
            {\dfgShowTag{##1}{number}{\theProjectNumber}[project]}%
          \@@_project_reference_only_indicator:
        }
        {
          \bool_if:NTF \l_@@_project_custom_text_bool
          {
            \bool_if:NTF \l_@@_class_cv_bool
              { #2 }
              { \hyperlink{project:##1}{#2} }
          }
          {
            \bool_if:NTF \l_@@_class_cv_bool
              { \dfgShowTag{##1}{number}{\theProjectNumber}[project] }
              { \hyperlink{project:##1}
                  {\dfgShowTag{##1}{number}{\theProjectNumber}[project]} }
          }
        }
  		}
  		\group_end:
  	}}%
  \@@_project_reference_seq_use:N \l_tmpb_seq
  }
}

