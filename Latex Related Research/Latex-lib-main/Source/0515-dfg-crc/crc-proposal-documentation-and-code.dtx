\cs_new_protected:Npn \@@_rfs_print_legend:
{
  \bool_lazy_or:nnT
    { ! \seq_if_empty_p:N \l_@@_rfs_institution_seq }
    { ! \seq_if_empty_p:N \l_@@_rfs_affiliation_seq }
  {
    \par\smallskip\noindent
    \group_begin:
    \footnotesize
    \seq_if_empty:NF \l_@@_rfs_institution_seq
    {
      \textbf{Institutions:}\space
      \seq_map_indexed_inline:Nn \l_@@_rfs_institution_seq
      {
        \int_compare:nNnF {##1} = {1} {;\space}
        \tl_set:Nn \l_tmpa_tl {##2}
        \prop_get:NVN \l_@@_rfs_institution_name_prop
          \l_tmpa_tl \l_tmpb_tl
        \prop_get:NVN \l_@@_rfs_institution_abbreviation_prop
          \l_tmpa_tl \l_tmpd_tl
        \prop_get:NVN \l_@@_rfs_institution_affiliation_abbreviation_prop
          \l_tmpa_tl \l_tmpc_tl
        \textbf{\dfgShowCalculatedTag{institutionLabel}{institution}
          {\l_tmpd_tl}}:~
        \dfgShowTag{##2}{name}{\l_tmpb_tl}[institution]\space
        (\dfgShowCalculatedTag{affiliationLabel}{affiliation}
          {\l_tmpc_tl})
      }
      .\space
    }
    \seq_if_empty:NF \l_@@_rfs_affiliation_seq
    {
      \textbf{Affiliations:}\space
      \seq_map_indexed_inline:Nn \l_@@_rfs_affiliation_seq
      {
        \int_compare:nNnF {##1} = {1} {;\space}
        \tl_set:Nn \l_tmpa_tl {##2}
        \prop_get:NVN \l_@@_rfs_affiliation_abbreviation_prop
          \l_tmpa_tl \l_tmpb_tl
        \prop_get:NVN \l_@@_rfs_affiliation_name_prop
          \l_tmpa_tl \l_tmpc_tl
        \textbf{\dfgShowCalculatedTag{affiliationLabel}{affiliation}
          {\l_tmpb_tl}}:~
        \dfgShowTag{##2}{name}{\l_tmpc_tl}[affiliation]
      }
      .
    }
    \par
    \group_end:
  }
}

