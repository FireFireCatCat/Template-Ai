\cs_new_protected:Npn \@@_collaboration_plot_collect_nodes:
{
  \seq_clear:N  \l_@@_collaboration_plot_nodes_seq
  \prop_clear:N \l_@@_collaboration_plot_all_status_prop
  \prop_clear:N \l_@@_collaboration_plot_status_prop
  \prop_clear:N \l_@@_collaboration_plot_lists_prop
  \prop_clear:N \l_@@_collaboration_plot_edges_prop
  \prop_clear:N \l_@@_collaboration_plot_area_prop
  % DATATOOL requires an iterated key to exist as a database column.  Older
  % proposals do not have project-area yet, so create the optional column and
  % let the ID-prefix fallback below handle its empty values.
  \DTLifhaskey { project } { project-area }
    { }
    { \DTLaddcolumn { project } { project-area } }
  \DTLifhaskey { project } { collaborations }
    { }
    { \DTLaddcolumn { project } { collaborations } }
  \DTLforeach*{project}
  {
    \l_@@_collaboration_plot_id_tl = id,
    \l_@@_collaboration_plot_status_tl = project-status,
    \l_@@_collaboration_plot_consider_tl = consider-for-lists,
    \l_@@_collaboration_plot_reference_only_tl = reference-only,
    \l_@@_collaboration_plot_area_tl = project-area,
    \l_@@_collaboration_plot_collaborations_tl = collaborations
  }
  {
    \prop_put:NVV \l_@@_collaboration_plot_all_status_prop
      \l_@@_collaboration_plot_id_tl
      \l_@@_collaboration_plot_status_tl
    \bool_lazy_all:nT
    {
      { \str_if_eq_p:Vn \l_@@_collaboration_plot_consider_tl { true } }
      { \str_if_eq_p:Vn \l_@@_collaboration_plot_reference_only_tl { false } }
      {
        \bool_lazy_or_p:nn
          { \str_if_eq_p:Vn \l_@@_collaboration_plot_status_tl { C } }
          { \str_if_eq_p:Vn \l_@@_collaboration_plot_status_tl { N } }
      }
    }
    {
      \DTLifnullorempty{\l_@@_collaboration_plot_collaborations_tl}
        { \tl_clear:N \l_@@_collaboration_plot_collaborations_tl }
        { }
      \seq_put_right:NV \l_@@_collaboration_plot_nodes_seq
        \l_@@_collaboration_plot_id_tl
      \DTLifnullorempty{\l_@@_collaboration_plot_area_tl}
        { \tl_set:Nx \l_@@_collaboration_plot_area_tl
            { \tl_head:V \l_@@_collaboration_plot_id_tl } }
        { }
      \tl_trim_spaces:N \l_@@_collaboration_plot_area_tl
      \prop_put:NVV \l_@@_collaboration_plot_area_prop
        \l_@@_collaboration_plot_id_tl \l_@@_collaboration_plot_area_tl
      \prop_put:NVV \l_@@_collaboration_plot_status_prop
        \l_@@_collaboration_plot_id_tl
        \l_@@_collaboration_plot_status_tl
      \prop_put:NVV \l_@@_collaboration_plot_lists_prop
        \l_@@_collaboration_plot_id_tl
        \l_@@_collaboration_plot_collaborations_tl
    }
  }
  \seq_sort:Nn \l_@@_collaboration_plot_nodes_seq
  {
    \prop_get:NnN \l_@@_collaboration_plot_area_prop {##1} \l_tmpa_tl
    \prop_get:NnN \l_@@_collaboration_plot_area_prop {##2} \l_tmpb_tl
    \str_compare:eNeTF
      { \tl_use:N \l_tmpa_tl / ##1 }
      <
      { \tl_use:N \l_tmpb_tl / ##2 }
      { \sort_return_same: }
      { \sort_return_swapped: }
  }
}

\cs_new_protected:Npn \@@_collaboration_plot_collect_edge:nn #1#2
{
  \tl_set:Nn \l_@@_collaboration_plot_source_tl {#1}
  \tl_set:Nn \l_@@_collaboration_plot_target_tl {#2}
  \tl_trim_spaces:N \l_@@_collaboration_plot_source_tl
  \tl_trim_spaces:N \l_@@_collaboration_plot_target_tl
  \tl_if_blank:VF \l_@@_collaboration_plot_target_tl
  {
    \prop_if_in:NVTF \l_@@_collaboration_plot_status_prop
      \l_@@_collaboration_plot_target_tl
    {
      \str_if_eq:VVF
        \l_@@_collaboration_plot_source_tl
        \l_@@_collaboration_plot_target_tl
      {
        \str_compare:eNeTF
          { \tl_use:N \l_@@_collaboration_plot_source_tl }
          <
          { \tl_use:N \l_@@_collaboration_plot_target_tl }
          {
            \tl_set:Nx \l_@@_collaboration_plot_edge_tl
              {
                \tl_use:N \l_@@_collaboration_plot_source_tl
                /\tl_use:N \l_@@_collaboration_plot_target_tl
              }
          }
          {
            \tl_set:Nx \l_@@_collaboration_plot_edge_tl
              {
                \tl_use:N \l_@@_collaboration_plot_target_tl
                /\tl_use:N \l_@@_collaboration_plot_source_tl
              }
          }
        \prop_put:NVn \l_@@_collaboration_plot_edges_prop
          \l_@@_collaboration_plot_edge_tl { 1 }
      }
    }
    {
      \prop_if_in:NVF \l_@@_collaboration_plot_all_status_prop
        \l_@@_collaboration_plot_target_tl
      {
        \msg_warning:nnee { dfg } { collaboration-target-not-found }
          { \l_@@_collaboration_plot_source_tl }
          { \l_@@_collaboration_plot_target_tl }
      }
    }
  }
}

