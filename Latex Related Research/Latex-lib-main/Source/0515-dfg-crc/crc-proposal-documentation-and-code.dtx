\cs_new_protected:Npn \@@_collaboration_plot_prepare:
{
  \prop_clear:N \l_@@_collaboration_plot_visible_prop
  \seq_clear:N \l_@@_collaboration_plot_areas_seq
  \prop_clear:N \l_@@_collaboration_plot_area_nodes_prop
  \prop_clear:N \l_@@_collaboration_plot_area_color_prop
  \int_zero:N \l_@@_collaboration_plot_area_index_int
  \prop_put:NVn \l_@@_collaboration_plot_visible_prop
    \l_@@_collaboration_plot_focus_tl { 1 }
  \seq_map_inline:Nn \l_@@_collaboration_plot_edges_seq
  {
    \@@_collaboration_plot_unpack_edge:n {##1}
    \bool_lazy_or:nnT
    {
      \str_if_eq_p:VV
        \l_@@_collaboration_plot_edge_left_tl
        \l_@@_collaboration_plot_focus_tl
    }
    {
      \str_if_eq_p:VV
        \l_@@_collaboration_plot_edge_right_tl
        \l_@@_collaboration_plot_focus_tl
    }
    {
      \prop_put:NVn \l_@@_collaboration_plot_visible_prop
        \l_@@_collaboration_plot_edge_left_tl { 1 }
      \prop_put:NVn \l_@@_collaboration_plot_visible_prop
        \l_@@_collaboration_plot_edge_right_tl { 1 }
    }
  }
  \seq_map_inline:Nn \l_@@_collaboration_plot_nodes_seq
  {
    \prop_get:NnN \l_@@_collaboration_plot_area_prop {##1}
      \l_@@_collaboration_plot_area_tl
    \prop_if_in:NVF \l_@@_collaboration_plot_area_nodes_prop
      \l_@@_collaboration_plot_area_tl
    {
      \seq_put_right:NV \l_@@_collaboration_plot_areas_seq
        \l_@@_collaboration_plot_area_tl
      \prop_get:NVNTF \l_@@_collaboration_plot_area_color_override_prop
        \l_@@_collaboration_plot_area_tl
        \l_@@_collaboration_plot_color_tl
      {
        \prop_put:NVV \l_@@_collaboration_plot_area_color_prop
          \l_@@_collaboration_plot_area_tl
          \l_@@_collaboration_plot_color_tl
      }
      {
        \int_incr:N \l_@@_collaboration_plot_area_index_int
        \int_set:Nn \l_tmpa_int
          {
            1 + \int_mod:nn
              { \l_@@_collaboration_plot_area_index_int - 1 }
              { \seq_count:N \l_@@_collaboration_plot_area_palette_seq }
          }
        \prop_put:NVx \l_@@_collaboration_plot_area_color_prop
          \l_@@_collaboration_plot_area_tl
          {
            \seq_item:Nn \l_@@_collaboration_plot_area_palette_seq
              { \l_tmpa_int }
          }
      }
      \prop_put:NVn \l_@@_collaboration_plot_area_nodes_prop
        \l_@@_collaboration_plot_area_tl { }
    }
    \prop_get:NVN \l_@@_collaboration_plot_area_nodes_prop
      \l_@@_collaboration_plot_area_tl \l_tmpa_tl
    \tl_if_blank:VTF \l_tmpa_tl
      { \tl_set:Nn \l_tmpa_tl {##1} }
      { \tl_put_right:Nn \l_tmpa_tl { , ##1 } }
    \prop_put:NVV \l_@@_collaboration_plot_area_nodes_prop
      \l_@@_collaboration_plot_area_tl \l_tmpa_tl
  }
}

\cs_new_protected:Npn \@@_collaboration_plot_set_color:n #1
{
  \tl_set:Nx \l_@@_collaboration_plot_label_tl {#1}
