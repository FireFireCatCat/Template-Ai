% Track which projects have already had their PI names expanded by either
% \cs{getProject} or \cs{getProjectPI} in the current section. Chapter
% boundaries also clear the state so references before the first section of a
% new chapter cannot inherit the preceding section's state.
\prop_new:N \g_@@_project_pi_seen_prop
\cs_new_protected:Npn \@@_project_pi_seen_clear:
  { \prop_gclear:N \g_@@_project_pi_seen_prop }
\AddToHook{cmd/chapter/before}[dfg/project-pi-once-per-section]
  { \@@_project_pi_seen_clear: }
\AddToHook{cmd/section/before}[dfg/project-pi-once-per-section]
  { \@@_project_pi_seen_clear: }

% PI details are never appended to reference-only projects, the project
% currently being typeset, or references inside generated tables and lists.
% Otherwise the customization setting selects either the former always-expanded
% \cs{getProjectPI} behaviour or one shared expansion per project and section.
\prg_new_protected_conditional:Npnn \@@_project_pi_if_show_people:n #1
  { T,F,TF }
{
  \@@_project_if_reference_only:nTF {#1}
    { \prg_return_false: }
    {
      \tl_if_eq:VnTF \l__tmp_current_project_tl {#1}
        { \prg_return_false: }
        {
          \bool_if:nTF
            {
              \g_@@_tblr_inside_bool
              || \l_@@_former_project_compact_bool
            }
            { \prg_return_false: }
            {
              \bool_if:NTF \l_@@_custom_project_pi_once_per_section_bool
              {
                \prop_if_in:NnTF \g_@@_project_pi_seen_prop {#1}
                  { \prg_return_false: }
                  {
                    \prop_gput:Nnn \g_@@_project_pi_seen_prop {#1} { }
                    \prg_return_true:
                  }
              }
              { \prg_return_true: }
            }
        }
    }
}

\cs_new_protected:Npn \@@_get_project_with_people:nnn #1#2#3
{
  \bool_if:NTF \l_@@_class_fastcompile_project_bool
  { \@@_get_project_compact:nn {#2} {#3} }
  {
  \group_begin:
  % Project-first references use lastnames by default regardless of the
  % global PIReferenceFirstName setting. The explicit star still selects full
  % names through the starred \getPI call below.
  \bool_set_false:N \l_@@_custom_pi_reference_firstname_bool
  %-----------------------------------------------------------------
  % 0.  Initialise the containers we are going to use.
  %-----------------------------------------------------------------
  %   #2 is a comma‑separated list of *project* IDs → turn it into a clist.
  \clist_set:Nn \l_@@_project_id_clist {#2}
  %   These three clists will be filled during the loops.
  \clist_clear:N \l_@@_person_project_clist   % final result: “project → PI list”
  \clist_clear:N \l_@@_person_id_clist        % temporary list of PIs for one project
  \clist_clear:N \l_@@_person_clist           % temporary list of formatted PI names

  %-----------------------------------------------------------------
  % 1.  Outer loop – one iteration per *project* ID.
  %-----------------------------------------------------------------
  \clist_map_inline:Nn \l_@@_project_id_clist
  {
  	% ##1 = the current project ID
  	%-------------------------------------------------------------
  	%   a)  Put the *project number* (coloured) at the beginning
  	%       of the block that will be stored in
  	%       \l_@@_person_project_clist.
  	%-------------------------------------------------------------
  	\clist_put_right:Nn \l_@@_person_project_clist
  	{%
  		% Reset the per‑project temporaries before we start filling them.
  		\clist_clear:N \l_@@_person_clist
  		\clist_clear:N \l_@@_person_id_clist

		% The coloured project number (e.g. “\color{blue}{12}”)
		\@@_get_project_compact:nn {##1} {#3}

		% Reference-only projects and the current project remain compact. For
		% other projects, the customization setting determines whether PI names
		% are always shown or only on the first reference in this section.
    \@@_project_pi_if_show_people:nT {##1}
    {
		%---------------------------------------------------------
		%   b)  Retrieve the *raw* CSV string that contains all
  		%       person IDs attached to this project.
  		%---------------------------------------------------------
  		\DTLgetvalueforkey
  		{\l_@@_person_id_clist}      % ← will receive something like “per1,per3”
  		{ref-person-id}              % field name in the “project” table
  		{project}{id}{##1}           % look it up for the current project

  		%---------------------------------------------------------
  		%   c)  Build the *list of PI names* for this project.
  		%       We use the “variable” version of \clist_map which
  		%       gives us a temporary clist variable (\l_tmpa_clist)
  		%       that holds a *single* person ID at each iteration.
  		%---------------------------------------------------------
  		\space(%
  		\clist_map_variable:NNn \l_@@_person_id_clist \l_tmpa_clist
  		{
  			% \l_tmpa_clist now expands to one person ID.
  			% We format it with \getPI (or \getPI* if the star was given).
  			\clist_put_right:Ne \l_@@_person_clist
  			{
  				\IfBooleanTF{#1}
  				{\getPI*{\l_tmpa_clist}}
  				{\getPI{\l_tmpa_clist}}
  			}
  		}
  		%---------------------------------------------------------
  		%   d)  Print the formatted PI list, separating consecutive
  		%       names with a thin slash (the macro \addnbthinspace and
  		%       \addthinspace are assumed to be defined elsewhere).
  		%---------------------------------------------------------
		\clist_use:Nn \l_@@_person_clist {\addnbthinspace/\addthinspace}
		  ) % end of the parentheses that surround the PI list
		}
	}   % end of \clist_put_right:Nn   (one *project block*)
  } % end of outer \clist_map_inline:Nn

  %-----------------------------------------------------------------
  % 2.  Typeset the collected project blocks.
  %     \clist_use:Nnnn joins the items with
  %        “~and~”   for the *last* separator,
  %        “,~”      for the *middle* separators,
  %        “,~and~”  for the *penultimate* separator.
  %-----------------------------------------------------------------
  \@@_project_reference_clist_use:N \l_@@_person_project_clist
  \group_end:
  }
}

