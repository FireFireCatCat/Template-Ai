\NewDocumentCommand{\ProjectsTable}{mm}
{%
  \def\tblrbody{}%
  \clist_clear:N \l_@@_research_area_clist
  \tl_clear:N    \l_tmpa_tl
  \clist_clear:N \l_tmpa_clist
  \seq_clear:N   \l_tmpb_seq
  \seq_clear:N   \l_tmpa_seq
  \seq_clear:N   \l_@@_projects_table_institution_ids_seq
  \@@_proj_pi_build:

  \StartTimer
  \DTLsort{number}{project}%
  \StopTimer{Proj-#1-sort}

  \int_zero:N \l_tmpa_int

  \StartTimer
  \DTLforeach*[
  	\DTLisPrefix{\pNumber}{#1}
    \and
    \not\DTLiseq{\pConsiderForLists}{false}
  ]{project}{
  	\pID          = id,
  	\pNumber      = number,
  	\pName        = name,
  	\pStatus      = project-status,
  	\pType        = project-type,
    \pConsiderForLists = consider-for-lists,
  	\l_tmpa_clist = research-area,
  	\pRefPersonId = ref-person-id
  }{%
  	\int_incr:N \l_tmpa_int
    \exp_args:NV \@@_projects_table_collect_institutions:n \pRefPersonId
  	% --- reset ALL flags each iteration ---------------------------------
  	\bool_set_false:N \l_@@_project_type_research_bool
  	\bool_set_false:N \l_@@_project_type_service_bool
  	\bool_set_false:N \l_@@_project_type_mgk_bool
  	\bool_set_false:N \l_@@_project_type_admin_bool

  	\bool_set_false:N \l_@@_project_status_N_bool
  	\bool_set_false:N \l_@@_project_status_E_bool
  	\bool_set_false:N \l_@@_project_status_C_bool


  	\str_case:Vn {\pStatus}
  	{
  		{N}{ \bool_set_true:N \l_@@_project_status_N_bool }
  		{E}{ \bool_set_true:N \l_@@_project_status_E_bool }
  		{C}{ \bool_set_true:N \l_@@_project_status_C_bool }
  	}

  	\str_case:Vn {\pType}{
  		{research}{ \bool_set_true:N \l_@@_project_type_research_bool }
  		{service} { \bool_set_true:N \l_@@_project_type_service_bool  }
  		{mgk}     { \bool_set_true:N \l_@@_project_type_mgk_bool      }
  		{admin}   { \bool_set_true:N \l_@@_project_type_admin_bool    }
  	}

  	\bool_if:nT
  	{ ( \l_@@_project_type_research_bool || \l_@@_project_type_service_bool ) && ! \l_@@_project_status_E_bool }
  	{%
    \clist_set:NV \l_tmpa_clist \l_tmpa_clist
  		\clist_sort:Nn \l_tmpa_clist
  		{ \fp_compare:nTF {##1 < ##2} {\sort_return_swapped:} {\sort_return_same:} }%
  		\seq_set_from_clist:NN \l_tmpa_seq \l_tmpa_clist
  		\seq_set_map:NNn \l_tmpb_seq \l_tmpa_seq
  		{%
  			\prop_if_in:NnTF \g_@@_dfg_research_areas_prop {##1}
  			{ ##1 }
  			{ \textcolor{error}{\textbf{##1}} }%
  		}%
  	}

  	\protected@edef\tblrbody{\tblrbody
      \noexpand\getProject{\pID}
      & \bool_if:NF \l_@@_project_status_C_bool
          { \noexpand\dfgShowTag{\pID}{project-status}{\pStatus}[project] }
      & \noexpand\dfgShowTag{\pID}{name}{\pName}[project]
  		&
  		\bool_if:nT
  		{ ( \l_@@_project_type_research_bool || \l_@@_project_type_service_bool ) && ! \l_@@_project_status_E_bool }
      {{\noexpand\dfgShowTag{\pID}{research-area}
          {\seq_use:Nn \l_tmpb_seq {\\}}[project]}}
  		& \dfgFastPIinProjectsTable{\pRefPersonId}
  		\\
  	}%
  }
  \StopTimer{Proj-#1-loop}
  \iow_term:x { Proj-#1-iterations:~ \int_use:N \l_tmpa_int }

  \StartTimer
  \begin{tblr}[
  		theme   = main,
  		expand  = \tblrbody,
  		caption = {Project~area~#1~--~#2},
  		long
  	]{
  		colspec     = {m{1.1cm}@{}m{0.2cm}X[m]m{1.1cm}X[1.3,m]},
  		rowhead     = 1,
        rows        = {halign=l,font=\raggedright},
  		column{2,4} = {halign=c},
		% column{1}   = {fg=tableFirstColumn},
  		row{1}      = {
  			              bg     = tableHeadingsBG,
  			              fg     = tableHeadingsFont,
  			              font   = \bfseries,
  			              % halign = c,
  			              guard
  		              },
  	}
  	Project
  	 & %{Status}
  	 & Title
  	 & {\mbox{Research}                                               \\area}
  	 & Project\space leader(s),\space institute(s),\space location(s)         \\
	\tblrbody
  \end{tblr}
  \@@_projects_table_institution_legend:
  \StopTimer{Proj-#1-render}
}
