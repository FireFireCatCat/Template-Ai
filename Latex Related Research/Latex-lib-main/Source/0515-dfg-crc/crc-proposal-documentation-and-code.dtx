% The public |label| option is a prefix, not enumitem's complete label
% format. Keep the original list and counter so existing list settings and
% numeric \cs{ref} values remain valid. A stable type per prefix prevents a
% later list from renaming earlier references. Store its name in the aux file
% so cleveref knows it before constructing formats and forward references on
% the next run. Other enumitem options pass through unchanged.
% Expand the label explicitly: older expl3 releases provide the hash
% function without its V variant.
%    \begin{macrocode}
\tl_new:N \l_@@_aim_label_tl
\tl_new:N \l_@@_aim_options_tl
\tl_new:N \l_@@_aim_type_tl
\keys_define:nn { dfg / aims }
{
  label .tl_set:N = \l_@@_aim_label_tl,
  label .value_required:n = true,
}
\NewCommandCopy\dfgOriginalAims\aims
\NewCommandCopy\dfgOriginalEndAims\endaims
\cs_new_protected:Npn \@@_aims_begin:n #1
  { \dfgOriginalAims[#1] }
\RenewDocumentEnvironment{aims}{ O{} }
{
  \tl_set:Nn \l_@@_aim_label_tl { \q_no_value }
  \keys_set_known:nnN { dfg / aims } {#1} \l_@@_aim_options_tl
  \quark_if_no_value:NF \l_@@_aim_label_tl
  {
    \tl_set:Ne \l_@@_aim_type_tl
      { dfg-aim-\exp_args:NV \str_mdfive_hash:n \l_@@_aim_label_tl }
    \exp_args:NnV \crefalias { aimsi } \l_@@_aim_type_tl
    \protected@write\@auxout{}
    {
      \string\dfgAimReferenceName
        {\l_@@_aim_type_tl}{\exp_not:V \l_@@_aim_label_tl}
    }
    \tl_put_left:Ne \l_@@_aim_options_tl
    {
      label={\exp_not:V \l_@@_aim_label_tl
        \exp_not:n {~\arabic*:}},
      \exp_not:n {ref={\arabic*},}
    }
  }
  \exp_args:NV \@@_aims_begin:n \l_@@_aim_options_tl
}
{ \dfgOriginalEndAims }
%    \end{macrocode}
