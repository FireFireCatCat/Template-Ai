    (*\refKey{name}*)           = {Rheinisch-Westfälische Technische Hochschule Aachen},
    (*\refKey{abbreviation}*)   = {RWTH Aachen University},
    (*\refKey{addressStreet}*)  = {Templergraben 55},
    (*\refKey{addressZIP}*)     = {52062},
    (*\refKey{location}*)       = {Aachen},
    (*\refKey{country}*)        = {Germany}
  }
\end{dispListing*}

\begin{docKey}{abbreviation}{=\meta{string}}{}
  In addition to \refKey{name} provide an abbreviated version of this affiliation.
\end{docKey}

\begin{docKey}{addressStreet}{=\meta{string}}{}
  Specify the street of the affiliation.
\end{docKey}

\begin{docKey}{addressZIP}{=\meta{string}}{}
  Specify the ZIP code of the affiliation.
\end{docKey}

\begin{docKey}{location}{=\meta{string}}{}
  Specify the location (city) of the affiliation.
\end{docKey}

\begin{docKey}{country}{=\meta{string}}{}
  Specify the country the affiliation is located at.
\end{docKey}

\subsection{Keyset \textbf{funding}}

Each row represents one funding line.  For a staff row, the class can derive
the annual amount from the declared personnel category, percentage, and yearly
quantity.  For other funding types, annual values continue to be supplied
with \refKey{sum}.

\begin{dispListing*}{title={Complete dataset for a funding entity. Not all keys
        are always required.}}
  (*\refCom{addEntry}*)[funding]{RequestedFunding}{
    (*\refKey{id}*)                 = {A01-staff-prof},
    (*\refKey{ref-project-id}*)     = {A01},
    (*\refKey{ref-affiliation-id}*) = {RWTH},
    (*\refKey{financed-by}*)        = {DFG},
    (*\refKey{funding-type}*)       = {staff},
    (*\refKey{percentage}*)         = {100},
    (*\refKey{category}*)           = {prof},
    (*\refKey{quantity}*)           = {
      { year1 = {1} },
      { year2 = {1} },
      { year3 = {1} },
      { year4 = {1} },
      { year5 = {1} },
    },
    (*\refKey{sum}*) = {
      { year1 = {1000} },
      { year2 = {1000} },
      { year3 = {1000} },
      { year4 = {1000} },
      { year5 = {1000} },
    },
    (*\refKey{year}*)               = {2026},
    (*\refKey{applicant}*)          = {5000},
    (*\refKey{participant}*)        = {2000},
    (*\refKey{other-funds}*)        = {0},
    (*\refKey{staff}*)              = {5000},
    (*\refKey{costs}*)              = {1200},
    (*\refKey{instrumentation}*)    = {0},
    (*\refKey{fellowships}*)        = {0},
    (*\refKey{globalfunds}*)        = {0}
  }
\end{dispListing*}

Not all of the above mentioned keys are necessary for each funding table.
We will provide examples for the various funding databases and their required
keysets.

\begin{docKey}{funding-type}{\docKeyChoices{staff, costs, fellowships,
      globalfunds, instrumentation}}{}
  Define the type of this funding according to the predefined set. This is
  important since different features are activated depending on the value of this key.
\end{docKey}

\begin{docKey}{percentage}{=\meta{number}}{}
  This is only relevant when \refKey{funding-type} is set to |staff|.
  State the percentage of a full position, for example |100| for a full
  position or |65| for a 65\% position.  Integer and decimal values are
  accepted by the automatic calculation.
\end{docKey}

\begin{docKey}{positionText}{=\meta{text}}{}
  Optional replacement for the staff description in the requested-funding
  table. When supplied, it is printed instead of the translated
  \refKey{category} name. If omitted or empty, the category name is printed.
  The category still determines the salary calculation.
\end{docKey}

\begin{docKey}{category}{\docKeyChoices{groupLeader, prof, prof-W2, prof-W3,%
    postDoc,medDoc,PhD,research,nonResearch,student,assistant}}{}
  This is only relevant when \refKey{funding-type} is set to |staff|.
  Describe the kind of the required person. Depending on this \meta{category}
  the matching |salary@...| setting is used.  The categories |prof|,
  |prof-W2|, and |prof-W3| all use \refKey{salary@prof}; the other category
  names correspond directly to their setting names below.
\end{docKey}

\begin{docKey}{quantity}{=\meta{key=value}}{}
  This is a key that enables further \meta{key-values} with a predefined subset
  |year1| through |year5|. State how many positions of the
  \refKey{category} are required in each year. Decimal quantities are
  supported, for example |year1={0.5}| for half a position.
\end{docKey}

\begin{docKey}{sum}{=\meta{key=value}}{}
  This is a key that enables further \meta{key-values} with a predefined subset
  for the individual years. State the sum for a person for a certain
  \refKey{category}.  For |funding-type=staff| this key is optional: every
  omitted yearly sum is calculated from the salary setting for
  \refKey{category}, \refKey{percentage}, and that year's
  \refKey{quantity}.  Because the five-year CRC period starts and ends with a
  half-year, automatically calculated amounts for |year1| and |year5| receive
  an additional factor of |0.5|; |year2| through |year4| use the complete
  annual rate.  The result is rounded to the nearest euro.  An explicit yearly
  sum remains an override, so existing declarations and exceptional personnel
  costs keep their stated value.
\end{docKey}

For every omitted staff sum, the class applies
\[
  \operatorname{round}\left(
    \text{salary(category)} \times
    \frac{\text{percentage}}{100} \times
    \text{quantity(year)} \times
    \text{period-factor(year)}, 0
  \right).
\]
Here, \(\text{period-factor}=0.5\) for |year1| and |year5| and \(1\) for
|year2|--|year4|.  Thus the two half-years together count as one complete
salary year.
The calculation is performed when the row is added and the result is stored in
the normal |sum-year1| through |sum-year5| fields.  Funding tables therefore
use calculated and explicitly supplied amounts in exactly the same way.  A
missing salary setting, percentage, or valid quantity produces a warning
instead of silently inventing an amount.

\begin{dispListing*}{title={Staff funding with automatically calculated sums.}}
(*\refCom{addEntry}*)[funding]{RequestedFunding}{
  (*\refKey{ref-project-id}*) = {A01},
  (*\refKey{funding-type}*)   = {staff},
  (*\refKey{category}*)       = {PhD},
  (*\refKey{percentage}*)     = {65},
  (*\refKey{quantity}*)       = {
    year1 = {1}, year2 = {1}, year3 = {1},
    year4 = {1}, year5 = {1}
  }
}
\end{dispListing*}

\begin{docKey}{year}{=\meta{integer}}{}
  State the year as integer. Actually only relevant in combination with
  \refKey{applicant}, \refKey{participant}, \refKey{other-funds}, \refKey{staff}, \refKey{costs}, \refKey{instrumentation}, \refKey{fellowships}, \refKey{globalfunds}.
\end{docKey}


\begin{docKey}{applicant}{=\meta{integer}}{}
  State the sum of direct costs for the applicant institution.
\end{docKey}

\begin{docKey}{participant}{=\meta{integer}}{}
  State the sum of direct costs for any other participating (i.e. not-applicant) institution.
\end{docKey}


\begin{docKey}{other-funds}{=\meta{integer}}{}
  State the sum of direct costs when neither the applicant nor a participating
  institution is covering the costs.
\end{docKey}

\begin{docKey}{staff}{=\meta{integer}}{}
  State the \meta{sum} of staff for the previous funding phase.
  This is a fixed sum and therefore not necessary to calculate the sum like we do
  with \refKey{category} etc.
\end{docKey}

\begin{docKey}{costs}{=\meta{integer}}{}
  State the \meta{sum} of direct costs for the previous funding phase.
  This is a fixed sum and therefore not necessary to calculate the sum like we do
  with \refKey{category} etc.
\end{docKey}


\begin{docKey}{instrumentation}{=\meta{integer}}{}
  State the \meta{sum} of instrumentation for the previous funding phase.
  This is a fixed sum and therefore not necessary to calculate the sum like we do
  with \refKey{category} etc.
\end{docKey}


\begin{docKey}{fellowships}{=\meta{integer}}{}
  State the \meta{sum} of staff for the previous funding phase.
  This is a fixed sum and therefore not necessary to calculate the sum like we do
  with \refKey{category} etc.
\end{docKey}


\begin{docKey}{globalfunds}{=\meta{integer}}{}
  State the \meta{sum} of globalfunds for the previous funding phase.
  This is a fixed sum and therefore not necessary to calculate the sum like we do
  with \refKey{category} etc.
\end{docKey}

\subsection{Keyset \textbf{staff}: requested-funding roster}

The |staff| key family also supplies the project-level roster required by the
DFG section \enquote{Requested funding for staff}.  These records use the fixed
database |RequestedFundingStaff| and are independent of the monetary
|RequestedFunding| rows above.  The public output call is
\refCom{printTable}|{{RequestedFundingStaff}{A01}}|.

\begin{dispListing*}{title={Complete staff-roster declaration.}}
(*\refCom{addEntry}*)[staff]{RequestedFundingStaff}{
  (*\refKey{ref-project-id}*)     = {A01},
  (*\refKey{funding-status}*)     = {existing},
  (*\refKey{staff-type}*)         = {research},
  (*\refKey{ref-person-id}*)      = {MM},
  (*\refKey{field-of-research}*)  = {Microbiology},
  (*\refKey{commitment}*)         = {8},
  (*\refKey{funding-source}*)     = {State funds},
  (*\refKey{description}*)        = {
    Leads the experimental work and supervises the research staff.
  }
}
\end{dispListing*}

\begin{docKey}{ref-project-id}{=\meta{project-id}}{}
  Required. Selects the project for which the roster row is printed.  The
  value must match the project argument in the table call.  For example, a
  row with |ref-project-id={A01}| is selected when |A01| is passed as the
  project argument to \refCom{printTable}.
\end{docKey}

\begin{docKeys}[
  doc parameter={=\meta{choice}}
]{
  {doc name=funding-status,
   doc parameter={\docKeyChoices{existing,requested}}},
  {doc name=staff-type,
   doc parameter={\docKeyChoices{research,nonResearch}}}
}
  These two required keys select one of the four official DFG groups.  Empty
  subgroups are omitted and declaration order is retained within each group.
  In a project with |project-status=E|, |funding-status=requested| denotes
  staff funded with approved grant money in the ending funding period; the
  table changes that group label and its job-description heading
  automatically.
\end{docKeys}

\begin{docKeys}[doc parameter={=\meta{string}}]{
  {doc name=ref-person-id},
  {doc name=firstname},
  {doc name=lastname},
  {doc name=academic-degree},
  {doc name=positionText}
}
  A resolvable \refKey{ref-person-id} obtains the name, academic degree,
  position, category, and organisation from the central |person| fields
  |firstname|, |lastname|, |academicdegree|, |positionText|, |position|,
  |ref-institution-id|, and the compatibility fallback |ref-affiliation-id|.
  Any explicitly supplied roster field overrides the central value. An empty
  or omitted \refKey{academic-degree} is silently left out of both the roster
  and the job-description heading. For an unnamed vacancy, use
  |lastname={TBA}|; |firstname| may then also be omitted, and both the roster
  and the job-description lead-in print a clean ``TBA'' marker. Multiple
  unnamed vacancies are distinguished by their category, position, field of
  research, and institution when duplicate records are checked. Either a
  person reference or at least a last name is required. For existing staff
  resolved through \refKey{ref-person-id}, the lastname is printed in bold in
  the roster.
  The position is optional: omitting |positionText| inherits the central
  person's position, whereas an explicit |positionText={}| suppresses it.
  If the resulting position is empty, its line and parentheses are omitted
  without a missing-field warning.
  The former roster key |position| remains accepted as a compatibility alias
  for |positionText|.
\end{docKeys}

\begin{docKeys}[doc parameter={=\meta{string}}]{
  {doc name=field-of-research},
  {doc name=funding-source},
  {doc name=description}
}
  \refKey{field-of-research} supplies its table cell for every roster row.
  It may be empty or omitted for existing non-research staff; in that case the
  empty cell receives the |tableNoValue| background and no missing-field
  warning is issued.  It remains an
  applicable, warning-checked value for the other three staff groups.
  \refKey{funding-source} applies only to existing staff; the corresponding
  cell for requested staff is marked as not applicable.  \refKey{description}
  supplies the numbered text below the table and accepts ordinary paragraph
  material, citations, and other LaTeX commands.  Each description is an item
  in the applicable existing- or requested-staff list. Its number is the
  flush-left item label; academic degree, first name, last name, and all
  continuation lines share a consistent hanging indent. The bold name and
  description are separated by a normal interword space.
  Missing applicable values are highlighted and reported in the log.
\end{docKeys}

\begin{docKey}{ref-institution-id}{=\meta{id-list}}{}
  Resolve one or more comma-separated institution ids through the central
  |institution| database.  Each institution's \refKey{abbreviation} is printed
  in the department/institution column; the full \refKey{name} is retained in
  the automatically generated legend together with its parent affiliation.
  Parent-affiliation abbreviations are checked and explained in first-use
  order.  This key may be omitted when a resolvable \refKey{ref-person-id}
  already supplies |person.ref-institution-id|; a value on the staff row acts
  as an explicit override.  When \refKey{ref-person-id} is empty or omitted,
  \refKey{ref-institution-id} must be supplied explicitly.  The class warns at
  declaration time if both keys are empty, because the institution cannot be
  inherited and an existing staff member could not be assigned to an
  affiliation in \refCom{OverviewExistingStaffTable}.
\end{docKey}

\begin{docKey}{department}{=\meta{string}}{}
  Compatibility override for unstructured declarations.  When present, this
  text is printed directly and takes precedence over institution lookup.  New
  declarations should normally use \refKey{ref-institution-id}.
\end{docKey}

\begin{docKey}{ref-affiliation-id}{=\meta{affiliation-id}}{}
  Compatibility fallback used only when neither \refKey{department} nor
  \refKey{ref-institution-id} is supplied.  It prints the affiliation
  abbreviation and adds the affiliation to the legend.  New declarations
  should use \refKey{ref-institution-id} so the organisational unit and its
  parent affiliation remain separate structured data.  In particular, this
  compatibility key does not replace the required \refKey{ref-institution-id}
  on a row that has no \refKey{ref-person-id}.
\end{docKey}

\begin{docKey}{commitment}{=\meta{number}}{}
  Project commitment in hours per week for existing staff.  The value may be
  a non-negative integer or decimal; no artificial upper limit is imposed.
  For requested staff the table cell is marked as not applicable.
\end{docKey}

\begin{docKey}{category}{\docKeyChoices{prof,groupLeader,postDoc,medDoc,
    PhD,research,nonResearch,student,assistant,prof-W2,prof-W3}}{}
  Required for requested staff unless it can be inherited from
  |person.position| through \refKey{ref-person-id}.  Only keys registered in
  \cs{g\_\_dfg\_dfg\_category\_names\_prop} are accepted, and the table
  expands each key to the label stored in that property; for example,
  |postDoc| prints \enquote{Postdoctoral researcher}.  Existing staff inherit
  the category for the chapter-2 overview when possible, but may still supply
  an explicit override; their Category cell in the project-level roster is
  marked as not applicable.
\end{docKey}

The table traverses |RequestedFundingStaff| only once for the selected project,
then assigns continuous sequence numbers in display order.  The same numbers
are reused below the table for the two job-description blocks.  Missing values,
unresolved references, and exact duplicate identities produce warnings and
visible placeholders without stopping compilation.

\paragraph{Reuse in chapter 2: overview of existing staff}

The same declarations also populate the proposal-wide table in section 2.1.2;
no separate totals database is needed.  The call is
\refCom{printTable}|{OverviewExistingStaff}|.  It selects only rows with
|funding-status={existing}|, counts one person per distinct parent affiliation,
and groups the values into the seven categories prescribed by the DFG form.
An unnamed or otherwise unreferenced person therefore needs an explicit
|ref-institution-id|; omitting both it and |ref-person-id| produces a warning
when the roster row is declared.
The mappings are |prof|, |prof-W2|, and |prof-W3| to Professors,
|groupLeader| to Junior research group leaders, |postDoc| to Postdoctoral
researchers, |PhD| to Doctoral researchers,
|research| and |medDoc| to Other research staff, |nonResearch| to Non-research
staff, and |student| and |assistant| to Student and graduate assistants.

The category column uses |X[3,l]|, reduced from |X[4,l]|; each affiliation
column remains |X[1,c]|. The label reads \enquote{Junior research group}
on its first line and \enquote{leaders} on its second line. This layout is
maintained in the class source, so a proposal customization override is not
needed after updating the generated class.

The proposal workspace contains a standalone layout test at
\path{proposal-overleaf-com/__admin/scripts/test-overview-staff.tex}.
It declares 85 complete fictional staff records across all seven categories
and nine real affiliations in an isolated database, independently of project
auxiliary files. The source lists the expected counts and build commands.
Run LuaLaTeX twice from the proposal workspace; the PDF is written to
\path{output/pdf/test-overview-staff.pdf}. The test PDF labels the counts as
illustrative rather than proposal totals.

The applicant affiliation or affiliations are read as a comma-separated list
from |meta.ref-affiliation-id| and printed first; other affiliations are
obtained from each row's |ref-institution-id|.  The group heading says
enquote{applicant university} for one id and enquote{applicant universities}
for several ids, spanning all corresponding columns.  Multiple institutions
belonging to the same affiliation count that person only once in that
affiliation column.  Since the project declarations normally occur after
chapter 2, the class transfers the rows through the |.aux| file.  The normal
multi-pass |latexmk| build therefore fills the table automatically on the next
pass.


\subsection{Shared identifiers and CRC metadata}
Following keys are available for the \meta{person}-keyset.

\begin{docKey}{id}{=\meta{unique string}}{}
  Any kind of a unique string that serves as an id, especially for commands
  like \refCom{getEntry}. Almost all databases require this key.
\end{docKey}

\begin{docKeys}[
    doc parameter = {=\meta{string}}
  ]{
    { doc name = firstname },
    { doc name = lastname },
    { doc name = academicdegree },
    { doc name = gender,
      doc parameter = {\docKeyChoices{f,m,d}}},
    { doc name = period,
      doc parameter = {\docKeyChoices{1,2,3}},
      doc description = multi choice!!},
    { doc name = role,
      doc parameter = {\docKeyChoices{PI, spokesperson, manager,
            steering-committee-member, rector}}},
    { doc name = position,
      doc parameter = {\docKeyChoices{PhD, postDoc, groupLeader, research,
            nonResearch, student, prof, prof-W2, prof-W3}}},
    { doc name = positionText,
      doc parameter = {=\meta{string}},
      doc description = {Specifying the position of the person, current or in the CV-section for the respective period.}},
  }
  Personal and individual \emph{required} information about a person.
\end{docKeys}

\begin{docKeys}[
    doc parameter = {=\meta{string}}
  ]{
    { doc name = ref-institution-id },
    { doc name = ref-affiliation-id },
    { doc name = ref-project-id     },
  }
  Referencing to an external database with its dedicated \meta{id}.
  \textbf{Note:} When you reference using \refKey{ref-institution-id}, there
  is no need to explicitly reference the affiliation with \refKey{ref-affiliation-id}.
\end{docKeys}

The institution data is resolved through a two-step relationship.  A person
stores one or more institution ids in \refKey{ref-institution-id}; each
institution stores the id of its parent affiliation in
\refKey{ref-affiliation-id}.  Commands such as \refCom{printList}
therefore follow this chain:
\[
  \texttt{person.ref-institution-id}
  \longrightarrow
  \texttt{institution.id}
  \longrightarrow
  \texttt{institution.ref-affiliation-id}
  \longrightarrow
  \texttt{affiliation.id}.
\]
The affiliation id usually does not need to be duplicated in the person entry.

For the database |meta| there are also dedicated keys.
The database |meta| contains specific information on the metalevel about the
CRC.
For the |meta| row with |id=crc|, \refKey{ref-affiliation-id} accepts one or
more comma-separated affiliation ids, for example |{aff1,aff2}|.  These are the
applicant or coordinating universities.  Their names and locations are
resolved in declaration order for the title page and related prose; applicant
funding totals include every listed id.
Besides \refKey{id}, \refKey{ref-affiliation-id} there are these dedicated keys:
\begin{docKeys}{
    {doc name = name,
      doc parameter = {=\meta{string}},
      doc description = {applicable to other keysets, too.}},
    {doc name = nameAddon,
      doc parameter = {=\meta{string}}},
    {doc name = number,
      doc parameter = {=\meta{integer}}},
    {doc name = fundingPeriodNumeral,
      doc parameter = {\docKeyChoices{1,2,3}},
    },
    {doc name = fundedSince,
      doc parameter = {=\meta{YYYY}}},
    {doc name = fundingYears,
      doc parameter = {=\meta{YYYY1,YYYY2,YYYY3,YYYY4,YYYY5}}},
    {doc name = fundingYearsPrevious,
      doc description = {applicable to 2nd and 3rd phases},
      doc parameter = {=\meta{YYYY1,YYYY2,YYYY3,YYYY4,YYYY5}}},
  }
  Specify the core information of a CRC.
  The key \refKey{fundingPeriodNumeral} corresponds to \refKey{period}.
\end{docKeys}
\section{Adjustments and Customizations}
\label{doc:customization}

\subsection{Documentclass options}
\begin{docCommand}{documentclass}{\marg{key=value}}
  Adjust on a metalevel various options (e.g.
  \refKey{showmarginalia},
  \refKey{fastcompile},
  \refKey{fastcompile-show-tags},
  \refKey{fastcompile-project},
  \refKey{fastcompile-project-show-images},
  \refKey{fastcompile-project-show-publications},
  \refKey{fastcompile-project-show-funding-tables},
  \refKey{showtags},
  \refKey{showtags-tables},
  \refKey{skip10pub},
  \refKey{cv},
  \refKey{final},
  \refKey{colorscheme})
  for the whole document. Not so much content
  wise but rather organisational.

  See \dfgExampleRef{ex:manual-generate-the-cv-appendix-or-select-one-person}.
\end{docCommand}

\begin{docKey}{BCOR}{=\meta{dim}}{initially \texttt{5mm}}
  Reserve binding space on the inner edge of each page.  The class passes this
  KOMA-Script option to \pkg{geometry} as its binding offset.  With the
  default 30\,mm nominal inner margin, |BCOR=5mm| gives 35\,mm of inner
  clearance and a 160\,mm text block; |BCOR=8mm| gives 38\,mm and 157\,mm.
\end{docKey}

\begin{docKey}{showmarginalia}
  {\docKeyChoices{true,false}}
  {initially \texttt{false}.}
  Show further information in the marginpar area, esp. total sum in funding tables.
\end{docKey}

\begin{docKey}{fastcompile}
  {\docKeyChoices{true,false}}
  {initially \texttt{false}.}
  Skip generated tables and lists, role-card grids, Gantt charts, and the CV
  publication block.  Metadata and ordinary database-backed references remain
  available, making this the less aggressive compatibility mode.
\end{docKey}

\begin{docKey}{fastcompile-show-tags}
  {\docKeyChoices{true,false}}
  {initially \texttt{false}.}
  Show database provenance annotations during either fast-compilation mode.
  In focused project mode, annotations show the starting row and requested
  lookup path because metadata rows are skipped. This option has no effect
  outside fast compilation; final mode disables the annotations.
\end{docKey}

\begin{docKey}{fastcompile-project}
  {\docKeyChoices{true,false}}
  {initially \texttt{false}.}
  Compile authored project text with minimal calculated framing.  This mode
  implies \refKey{fastcompile}, does not load metadata files unless
  \refKey{fastcompile-project-show-images} needs project rows, and executes only
  the three project-local funding entry types when
  \refKey{fastcompile-project-show-funding-tables} is enabled. It replaces the
  calculated project head with state-only setup,
  disables title/front-matter helpers when wrapped with
  \cs{dfgIfFastCompileProjectF}, and uses draft links.  Graphics also default
  to draft placeholders unless \refKey{fastcompile-project-show-images} is enabled.
  Database references fall back to their IDs so prose remains readable. Apart
  from the optional project funding tables, generated tables and lists retain
  the same visible skipped-item notice as \refKey{fastcompile}.
\end{docKey}

\begin{docKey}{fastcompile-project-show-images}
  {\docKeyChoices{true,false}}
  {initially \texttt{false}.}
  Render images and generated plots encountered in the selected project while
  \refKey{fastcompile-project} is active.  Project entries from the metadata
  file are retained for database-backed plots such as
  |\printPlot{{ProjectCollaboration}{B06}}|; other metadata entries,
  calculated headings, generated tables and the remaining fast-mode work stay
  disabled.  With the default value, \pkg{graphicx} stays in draft mode,
  displays image placeholders, and \refCom{printPlot} emits the usual skipped
  item notice.
\end{docKey}

\begin{docKey}{fastcompile-project-show-publications}
  {\docKeyChoices{true,false}}
  {initially \texttt{false}.}
  Show or suppress project publication headings, explicit project \cs{nocite}
  lists, project bibliographies, report references, and ending-project result
  lists while \refKey{fastcompile-project} is active.  Ordinary and final builds
  always enable publication output.  When this option is false in focused
  project mode, inline citation commands render compact bibliography-key
  markers without requesting biber.
\end{docKey}
\begin{docKey}{fastcompile-project-show-funding-tables}
  {\docKeyChoices{true,false}}
  {initially \texttt{true}.}
  Show or suppress \cs{RequestedFundingTable},
  \refCom{RequestedFundingStaffTable}, and
  \cs{RequestedAndExistingFundingDirectCostsTable} while
  \refKey{fastcompile-project} is active. Focused mode processes only the
  corresponding project-local |RequestedFunding|, |RequestedFundingStaff|, and
  |RequestedAndExistingFundingDirectCosts| entries. Local staff-cost and total
  calculations remain available, including the per-year and full-period sums
  of existing direct-cost rows. Multiple rows accumulate in those local sums.
  Missing staff-table values use field-name placeholders such as
  |<firstname>| instead of ``not provided'' in fast compilation, since
  metadata needed for inherited values may have been skipped.
  Auxiliary-file restoration and proposal-wide overview caches stay disabled. This option has no effect on
  ordinary or final builds, where these tables are always rendered.
\end{docKey}
\begin{docKey}{showtags}
  {\docKeyChoices{true,false}}
  {initially \texttt{false}.}
  Annotate direct database values with their database, row identifier, and
  field, and calculated values with a concise calculation and source-database
  label.  Successive labels alternate between two vertical levels to keep
  adjacent annotations legible. During fast compilation,
  \refKey{fastcompile-show-tags} controls whether these annotations appear.
  In focused project mode, annotations identify the starting row and full
  requested field path because skipped metadata cannot supply destination row
  identifiers. Final mode disables annotations.
\end{docKey}
\begin{docKey}{showtags-tables}
  {\docKeyChoices{true,false}}
  {initially \texttt{true}.}
  Allow provenance tags inside generated table cells when \refKey{showtags} is
  enabled.  Set this to \texttt{false} to retain tags in prose and other output
  while keeping tables uncluttered.  It has no effect when \refKey{showtags} is
  disabled.
\end{docKey}
\begin{docKey}{skip10pub}
  {={\meta{\texttt{true}\textbar\texttt{false}}}}
  {initially \texttt{false}.}
  Especially in the CV part, it might take longer to compile the reference list
  with the 10 most important publications. With this set to \meta{true} the
  reference list will be skipped.
\end{docKey}

\begin{docKey}{colorscheme}
  {\docKeyChoices{rgb,cmyk}}
  {initially \texttt{cmyk}.}
  Set the colorscheme according to your needs. For a PDF that is meant for
  only being displayed on a screen, go with \meta{rgb}, for a printed version
  choose \meta{cmyk}.
\end{docKey}



\begin{docKey}{cv}
  {\docKeyChoices{true,false}}
  {initially \texttt{false}.}
  In the document which prints the CVs, set this option to \meta{true}, since
  it will show additional/needed text and modifications.
\end{docKey}


\begin{docKey}{final}
  {\docKeyChoices{true,false}}
  {initially \texttt{false}.}
  When your proposal has been finalised and is ready to be submitted, set this
  option to \meta{true} for the final compilation. The capitalized alias
  \texttt{Final} is accepted for compatibility. This option has
  consequences for
  \refKey{showmarginalia},
  \refKey{showtags},
  \refKey{fastcompile},
  \refKey{fastcompile-project},
  \refKey{skip10pub},
  \refKey{fastcompile-project-show-publications},
  \refKey{colorscheme}, and open-access markers in the bibliography. Open-access
  DOI API lookup is enabled only in final documents when \refKey{doiAPIMail}
  is non-empty and LuaSocket is available.
\end{docKey}

\begin{dispListing*}{title={Example configuration for documentclass mit \texttt{final}-flag}}
  \documentclass[
    (*\refKey{final}*)           =true,
  % sets to false:
  (*\refKey{showmarginalia}*) =false,
    (*\refKey{showtags}*)       =false,
    (*\refKey{fastcompile}*)    =false,
    (*\refKey{fastcompile-project}*)=false,
    (*\refKey{fastcompile-project-show-funding-tables}*)=true,
    (*\refKey{skip10pub}*)      =false,
    (*\refKey{fastcompile-project-show-publications}*)=true,
    (*\refKey{colorscheme}*)    =cmyk
  ]{dfg-crc}
\end{dispListing*}

\subsection{Change default settings}
In the \dfgFile{preamble/dfg-customization} you can overwrite the default settings of
this documentclass.



Read these settings in text with \refCom{getValue}, for example
|\num{\getValue{animalHousing@mouse}}\,EUR|.

The following keys are to be set or changed in \refCom{changeSettings}:

\begin{docKeys}[doc parameter={=\meta{file path}}]{
  {doc name=crcLogoPath,
   doc description=initially \texttt{example-image-a}},
  {doc name=affiliationLogoPath,
   doc description=initially \texttt{example-image-b}}
}
  Select the image files used by \cs{crcLogo} and \cs{affiliationLogo}.
  As with \cs{includegraphics}, the file extension may be omitted.
\end{docKeys}

\begin{docKey}{doiAPIMail}{=\meta{email address}}{initially empty}
  Set the contact address required by the DOI API used for automatic
  open-access markers.  Network lookup remains disabled unless this value is
  non-empty, the document uses |final=true|, and LuaLaTeX has socket support.
\end{docKey}

\begin{docKey}{projectPIOncePerSection}{\docKeyChoices{true,false}}{initially \texttt{true}}
  Show the PIs attached to a project only on that project's first shared
  \refCom{getProject} or \refCom{getProjectPI} reference in each section.
  Later references use the compact project form. Set this to \texttt{false} to
  keep \refCom{getProject} compact and repeat the PI names at every
  \refCom{getProjectPI} reference. References to the current project and
  references in generated tables and lists always remain compact.
\end{docKey}

\begin{docKey}{PIReferenceFirstName}{\docKeyChoices{true,false}}{initially \texttt{false}}
  Include the firstname in unstarred \refCom{getPI} references. The starred
  form always includes it. Set this through \refCom{changeSettings}; it also
  affects person-first \refCom{getPIProject} and \refCom{getPIofProject}.
  Project-first \refCom{getProjectPI} references keep lastnames unless the
  command is starred. Shared PI surnames are automatically disambiguated by
  the first given-name initial in unstarred references, regardless of this
  setting. If that initial is also shared, the full firstname is used.
  Use the starred command to request full firstnames explicitly.
\end{docKey}

\begin{docKey}{projectsTableInstitutionAbbreviations}{\docKeyChoices{true,false}}{initially \texttt{false}}
  Control the institution display in \cs{ProjectsTable} and
  \cs{ProjectLeadersTable}.  With \texttt{true}, both tables use compact
  institution abbreviations; each projects table is followed by a tightly set
  legend containing only the abbreviations used in that table, sorted
  alphabetically by abbreviation.  Reusing one abbreviation for different
  institution names raises a package warning.  With \texttt{false}, full
  institution names are printed and no legend is added.
\end{docKey}

\begin{docKeys}[doc parameter={=\meta{color list}}]{
  {doc name=collaborationAreaColors,
   doc description=initially \texttt{A=projectA,B=projectB,Q=projectQ}},
  {doc name=collaborationAreaPalette,
   doc description=initially a rotating seven-color palette}
}
  Set collaboration-area colors once for every collaboration plot.
  |collaborationAreaColors| is a key--value mapping such as
  |{A=projectA,B=projectB,C=orange}|.  Areas absent from that mapping receive
  colors from |collaborationAreaPalette| in deterministic area order.  The
  corresponding |area-colors| and |area-palette| plot options override these
  settings for one \refCom{printPlot} call.
\end{docKeys}

\begin{docKeys}[doc parameter={=\meta{euros per year}}]{
  {doc name=salary@prof,
   doc description=initially \texttt{126600}},
  {doc name=salary@groupLeader,
   doc description=initially \texttt{105000}},
  {doc name=salary@postDoc,
   doc description=initially \texttt{90600}},
  {doc name=salary@medDoc,
   doc description=initially \texttt{112200}},
  {doc name=salary@PhD,
   doc description=initially \texttt{83700}},
  {doc name=salary@research,
   doc description=initially \texttt{69000}},
