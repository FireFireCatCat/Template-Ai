}

\cs_new_protected:Npn \@@_rfs_resolve_person:
{
  \bool_set_false:N \l_@@_rfs_person_resolved_bool
  \tl_if_blank:VF \l_@@_rfs_ref_person_tl
  {
    \DTLifdbexists{person}
    {
      \DTLgetvalueforkey{\l_tmpa_tl}{lastname}{person}{id}
        {\l_@@_rfs_ref_person_tl}
      \DTLifnullorempty{\l_tmpa_tl}
      {
        \msg_warning:nnee { dfg } { requested-staff-unresolved-person }
          { \l_@@_rfs_project_tl } { \l_@@_rfs_ref_person_tl }
      }
      {
        \bool_set_true:N \l_@@_rfs_person_resolved_bool
        \@@_rfs_use_fallback:NN \l_@@_rfs_lastname_tl \l_tmpa_tl
        \DTLgetvalueforkey{\l_tmpa_tl}{firstname}{person}{id}
          {\l_@@_rfs_ref_person_tl}
        \@@_rfs_use_fallback:NN \l_@@_rfs_firstname_tl \l_tmpa_tl
        \DTLgetvalueforkey{\l_tmpa_tl}{academicdegree}{person}{id}
          {\l_@@_rfs_ref_person_tl}
        \@@_rfs_use_fallback:NN \l_@@_rfs_degree_tl \l_tmpa_tl
        % Only a missing database value inherits; an explicit empty value wins.
        \DTLifnull{\l_@@_rfs_position_tl}
        {
          \DTLgetvalueforkey{\l_tmpa_tl}{positionText}{person}{id}
            {\l_@@_rfs_ref_person_tl}
          \tl_set:NV \l_@@_rfs_position_tl \l_tmpa_tl
        }
        { }
        \DTLgetvalueforkey{\l_tmpa_tl}{position}{person}{id}
          {\l_@@_rfs_ref_person_tl}
        \@@_rfs_use_fallback:NN \l_@@_rfs_category_tl \l_tmpa_tl
        \bool_lazy_all:nT
        {
          { \tl_if_blank_p:V \l_@@_rfs_department_tl }
          { \tl_if_blank_p:V \l_@@_rfs_ref_institution_tl }
          { \tl_if_blank_p:V \l_@@_rfs_ref_affiliation_tl }
        }
        {
          \DTLgetvalueforkey{\l_tmpa_tl}{ref-institution-id}{person}{id}
            {\l_@@_rfs_ref_person_tl}
          \@@_rfs_use_fallback:NN \l_@@_rfs_ref_institution_tl \l_tmpa_tl
          \tl_if_blank:VT \l_@@_rfs_ref_institution_tl
          {
            \DTLgetvalueforkey{\l_tmpa_tl}{ref-affiliation-id}{person}{id}
              {\l_@@_rfs_ref_person_tl}
            \@@_rfs_use_fallback:NN \l_@@_rfs_ref_affiliation_tl \l_tmpa_tl
          }
        }
      }
    }
    {
      \msg_warning:nnee { dfg } { requested-staff-unresolved-person }
        { \l_@@_rfs_project_tl } { \l_@@_rfs_ref_person_tl }
    }
  }
  \DTLifnull{\l_@@_rfs_position_tl}
    { \tl_clear:N \l_@@_rfs_position_tl }{ }
}

\cs_new_protected:Npn \@@_rfs_register_affiliation:n #1
{
  \tl_set:Ne \l_tmpa_tl {#1}
  \tl_clear:N \l_@@_rfs_affiliation_name_tl
  \tl_clear:N \l_@@_rfs_affiliation_abbreviation_tl
  \DTLifdbexists{affiliation}
  {
    \DTLgetvalueforkey{\l_@@_rfs_affiliation_name_tl}
      {name}{affiliation}{id}{\l_tmpa_tl}
    \DTLifnullorempty{\l_@@_rfs_affiliation_name_tl}
    {
      \msg_warning:nnee { dfg } { requested-staff-unresolved-affiliation }
        { \l_@@_rfs_project_tl } { \l_tmpa_tl }
      \tl_clear:N \l_@@_rfs_affiliation_name_tl
    }
    {
      \DTLgetvalueforkey{\l_@@_rfs_affiliation_abbreviation_tl}
        {abbreviation}{affiliation}{id}{\l_tmpa_tl}
      \DTLifnullorempty{\l_@@_rfs_affiliation_abbreviation_tl}
      {
        \msg_warning:nne { dfg } { requested-staff-missing-abbreviation }
          { \l_tmpa_tl }
        \tl_set:NV \l_@@_rfs_affiliation_abbreviation_tl
          \l_@@_rfs_affiliation_name_tl
      }
      { }
      \seq_if_in:NVF \l_@@_rfs_affiliation_seq \l_tmpa_tl
      {
        \seq_put_right:NV \l_@@_rfs_affiliation_seq \l_tmpa_tl
        \prop_put:NVV \l_@@_rfs_affiliation_abbreviation_prop
          \l_tmpa_tl \l_@@_rfs_affiliation_abbreviation_tl
        \prop_put:NVV \l_@@_rfs_affiliation_name_prop
          \l_tmpa_tl \l_@@_rfs_affiliation_name_tl
      }
    }
  }
  {
    \msg_warning:nnee { dfg } { requested-staff-unresolved-affiliation }
      { \l_@@_rfs_project_tl } { \l_tmpa_tl }
  }
}

\cs_new_protected:Npn \@@_rfs_resolve_organisation:
{
  \tl_if_blank:VT \l_@@_rfs_department_tl
  {
    \tl_if_blank:VTF \l_@@_rfs_ref_institution_tl
    {
      % Compatibility fallback for roster declarations written before the
      % institution-level key was introduced.
      \tl_if_blank:VTF \l_@@_rfs_ref_affiliation_tl
      {
        \@@_rfs_warn_missing:n { department~or~ref-institution-id }
        \tl_set:Nn \l_@@_rfs_department_tl
          { \SetCell{bg=tableNoValue}\@@_rfs_missing_text:n {department} }
      }
      {
        \@@_rfs_register_affiliation:n { \l_@@_rfs_ref_affiliation_tl }
        \tl_if_blank:VTF \l_@@_rfs_affiliation_name_tl
        {
          \tl_set:Ne \l_@@_rfs_department_tl
          {
            \exp_not:N \SetCell { bg=tableNoValue }
            \exp_not:N \@@_rfs_error_text:n
              { \exp_not:V \l_@@_rfs_ref_affiliation_tl }
          }
        }
        {
          \tl_set:NV \l_@@_rfs_department_tl
            \l_@@_rfs_affiliation_abbreviation_tl
        }
      }
    }
    {
      \tl_clear:N \l_@@_rfs_department_tl
      \DTLifdbexists{institution}
      {
        \clist_set:NV \l_tmpa_clist \l_@@_rfs_ref_institution_tl
        \bool_set_true:N \l_tmpa_bool
        \clist_map_inline:Nn \l_tmpa_clist
        {
          \bool_if:NTF \l_tmpa_bool
            { \bool_set_false:N \l_tmpa_bool }
            { \tl_put_right:Nn \l_@@_rfs_department_tl {,~} }
          \DTLgetvalueforkey{\l_@@_rfs_institution_affiliation_tl}
            {ref-affiliation-id}{institution}{id}{##1}
          \DTLifnullorempty{\l_@@_rfs_institution_affiliation_tl}
          {
            \msg_warning:nnee { dfg } { requested-staff-unresolved-institution }
              { \l_@@_rfs_project_tl } {##1}
            \tl_put_right:Ne \l_@@_rfs_department_tl
              { \exp_not:N \@@_rfs_error_text:n { \exp_not:n {##1} } }
          }
          {
            \DTLgetvalueforkey{\l_@@_rfs_institution_name_tl}
              {name}{institution}{id}{##1}
            \@@_institution_abbreviation_or_name:nN
              {##1} \l_@@_rfs_institution_abbreviation_tl
            \@@_rfs_register_affiliation:n
              { \l_@@_rfs_institution_affiliation_tl }
            \DTLifnullorempty{\l_@@_rfs_institution_name_tl}
            {
              \tl_set:NV \l_@@_rfs_institution_name_tl
                \l_@@_rfs_affiliation_name_tl
            }
            { }
            \DTLifnullorempty{\l_@@_rfs_institution_abbreviation_tl}
            {
              \tl_set:NV \l_@@_rfs_institution_abbreviation_tl
                \l_@@_rfs_affiliation_abbreviation_tl
            }
            { }
            \tl_put_right:NV \l_@@_rfs_department_tl
              \l_@@_rfs_institution_abbreviation_tl
            \tl_set:Nn \l_tmpa_tl {##1}
            \seq_if_in:NVF \l_@@_rfs_institution_seq \l_tmpa_tl
            {
              \seq_put_right:NV \l_@@_rfs_institution_seq \l_tmpa_tl
              \prop_put:NVV \l_@@_rfs_institution_name_prop
                \l_tmpa_tl \l_@@_rfs_institution_name_tl
              \prop_put:NVV \l_@@_rfs_institution_abbreviation_prop
                \l_tmpa_tl \l_@@_rfs_institution_abbreviation_tl
              \prop_put:NVV
                \l_@@_rfs_institution_affiliation_abbreviation_prop
                \l_tmpa_tl \l_@@_rfs_affiliation_abbreviation_tl
            }
          }
        }
      }
      {
        \msg_warning:nnee { dfg } { requested-staff-unresolved-institution }
          { \l_@@_rfs_project_tl } { \l_@@_rfs_ref_institution_tl }
        \tl_set:Ne \l_@@_rfs_department_tl
        {
          \exp_not:N \SetCell { bg=tableNoValue }
          \exp_not:N \@@_rfs_error_text:n
            { \exp_not:V \l_@@_rfs_ref_institution_tl }
        }
      }
    }
  }
}

