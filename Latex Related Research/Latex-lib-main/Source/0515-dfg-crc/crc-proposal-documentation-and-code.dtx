    {\msg_warning:nnnnn {dfg}{missing-key}{#1}{#2}{#3}}
}
\cs_new_protected:Npn \@@_get_path_read:nnnn #1#2#3#4
{
  \tl_clear:N \l_@@_get_path_value_tl
  \tl_if_blank:nTF {#1}
    {\msg_warning:nnn {dfg}{database-name-not-given}{#2-/-#3}}
    {
      \DTLifdbexists{#1}
        {
          \datatool_if_has_key:nnTF {#1}{#3}
            {
              \datatool_if_has_key:nnTF {#1}{#4}
                {
                  \DTLgetvalueforkey{\l_@@_get_path_value_tl}{#3}{#1}{#4}{#2}
                  \DTLifnullorempty{\l_@@_get_path_value_tl}
                    {\@@_get_path_missing:nnn {#1}{#2}{#3}} {}
                }
                {\@@_get_path_missing:nnn {#1}{#2}{#4}}
            }
            {\@@_get_path_missing:nnn {#1}{#2}{#3}}
        }
        {\msg_warning:nnn {dfg}{database-not-found}{#1}}
    }
}

\cs_new_protected:Npn \@@_get_path_walk:nnnw #1#2#3#4#5\q_stop
{
  \tl_if_eq:nnTF {#5}{\q_nil}
    {
      \prop_if_in:NnF \l_@@_get_path_seen_prop {{#1}{#2}{#4}}
        {
          \prop_put:Nnn \l_@@_get_path_seen_prop {{#1}{#2}{#4}} {}
          \@@_get_path_read:nnnn {#1}{#2}{#4}{#3}
          \tl_if_empty:NF \l_@@_get_path_value_tl
            {
              \seq_put_right:Ne \l_@@_get_path_values_seq
                {
                  \exp_not:N \dfgShowTag {#2}{#4}
                    {\exp_not:V \l_@@_get_path_value_tl}[#1]
                }
            }
        }
    }
    {
      \tl_set:Nn \l_@@_get_path_target_tl {#4}
      \regex_replace_once:nnN {\A ref-(.+)-id \Z} {\1}
        \l_@@_get_path_target_tl
      \use:e
        {
          \exp_not:N \@@_get_path_read:nnnn {#1}{#2}
            {ref-\l_@@_get_path_target_tl-id}{#3}
        }
      \tl_if_empty:NF \l_@@_get_path_value_tl
        {
          % Freeze both the destination database and the complete ID list
          % before recursion changes the local lookup variables.
          \use:e
            {
              \exp_not:N \@@_get_path_branch:nnn
                {\l_@@_get_path_target_tl}
                {\exp_not:V \l_@@_get_path_value_tl}
                {\exp_not:n {#5}}
            }
        }
    }
}
\cs_new_protected:Npn \@@_get_path_branch:nnn #1#2#3
{
  \clist_map_inline:nn {#2}
    {\@@_get_path_walk:nnnw {#1}{##1}{id}#3\q_stop}
}
\cs_new_protected:Npn \@@_get_path_finish:
{
  \bool_if:NTF \l_@@_class_fastcompile_project_bool
    {
      \tl_set:Ne \l_tmpa_tl
        {\seq_use:Nn \l_@@_get_path_annotation_seq {/}}
      \use:e
        {
          \exp_not:N \dfgShowTag
            {\exp_not:V \l_@@_get_path_id_tl}
            {\exp_not:V \l_tmpa_tl}
            {
              \exp_not:n
                {
                  \str_if_eq:VnTF \l_@@_get_path_db_tl {project}
                    {\@@_fast_project_reference:n {\l_@@_get_path_id_tl}}
                    {\dfgFastReference{\l_@@_get_path_id_tl}}
                }
            }
            [\exp_not:V \l_@@_get_path_db_tl]
        }
    }
    {
      \seq_clear:N \l_@@_get_path_values_seq
      \prop_clear:N \l_@@_get_path_seen_prop
      \use:e
        {
          \exp_not:N \@@_get_path_walk:nnnw
            {\l_@@_get_path_db_tl}{\l_@@_get_path_id_tl}
            {\l_@@_get_path_id_field_tl}
            \exp_not:V \l_@@_get_path_tl \exp_not:N \q_nil \exp_not:N \q_stop
        }
      \seq_use:Nn \l_@@_get_path_values_seq {,~}
    }
  \group_end:
}

