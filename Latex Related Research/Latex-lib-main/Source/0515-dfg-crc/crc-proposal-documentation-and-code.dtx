}

\cs_new_protected:Npn \@@_funding_calculate_one:NNnn #1#2#3#4
{
  % #1 sum tl, #2 quantity tl, #3 database field, #4 period factor
  \bool_lazy_all:nT
  {
    { \tl_if_blank_p:V #1 }
    { ! \tl_if_blank_p:V #2 }
    { \bool_if_p:N \l_@@_funding_calculation_ready_bool }
  }
  {
    \exp_args:NnV \regex_match:nnTF
      { \A \d+ (?: \. \d+ )? \Z } #2
    {
      \tl_set:Nx #1
      {
        \fp_eval:n
        {
          round(
            \l_@@_funding_salary_value_tl
            * \l_@@_funding_cache_percentage_tl / 100
            * #2
            * #4,
            0
          )
        }
      }
      \bool_if:NT \l_@@_funding_calculation_store_bool
      {
        \exp_args:Nnne \DTLnewdbentry
          {\l_@@_database_name_tl}{#3}{\tl_use:N #1}
      }
    }
    {
      \bool_if:NT \l_@@_funding_calculation_store_bool
      {
