% Retain only the database-to-keyset mapping when focused builds skip rows.
% The get parser needs the schema to consume reference paths without values.
\prop_new:N \g_@@_database_keyset_prop
\NewDocumentCommand \addEntry { O{} m m }
{
  \tl_if_blank:nTF {#1}
    {\prop_gput:Nnn \g_@@_database_keyset_prop {#2}{#2}}
    {\prop_gput:Nnn \g_@@_database_keyset_prop {#2}{#1}}
  \bool_if:NTF \l_@@_class_fastcompile_project_bool
  { \@@_fast_project_add_entry:nnn {#1} {#2} {#3} }
  {
  \tl_if_eq:nnTF {#1} { cv }
  { \bool_if:NTF \l_@@_class_cv_bool
	{ \@@_add_entry:nnn {#1} {#2} {#3} }
  	{ \msg_warning:nnn { dfg } { cv-entry-omitted } {#2} } }
  {% default behaviour: use #2 as family if #1 is empty
   \tl_if_empty:nTF {#1}
   { \@@_add_entry:nnn {#2} {#2} {#3} }
   {
      \@@_add_entry:nnn {#1} {#2} {#3}
      \str_if_eq:nnT {#1} { funding }
        { \@@_funding_cache_entry:nn {#2} {#3} }
      \bool_lazy_all:nT
        {
          { \str_if_eq_p:nn {#1} { funding } }
          { \str_if_eq_p:nn {#2} { RequestedFunding } }
        }
        { \@@_cache_requested_funding:n {#3} }
      \bool_lazy_all:nT
        {
          { \str_if_eq_p:nn {#1} { staff } }
          { \str_if_eq_p:nn {#2} { RequestedFundingStaff } }
        }
        { \@@_cache_requested_funding_staff:n {#3} }
      \bool_lazy_all:nT
        {
          { \str_if_eq_p:nn {#1} { funding } }
          { \str_if_eq_p:nn {#2} { RequestedAndExistingFundingDirectCosts } }
        }
        { \@@_cache_requested_and_existing_direct_costs:n {#3} }
    }
  }
  }
}
%    \end{macrocode}
% \end{macro}
%
% \begin{message}{cv-entry-omitted}
% Issued by \cs{addEntry} when an entry is targeted at the \texttt{cv}
% database but no CV is being produced (\cs{l\_dfg\_class\_cv\_bool} is
% false). The omitted entry's key-value data is included in the message
% to aid debugging.
%    \begin{macrocode}
\msg_new:nnn { dfg } { cv-entry-omitted }
{
  CV~entry~omitted:~no~CV~is~being~created.^^J
  Entry~data:~'#1'.
}
%    \end{macrocode}
% \end{message}
% There is a shortcut to define a database for e.g. a whole command to avoid all
% the time to write something like
% \cs{getEntry}\oarg{person}\marg{MM}\marg{lastname}.
% So you can define \cs{tmpLocalDB} with the database name.
%    \begin{macrocode}
\str_set:Nn \tmpLocalDB {}
%    \end{macrocode}
% \paragraph{\refCom{getEntry}}
% The primary read command: \cs{getEntry}\oarg{db}\marg{id-value}\marg{field}\oarg{id-field}.
% \begin{enumerate}
%   \item |#1|: Database name (default: \cs{tmpLocalDB}).
%   \item |#2|: The value to look up in the |id-field| column.
%   \item |#3|: The field whose value is to be returned.
%   \item |#4|: The name of the ID column (default: |id|); change this to
%         look up rows by a field other than the primary key.
% \end{enumerate}
% The guard logic runs in order:
%   If \refKey{fastcompile-project}|=true|, replace the output with a literal
%   identifier placeholder to skip the query entirely.
%   If |#1| is empty (\cs{tmpLocalDB} not set), warn and abort.
%   If the database does not exist, warn and abort.
%   Retrieve the value; if null/empty, warn (but only outside the
%   tabularray measuring pass to avoid duplicate messages).
%   Output via \cs{dfgShowTag} so that \refKey{showtags} annotations
%         are applied automatically.
%
% \textbf{PDF-bookmark note (FIXME):} When |#3| contains LaTeX commands,
% the value may produce garbage in PDF bookmarks.  Wrapping the output
% in \cs{texorpdfstring} would fix this but requires knowing at definition
% time what the field contains, which is not possible.  A workaround is
% to use \cs{texorpdfstring} at the call site for fields that appear in
% section headings.
%    \begin{macrocode}
%\getEntry [<DB>]{<id-value>}{<field>}                 [<id-column>]
%   single field, prints with \dfgShowTag wrapping
%
%\getEntry*[<DB>]{<id-value>}{<assignments>}            [<id-column>]
%   multi-field, assigns to macros, no printing
\NewDocumentCommand \dfgFastReference { m }
{ { \textcolor{error}{\texttt{<#1>}} } }

