  	\DTLconverttodecimal{\totalRequestedFunds}{\totalRequestedFunds}%
  	\DTLconverttodecimal{\totalExistingFunds}{\totalExistingFunds}%
  	\def\tblrbody{}%
    \def\totalMouseQuantity{0}%
    \def\totalRatQuantity{0}%
