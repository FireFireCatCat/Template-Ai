%    \end{macrocode}
% \paragraph{Reference-aware lookup (\cs{get})}
% Parse relation steps before rendering, so metadata containing braces cannot
% become part of the path. The walker carries its path in arguments rather
% than shared scratch variables; this also permits branching reference lists.
%    \begin{macrocode}
\tl_new:N \l_@@_get_path_db_tl
\tl_new:N \l_@@_get_path_id_tl
\tl_new:N \l_@@_get_path_id_field_tl
\tl_new:N \l_@@_get_path_scan_db_tl
\tl_new:N \l_@@_get_path_field_tl
\tl_new:N \l_@@_get_path_tl
\tl_new:N \l_@@_get_path_keyset_tl
\tl_new:N \l_@@_get_path_target_tl
\tl_new:N \l_@@_get_path_value_tl
\seq_new:N \l_@@_get_path_values_seq
\seq_new:N \l_@@_get_path_annotation_seq
\prop_new:N \l_@@_get_path_seen_prop

\NewDocumentCommand{\get}{s O{\tmpLocalDB} m m O{id}}
{
  \IfBooleanTF{#1}
    {\getEntry*[#2]{#3}{#4}[#5]}
    {
      \group_begin:
      \tl_set:Ne \l_@@_get_path_db_tl {#2}
      \tl_set:Ne \l_@@_get_path_id_tl {#3}
      \tl_set:Nn \l_@@_get_path_id_field_tl {#5}
      \tl_set_eq:NN \l_@@_get_path_scan_db_tl \l_@@_get_path_db_tl
      \tl_clear:N \l_@@_get_path_tl
      \seq_clear:N \l_@@_get_path_annotation_seq
      \@@_get_path_scan:n {#4}
    }
}

\prg_new_protected_conditional:Npnn \@@_get_path_if_has_key:nn #1#2 {TF}
{
  \datatool_if_has_key:nnTF {#1}{#2}
    {\prg_return_true:}
    {
      \prop_get:NnNF \g_@@_database_keyset_prop {#1}
