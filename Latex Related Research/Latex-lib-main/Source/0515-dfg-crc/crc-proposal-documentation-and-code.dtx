\cs_new_protected:Npn \@@_oes_append_category:nn #1#2
{
  \tl_put_right:Nn \l_@@_oes_table_body_tl {#2}
  \seq_map_inline:Nn \l_@@_oes_affiliation_seq
  {
    \tl_set:Ne \l_@@_oes_lookup_key_tl { #1 / ##1 }
    \prop_get:NVNTF \l_@@_oes_count_prop
      \l_@@_oes_lookup_key_tl \l_tmpc_tl
    {
      \tl_put_right:Ne \l_@@_oes_table_body_tl
      {
        & \exp_not:N \dfgShowCalculatedTag{OverviewExistingStaffTable}
          {\exp_not:V \l_@@_oes_database_tl,person,institution,affiliation}
          {\exp_not:V \l_tmpc_tl}
      }
    }
    {
      \tl_put_right:Ne \l_@@_oes_table_body_tl
      {
        & \exp_not:N \dfgShowCalculatedTag{OverviewExistingStaffTable}
          {\exp_not:V \l_@@_oes_database_tl,person,institution,affiliation}{0}
      }
    }
  }
  \tl_put_right:Nn \l_@@_oes_table_body_tl { \\ }
}

\cs_new_protected:Npn \@@_oes_build_table_body:
{
  \int_set:Nn \l_@@_oes_affiliation_count_int
    { \seq_count:N \l_@@_oes_affiliation_seq }
  \int_set:Nn \l_@@_oes_other_affiliation_count_int
    {
      \l_@@_oes_affiliation_count_int
      - \l_@@_oes_applicant_affiliation_count_int
    }
  \tl_set:Nx \l_@@_oes_colspec_tl
    {
      X[3,l]~*{\int_use:N \l_@@_oes_affiliation_count_int}{X[1,c]}
    }
  \tl_clear:N \l_@@_oes_table_body_tl
  \tl_put_right:Nx \l_@@_oes_table_body_tl
  {
    \exp_not:N \SetCell [r=3] {c,m} Category
    & \exp_not:N \SetCell
      [c=\int_use:N \l_@@_oes_affiliation_count_int] {c,m}
      {Number~of~persons}
  }
  \@@_oes_append_empty_cells:n
    { \l_@@_oes_affiliation_count_int - 1 }
  \tl_put_right:Nn \l_@@_oes_table_body_tl { \\ & }
  \int_compare:nNnTF
    { \l_@@_oes_applicant_affiliation_count_int } = {1}
  {
    \tl_put_right:Nn \l_@@_oes_table_body_tl
      { \SetCell{c,m} {at~the~applicant\\university} }
  }
  {
    \tl_put_right:Nx \l_@@_oes_table_body_tl
    {
      \exp_not:N \SetCell
        [c=\int_use:N \l_@@_oes_applicant_affiliation_count_int] {c,m}
        {at~the~applicant\\universities}
    }
    \@@_oes_append_empty_cells:n
      { \l_@@_oes_applicant_affiliation_count_int - 1 }
  }
  \int_compare:nNnT { \l_@@_oes_other_affiliation_count_int } > {0}
  {
    \tl_put_right:Nx \l_@@_oes_table_body_tl
    {
      & \exp_not:N \SetCell
        [c=\int_use:N \l_@@_oes_other_affiliation_count_int] {c,m}
        {at~other~participating\\institutions}
    }
    \@@_oes_append_empty_cells:n
      { \l_@@_oes_other_affiliation_count_int - 1 }
  }
  \tl_put_right:Nn \l_@@_oes_table_body_tl { \\ }
  \tl_put_right:Nn \l_@@_oes_table_body_tl { & }
  \seq_map_indexed_inline:Nn \l_@@_oes_affiliation_seq
  {
    \int_compare:nNnF {##1} = {1}
      { \tl_put_right:Nn \l_@@_oes_table_body_tl { & } }
    \tl_set:Nn \l_tmpa_tl {##2}
    \prop_get:NVN \l_@@_oes_affiliation_abbreviation_prop
      \l_tmpa_tl \l_tmpb_tl
    \tl_put_right:Ne \l_@@_oes_table_body_tl
    {
      \exp_not:N \dfgShowCalculatedTag{affiliationLabel}{affiliation}
        {\exp_not:V \l_tmpb_tl}
    }
  }
  \tl_put_right:Nn \l_@@_oes_table_body_tl { \\ }
  \@@_oes_append_category:nn { prof } { Professors }
  \@@_oes_append_category:nn { groupLeader }
    { {Junior~research~group\\leaders} }
  \@@_oes_append_category:nn { postDoc } { Postdoctoral~researchers }
  \@@_oes_append_category:nn { PhD } { Doctoral~researchers }
  \@@_oes_append_category:nn { research } { Other~research~staff }
  \@@_oes_append_category:nn { nonResearch } { Non-research~staff }
  \@@_oes_append_category:nn { student }
    { Student~and~graduate~assistants }
}

