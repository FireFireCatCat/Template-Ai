% 
% \begin{macro}{\StartTimer}
% \begin{macro}{\StopTimer}
%   A simple pair of profiling helpers for measuring how long a
%   stretch of \LaTeX{} code takes to execute.  Wrap the code under
%   investigation between |\StartTimer| and
%   |\StopTimer{|\meta{label}|}|; the elapsed time in milliseconds
%   is written to the terminal and the |.log| file, prefixed with
%   the supplied \meta{label} so several measurements in one run
%   can be told apart.
%
%   Typical use:
%   \begin{quote}
%     |\StartTimer|\\
%     |\ParticipatingInstitutionsList[count]|\\
%     |\StopTimer{ParticipatingInstitutionsList}|
%   \end{quote}
%   producing a line such as
%   \begin{quote}
%     |TIMING ParticipatingInstitutionsList: 115 ms|
%   \end{quote}
%   in the log.
%
%   Only one measurement can be in progress at any one time, since
%   the start time is held in a single shared integer variable.
%   For nested or overlapping measurements, define additional
%   counters or switch to the labelled-timer variant.
%
%   The implementation uses the kernel-native expl3 function
%   |\sys_timer:|, which abstracts over the engine-specific timer and avoids an
%   additional package dependency.
%    \begin{macrocode}
\int_new:N \l_@@_timer_int
%    \end{macrocode}
%   Storage for the start timestamp.  We use an |int| rather than a
%   |tl| so the later subtraction in |\int_eval:n| is unambiguous.
%    \begin{macrocode}
\NewDocumentCommand { \StartTimer } { }
{
  \bool_if:NF \l_@@_class_fastcompile_project_bool
  { \int_set:Nn \l_@@_timer_int { \sys_timer: } }
}
%    \end{macrocode}
%   |\sys_timer:| expands to the time since job start in
%   \emph{scaled seconds} -- units of $1/65536$~s.  We capture
%   that raw value here and convert to milliseconds only at
%   reporting time, to keep the start-up overhead minimal.
%    \begin{macrocode}
\NewDocumentCommand { \StopTimer } { m }
{
  \bool_if:NF \l_@@_class_fastcompile_project_bool
  {
    \iow_term:x
    {
      TIMING~#1:~
      \int_eval:n
      { ( \sys_timer: - \l_@@_timer_int ) * 1000 / 65536 }
      \c_space_tl ms
    }
  }
}
%    \end{macrocode}
%   The arithmetic computes elapsed scaled-seconds first, then
%   multiplies by~$1000$ before dividing by~$65536$.  Doing the
%   multiplication first preserves precision: a naive
%   |(now - start) / 65536 * 1000| would truncate sub-second
%   measurements to zero.  The result is an integer count of
%   milliseconds, accurate to roughly $\pm 1$~ms.
%
%   |\iow_term:x| writes to the terminal \emph{and} the log,
%   fully expanding its argument once -- which is what makes
%   |\int_eval:n| produce a literal number rather than the
%   unevaluated expression.  |\c_space_tl| inserts a real space
%   between the number and the |ms| unit; a literal space there
%   would be consumed by |expl3|'s tokenisation rules.
%
%   Note that the reported time is wall-clock and includes any
%   |\typeout|, file~I/O, or shell-escape work performed inside
%   the timed block.  For tight measurements of pure computation,
%   silence debugging output during the run, and take the second
%   of two consecutive timings to avoid first-run effects such
%   as font caching or |.aux| reads.
% \end{macro}
% \end{macro}
% \subsection{Documentclass Options}
%
% We have very few global options we use from the KOMAscript.
% But you can use any known option of the KOMAscript |scrbook|.
%    \begin{macrocode}
\PassOptionsToClass{
  fontsize  =10pt,
  twoside   =true,
  BCOR      =5mm,
  headings  =optiontoheadandtoc,
  parskip   =half-,
  numbers   =noenddot,
  toc       =indentunnumbered
}{scrbook}
%    \end{macrocode}
% \subsection{Class options (\texttt{dfg/class} key family)}
%
% All class-level toggles live in the |dfg/class| key family and are
% processed via \cs{ProcessKeyOptions}.  They control the two major compilation modes
% (\refKey{fastcompile}, \refKey{fastcompile-project}, \refKey{final}) plus
% several debugging and output flags.
%
% The general design principle is that every flag defaults to |false| or
% to a safe, submission-ready value.  Authors enable the helpers they need
% during drafting and simply remove them (or set |final=true|) before
% submitting.  Setting |final=true| enforces this by hard-resetting all
% drafting flags to |false| automatically.
%    \begin{macrocode}
\keys_define:nn { dfg / class }
{
%    \end{macrocode}
% The manual loads explicit example inputs, independent of proposal files.
%    \begin{macrocode}
documentation .bool_set:N = \l_@@_class_documentation_bool,
documentation .initial:n = false,
%    \end{macrocode}
% \refKey{final}: Set to |true| immediately before submission.
% It forces |cmyk| colour model (required for print), silently sets
% |fastcompile=false|, |showtags=false|, |showmarginalia=false| and
% |skip10pub=false|, and turns the draft-green placeholder colour
% to white so it is invisible in the output.
%    \begin{macrocode}
final      .bool_set:N = \l_@@_class_final_bool,
final      .initial:n  = false,
Final      .meta:n     = { final = #1 },
Final      .default:n  = true,
%    \end{macrocode}
% \refKey{fastcompile}: When |true|, generated tables and lists are replaced by
% a placeholder.  It also suppresses role-card grids, the Gantt chart, and the
% ten-publications CV block while retaining metadata-backed prose references.
% Automatically disabled when |final=true|.
%    \begin{macrocode}
fastcompile   .bool_set:N = \l_@@_class_fastcompile_bool,
fastcompile   .initial:n  = false,
%    \end{macrocode}
% \refKey{fastcompile-project}: Aggressive project-text drafting mode.  It
% implies \refKey{fastcompile}, but additionally prevents metadata rows from
% being loaded or restored, replaces calculated project headings with a
% state-only setup, uses draft rendering for graphics and links, and provides
% literal fallbacks for database-backed references.  Authored sections,
% paragraphs, aims, work packages, labels, and inline citations remain.
% Automatically disabled when |final=true|.
%    \begin{macrocode}
fastcompile-project .bool_set:N = \l_@@_class_fastcompile_project_bool,
fastcompile-project .initial:n  = false,
%    \end{macrocode}
% \refKey{fastcompile-project-show-images}: Opt back into real image rendering while
% aggressive project drafting is active.  It has no effect on ordinary builds,
% where graphics are rendered normally.  Final mode resets it to |false|
% together with the other drafting controls.
%    \begin{macrocode}
fastcompile-project-show-images .bool_set:N = \l_@@_class_fastcompile_project_show_images_bool,
fastcompile-project-show-images .initial:n  = false,
%    \end{macrocode}
% \refKey{fastcompile-project-show-publications}: Controls the standard project publication
% heading, explicit project \cs{nocite} lists, project bibliographies,
% project-report references, and ending-project result lists during focused
% project drafting.  Ordinary and final builds force it to |true|.
%    \begin{macrocode}
fastcompile-project-show-publications .bool_set:N = \l_@@_class_fastcompile_project_show_publications_bool,
fastcompile-project-show-publications .initial:n  = false,
%    \end{macrocode}
% \refKey{fastcompile-project-show-funding-tables}: Retain the three
% project-local funding tables in aggressive project drafting mode.  The
% option defaults to |true| and has no effect outside that mode.
%    \begin{macrocode}
fastcompile-project-show-funding-tables .bool_set:N = \l_@@_class_fastcompile_project_show_funding_tables_bool,
fastcompile-project-show-funding-tables .initial:n  = true,
%    \end{macrocode}
% \refKey{fastcompile-show-tags}: Enables provenance overlays during fast
% compilation. Focused project lookups show their source row and requested
% field path because metadata rows are skipped.
%    \begin{macrocode}
fastcompile-show-tags .bool_set:N = \l_@@_class_fastcompile_show_tags_bool,
fastcompile-show-tags .initial:n  = false,
%    \end{macrocode}
% \refKey{showtags}: Enables provenance overlays for direct database values and
% concise source labels for calculated values in ordinary builds. During fast
% compilation, \refKey{fastcompile-show-tags} controls the setting instead.
%    \begin{macrocode}
showtags   .bool_set:N = \l_@@_class_showtags_bool,
showtags   .initial:n  = false,
%    \end{macrocode}
% \refKey{showtags-tables}: Controls only provenance overlays rendered in table
% cells.  It defaults to |true|, but remains inert unless \refKey{showtags} is
% enabled.  Keeping it separate lets authors debug prose without widening or
% visually overloading dense generated tables.
%    \begin{macrocode}
showtags-tables  .bool_set:N = \l_@@_class_showtags_tables_bool,
showtags-tables  .initial:n  = true,
%    \end{macrocode}
% \refKey{showmarginalia}: Enables marginal notes that display running
% subtotals alongside the funding tables.  Useful for cross-checking
% calculated sums during data entry.  Disabled by |final=true|.
%    \begin{macrocode}
showmarginalia .bool_set:N = \l_@@_class_showmarginalia_bool,
showmarginalia .initial:n  = false,
%    \end{macrocode}
% \refKey{skip10pub}: Suppresses the mandatory ten-publication block in
% each CV section.  Because each bibliography list requires a full biber
% run and can take several seconds per PI, skipping it during early drafting
% significantly reduces compilation time.  Automatically disabled by |final=true|.
%    \begin{macrocode}
skip10pub  .bool_set:N = \l_@@_class_skipTENpublications_bool,
skip10pub  .initial:n  = false,
%    \end{macrocode}
% \refKey{colorscheme}: Passed directly to \cs{selectcolormodel} at
% \cs{AtBeginDocument}.  Use |cmyk| for press-quality PDF output (DFG
% submission default) or |RGB| for on-screen review.  Overridden to
% |cmyk| when |final=true|.
%    \begin{macrocode}
colorscheme .tl_set:N   =  \l_@@_class_color_model_tl,
colorscheme .initial:n  = cmyk,
%    \end{macrocode}
% \refKey{cv}: Set to |true| in the standalone CV document
% (|crc-cv.tex|).  When |true|, the class adjusts heading styles
% and suppresses proposal-specific front matter so the output is a
% self-contained curriculum vitae suitable for DFG submission.
%    \begin{macrocode}
cv   .bool_set:N = \l_@@_class_cv_bool,
cv   .initial:n  = false,
unknown .code:n = { \PassOptionsToClass{\CurrentOption}{scrbook} },
}
%    \end{macrocode}
% \subsection{Conditional execution based on class options}
%
% The class option |cv| toggles whether the document is rendered as a
% CV (curriculum vitae) supplement.  Internally this is stored in the
% expl3 boolean |\l_@@_class_cv_bool|.  Since end-user document files
% should not be required to wrap conditional content in
% |\ExplSyntaxOn|\,/\,|\ExplSyntaxOff|, the following three commands
% expose the switch through a conventional \LaTeX{} interface.
%
% \DescribeMacro{\dfgIfCV}
% |\dfgIfCV|\marg{true code}\marg{false code}\par
% Executes \meta{true code} if the |cv| option is active, otherwise
% \meta{false code}.  Use this when both branches need to produce
% content, for instance to switch between a full bibliography and a
% short selected-publications list:
% \begin{quote}
% |\dfgIfCV{\printbibliography[heading=none]}{\printshortbib}|
% \end{quote}
%
% \DescribeMacro{\dfgIfCVT}
% |\dfgIfCVT|\marg{true code}\par
% Shorthand for the common case where only the true branch matters.
% Typical use is gating a section that exists only in the CV variant:
% \begin{quote}
% |\dfgIfCVT{\par\textcolor{tableHeadingsFont}{Appendix:~Research~profiles}}|
% \end{quote}
% Equivalent to |\dfgIfCV{|\meta{true code}|}{}| but avoids the empty
% second argument and reads more naturally in document source.
%
% \DescribeMacro{\dfgIfCVF}
% |\dfgIfCVF|\marg{false code}\par
% Mirror image of |\dfgIfCVT|: executes \meta{false code} only when the
% |cv| option is \emph{not} active.  Useful for content that belongs in
% the main proposal but should be suppressed in the CV variant.
%
% None of these commands evaluates its arguments unless the relevant
% branch is taken, so wrapping expensive or side-effecting code is safe.
% All three are defined with |\NewDocumentCommand|, so their arguments
% are read as standard mandatory braced groups and may contain verbatim
% material only where the underlying typesetting context permits.
%
%    \begin{macrocode}
\NewDocumentCommand \dfgIfCV  { +m +m }
  { \bool_if:NTF \l_@@_class_cv_bool {#1} {#2} }
\NewDocumentCommand \dfgIfCVT { +m }
  { \bool_if:NT  \l_@@_class_cv_bool {#1} }
\NewDocumentCommand \dfgIfCVF { +m }
  { \bool_if:NF  \l_@@_class_cv_bool {#1} }

\NewDocumentCommand \dfgIfFinalF { +m }
  { \bool_if:NF  \l_@@_class_final_bool {#1} }
\NewDocumentCommand \dfgIfFastCompileProject { +m +m }
  { \bool_if:NTF \l_@@_class_fastcompile_project_bool {#1} {#2} }
\NewDocumentCommand \dfgIfFastCompileProjectT { +m }
  { \bool_if:NT \l_@@_class_fastcompile_project_bool {#1} }
\NewDocumentCommand \dfgIfFastCompileProjectF { +m }
  { \bool_if:NF \l_@@_class_fastcompile_project_bool {#1} }
\NewDocumentCommand \dfgIfProjectPublications { +m +m }
  { \bool_if:NTF \l_@@_class_fastcompile_project_show_publications_bool {#1} {#2} }
%    \end{macrocode}
% Unknown options are forwarded by the key handler above, so ordinary
% KOMA-Script options remain available without processing the class options a
% second time.  Finally process and execute all options and key-values.
%    \begin{macrocode}
\ProcessKeyOptions[ dfg / class ]
% Resolve mode precedence before any package, customisation, metadata, or
% auxiliary-file work can observe the drafting booleans.
\bool_if:NTF \l_@@_class_final_bool
{
  \bool_set_false:N \l_@@_class_fastcompile_bool
  \bool_set_false:N \l_@@_class_fastcompile_project_bool
  \bool_set_false:N \l_@@_class_fastcompile_project_show_images_bool
  \bool_set_true:N  \l_@@_class_fastcompile_project_show_funding_tables_bool
  \bool_set_false:N \l_@@_class_showtags_bool
  \bool_set_false:N \l_@@_class_showmarginalia_bool
  \bool_set_false:N \l_@@_class_skipTENpublications_bool
  \bool_set_true:N  \l_@@_class_fastcompile_project_show_publications_bool
}
{
  \bool_if:NTF \l_@@_class_fastcompile_project_bool
  {
    \bool_set_true:N  \l_@@_class_fastcompile_bool
    \bool_set_false:N \l_@@_class_showmarginalia_bool
    \bool_set_true:N  \l_@@_class_skipTENpublications_bool
    \PassOptionsToPackage{draft}{hyperref}
    \PassOptionsToPackage{draft}{microtype}
  }
  { \bool_set_true:N \l_@@_class_fastcompile_project_show_publications_bool }
  \bool_if:NT \l_@@_class_fastcompile_bool
  {
    \bool_if:NTF \l_@@_class_fastcompile_show_tags_bool
      { \bool_set_true:N \l_@@_class_showtags_bool }
      { \bool_set_false:N \l_@@_class_showtags_bool }
  }
}
