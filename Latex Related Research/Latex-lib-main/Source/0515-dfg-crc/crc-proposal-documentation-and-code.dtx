% \subsection{tabularray setup and table themes}
%
% \pkg{tabularray} renders each cell \emph{twice}: once in a hidden
% measuring pass to determine column widths, and once for final output.
% This means every database query, numeric calculation or warning inside
% a cell body would be executed twice.  The global boolean
% \cs{g\_@@\_tblr\_inside\_bool} (toggled via environment hooks) lets code
% detect the measuring pass so it can skip expensive side effects (e.g.\
% the \texttt{missing-key} warning is suppressed when
% \cs{lTblrMeasuringBool} is |true|).
%    \begin{macrocode}
\bool_new:N \g_@@_tblr_inside_bool
% -- Hook into the beginning and ending of the tblr environment ---------------
\AddToHook{env/tblr/begin}{\bool_set_true:N \g_@@_tblr_inside_bool}
\AddToHook{env/tblr/end}{\bool_set_false:N \g_@@_tblr_inside_bool}
%    \end{macrocode}
% \subsection{Custom table definition}
% \paragraph{Base Table Theme}
% Defines the shared templates and outer settings used by all table themes.
% The table font size is established as an ambient declaration here instead of
% through a |rows={font=...}| property.  A more specific cell property such as
% |font=\bfseries| replaces a row font property, but it inherits an ambient
% \cs{footnotesize}; an explicit size in the cell property can still override
% the default.
%    \begin{macrocode}
% Reduce tabularray's default 1.5\bigskipamount above every generated table.
% Change presep here to adjust the gap before tables printed by \printTable.
\SetTblrOuter[tblr]{label=none,entry=none,presep=6pt,headsep=4pt}
% For long tables:
\cs_new_protected:Npn \mytblr_basecode: {
  \footnotesize
  % Continuous head/footer templates (use ~ for spaces)
  \DeclareTblrTemplate {conthead-text}{default}{%
  	\normalfont\color{tableContFootHead}%
  	\sffamily\footnotesize%
  	\ldots~continuing~from~previous~page.%
  }
  \DeclareTblrTemplate {contfoot-text}{default}{%
  	\normalfont\color{tableContFootHead}%
  	\sffamily\footnotesize%
  	Continue~on~the~following~page~\ldots%
  }
  % Caption continuation uses conthead
  \DeclareTblrTemplate {capcont}{default}{%
  	\UseTblrTemplate{conthead-text}{default}%
  }
  % Keep all text rendered below a table at least at footnote size.
  \SetTblrStyle{note-tag}{font=\footnotesize}
  \SetTblrStyle{note-sep}{font=\footnotesize}
  \SetTblrStyle{note-text}{font=\footnotesize}
  \SetTblrStyle{remark-tag}{font=\footnotesize}
  \SetTblrStyle{remark-sep}{font=\footnotesize}
  \SetTblrStyle{remark-text}{font=\footnotesize}
  % Left-align tables
  \RenewDocumentCommand \TblrAlignLeft {} {\RaggedRight}%
  % Common outer settings
}
%    \end{macrocode}
% \paragraph{Table themes}
% Three named tblr themes are provided.  All inherit the shared
% \cs{mytblr\_basecode:} helper (continuous head/footer templates, left
% alignment) via a direct call at theme definition time.
%
% \textbf{plain}: minimal two-rule + alternating-row look used for
% simple supplementary tables (e.g.\ the direct-costs breakdown).
%    \begin{macrocode}
\NewTblrTheme{plain}{
  \mytblr_basecode:
  % plain-only inner tweaks:
  \SetTblrInner{
    % Keep row metrics independent of descenders such as p, q, f.
    stretch   = 1,
    rowsep    = .667pt,
  	row{even}={bg=tableRows},
  	width=\linewidth,
  	hline{1,Z}={1pt,fg=tableOuterLines},
  }
}
%    \end{macrocode}
% \textbf{main}: the full-featured style used by all DFG data tables.
% Adds a styled first-row header (blue background, bold sans-serif text),
% a midrule below row 1, caption fonts, and row continuation labels for
% long tables that span multiple pages.
%    \begin{macrocode}
\RenewDocumentCommand\TblrAlignLeft{}{\RaggedRight}
\NewTblrTheme{main}{
  \mytblr_basecode:
  % main-only styles & inner grid:
  \SetTblrStyle{caption-tag}{font=\bfseries\footnotesize\sffamily,tableCaption}
  \SetTblrStyle{caption-text}{
   tableCaption,
   font=\footnotesize,
   halign=l
  }
  \SetTblrStyle{caption}{halign=l}
  \SetTblrTemplate{caption}{simple}
  \SetTblrInner{%
  	row{odd}={bg=tableRows},
  	width=\linewidth,
  	hline{1,Z}={1pt,fg=tableOuterLines},
  	rowhead      = 1,
  	width        = \textwidth,
  	hline{1,Z}   = {
  		1pt,
  		fg =tableOuterLines
  	},
  	hline{2} = {1pt, fg=tableOuterLines}, % midrule
    % Keep row metrics independent of descenders such as p, q, f.
    stretch   = .9,
    rowsep    = 1pt,
  	row{1}       = {
  		bg       = tableHeadingsBG,
  		fg       = tableHeadingsFont,
        font     = \bfseries,
  		halign   = {c},
  		valign   = {t},
        abovesep = 3pt,
  		guard
  	},
  }%
  % \SetTblrInner{
  %   rows={ht=.5\baselineskip},
  %   rowsep       = 0pt,
  % }
}
%    \end{macrocode}
% \textbf{requestedFundingStaff}: caption styling for the staff roster without
% a table-wide row background.  This lets the roster mark individual
% non-applicable cells with the |tableNoValue| background.
%    \begin{macrocode}
\NewTblrTheme{requestedFundingStaff}{
  \mytblr_basecode:
  \SetTblrStyle{caption-tag}{font=\bfseries\footnotesize\sffamily,tableCaption}
  \SetTblrStyle{caption-text}{tableCaption,\footnotesize}
}
%    \end{macrocode}
% A generic long-table environment.  Its second argument supplies additional
% tabularray options and defaults to an empty option list.
% Let tabularray measure the caption normally; negative skips can pull it
% into the preceding paragraph or the top rule of the table.
%    \begin{macrocode}
\NewDocumentEnvironment{TableEnv}{ m O{} m m }
{
  % #1: colspec
  % #2: further options
  % #3: caption
  % #4: label
  \par
  \begin{tblr}[%
  	%  expand=\tblrbody,
  	theme=main,
  	label  ={#4},
    entry  ={#3},
  	caption={#3},
  	long
  ]{%
  	colspec ={#1},
        row{2-Z}={font=\RaggedRight},
  	rowhead = 1, %<- first row is head
  	#2 %<- in case we need further adjustments
  }
}
{\end{tblr}\par}
%    \end{macrocode}
% At the final part of projects the costs must be listed more granularly.
% Keep the optional heading and the unbreakable table in one minipage, so
% the heading cannot be left alone at a page boundary.
% Measure the currency column at its natural width: a fixed 0.5cm column
% is too narrow for EUR in some document fonts.  The X description column
% absorbs the width difference while the amount column stays rightmost.
%    \begin{macrocode}
\NewDocumentEnvironment{FundingDirectCostsTable}{O{}}
{\par\noindent
  \begin{minipage}{\linewidth}
  \tl_if_blank:nF {#1}
    {\noindent\textbf{\sffamily#1}\par}
  \begin{tblr}[%
  	theme=plain, label=none, entry=none]{
  	colspec={
  			X[t]
        Q[t,r]
			Q[t,si={table-format=9}]
  		},
  }
}
{\end{tblr}
  \end{minipage}\par}

%    \end{macrocode}
