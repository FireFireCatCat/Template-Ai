% \subsection{Message catalogue}
%
% All user-visible diagnostics are declared here once using \cs{msg\_new:nnn}
% from the L3 message system.  Centralising them serves several purposes:
% \begin{enumerate}
%   \item The exact wording of every log line can be reviewed and updated in
%         one place without searching through the entire code.
%   \item They are bound to the \texttt{dfg} module name, so a user can grep
%         the |.log| with |grep "Package dfg"| to see a condensed overview.
%   \item Using the L3 message system instead of raw |\PackageWarning| gives
%         consistent formatting, the file\/line context via
%         \cs{msg\_line\_context:}, and the ability to suppress or redirect
%         messages at a global level with \cs{msg\_redirect\_module:nnn}.
% \end{enumerate}
% The engine check fails early with a direct instruction instead of letting
% \pkg{fontspec} or a later \cs{directlua} call produce a less helpful error.
% The next message is emitted when an optional input file (e.g.\ a metadata
% or preamble fragment) cannot be found on the search path.  Compilation is
% not aborted, but the user is strongly warned.
%    \begin{macrocode}
\msg_new:nnn { dfg } { unsupported-engine }
{
  The~dfg-crc~class~requires~LuaLaTeX.^^J
  Compile~this~document~with~lualatex~or~latexmk~-lualatex.
}
\sys_if_engine_luatex:F
  { \msg_fatal:nn { dfg } { unsupported-engine } }

\msg_new:nnn { dfg } { file-not-found }
{ File~'#1'~not~found.^^J
  ~You~can~proceed~without~it~
  but~it~is~not~recommended.
}
%    \end{macrocode}
% \paragraph{database-not-found}
% Emitted by \refCom{getEntry}, \refCom{compareEntry} and each table command when the
% database name passed by the user does not exist in the datatool register.
% The most common cause is a typo in the database name, or calling a retrieval
% command before the corresponding \refCom{addEntry} block has been processed.
%    \begin{macrocode}
\msg_new:nnn { dfg } { database-not-found }
{ Unknown~ database~ name:~ #1^^J^^J
  Database~'#1'~not~found~\msg_line_context:.~
  Either~you~have~misspelled~it~or~
  ~the~database~has~not~yet~been~created.
}
%    \end{macrocode}
% \paragraph{database-name-not-given}
% Fired when the optional \meta{database} argument of \refCom{getEntry} is empty
% because \cs{tmpLocalDB} has not been set and no explicit database name was
% supplied.  The message text suggests two remedies: set \cs{tmpLocalDB} at
% the top of a section, or pass the database name inline.
%    \begin{macrocode}
\msg_new:nnn { dfg } { database-name-not-given }
{ Missing~ database~ name~ for~ entry:~ #1^^J ^^J
  You~forgot~to~pass~a~database~name~\msg_line_context:.~
  You~can~provide~a~name~with~ e.g.~ '\def\tmpLocalDB{<database>}'
  ~or~within~entries~like~
  '\getEntry[<database>]{<id>}{<field>}'.
}
%    \end{macrocode}
% \paragraph{biblatex-ext-oa-doiapi-unavailable}
% Warns when \pkg{biblatex-ext-oa}'s DOI API integration cannot be enabled
% because |socket.http| is not available in the current LuaTeX run.  The
% package is still loaded, so manual BibTeX annotations continue to work.
%    \begin{macrocode}
\msg_new:nnn { dfg } { biblatex-ext-oa-doiapi-unavailable }
{ biblatex-ext-oa~ DOI~ API~ lookup~ disabled:~ LuaSocket~ module~
  'socket.http'~ is~ not~ available~ in~ this~ LuaTeX~ run.~
  Compile~ with~ '--socket'~ to~ enable~ DOI~ API~ requests.~
  Open-access~ markers~ still~ work~ from~ manual~ BibTeX~ annotations.
}
%    \end{macrocode}
% \paragraph{biblatex-ext-oa-doiapi-email-missing}
% DOI lookups require a real contact address.  An empty default keeps network
% access opt-in and prevents all users of the class from sharing a placeholder
% or maintainer address.
%    \begin{macrocode}
\msg_new:nnn { dfg } { biblatex-ext-oa-doiapi-email-missing }
{ biblatex-ext-oa~ DOI~ API~ lookup~ disabled:~ no~contact~address~was~set.^^J
  Set~'doiAPIMail=<address>'~with~\string\changeSettings~to~enable~lookups.
  Open-access~markers~still~work~from~manual~BibTeX~annotations.
}
%    \end{macrocode}
% \paragraph{missing-orcid}
% Triggered specifically by \refCom{getORCiD} when the |orcid| field is absent
% or empty for the requested person.  The message body reproduces the exact
% \refCom{addEntry} snippet the user needs to fill in, lowering the barrier to
% fixing the data.
%    \begin{macrocode}
\msg_new:nnn { dfg } { missing-orcid }
{DB:~'#1';~ID:~'#2';~null/empty:~'orcid'.~^^J^^J
  The~ORCiD~for~the~person~with~the~ID~'#2'~has~not~been~given.~
  You~asked~for~it~\msg_line_context: ~^^J
  If~the~person~has~an~ORCiD, ~go~to~where~you~have~written~^^J
  \addEntry{#1}{^^J
  	id   =#2, ^^J
  	orcid=<INSERT~ORCID~HERE>^^J
  }
}
%    \end{macrocode}
