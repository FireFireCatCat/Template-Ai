% Precompute once: store only the tokens, not \color & \bfseries directly
\cs_new_protected:Npn \@@_proj_pi_build: {
  \bool_if:NF \g_@@_proj_pi_built_bool {
  	\bool_gset_true:N \g_@@_proj_pi_built_bool

	  % Pass 1+2: precompute institution strings (as before)
  	\prop_new:N \l_@@_aff_narrow_prop
  	\DTLforeach*{affiliation}{
  		\l_tmpa_tl = id,
  		\l_tmpb_tl = name
  	}{%
  		\prop_put:NVV \l_@@_aff_narrow_prop \l_tmpa_tl \l_tmpb_tl
  	}

  \prop_new:N \l_@@_inst_narrow_prop
  \DTLforeach*{institution}{
  		\l_tmpa_tl = id,
  		\l_tmpb_tl = name,
		\l_tmpc_tl = ref-affiliation-id,
      \l_@@_projects_table_institution_abbreviation_tl = abbreviation
  	}{%
		\prop_gput:NVV \g_@@_projects_table_institution_abbreviation_prop
      \l_tmpa_tl \l_@@_projects_table_institution_abbreviation_tl
		\prop_gput:NVV \g_@@_projects_table_institution_name_prop
      \l_tmpa_tl \l_tmpb_tl
		\DTLifnullorempty{\l_@@_projects_table_institution_abbreviation_tl}{}
    {
      \prop_get:NVNTF \g_@@_projects_table_abbreviation_owner_name_prop
        \l_@@_projects_table_institution_abbreviation_tl \l_tmpe_tl
      {
        \tl_if_eq:NNF \l_tmpe_tl \l_tmpb_tl
        {
          \prop_if_in:NVF \g_@@_projects_table_abbreviation_warned_prop
            \l_@@_projects_table_institution_abbreviation_tl
          {
            \prop_get:NVN \g_@@_projects_table_abbreviation_owner_id_prop
              \l_@@_projects_table_institution_abbreviation_tl \l_tmpf_tl
            \msg_warning:nneeee { dfg } { duplicate-institution-abbreviation }
              { \l_@@_projects_table_institution_abbreviation_tl }
              { \l_tmpe_tl }
              { \l_tmpb_tl }
              { \l_tmpf_tl,~\l_tmpa_tl }
            \prop_gput:NVn \g_@@_projects_table_abbreviation_warned_prop
              \l_@@_projects_table_institution_abbreviation_tl { 1 }
          }
        }
      }
      {
        \prop_gput:NVV \g_@@_projects_table_abbreviation_owner_id_prop
          \l_@@_projects_table_institution_abbreviation_tl \l_tmpa_tl
        \prop_gput:NVV \g_@@_projects_table_abbreviation_owner_name_prop
          \l_@@_projects_table_institution_abbreviation_tl \l_tmpb_tl
      }
    }
		\bool_if:NTF
		  \l_@@_custom_projects_table_institution_abbreviations_bool
		{
		  \@@_institution_abbreviation_or_name:nN
		    { \l_tmpa_tl } \l_tmpf_tl
		}
		{
		  \tl_set:Nn \l_@@_institution_label_field_tl { name }
		  \DTLgetvalueforkey{\l_tmpf_tl}{name}{institution}{id}{\l_tmpa_tl}
		}
  		\prop_get:NVNT \l_@@_aff_narrow_prop \l_tmpc_tl \l_tmpd_tl {
          \tl_if_blank:VTF \l_tmpf_tl
          {
            \tl_set:Nx \l_tmpe_tl
            {
              \exp_not:N \dfgShowTag
                {\exp_not:V \l_tmpc_tl}{name}
                {\exp_not:V \l_tmpd_tl}[affiliation]
            }
          }
          {
            \tl_set:Nx \l_tmpe_tl
            {
              \exp_not:N \dfgShowTag
                {\exp_not:V \l_tmpa_tl}
                {\exp_not:V \l_@@_institution_label_field_tl}
                {\exp_not:V \l_tmpf_tl}[institution]
              ,~
              \exp_not:N \dfgShowTag
                {\exp_not:V \l_tmpc_tl}{name}
                {\exp_not:V \l_tmpd_tl}[affiliation]
            }
          }
  			\prop_put:NVV \l_@@_inst_narrow_prop \l_tmpa_tl \l_tmpe_tl
  		}
  	}

  	% Pass 3: per Person die ganze Zelle vorberechnen, mit \dfgPIformat
  	\DTLforeach*{person}{
  		\l_tmpa_tl = id,
  		\l_tmpb_tl = firstname,
  		\l_tmpc_tl = lastname,
  		\l_tmpd_tl = ref-institution-id
  	}{%
		\prop_gput:NVV \g_@@_proj_pi_institution_ids_prop
      \l_tmpa_tl \l_tmpd_tl
  		\tl_clear:N \l_tmpe_tl
  		\tl_put_right:Nx \l_tmpe_tl {%
  			\exp_not:N \dfgPIformat
        { \exp_not:V \l_tmpa_tl }
  			{ \exp_not:V \l_tmpb_tl }
  			{ \exp_not:V \l_tmpc_tl }%
  		}%
  		% Institutions, separator ";~"
  		\seq_set_from_clist:NV \l_tmpa_seq \l_tmpd_tl
  		\bool_set_true:N \l_tmpa_bool
  		\seq_map_inline:Nn \l_tmpa_seq {%
  			\bool_if:NTF \l_tmpa_bool
  			{ \bool_set_false:N \l_tmpa_bool }
  			{ \tl_put_right:Nn \l_tmpe_tl { ;~ } }%
  			\prop_get:NnNT \l_@@_inst_narrow_prop {##1} \l_tmpf_tl
  			{ \tl_put_right:NV \l_tmpe_tl \l_tmpf_tl }%
  		}
  		\prop_gput:NVV \g_@@_proj_pi_prop \l_tmpa_tl \l_tmpe_tl
  	}
  }
}

