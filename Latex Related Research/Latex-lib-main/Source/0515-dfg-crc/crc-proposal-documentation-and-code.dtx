% \begin{macro}{\ifIDequal}
%   Conditional macro for use inside \texttt{.bib} files.  Inside an
%   |addendum| field, write \verb|\ifIDequal{pi-id}{text}|; the text is
%   only emitted when the bibliography is being rendered for that PI.
%
%   The current PI is held in |\g_@@_current_pi_tl|, which is set by
%   |\dfgCVpublications| before each \verb|\printbibliography| call.
%
%   The implementation deliberately uses classic \LaTeX{} primitives
%   (|\edef|, |\ifx|, |\csname|) rather than expl3, because |\ifIDequal|
%   is invoked from inside a |biblatex|-rendered bibliography where
%   |\ExplSyntaxOff| is in effect.  Wrapping the variable lookup in
%   |\csname...\endcsname| makes the name resolve correctly regardless
%   of catcode state.
%    \begin{macrocode}
\DeclareFieldFormat{addendum}{\mkbibitalic{#1}}
\ExplSyntaxOff
\protected\long\def\ifIDequal#1#2{%
  \if\relax\detokenize{#2}\relax
    % #2 is empty: do nothing
  \else
    \begingroup
      \edef\dfg@tempa{#1}%
      \edef\dfg@tempb{\csname g_@@_current_pi_tl\endcsname}%
      \ifx\dfg@tempa\dfg@tempb
        \endgroup \par\textcolor{color@font@alternative}{#2}%
      \else
        \endgroup
      \fi
  \fi
}
\ExplSyntaxOn
%    \end{macrocode}
