% We also need a way to extract all PIs of a project. 
%    \begin{macrocode}
% The star defaults to full names and a prose list; explicit properties still
% override the default. A starred delimiter overrides only the final join.
\clist_new:N \l_@@_project_pi_properties_clist
\tl_new:N \l_@@_project_pi_name_tl
\NewDocumentCommand{\getPIofProject}{s o m o}
{
  \group_begin:
  \IfNoValueTF{#2}
    {
      \bool_if:NTF \l_@@_custom_pi_reference_firstname_bool
        {\clist_set:Nn \l_@@_project_pi_properties_clist {firstname,lastname}}
