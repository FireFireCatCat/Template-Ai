\chapter{Bylaws of the Collaborative Research Centre} %4
\printThumbIndex{4}
\cohead{Bylaws of the \crc}%
\cehead{Bylaws of the \crc}%

\begin{bylaws}
  \item Name, coordinating
    \dfgApplicantAffiliationsTF{university}{universities}, and purpose of the \crc
  \begin{bylaws}
	\item The \crc (CRC) \enquote{\dfgCRCName\space --\space\dfgCRCNameAddon}
      is a legally dependent institution of \theCRCaffiliation.

    \item The \crc conducts interrelated research on microbial signalling,
      epithelial barriers, immune regulation, and organ function.  It is
      divided into research project areas and central projects.

    \item The \crc promotes interaction with other research institutions,
      supports researchers in early career phases, and fosters responsible
      international cooperation, equity, and equal opportunity.
  \end{bylaws}

  \item Membership and governing bodies
  \begin{bylaws}
    \item Members are the project leaders and persons appointed to central
      scientific or administrative responsibilities by the general assembly.
    \item The governing bodies are the general assembly, the spokesperson, and
      the steering committee.  The general assembly elects the spokesperson
      and steering committee for the applicable funding period.
    \item The steering committee prepares strategic and budgetary decisions,
      monitors milestones, and reports to the general assembly at least once
      per year.
  \end{bylaws}

  \item Decisions and allocation of shared resources
  \begin{bylaws}
    \item Decisions are normally taken by simple majority of members present;
      changes to these bylaws require a two-thirds majority.
    \item Shared funds and infrastructure are allocated through documented,
      transparent procedures based on scientific need, feasibility, and equal
      access across participating projects.
    \item Members disclose conflicts of interest and do not participate in the
      corresponding deliberation or decision.
  \end{bylaws}

  \item Research integrity, equity, and conflict resolution
  \begin{bylaws}
    \item All members follow the applicable rules of good research practice,
      data protection, animal welfare, research ethics, and occupational safety.
    \item The CRC implements equal-opportunity and accessibility measures and
      monitors participation in recruitment, training, and governance.
    \item Concerns may be raised confidentially with the spokesperson, the CRC
      management, or the competent independent offices of the participating
      institutions.
  \end{bylaws}

  \item Research-data governance
  \begin{bylaws}
    \item Projects document data, code, samples, access rights, retention, and
      publication in project-specific data-management plans.
    \item Central data stewardship defines common metadata and quality
      standards, manages controlled access, and supports publication according
      to the FAIR principles and applicable legal requirements.
  \end{bylaws}
\end{bylaws}
