% \subsection{\cs{changeSettings}}
%
% \cs{changeSettings}\marg{key=value,...} is the public command used
% to customise the document class beyond its defaults.  It delegates
% directly to \cs{keys\_set:nn}|{dfg/custom}{\meta{key=value,...}}|.
%
% It should be called inside |preamble/dfg-customization.tex| so that all
% customisations are centralised.  Examples:
% \begin{dispListing*}{title={Typical changeSettings call}}
%   \changeSettings{
%     font                        = Arial,
%     crcLogoPath                 = img/logo-crc,
%     affiliationLogoPath         = img/logo-affiliation,
%     doiAPIMail                  = researcher@example.org,
%     projectPIOncePerSection     = true,
%     collaborationAreaColors     = {A=projectA,B=projectB,Q=projectQ},
%     collaborationAreaPalette    = {orange,violet,teal,brown},
%     salary@postDoc              = 90000,
%     animalHousing@mouse         = 0.80,
%     thumbindex                  = false,
%     biblatexstyleCV             = ext-numeric-comp,
%     biblatexstyleFeatureCV      = {sorting=none},
%     biblatexstyleProposal       = ext-authoryear-ecomp,
%     biblatexstyleFeatureProposal= {},
%     color@table@rows            = blue-10,
%   }
% \end{dispListing*}
% The command is defined before \pkg{biblatex} is loaded so bibliography
% package options from the customization file take effect in time.
% \subsection{Thumb index implementation}
%
% The thumb index is a series of colour tabs printed on the outer margin
% of each page to help readers navigate between chapters or project sections.
% Each tab occupies one slot in a vertical grid that repeats with a period
% equal to \texttt{thumbindex@pattern} (default: 10).
%
% \textbf{Geometry calculation:}
% \cs{thumb\_compute\_height:} calculates the slot height as
% |(\cs{paperheight} - topmargin - bottommargin) / pattern|.  In the default
% |auto| mode, the margins are derived from the current text-block position and
% \cs{textheight}, so the slot height is \cs{textheight}| / pattern|.  The
% calculation runs when the tab is drawn, allowing later layout changes to
% affect the thumb-index grid.
%
% \textbf{Placement:}
% \cs{thumb\_place\_node:nnnn} draws an absolutely-positioned TikZ node
% on the current page using |remember picture,overlay|.  Its reference point
% is |(current page.north west/east) -| followed by
% |(0, topmargin + height*(index-1/2))|, centering each tab in its slot.
% The rectangular tab has 7pt rounded corners and is shifted 7pt past the
% page boundary, clipping the outer corners while retaining the configured
% visible depth.  Its label is rotated 90 degrees in opposite directions on
% facing pages so the tab stays within the marginal column. The default
% |thumbindex@orientation=outwards| points the tops of the letters towards the
% outer edge. Choosing |inwards| adds 180 degrees to the label rotation on
% both sides, without changing the tab geometry.
% The label is inset 2\,mm towards the text block on either side; paired
% horizontal kerns leave the tab dimensions and placement unchanged.
%
% \textbf{Call pattern:}
% \cs{printThumbIndex}\oarg{colour}\marg{label} increments the slot counter,
% wrapping at \texttt{pattern}, then injects the node into both the header
% and footer layers via \cs{lehead}/\cs{lohead} so the tab appears on
% the page regardless of which scrlayer-scrpage style is active.  The
% optional colour argument allows project-specific hues (typically the
% |projectA|, |projectB|, |projectQ| aliases).
%
% \cs{printThumbIndexOff} clears the header/footer layers to suppress the
% tab on pages where no thumb index is desired (e.g.\ the bibliography).
% \cs{resetThumbIndex} resets the slot counter so that the next
% \cs{printThumbIndex} call starts at the first slot again.  This is useful
% when a manually inserted section should begin a new thumb-index sequence.
%    \begin{macrocode}
\int_new:N \l_thumb_index_int
\int_zero:N \l_thumb_index_int
%    \end{macrocode}
% The effective margins follow the current text block unless overridden with
% explicit page-edge dimensions.  Calculate them when drawing each tab rather
% than at class load time, when page geometry may not yet be final.
%    \begin{macrocode}
\dim_new:N \l_thumb_height_dim
\dim_new:N \l_thumb_topmargin_dim
\dim_new:N \l_thumb_bottommargin_dim
\cs_new_protected:Npn \thumb_compute_height:
{
  \bool_if:NTF \l_@@_custom_thumbindex_topmargin_set_bool
    { \dim_set_eq:NN \l_thumb_topmargin_dim
        \l_@@_custom_thumbindex_topmargin_dim }
    {
      \dim_set:Nn \l_thumb_topmargin_dim
        { 1in + \voffset + \topmargin + \headheight + \headsep }
    }
  \bool_if:NTF \l_@@_custom_thumbindex_bottommargin_set_bool
    { \dim_set_eq:NN \l_thumb_bottommargin_dim
        \l_@@_custom_thumbindex_bottommargin_dim }
    {
      \dim_set:Nn \l_thumb_bottommargin_dim
        {
          \paperheight
          - ( 1in + \voffset + \topmargin + \headheight + \headsep )
          - \textheight
        }
    }
  \dim_set:Nn \l_thumb_height_dim
    {
      ( \paperheight - \l_thumb_topmargin_dim
        - \l_thumb_bottommargin_dim )
      / \l_@@_custom_thumbindexpattern_int
    }
}
%    \end{macrocode}
% defining now the layout of the thumb index. Be aware of the stripped spaces in
% the LaTeX3 environment.
%    \begin{macrocode}
\tikzset
{
  thumb/.style=
  	{
  		fill   = thumbIndexBG ,      % colour may be changed later
  		text   = thumbIndexFont,
  		minimum~ height = \dim_use:N \l_thumb_height_dim,
		minimum~ width  = \dim_eval:n
		  { \l_@@_custom_thumbindex_width_dim + 7pt },
		outer~ sep      = 0pt,
  		font            = \tl_use:N \l_@@_custom_thumbindex_font_tl,
		inner~ sep      = 1mm,
  	}
}
%    \end{macrocode}
% we need a couple of helper commands though.
%   The <even/odd> macros are now tiny wrappers around a single
%   protected function that does the arithmetic in expl3.
%    \begin{macrocode}
\cs_new_protected:Npn \thumb_place_node:nnnn #1#2#3#4
{
  %  #1 = west|east    (anchor direction)
  %  #2 = shift past the page edge
  %  #3 = label rotation
  %  #4 = node contents
  \thumb_compute_height:
  \begin{tikzpicture}[remember~ picture,overlay]
  	\node[
  		thumb,
  		anchor  =#1,
		rectangle,
		rounded~ corners=7pt,
		xshift  =#2
  	]
  	% ---------------------------------------------------------
  	%   absolute position = (current page.north <west/east>) –
  	%                       (0 , vertical offset)
  	%   The whole thing must be inside $ … $.
  	% ---------------------------------------------------------
  	at
  	($ (current~page.north~ #1)~ -~
  		(0,\dim_eval:n{
            \l_thumb_topmargin_dim
            + \l_thumb_height_dim * (\l_thumb_index_int - 1)
            + \l_thumb_height_dim / 2
  		}) $)
	{
      % Inset the text by 2mm; opposite kerns preserve the tab dimensions.
      \str_if_eq:nnTF {#1}{west}
        {\kern2mm}{\kern-2mm}
      \rotatebox[origin=c]{#3}{#4}
      \str_if_eq:nnTF {#1}{west}
        {\kern-2mm}{\kern2mm}
    };
  \end{tikzpicture}
}

\NewDocumentCommand{\evenpageletterthumb}{m}
{
  \thumb_place_node:nnnn {west}{-7pt}
    {\int_eval:n {90 + \l_@@_custom_thumbindex_rotation_int}}{#1}
}
\NewDocumentCommand{\oddpageletterthumb}{m}
{
  \thumb_place_node:nnnn {east}{7pt}
    {\int_eval:n {-90 + \l_@@_custom_thumbindex_rotation_int}}{#1}
}
%    \end{macrocode}
% Now the key command |\printThumbIndex|.
%    \begin{macrocode}
\NewDocumentCommand{\printThumbIndex}{ O{thumbIndexBG} m }
{
  %   #1 (optional) – colour definition used when no project is given
  %   #2 (mandatory) – the letter (or any material) to be printed

  \bool_if:NT \l_@@_custom_thumbindex_bool
  {
  	\colorlet{thumbIndexBG}{#1}

  	% ---- reset index if we have reached the bottom of the column -----
  	\int_compare:nNnT { \l_thumb_index_int } = { \l_@@_custom_thumbindexpattern_int }
  	{ \int_zero:N \l_thumb_index_int }

  	% ---- step to the *next* position -----------------------------------
  	\int_incr:N \l_thumb_index_int

  	% ---- actually place the thumb on the current page ------------------
  	%   (the same node is put into both the header and the foot, so it
  	%   appears on the page no matter which page‑style you use)
  	\lehead[\evenpageletterthumb{#2}]{\evenpageletterthumb{#2}}
  	\lohead[\oddpageletterthumb{#2}]{\oddpageletterthumb{#2}}
  }
}
\NewDocumentCommand{\resetThumbIndex}{}
{
  \int_zero:N \l_thumb_index_int
}
\NewDocumentCommand{\printThumbIndexOff}{}
{
  \lehead[]{}
  \lohead[]{}
}
%    \end{macrocode}
% \subsection{Bold-author mechanism}
%
% The DFG requires that the names of all CRC project leaders are printed in
% bold in every bibliography list so reviewers can immediately identify the
% investigators' output.  This is technically non-trivial because biblatex
% does not natively support singling out individual author names.
%
% The implementation uses a hash-based approach:
% \begin{enumerate}
%   \item For each PI, \refCom{addboldnames} is called with their name as it
%         appears in the |.bib| file (and all common aliases via
%         \refKey{name-alias}).  Each name is written as a |\@misc|
%         |dataonly| entry to an auxiliary |.bib| file.
%   \item During the |\AfterPreamble| pass, the cite command
%         |\nhblx@getmethehash| processes each entry and extracts its
%         biblatex internal hash (a fingerprint stable across style changes)
%         into the list |\nhblx@boldhashes|.
%   \item The name wrapper |boldifhashinlist| applies
%         \cs{mkboldifhashinlist} to every printed author name; if the
%         author's hash appears in the list, the name is wrapped in
%         \cs{mkbibbold} and coloured with |color@reference@boldAuthor|.
% \end{enumerate}
% The mechanism is only activated when |emphasizeAuthors=true| (the default).
% Fallback no-op definitions of \refCom{addboldnames} and \refCom{resetboldnames}
% are provided via \cs{providecommand} so that content files compile
% correctly even if the feature is disabled.
%
% \refCom{addboldnames} should be called in the preamble of both the proposal
% document and the standalone CV document, typically inside
% |preamble/dfg-customization.tex|.
% For displaying certain authors in bold letters, \refKey{emphasizeAuthors}
% (for the switch) and \refCom{addboldnames} (for the addition of authors).
%    \begin{macrocode}
\int_new:N  \g_@@_boldnames_int
\iow_new:N  \g_@@_boldnames_iow
\prop_new:N \g_@@_boldnames_hashes_prop
\tl_new:N   \l_@@_boldnames_name_tl

\bool_if:NT \l_@@_custom_emphasize_authors_bool
{
  % ---------- Auxiliary .bib file -----------------------------------

  \bool_if:NTF \l_@@_class_documentation_bool
    {\tl_const:Nn \c_@@_boldnames_bibfile_tl {\jobname-boldAuthors.bib}}
    {\tl_const:Nn \c_@@_boldnames_bibfile_tl {bib/\jobname-boldAuthors.bib}}
  \iow_open:Nn \g_@@_boldnames_iow { \c_@@_boldnames_bibfile_tl }
  \iow_now:Nn  \g_@@_boldnames_iow { @comment{Auto-generated~file} }
  \AtEndDocument { \iow_close:N \g_@@_boldnames_iow }
  \addbibresource{\c_@@_boldnames_bibfile_tl}

  % ---------- Writing a single name ---------------------------------
  %
  % We need:
  %   - the entry KEY  (nhblx@name@<N>)  fully expanded
  %   - the AUTHOR field written verbatim (so \"a etc. survive)
  %
  % \iow_now:Nn  → no expansion
  % \iow_now:Nx  → full expansion (breaks accents in names)
  % \iow_now:Nn + \exp_not:n on the name = best of both via \iow_now:Nx

  \cs_new_protected:Npn \@@_boldnames_write:n #1
  {
  	\int_gincr:N \g_@@_boldnames_int
  	% Stash the name so it survives the x-expansion intact.
  	\tl_set:Nn \l_@@_boldnames_name_tl { #1 }
  	\iow_now:Nx \g_@@_boldnames_iow
  	{
  		@misc{nhblx@name@\int_use:N \g_@@_boldnames_int,
  				author~=~{\exp_not:V \l_@@_boldnames_name_tl},
  				options~=~{dataonly=true},
  			}
  	}
  	% Schedule hash extraction after biblatex has loaded the entry.
  	\exp_args:Nx \AfterPreamble
  	{
  		\exp_not:N \hbox_set:Nn \exp_not:N \l_tmpa_box
  		{ \exp_not:N \nhblx@getmethehash
  			{ nhblx@name@ \int_use:N \g_@@_boldnames_int } }
  	}
  }

  % ---------- User-level commands -----------------------------------

  \NewDocumentCommand \addboldnames { m }
  { \clist_map_function:nN { #1 } \@@_boldnames_write:n }

  \NewDocumentCommand \resetboldnames { }
  { \prop_gclear:N \g_@@_boldnames_hashes_prop }

  % ---------- biblatex glue -----------------------------------------

  \DeclareNameFormat{nhblx@hashextract}
  {
  	\prop_gput:Nen \g_@@_boldnames_hashes_prop { \thefield{hash} } { }
  }

  \DeclareCiteCommand{\nhblx@getmethehash}
  {}{ \printnames[nhblx@hashextract][1-999]{author} }{}{}

  \cs_new_protected:Npn \@@_boldnames_mark:n #1
  {
  	\prop_if_in:NeTF \g_@@_boldnames_hashes_prop { \thefield{hash} }
  	{ \mkbibbold { \textcolor{color@reference@boldAuthor} { #1 } } }
  	{ #1 }
  }

  \cs_set_eq:NN \mkboldifhashinlist \@@_boldnames_mark:n

  \DeclareNameWrapperFormat{boldifhashinlist}
  { \renewcommand*{\mkbibcompletename}{\mkboldifhashinlist} #1 }

  \DeclareNameWrapperAlias{sortname}{default}
  \DeclareNameWrapperAlias{default}{boldifhashinlist}
}

%    \end{macrocode}
% We need the fallback of the commands in case the functionality isnt used at all.
%    \begin{macrocode}
\providecommand { \addboldnames   } [1] { }
\providecommand { \resetboldnames }     { }
%    \end{macrocode}
% \subsection{Database infrastructure and key families}
%
% All structured data in the proposal (people, projects, institutions,
% funding entries, \ldots) is stored in \pkg{datatool} databases at
% compile time.  Each database is created lazily: \refCom{addEntry} checks
% whether the named database already exists and creates it if not,
% eliminating the need for explicit initialisation calls.
%
% The central mechanism relies on the L3 variable
% \cs{l\_@@\_database\_name\_tl}, which holds the name of the
% currently-active database while a \cs{keys\_set:nn} call is in
% progress.  Every |.code:n| handler in a keyset calls
% \cs{DTLnewdbentry} with that variable as the database name, so no
% explicit database name is needed inside the keyset definition itself.
%
% The token list is reset in each call to \refCom{addEntry} and is wrapped
% in a |\group_begin:/end:| pair to prevent it from leaking across
% independent \refCom{addEntry} calls.
%
% \paragraph{Input validation strategy}
% Choice-valued keys (e.g.\ \refKey{gender}, \refKey{project-type}) use
% |.choices:nn| with an |unknown .code:n| handler wired to the
% |dfg/invalid-value| message.  Free-text keys accept any input.
% Required keys are marked with |.value\_required:n = true| so that
% omitting them produces an immediate error rather than a silent empty
% database field.
%    \begin{macrocode}
\tl_new:N \l_@@_database_name_tl
%    \end{macrocode}
% \paragraph{Keyset \textbf{meta}}
% The |meta| database holds exactly one row with |id=crc| that describes
% the CRC itself.  Its fields are read in \cs{AfterEndPreamble} to populate
% the global macros used in headers, footers, and PDF metadata
% (\cs{theCRCname}, \cs{theCRCnumber}, \cs{theCRCaffiliation}, etc.).
%
% The \refKey{fundingYears} and \refKey{fundingYearsPrevious} keys accept a
% comma-separated list of calendar years (one per funding year) and expand
% them into individually named fields |fundingYear1| \ldots |fundingYear5|,
% which are used e.g. as column headers in the Gantt chart title row.
%
% \refKey{fundingPeriodNumeral} (1, 2 or 3) drives all period-filtered queries:
% only personnel with a matching |period| entry are included in the project
% leader table and the gender equality analysis.
%    \begin{macrocode}
\keys_define:nn { meta }{
  id              .code:n     =  \DTLnewdbentry{\l_@@_database_name_tl}{id}{#1},
  id              .value_required:n = true,
  name      .code:n  = \DTLnewdbentry{\l_@@_database_name_tl}{name}{#1},
  nameAddon .code:n  = \DTLnewdbentry{\l_@@_database_name_tl}{nameAddon}{#1},
  number    .code:n  = \DTLnewdbentry{\l_@@_database_name_tl}{number}{#1},
  fundingPeriodNumeral .choices:nn = { 1 , 2 , 3 }
  	{
  		% store the numeral itself
  		\DTLnewdbentry{\l_@@_database_name_tl}{fundingPeriodNumeral}{#1}
  		% map numeral → text without a property list
  		\int_case:nnF {#1}
  		{
  			{ 1 } { \DTLnewdbentry{\l_@@_database_name_tl}{fundingPeriodText}{first} }
  			{ 2 } { \DTLnewdbentry{\l_@@_database_name_tl}{fundingPeriodText}{second} }
  			{ 3 } { \DTLnewdbentry{\l_@@_database_name_tl}{fundingPeriodText}{third} }
  		}
  		{
  			% fallback (should not happen because of the .choices clause)
        \msg_warning:nnnn { dfg } { invalid-value }
  			{ #1 } { 1 , 2 , 3 }
  		}
  	} ,
  fundingPeriodNumeral / unknown .code:n =
  	{
      \msg_warning:nnnn { dfg } { invalid-value }
  		{ #1 } { 1 , 2 , 3 }
  	} ,
  fundedSince          .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{fundedSince}{#1},
  fundingYears .code:n =
  	{
  		\seq_set_from_clist:Nn \l_meta_funding_years_seq {#1}
  		%--- create the individual entries -----------------
  		\int_zero_new:N \l_tmpa_int
  		\seq_map_inline:Nn \l_meta_funding_years_seq
  		{
  			\int_incr:N \l_tmpa_int
  			\DTLnewdbentry
  			{\l_@@_database_name_tl}
  			{fundingYear\int_use:N \l_tmpa_int}
  			{##1}
  		}
  	},
  fundingYearsPrevious .code:n =
  	{
  		\seq_set_from_clist:Nn \l_meta_funding_years_previous_seq {#1}

  		%--- create the individual entries -----------------
  		\int_zero_new:N \l_tmpa_int
  		\seq_map_inline:Nn \l_meta_funding_years_previous_seq
  		{
  			\int_incr:N \l_tmpa_int
  			\DTLnewdbentry
  			{\l_@@_database_name_tl}
  			{fundingYearPrevious\int_use:N \l_tmpa_int}
  			{##1}
  		}
  	},
  ref-affiliation-id  .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{ref-affiliation-id}{#1},
}
%    \end{macrocode}
% \paragraph{Keyset \textbf{GenderEquality}}
% This keyset is used to populate the \cs{GenderEqualityStaffTable} and
% \cs{GenderEqualityProjectLeadersTable}.  Each row stores one
% position-level target for the upcoming funding period alongside the
% previous period's objective for comparison.
%
% The live counts (current numbers of female/male/diverse staff per
% position and period) are \emph{computed} at render time from the |person|
% database — they are not entered manually.  Only the
% percentage-female objective values need to be provided here.
%    \begin{macrocode}
\keys_define:nn { GenderEquality }{
  position                             .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{position}{#1},
  previous-objective-percentage-female .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{previous-objective-percentage-female}{#1},
  status-quo-number-female             .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{status-quo-number-female}{#1},
  status-quo-percentage-female         .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{status-quo-percentage-female }{#1},
  future-objective-percentage-female   .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{future-objective-percentage-female}{#1},
}
%    \end{macrocode}
% \paragraph{Multi-value helper: \cs{\_\_dfg\_set\_filtered\_clist:Nnn}}
% Several keys (|role|, |period|) accept comma-separated lists rather than
% a single choice.  The private helper
% \cs{\_\_dfg\_set\_filtered\_clist:Nnn}|{\meta{result}}{\meta{valid}}{\meta{input}}|
% iterates over the input list, drops any item that is not in the valid list
% (and emits an |invalid-value| warning for it), and stores the cleaned
% result in a clist variable.  This is used instead of |.choices:nn| because
% the standard choices handler only accepts a single value.
%    \begin{macrocode}
\clist_new:N \l_@@_person_tmp_period_clist
\clist_new:N \l_@@_person_tmp_role_clist
\clist_new:N \l_@@_keys_tmp_clist
\cs_new_protected:Npn \_@@_set_filtered_clist:Nnn #1#2#3
{
  % #1: clist variable in which valid values are stored
  % #2: clist of valid values
  % #3: clist of given values
  % function assumes none of the values contain braces or `#` tokens
  \clist_set:Nn \l_@@_keys_tmp_clist {#2}
  \clist_clear:N #1
  \clist_map_inline:nn {#3}
  {
  	\clist_if_in:NnTF \l_@@_keys_tmp_clist {##1}
  	{ \clist_put_right:Nn #1 {##1} }
    { \msg_warning:nnne { dfg } { invalid-value } {##1}
      { \clist_use:Nn \l_@@_keys_tmp_clist {,~} } }
  }
}
%    \end{macrocode}
%
% \paragraph{Keyset \textbf{project}}
% One row per CRC sub-project.  The \refKey{id} is the short project letter (e.g.\
% |A01|); \refKey{number} is the DFG-assigned project number; \refKey{name} is the full
% project title.  \refKey{project-type} and \refKey{project-status} control how the project
% appears in tables and are choice-validated.
%
% The \refKey{research-area} key is a tick-list of DFG classification codes in
% the form |1.11-01| (see the property list in Section~\ref{sec:research-areas}).
% Multiple codes are passed as a brace-grouped comma list.
%
% The \refKey{ref-person-id} and \refKey{collaborations} values are comma
% lists.  Whitespace surrounding individual IDs is ignored and the canonical,
% space-free list is stored in the database.  Thus
% |{person-a,person-b,person-c}| and |{person-a, person-b, person-c}| are equivalent for
% every later consumer.
% The optional |project-area| key controls the area row in collaboration plots.
% When omitted, the first character of the project ID is used as a fallback.
%
% The \refKey{legal-issues} sub-keyset mirrors the questions from the DFG online
% portal's project-information form (\refKey{L1}--\refKey{L7}).  Nested key-value parsing
% is triggered via a single |legal-issues={...}| block.
%
%    \begin{macrocode}
\cs_new_protected:Npn \@@_new_clist_dbentry:nnn #1#2#3
{
  \clist_set:Nn \l_tmpa_clist {#3}
  \exp_args:NnnV \DTLnewdbentry {#1} {#2} \l_tmpa_clist
}

\bool_new:N \l_@@_project_consider_for_lists_bool
\bool_new:N \l_@@_project_reference_only_bool
\bool_new:N \g_@@_project_count_ready_bool

\keys_define:nn { project }{
  id                       .code:n           =   \DTLnewdbentry{\l_@@_database_name_tl}{id}{#1},
  id                       .value_required:n = true,
  number                   .code:n           = \DTLnewdbentry{\l_@@_database_name_tl}{number}{#1},
  number                   .value_required:n = true,
  name                     .code:n           = \DTLnewdbentry{\l_@@_database_name_tl}{name}{#1},
  project-type             .choices:nn       =  { research,service,mgk,admin} {\DTLnewdbentry{\l_@@_database_name_tl}{project-type}{#1}},
  project-type / unknown   .code:n           = {\msg_warning:nnnn { dfg } { invalid-value }{ #1 }{research,service,mgk,admin}},
  project-type             .value_required:n = true,
  project-status           .choices:nn       =  { N,E,C} {\DTLnewdbentry{\l_@@_database_name_tl}{project-status}{#1}},
  project-status / unknown .code:n           = {\msg_warning:nnnn { dfg } { invalid-value }{ #1 }{N,E,C}},
  project-status           .value_required:n = true,
  consider-for-lists           .choices:nn       = { true,false }
    { \str_if_eq:nnTF {#1} {true}
        { \bool_set_true:N \l_@@_project_consider_for_lists_bool }
        { \bool_set_false:N \l_@@_project_consider_for_lists_bool } },
  consider-for-lists / unknown .code:n           =
    { \msg_warning:nnnn { dfg } { invalid-value } {#1} {true,false} },
  consider-for-lists           .value_required:n = true,
  reference-only           .choices:nn       = { true,false }
    { \str_if_eq:nnTF {#1} {true}
        { \bool_set_true:N \l_@@_project_reference_only_bool }
        { \bool_set_false:N \l_@@_project_reference_only_bool } },
  reference-only / unknown .code:n           =
    { \msg_warning:nnnn { dfg } { invalid-value } {#1} {true,false} },
  reference-only           .value_required:n = true,
  research-area            .code:n           = \DTLnewdbentry{\l_@@_database_name_tl}{research-area}{#1},
  project-area             .code:n           = \DTLnewdbentry{\l_@@_database_name_tl}{project-area}{#1},
  ref-person-id            .code:n           =
  \@@_new_clist_dbentry:nnn {\l_@@_database_name_tl} {ref-person-id} {#1},
  collaborations           .code:n           =
  \@@_new_clist_dbentry:nnn {\l_@@_database_name_tl} {collaborations} {#1},
  legal-issues             .code:n           = { \keys_set:nn { project / legal-issues  } { #1 } }
}
%    \end{macrocode}
% The |legal-issues| key in a |project| entry accepts a sub-keyset that
% maps each legal-issue question to a value.  The questions fall into two
% groups, which are handled differently:
%
% \begin{description}
%   \item[Main questions (\refKey{L1}, \refKey{L2}, \refKey{L3},
%     \refKey{L4}, \refKey{L5}, \refKey{L6}, \refKey{L7})] Each must be
%     answered with exactly \texttt{yes} or \texttt{no}.  Any other
%     value triggers a warning via \cs{person\_questions\_invalid:n}, and
%     no database entry is created.
%
%   \item[Sub-questions (\refKey{L1a}, \refKey{L2a}, \refKey{L5a},
%     \refKey{L7a})] These are conditional follow-ups whose answer only
%     matters when the corresponding main question was answered with
%     \texttt{yes}.  Sub-questions accept \texttt{yes}, \texttt{no},
%     or an empty value.  An empty value records an empty cell in the
%     database, which the typesetting code treats as ``not answered''
%     and consequently does not render in the legal-issues table.
% \end{description}
%
% The asymmetry exists because forcing every sub-question to be answered
% would require authors to fill in irrelevant follow-ups whenever the
% parent question is \texttt{no} -- for example, providing an answer
% to ``has legal authorization been obtained'' for a project that does
% not involve human embryonic stem cells in the first place.  Allowing
% an empty value lets the data file mirror the structure of the
% questionnaire: only the relevant cells need to be filled in.
%
% \medskip
%
% Internally, the main questions use the \refPkg{l3keys} \texttt{.choices:nn}
% property, which natively rejects values outside the allowed set.  The
% sub-questions cannot use \texttt{.choices:nn} directly because that
% property does not accept the empty string as a choice; they instead
% dispatch through the helper \cs{dfg\_legal\_subq:nn}, which inspects
% the supplied value and creates a database entry when the value is
% \texttt{yes}, \texttt{no}, or empty, and warns otherwise.
%
% \medskip
%
% Example of a complete |legal-issues| block in a project entry:
%
% \begin{dispListing*}{title={Example entries for |legal-issues|}}
% legal-issues = {
%   L1  = {yes},
%   L1a = {yes},      % L1 was true, follow-up answered
%   L2  = {no},
%   L2a = {},          % L2 was false, follow-up irrelevant
%   L3  = {yes},
%   L4  = {no},
%   L5  = {no},
%   L5a = {},
%   L6  = {yes},
%   L7  = {yes},
%   L7a = {yes}
% }
% \end{dispListing*}
%
% The empty values for \refKey{L2a} and \refKey{L5a} are valid: they correspond to
% follow-ups whose parent question was answered \texttt{no}, so no
% follow-up information is required or rendered.
%    \begin{macrocode}
\keys_define:nn { project / legal-issues }
{
  % main questions: must be yes/no
  L1  .choices:nn = { yes, no } { \DTLnewdbentry{\l_@@_database_name_tl}{L1} {#1} },
  L2  .choices:nn = { yes, no } { \DTLnewdbentry{\l_@@_database_name_tl}{L2} {#1} },
  L3  .choices:nn = { yes, no } { \DTLnewdbentry{\l_@@_database_name_tl}{L3} {#1} },
  L4  .choices:nn = { yes, no } { \DTLnewdbentry{\l_@@_database_name_tl}{L4} {#1} },
  L5  .choices:nn = { yes, no } { \DTLnewdbentry{\l_@@_database_name_tl}{L5} {#1} },
  L6  .choices:nn = { yes, no } { \DTLnewdbentry{\l_@@_database_name_tl}{L6} {#1} },
  L7  .choices:nn = { yes, no } { \DTLnewdbentry{\l_@@_database_name_tl}{L7} {#1} },
  %
  % sub-questions: yes / no / empty all allowed
  L1a .code:n = { \dfg_legal_subq:nn {L1a} {#1} },
  L2a .code:n = { \dfg_legal_subq:nn {L2a} {#1} },
  L5a .code:n = { \dfg_legal_subq:nn {L5a} {#1} },
  L7a .code:n = { \dfg_legal_subq:nn {L7a} {#1} },
  %
  % unknown handlers (only need them for the binary keys)
  L1  / unknown .code:n = { \person_questions_invalid:n {#1} },
  L2  / unknown .code:n = { \person_questions_invalid:n {#1} },
  L3  / unknown .code:n = { \person_questions_invalid:n {#1} },
  L4  / unknown .code:n = { \person_questions_invalid:n {#1} },
  L5  / unknown .code:n = { \person_questions_invalid:n {#1} },
  L6  / unknown .code:n = { \person_questions_invalid:n {#1} },
  L7  / unknown .code:n = { \person_questions_invalid:n {#1} },
}

% Sub-question handler: accepts yes, no, or empty.
\cs_new_protected:Npn \dfg_legal_subq:nn #1#2
{
  \tl_if_blank:nTF {#2}
  { \DTLnewdbentry{\l_@@_database_name_tl}{#1}{} }
  {
  	\str_case:nnF {#2}
  	{
  		{ yes  } { \DTLnewdbentry{\l_@@_database_name_tl}{#1}{yes}  }
  		{ no } { \DTLnewdbentry{\l_@@_database_name_tl}{#1}{no} }
  	}
    { \msg_warning:nnnn { dfg } { invalid-value } {#2}
      { yes,~no,~or~an~empty~value } }
  }
}
%    \end{macrocode}
% \paragraph{Keyset \textbf{person}}
% The |person| database is the central personnel registry for the proposal.
% Every PI, manager, steering committee member and early-career researcher
% who appears in any table must have a row here.
%
% \textbf{Key semantics:}
%   \refKey{role}: A filterable comma list of roles.  The supported values
%     (|PI|, |spokesperson|, |manager|, |steering-committee-member|,
%     |rector|) are validated against a fixed list using the multi-value
%     helper so that multiple roles per person are permitted.
%   \refKey{position}: A single choice describing the employment category
%     (|prof-W2|, |prof-W3|, |postDoc|, |PhD|, etc.).  Used in the gender
%     equality and staff cost tables.
%   \refKey{period}: Comma list of funding periods (|1|, |2|, |3|) in which
%     this person is active.  All period-filtered queries
%     (e.g.\ the project-leaders table) use this field.
%   \refKey{name-alias}: Brace-grouped list of name variants as the author
%     name appears in |.bib| files.  These are passed to \cs{addboldnames}
%     so all spelling variants are highlighted consistently.
%   \refKey{contract-information}: Sub-keyset (\refKey{C1}--\refKey{C4a}) for the four
%     employment-contract questions required in the DFG project header.
%     Internally stored as fields |Q1|--|Q4a|.
%    \begin{macrocode}
\keys_define:nn { person }{
  unknown .code:n = { \msg_warning:nnn  { dfg } { unknown-key } {#1}},
  unknown .default:V = \c_novalue_tl,
  id                .code:n =   \DTLnewdbentry{\l_@@_database_name_tl}{id}{#1},
  id                .value_required:n = true,
  firstname        .code:n =	\DTLnewdbentry{\l_@@_database_name_tl}{firstname}{#1},
  firstname .value_required:n = true,
  lastname         .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{lastname}{#1},
  lastname .value_required:n = true,
  academicdegree   .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{academicdegree}{#1},
  gender .choices:nn =  { m , f , d } {\DTLnewdbentry{\l_@@_database_name_tl}{gender}{#1}},
  gender / unknown .code:n = {\msg_warning:nnnn { dfg } { invalid-value }{ #1 }{ m,f,d }},
  gender .value_required:n = true,
  ref-affiliation-id   .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{ref-affiliation-id}{#1},
  ref-institution-id   .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{ref-institution-id}{#1},
  ref-project-id .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{ref-project-id}{#1},
%    \end{macrocode}
% With \refKey{role} we want to differentiate between various people so we easily can
% get the necessary person into the right table. Roles can be e.g. |PI|,
% |service| etc.
%    \begin{macrocode}
  role .code:n = {\_@@_set_filtered_clist:Nnn \l_@@_person_tmp_role_clist {
  			PI,~ spokesperson,~ manager,~ steering-committee-member,~rector
  		} {#1}
  		\exp_args:Nnne \DTLnewdbentry{\l_@@_database_name_tl}{role}
                 { \clist_use:N  \l_@@_person_tmp_role_clist}},
%    \end{macrocode}
% position is also bound to a value list
%    \begin{macrocode}
  position .choices:nn =  {
  		PhD, postDoc, groupLeader, research,
  		nonResearch, student, prof,
  		prof-W2, prof-W3 }
  	{\DTLnewdbentry{\l_@@_database_name_tl}{position}{#1}},
  position / unknown .code:n = {\msg_warning:nnnn { dfg } { invalid-value }{ #1 }{
  			PhD,~ postDoc,~ groupLeader,~ research,~
  			nonResearch,~ student,~ prof,~ prof-W2,~ prof-W3 }},
  positionText .code:n =  \DTLnewdbentry{\l_@@_database_name_tl}{positionText}{#1},
%    \end{macrocode}
% we need to figure out in which funding period the person was active. 
%    \begin{macrocode}
  period .code:n = {
  		\_@@_set_filtered_clist:Nnn \l_@@_person_tmp_period_clist { 1, 2, 3 } {#1}
  		\exp_args:Nnne \DTLnewdbentry{\l_@@_database_name_tl}{period}
                 { \clist_use:N  \l_@@_person_tmp_period_clist }
  	},
%    \end{macrocode}
% The following keys are used for the CV section (additionally |position|).
% We start with |name-alias| which is used to get the author’s name in bold
% letters into the publications list. Write all aliases of the author according
% to their appearence in the |.bib|-file. Encapsulate each with one pair of |{}|.
%    \begin{macrocode}
  name-alias   .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{name-alias}{{#1}},
  orcid        .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{orcid}{#1},
  email        .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{email}{#1},
  phone        .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{phone}{#1},
  url          .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{url}{#1},
  doctorateYear .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{doctorateYear}{#1},
  doctorate    .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{doctorate}{#1},
  degree-programme   .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{degree-programme}{#1},
%    \end{macrocode}
% Following part is for the early career researchers
%    \begin{macrocode}
  financed-by .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{financed-by}{#1},
  topic       .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{topic}{#1},
  category    .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{category}{#1},
  dateDefense .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{dateDefense}{#1},
  periodStart .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{periodStart}{#1},
  periodEnd .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{periodEnd}{#1},
%    \end{macrocode}
% For the PI we need to have information regarding their contract situation.
% Those questions are asked in the Header section of each project.
%    \begin{macrocode}
  contract-information .code:n = { \keys_set:nn { person / contract-information } { #1 } }
}
%    \end{macrocode}
%
% \paragraph{Helper: \cs{person\_questions\_invalid:n}}
% Small private helper used as the |unknown .code:n| handler for every
% boolean choice key in the |contract-information| and
% |project/legal-issues| key families.  It fires |dfg/invalid-value| with
% the allowed set hard-coded to |yes,no|.
%    \begin{macrocode}
\cs_new_protected:Npn \person_questions_invalid:n #1
{ \msg_warning:nnnn { dfg } { invalid-value } {#1} { yes , no } }


\keys_define:nn { person / contract-information }
{
  %--- yes/no questions -----------------------------------------------
  C1 .choices:nn = { yes , no }
  	{ \DTLnewdbentry{\l_@@_database_name_tl}{C1}{#1} },
  C1 / unknown .code:n = { \person_questions_invalid:n {#1} },

  C2 .choices:nn = { yes , no  }
  	{ \DTLnewdbentry{\l_@@_database_name_tl}{C2}{#1} },
  C2 / unknown .code:n = { \person_questions_invalid:n {#1} },

  C3 .choices:nn = { yes , no  }
  	{ \DTLnewdbentry{\l_@@_database_name_tl}{C3}{#1} },
  C3 / unknown .code:n = { \person_questions_invalid:n {#1} },

  C4 .choices:nn = {  yes , no  }
  	{ \DTLnewdbentry{\l_@@_database_name_tl}{C4}{#1} },
  C4 / unknown .code:n = { \person_questions_invalid:n {#1} },

  %--- free-form follow-ups (may be empty) ----------------------------
  C2a .code:n = { \dfg_contract_date:nn {C2a} {#1} },
  C2b .code:n = { \dfg_contract_date:nn {C2b} {#1} },
  C3a .code:n = { \dfg_contract_date:nn {C3a} {#1} },
  C4a .code:n = { \dfg_contract_text:nn {C4a} {#1} },
}

% Date follow-up: allows empty or ISO-8601 (YYYY-MM-DD).
\cs_new_protected:Npn \dfg_contract_date:nn #1#2
{
  \tl_if_blank:nTF {#2}
  { \DTLnewdbentry{\l_@@_database_name_tl}{#1}{} }
  {
  	\dfg_is_iso_date:nTF {#2}
  	{ \DTLnewdbentry{\l_@@_database_name_tl}{#1}{#2} }
  	{
  		\msg_warning:nnnn { dfg } { invalid-date } {#1} {#2}
  		\DTLnewdbentry{\l_@@_database_name_tl}{#1}{#2}
  	}
  }
}

% Plain-text follow-up: allows empty or any string.
\cs_new_protected:Npn \dfg_contract_text:nn #1#2
{
  \DTLnewdbentry{\l_@@_database_name_tl}{#1}{#2}
}

% Format check: YYYY-MM-DD where Y/M/D are digits.
% Doesn't validate calendar correctness (e.g. Feb 30) -- just shape.
\prg_new_protected_conditional:Npnn \dfg_is_iso_date:n #1 { TF , T , F }
{
  \regex_match:nnTF { \A \d{4} - \d{2} - \d{2} \Z } {#1}
  { \prg_return_true: }
  { \prg_return_false: }
}
%    \end{macrocode}
% \paragraph{Keyset \textbf{cv}}
% The |cv| database holds supplementary career information for each PI
% beyond what is already stored in the |person| row.  Multiple entries
% per person are permitted; each entry is identified by |ref-person-id|
% and a \refKey{cv-type} that governs where in the printed CV the item appears.
%
%    \begin{macrocode}
\keys_define:nn { cv }{
  id           .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{id}{#1},
  ref-person-id.code:n = \DTLnewdbentry{\l_@@_database_name_tl}{ref-person-id}{#1},
  cv-type .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{type}{#1},
  cv-type .choices:nn =  {mandatory, supplement,
  		activities, supervision,
  		distinction, other }
  	{\DTLnewdbentry{\l_@@_database_name_tl}{type}{#1}},
  % Backward-compatibility alias for the former misspelling.
  cv-type / distinction .code:n = {			\DTLnewdbentry{\l_@@_database_name_tl}{type}{distinction}},
  cv-type / unknown .code:n = {\msg_warning:nnnn { dfg } { invalid-value }{ #1 }{
  			mandatory,~ supplement,~
  			activities,~  supervision,~
  			distinction,~ other }},
  positionText .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{positionText}{#1},
  position .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{position}{#1},
  ref-institution-id .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{ref-institution-id}{#1},
  description .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{description}{#1},
  periodStart .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{periodStart}{#1},
  periodEnd .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{periodEnd}{#1},
}
%    \end{macrocode}
% \paragraph{Keysets \textbf{affiliation} and \textbf{institution}}
% The template distinguishes between two levels of organisational unit:
%   affiliation: A \emph{university} or equivalent top-level
%     organisation, described by its full name, abbreviation, and postal
%     address.  Referenced from |person| rows via |ref-affiliation-id|.
%   institution: A \emph{department, institute or centre} within an
%     affiliation (e.g.\ |IT Center RWTH Aachen|).  Referenced from |person|
%     rows via |ref-institution-id| and from |affiliation| via
%     |ref-affiliation-id|.
%
% This two-level model allows the same address block to be reused across
% multiple people without duplicating data, and the same university to
% appear under different institute names for different projects.
%    \begin{macrocode}
\keys_define:nn { affiliation }
{
  id               .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{id}{#1},
  id               .value_required:n = true,
  name             .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{name}{#1},
  abbreviation  .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{abbreviation}{#1},
  addressStreet    .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{addressStreet}{#1},
  addressZIP   .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{addressZIP}{#1},
  location         .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{location}{#1},
  country          .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{country}{#1},
}
%    \end{macrocode}
%    \begin{macrocode}
\keys_define:nn { institution }
{
  id        .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{id}{#1},
  id        .value_required:n = true,
  name      .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{name}{#1},
  abbreviation .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{abbreviation}{#1},
  ref-affiliation-id  .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{ref-affiliation-id}{#1},
}

% Resolve the compact reader-facing institution label once.  Older metadata
% without an abbreviation remains usable by falling back to the full name.
\tl_new:N \l_@@_institution_label_field_tl
\cs_new_protected:Npn \@@_institution_abbreviation_or_name:nN #1#2
{
  \tl_clear:N #2
  \tl_set:Nn \l_@@_institution_label_field_tl { abbreviation }
  \datatool_if_has_key:nnTF { institution } { abbreviation }
  {
    \DTLgetvalueforkey{#2}{abbreviation}{institution}{id}{#1}
  }
  { }
  \DTLifnullorempty{#2}
  {
    \tl_set:Nn \l_@@_institution_label_field_tl { name }
    \DTLgetvalueforkey{#2}{name}{institution}{id}{#1}
  }
  { }
}
%    \end{macrocode}
% \paragraph{Keyset \textbf{funding}}
% One |funding| row represents a single requested-funding line item, such
% as one FTE of PhD salary across five years, or a one-off equipment
% purchase.  The same keyset is also used for\emph{existing} and
% \emph{previous} funding entries in the relevant tables.
%
% \textbf{|funding-type|}:
%   \refKey{staff}: Personnel costs.  Activates the restricted |category|
%     validation (only staff-position names are accepted).
%   \refKey{costs}: Direct project costs (consumables, travel, etc.).
%   \refKey{fellowships}: Stipend payments.
%   \refKey{globalfunds}: Funds requested at the CRC level (coordination).
%   \refKey{instrumentation}: Equipment purchases.
%
% \textbf{\refKey{quantity} and \refKey{sum}}: both accept a |funding/year| sub-keyset
% |{year1={n},year2={n},...}|.  The token-list variable
% \cs{l\_funding\_sum\_quantity\_tl} is set to the key name (|quantity| or
% |sum|) before the sub-parse so the |year\meta{n}| handlers can construct
% the correct database field name (|quantity-year1|, |sum-year2|, etc.)
% without extra parameters.
%    \begin{macrocode}
\str_new:N \l_@@_funding_tmp_type_str
\tl_new:N \l_funding_sum_quantity_tl
\clist_const:Nn \c_@@_funding_staff_categories_clist
  { prof, groupLeader, postDoc, medDoc, PhD, research,
    nonResearch, student, assistant }
\keys_define:nn { funding / year }
{
  year1 .code:n =
  	{\DTLnewdbentry{\l_@@_database_name_tl}{\tl_use:N \l_funding_sum_quantity_tl-year1}{#1}},
  year2 .code:n =
  	{\DTLnewdbentry{\l_@@_database_name_tl}{\tl_use:N \l_funding_sum_quantity_tl-year2}{#1}},
  year3 .code:n =
  	{\DTLnewdbentry{\l_@@_database_name_tl}{\tl_use:N \l_funding_sum_quantity_tl-year3}{#1}},
  year4 .code:n =
  	{\DTLnewdbentry{\l_@@_database_name_tl}{\tl_use:N \l_funding_sum_quantity_tl-year4}{#1}},
  year5 .code:n =
  	{\DTLnewdbentry{\l_@@_database_name_tl}{\tl_use:N \l_funding_sum_quantity_tl-year5}{#1}},
}

\keys_define:nn { funding }
{
  id        .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{id}{#1},
  id        .value_required:n = true,
  ref-project-id .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{ref-project-id}{#1},
  ref-affiliation-id .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{ref-affiliation-id}{#1},
  financed-by .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{financed-by}{#1},
  funding-type .choices:nn =  {
  		staff,~ costs,~ fellowships,~ globalfunds,~ instrumentation }
  	{
  		\str_set:Nn \l_@@_funding_tmp_type_str {#1}
  		\DTLnewdbentry{\l_@@_database_name_tl}{type}{#1}
  	},
  funding-type / unknown .code:n = {\msg_warning:nnnn { dfg } { invalid-value }{ #1 }{
  			staff,~ costs,~ fellowships,~ globalfunds,~ instrumentation }},
  funding-type        .value_required:n = true,
  percentage .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{percentage}{#1},
  positionText .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{positionText}{#1},
  quantity .code:n = {
  		\tl_set:Nn \l_funding_sum_quantity_tl {quantity}
  		\keys_set:nn { funding / year  } { #1 }
  	},
  sum .code:n = {
  		\tl_set:Nn \l_funding_sum_quantity_tl {sum}
  		\keys_set:nn { funding / year  } { #1 }
  	},
  category .code:n =
  	{
  		\str_if_eq:VnTF \l_@@_funding_tmp_type_str { staff }
  		{% staff → restricted choices
        \clist_if_in:NnTF \c_@@_funding_staff_categories_clist {#1}
  			{
  				\DTLnewdbentry{\l_@@_database_name_tl}{category}{#1}
  			}
  			{
          \msg_warning:nnne { dfg } { invalid-value }{ #1 }
          { \clist_use:Nn \c_@@_funding_staff_categories_clist {,~} }
  			}
  		}
  		{
  			% non-staff → unrestricted
  			\DTLnewdbentry{\l_@@_database_name_tl}{category}{#1}
  		}
  	},
  % following keys are especially for the previous fundings
  year            .code:n = {\DTLnewdbentry{\l_@@_database_name_tl}{year}{#1}},
  applicant       .code:n = {\DTLnewdbentry{\l_@@_database_name_tl}{applicant}{#1}},
  participant     .code:n = {\DTLnewdbentry{\l_@@_database_name_tl}{participant}{#1}},
  other-funds     .code:n = {\DTLnewdbentry{\l_@@_database_name_tl}{other-funds}{#1}},
  staff           .code:n = {\DTLnewdbentry{\l_@@_database_name_tl}{staff}{#1}},
  costs           .code:n = {\DTLnewdbentry{\l_@@_database_name_tl}{costs}{#1}},
  instrumentation .code:n = {\DTLnewdbentry{\l_@@_database_name_tl}{instrumentation}{#1}},
  fellowships     .code:n = {\DTLnewdbentry{\l_@@_database_name_tl}{fellowships}{#1}},
  globalfunds     .code:n = {\DTLnewdbentry{\l_@@_database_name_tl}{globalfunds}{#1}},
}
%    \end{macrocode}
% A keyset for instrumentation.  The flat |cost| field belongs to the
% informational |existingInstrumentation| list, is expressed in thousands of
% EUR, and is never included in funding totals.  The nested |sum| fields are
% requested-funding amounts expressed in full EUR.
%    \begin{macrocode}
\keys_define:nn { instrumentation }{
  ref-project-id  .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{ref-project-id}{#1},
  quantity        .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{quantity}{#1},
  instrument      .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{instrument}{#1},
  company         .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{company}{#1},
  year            .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{year}{#1},
  cost            .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{cost}{#1},
  financed-by     .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{financed-by}{#1},
  description     .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{description}{#1},
  sum .code:n = {
  		\tl_set:Nn \l_funding_sum_quantity_tl {sum}
  		\keys_set:nn { funding / year  } { #1 }
  	},
}
%    \end{macrocode}
%
% \paragraph{Keyset \textbf{staff}}
% The |staff| key family serves two related personnel data shapes.  Its
% |year1|--|year5| subkeys store the headcount plan per position category for
% \cs{OverviewOfFundsRequestedForStaffTable}.  The flat keys added below store
% the named and unnamed staff roster required by the DFG project template in
% the fixed |RequestedFundingStaff| database.  All keys remain optional at the
% parser level so the older overview declarations continue to work unchanged;
% database-specific validation supplies useful warnings for roster entries.
%
% The \refKey{position} sub-keyset holds named keys for each staff category
% (|postDoc|, |PhD|, |research|, etc.); each key's value is the number of
% FTEs for a specific year.  \cs{l\_staff\_year\_tl} is set to |year1|--|year5|
% before each sub-parse so the handlers can construct the correct field name
% (e.g.\ |postDoc-year2|) without extra parameters.
%    \begin{macrocode}
\tl_new:N \l_staff_year_tl          % will hold “year1”, “year2”, …
\keys_define:nn { staff / position }{
  postDoc      .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{postDoc-\tl_use:N \l_staff_year_tl}{#1},
  PhD          .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{PhD-\tl_use:N \l_staff_year_tl}{#1},
  research     .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{research-\tl_use:N \l_staff_year_tl}{#1},
  nonResearch  .code:n = \DTLnewdbentry{\l_@@_database_name_tl}
  {nonResearch-\tl_use:N \l_staff_year_tl}{#1},
  student      .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{student-\tl_use:N \l_staff_year_tl}{#1},
}

% Category warnings list the currently registered keys, so the diagnostic
% stays in sync with the category-name property list, including extensions.
\seq_new:N \l_@@_diagnostic_keys_seq
\cs_new_protected:Npn \@@_collect_diagnostic_keys:N #1
{
  \seq_clear:N \l_@@_diagnostic_keys_seq
  \prop_map_inline:Nn #1
    { \seq_put_right:Nn \l_@@_diagnostic_keys_seq {##1} }
}
\cs_new_protected:Npn \@@_warn_unknown_name:nnN #1#2#3
{
  \@@_collect_diagnostic_keys:N #3
  \msg_warning:nneee { dfg } { unknown-name } {#1} {#2}
    { \seq_use:Nn \l_@@_diagnostic_keys_seq {,~} }
}
\cs_new_protected:Npn \@@_staff_set_category:n #1
{
  \prop_if_in:NnTF \g_@@_dfg_category_names_prop {#1}
  { \DTLnewdbentry{\l_@@_database_name_tl}{category}{#1} }
  {
    \@@_collect_diagnostic_keys:N \g_@@_dfg_category_names_prop
    \msg_warning:nnne { dfg } { invalid-value } {#1}
      { \seq_use:Nn \l_@@_diagnostic_keys_seq {,~} }
  }
}

\keys_define:nn { staff }{
  unknown .code:n = { \msg_warning:nnn { dfg } { unknown-key } {#1} },
  unknown .default:V = \c_novalue_tl,
  ref-project-id .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{ref-project-id}{#1},
  funding-status .choices:nn = { existing, requested }
  { \DTLnewdbentry{\l_@@_database_name_tl}{funding-status}{#1} },
  funding-status / unknown .code:n =
  { \msg_warning:nnnn { dfg } { invalid-value } {#1} { existing,~requested } },
  staff-type .choices:nn = { research, nonResearch }
  { \DTLnewdbentry{\l_@@_database_name_tl}{staff-type}{#1} },
  staff-type / unknown .code:n =
  { \msg_warning:nnnn { dfg } { invalid-value } {#1} { research,~nonResearch } },
  ref-person-id .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{ref-person-id}{#1},
  firstname .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{firstname}{#1},
  lastname .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{lastname}{#1},
  academic-degree .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{academic-degree}{#1},
  positionText .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{positionText}{#1},
  position .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{positionText}{#1},
  field-of-research .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{field-of-research}{#1},
  ref-institution-id .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{ref-institution-id}{#1},
  ref-affiliation-id .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{ref-affiliation-id}{#1},
  department .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{department}{#1},
  commitment .code:n =
  {
    \regex_match:nnTF { \A \d+ (?: \. \d+ )? \Z }
      {#1}
    { \DTLnewdbentry{\l_@@_database_name_tl}{commitment}{#1} }
    { \msg_warning:nnnn { dfg } { invalid-format } {#1}
      { a~non-negative~integer~or~decimal~using~a~decimal~point,
        ~for~example~0,~10,~or~10.5 } }
  },
  category .code:n = \@@_staff_set_category:n {#1},
  funding-source .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{funding-source}{#1},
  description .code:n =
  \DTLnewdbentry{\l_@@_database_name_tl}{description}{#1},
  year1 .code:n = {
  		\tl_set:Nn \l_staff_year_tl {year1}
  		\keys_set:nn { staff / position  } { #1 }
  	},
  year2 .code:n = {
  		\tl_set:Nn \l_staff_year_tl {year2}
  		\keys_set:nn { staff / position  } { #1 }
  	},
  year3 .code:n = {
  		\tl_set:Nn \l_staff_year_tl {year3}
  		\keys_set:nn { staff / position  } { #1 }
  	},
  year4 .code:n = {
  		\tl_set:Nn \l_staff_year_tl {year4}
  		\keys_set:nn { staff / position  } { #1 }
  	},
  year5 .code:n = {
  		\tl_set:Nn \l_staff_year_tl {year5}
  		\keys_set:nn { staff / position  } { #1 }
  },
}

% Pre-create every roster column once.  Datatool can otherwise report an
% unknown column when an optional key is omitted by every row in the database.
\bool_new:N \g_@@_requested_funding_staff_schema_ready_bool
\cs_new_protected:Npn \@@_requested_funding_staff_ensure_schema:
{
  \bool_if:NF \g_@@_requested_funding_staff_schema_ready_bool
  {
    \clist_map_inline:nn
    {
      ref-project-id, funding-status, staff-type, ref-person-id,
      firstname, lastname, academic-degree, positionText, field-of-research,
      ref-institution-id, ref-affiliation-id, department, commitment, category,
      funding-source, description
    }
    {
      \DTLifhaskey { RequestedFundingStaff } {##1}
      { }
      { \DTLaddcolumn { RequestedFundingStaff } {##1} }
    }
    \bool_gset_true:N \g_@@_requested_funding_staff_schema_ready_bool
  }
}

\tl_new:N \l_@@_requested_funding_staff_validate_project_tl
\tl_new:N \l_@@_requested_funding_staff_validate_status_tl
\tl_new:N \l_@@_requested_funding_staff_validate_type_tl
\tl_new:N \l_@@_requested_funding_staff_validate_person_tl
\tl_new:N \l_@@_requested_funding_staff_validate_lastname_tl
\tl_new:N \l_@@_requested_funding_staff_validate_institution_tl
\keys_define:nn { dfg / requested-funding-staff-validation }
{
