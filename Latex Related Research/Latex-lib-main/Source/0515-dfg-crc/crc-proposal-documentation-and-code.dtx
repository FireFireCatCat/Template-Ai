\prop_new:N \l_@@_inst_to_aff_prop
\prop_new:N \l_@@_inst_name_prop
\prop_new:N \l_@@_inst_seen_prop
\prop_new:N \l_@@_aff_seen_prop
\prop_new:N \l_@@_aff_to_insts_prop  % values are seq names (tl)
\prop_new:N \l_@@_aff_name_prop
\seq_new:N  \l_@@_affiliations_seq
\seq_new:N  \l_@@_aff_sort_seq
\seq_new:N  \l_@@_inst_sort_seq
