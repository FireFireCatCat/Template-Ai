% \subsection{Customisation key family (\texttt{dfg/custom})}
% We provide as much as possible all settings to customize to your desire and
% needs.
% The customization is done with key-values, which we set up below.
%
%    \begin{macrocode}
% Public document text exists before the customization file is read. Keep
% externally supplied definitions (including InfoTeX from the build command).
\providecommand{\dfgLocation}{
  \bool_if:NTF \l_@@_class_fastcompile_bool
    { \textcolor{error}{<Location>} }
    { <Location> }\xspace
}
\providecommand{\dfgDate}{
  \bool_if:NTF \l_@@_class_fastcompile_bool
    { \textcolor{error}{<date>} }
    { <date> }\xspace
}
\providecommand{\dfgTitle}{\enquote{\get[meta]{crc}{name}}\xspace}
\providecommand{\InfoTeX}{LuaLaTeX~ (via~ Overleaf).}
\bool_new:N \l_@@_custom_thumbindex_topmargin_set_bool
\bool_new:N \l_@@_custom_thumbindex_bottommargin_set_bool
\dim_new:N \l_@@_custom_thumbindex_topmargin_dim
\dim_new:N \l_@@_custom_thumbindex_bottommargin_dim
\int_new:N \l_@@_custom_thumbindex_rotation_int
\tl_new:N \l_@@_custom_pi_contact_style_tl
\keys_define:nn { dfg / custom  }
{
  % Assign without expansion; metadata references resolve when printed.
  dfgLocation .code:n = \cs_set:Npn \dfgLocation {#1\xspace},
  dfgDate     .code:n = \cs_set:Npn \dfgDate {#1\xspace},
  dfgTitle    .code:n = \cs_set:Npn \dfgTitle {#1\xspace},
  InfoTeX     .code:n = \cs_set:Npn \InfoTeX {#1},

  % You can pass any font you like (and |fontspec| will understand or is known to
  % your system). But since the DFG is requiring Arial, we set this as default.
  font                       .tl_set:N   = \l_@@_custom_font_tl,
  fontspec                   .tl_set:N   = \l_@@_custom_fontspec_tl,
  font                       .initial:n  = Noto Serif,
  sansfont                   .tl_set:N   = \l_@@_custom_sansfont_tl,
  sansfontspec               .tl_set:N   = \l_@@_custom_sansfontspec_tl,
  sansfont                   .initial:n  = Roboto Light,
  sansfontspec            .initial:n     = {
  		ItalicFont=Roboto-LightItalic,
  		BoldFont=Roboto-Medium,
  		BoldItalicFont=Roboto-Medium-Italic},
  % \paragraph{Logo paths}
  crcLogoPath                 .tl_set:N   = \l_@@_custom_crc_logo_path_tl,
  crcLogoPath                 .initial:n  = example-image-a,
  affiliationLogoPath         .tl_set:N   = \l_@@_custom_affiliation_logo_path_tl,
