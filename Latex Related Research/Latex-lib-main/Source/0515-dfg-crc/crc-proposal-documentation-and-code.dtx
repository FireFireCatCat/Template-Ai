% Cached counting infrastructure:
% A single pass over the |person| database fills a property list with one
% count per (position, gender, phase) triple.  All user-facing commands then
% read from this prop list in O(1) instead of doing a fresh full-table scan
% per call.  This replaces ~100 full database walks per gender table with 1.
%    \begin{macrocode}
\prop_new:N \g_@@_counts_prop
\tl_new:N   \l_@@_count_key_tl
\tl_new:N   \g_@@_count_phase_tl
\tl_new:N   \l_@@_count_db_tl
%    \end{macrocode}
% Keep the cache phase global, like the counts themselves: a nested group
% may switch periods, and subsequent calls must see the matching phase.
% Compute counts for ALL (position, gender) combinations in one pass.
% Stores them in |\g_@@_counts_prop| with key "<position>/<gender>".
% |\dfg_compute_counts:nn {<db>} {<phase>}|.
%    \begin{macrocode}
\cs_new_protected:Npn \dfg_compute_counts:nn #1#2
{
  % Skip if already computed for this (db, phase).
  \tl_set:Nx \l_tmpa_tl { #1 | #2 }
  \tl_if_eq:NNF \l_tmpa_tl \g_@@_count_phase_tl
  {
    \tl_gset:Nx \g_@@_count_phase_tl { #1 | #2 }
  	\prop_gclear:N \g_@@_counts_prop
  	\DTLforeach*[
  		\DTLisinlist{#2}{\pPeriod}
  		\and
  		\DTLisinlist{PI}{\pRole}
  	]{#1}{
  		\pPosition = position,
  		\pGender   = gender,
  		\pPeriod   = period,
  		\pRole     = role
  	}{
  		\tl_set:Nx \l_@@_count_key_tl { \pPosition | \pGender }
  		\prop_get:NVNTF \g_@@_counts_prop \l_@@_count_key_tl \l_tmpb_tl
  		{
  			\int_set:Nn \l_@@_count_int { \l_tmpb_tl + 1 }
  			\prop_gput:NVx \g_@@_counts_prop \l_@@_count_key_tl
  			{ \int_use:N \l_@@_count_int }
  		}
  		{
  			\prop_gput:NVn \g_@@_counts_prop \l_@@_count_key_tl { 1 }
  		}
  	}
  }
}
% O(1) lookup. Returns 0 for unknown keys.
% \dfg_count_lookup:nn {<position>} {<gender>}  -> integer literal
\cs_new:Npn \dfg_count_lookup:nn #1#2
{
  \prop_if_in:NnTF \g_@@_counts_prop { #1 | #2 }
  { \prop_item:Nn \g_@@_counts_prop { #1 | #2 } }
  { 0 }
}

% Set <int> to count for (position, gender) — uses cache.
% \dfg_count_position_set:Nnnnn <int> {<db>} {<position>} {<gender>} {<phase>}
\cs_new_protected:Npn \dfg_count_position_set:Nnnnn #1#2#3#4#5
{
  \prop_if_in:NnTF \g_@@_dfg_position_names_prop {#3}
  {
  	\dfg_compute_counts:nn {#2} {#5}
  	\int_set:Nn #1 { \dfg_count_lookup:nn {#3} {#4} }
  }
  {
  	\textcolor{error}{mismatch:~#3}
    \@@_warn_unknown_name:nnN {staff~position~for~counts} {#3}
      \g_@@_dfg_position_names_prop
  }
}

% Sum across all genders for one position.
% \dfg_total_position_set:Nnnn <int> {<db>} {<position>} {<phase>}
\cs_new_protected:Npn \dfg_total_position_set:Nnnn #1#2#3#4
{
  \dfg_compute_counts:nn {#2} {#4}
  \int_set:Nn #1
  {
  	\dfg_count_lookup:nn {#3} {f}
  	+ \dfg_count_lookup:nn {#3} {m}
  	+ \dfg_count_lookup:nn {#3} {d}
  }
}

% Sum across all positions for one gender.
% \dfg_total_gender_set:Nnnn <int> {<db>} {<gender>} {<phase>}
\cs_new_protected:Npn \dfg_total_gender_set:Nnnn #1#2#3#4
{
  \dfg_compute_counts:nn {#2} {#4}
  \int_set:Nn #1
  {
  	\dfg_count_lookup:nn {postDoc}     {#3}
  	+ \dfg_count_lookup:nn {groupLeader} {#3}
  	+ \dfg_count_lookup:nn {prof-W2}    {#3}
  	+ \dfg_count_lookup:nn {prof-W3}    {#3}
  }
}

% Grand total across all positions and genders.
% \dfg_total_position_gender_set:Nnn <int> {<db>} {<phase>}
\cs_new_protected:Npn \dfg_total_position_gender_set:Nnn #1#2#3
{
  \dfg_compute_counts:nn {#2} {#3}
  \int_zero:N #1
  \clist_map_inline:nn {postDoc, groupLeader, prof-W2, prof-W3}
  {
  	\clist_map_inline:nn { f , m , d }
  	{
  		\int_add:Nn #1 { \dfg_count_lookup:nn {##1} {####1} }
  	}
  }
}
%    \end{macrocode}
% You can get the count of PIs of a certain position, gender and funding phase. 
%    \begin{macrocode}
\NewDocumentCommand{\getPositionGenderPhaseAmount}{ O{person} m m m }
{
  % #1: database
  % #2: position
  % #3: gender
  % #4: phase
  \dfg_count_position_set:Nnnnn \l_@@_tmp_int {#1} {#2} {#3} {#4}
  \dfgShowCalculatedTag{getPositionGenderPhaseAmount}{#1}
    { \int_use:N \l_@@_tmp_int }
}
%    \end{macrocode}
% This command sums up a certain gender column based on a funding phase. 
%    \begin{macrocode}
\NewDocumentCommand{\getPositionPhaseTotal}{ O{person} m m }
{
  % #1: database
  % #2: position
  % #3: phase

  \dfg_total_position_set:Nnnn \l_@@_total_int {#1} {#2} {#3}

  % no macro supplied → print the total
  \dfgShowCalculatedTag{getPositionPhaseTotal}{#1}
    { \int_use:N \l_@@_total_int }
}
%    \end{macrocode}
