\begin{docKeys}[doc parameter={=\meta{euros per animal and week}}]{
  {doc name=animalHousing@mouse,
   doc description=initially \texttt{0.75}},
  {doc name=animalHousing@mouseGnotobiotic,
   doc description=initially \texttt{3.9}},
