%    \end{macrocode}
% \subsection{Gantt chart rendering}
%
% The Gantt chart for each project is assembled in two steps:
% \begin{enumerate}
%   \item \cs{dfgGanttContent}\marg{project}: iterates over the
%         |gantt-\meta{project}| database and generates one
%         |\ganttbar| call per row.  Rows where |periodStart = periodEnd|
%         are silently skipped.  Row breaks precede each visible bar after
%         the first, so skipped rows and the last bar add no blank bottom row.
%         The bar style is dispatched via
%         \cs{str\_case:VnF}: |crosshatch| uses a pgfgantt pattern fill;
%         |striped| overlays two colours at 45° with \cs{postaction}, using
%         an explicitly coloured PDF pattern for consistent viewer rendering;
%         |alternative| and |important| use flat fills; the default is
%         a solid |color@gantt@default| bar.
%   \item \cs{dfgGanttEnvironment}\marg{project}: wraps the content in a
%         |pgfgantt| |ganttchart| environment spanning 16 columns (quarters
%         Q3 of year 0 through Q2 of year 5, matching the standard DFG
%         5-year period).  The chart is scaled with \cs{resizebox} to fill
%         the full text width.  A 0.9-row bar with no top shift leaves a
%         narrow gap between the final bar and the bottom rule.
% \end{enumerate}
%
% \cs{printPlot}|{{Gantt}{|\meta{project}|}}| is the preferred user-facing
% command; \cs{printGantt} remains a compatibility alias.  The dispatcher
% calls \cs{GanttPlot}, which wraps the chart in an |hvfloat| figure with an
% appropriate caption.  Both \cs{hvFloat} calls put the caption below the
% chart; the second one appends optional extra text.  Both variants use the
% strict |h| position so the chart remains directly after the work
% packages; the following \cs{FloatBarrier} closes that project-plan block.
%
% \textbf{Quarter numbering:} columns 1--2 correspond to Q3--Q4 of the
% calendar year preceding the funding start; columns 3--16 are Q1--Q4 of
% years 1--4; the final 16th column is Q1--Q2 of year 5.  Bar start/end
% values in the Gantt database should use these numbers directly.
%    \begin{macrocode}
% Store the stripe colour inside the PDF pattern. Some renderers paint
% stroked, uncoloured patterns black even when their fill colour is set.
% Include the resolved model and components in the pattern cache key, so
% per-chart colour changes produce a new pattern instead of reusing one.
\tl_new:N \l_@@_gantt_stripe_color_model_tl
\tl_new:N \l_@@_gantt_stripe_color_spec_tl
\pgfdeclarepattern{
  name = dfg~gantt~stripes,
  type = colored,
  parameters = {
    \l_@@_gantt_stripe_color_model_tl,
    \l_@@_gantt_stripe_color_spec_tl
  },
  bottom~left = {\pgfpoint{-6pt}{-6pt}},
  top~right = {\pgfpoint{6pt}{6pt}},
  tile~size = {\pgfpoint{12pt}{12pt}},
  tile~transformation = {\pgftransformrotate{45}},
  code = {
    \pgfsetstrokecolor{dfgGanttStripeColor}
    \pgfsetlinewidth{6pt}
    \pgfpathmoveto{\pgfpoint{-6pt}{0pt}}
    \pgfpathlineto{\pgfpoint{6pt}{0pt}}
    \pgfusepath{stroke}
  },
}
\bool_new:N \l_@@_gantt_first_bar_bool
\NewDocumentCommand{\dfgGanttContent}{m}{%
  % Resolve the active colour model before extracting the cache parameters.
  \colorlet{dfgGanttStripeColor}{color@gantt@stripe-two}
  \extractcolorspecs{dfgGanttStripeColor}
    {\l_@@_gantt_stripe_color_model_tl}{\l_@@_gantt_stripe_color_spec_tl}
  \bool_set_true:N \l_@@_gantt_first_bar_bool
  \DTLforeach*{gantt-#1}{%
  	\ganttWP=id,%
  	\ganttName=name,%
  	\ganttDescription=description,%
  	\ganttPeriodStart=periodStart,%
  	\ganttPeriodEnd=periodEnd,%
  	\ganttPatternbar=style%
  }{\hypersetup{linkcolor=black}%
  	% If we want to omit a bar in the plot,
  	% you need to set periodStart and periodEnd
  	% the same value.
  	\ifdefstrequal{\ganttPeriodStart}{\ganttPeriodEnd}{}{%
  		% if the values are different then there will be a bar.
		\bool_if:NTF \l_@@_gantt_first_bar_bool
		  { \bool_set_false:N \l_@@_gantt_first_bar_bool }
		  { \ganttnewline }
		\def\ganttBarPlot{
			\sffamily
			\dfgShowTag{\ganttWP}{id}{\getWP{\ganttWP}}[gantt-#1]
			\ifdefempty{\ganttDescription}{}
			  {:~\dfgShowTag{\ganttWP}{description}{\ganttDescription}[gantt-#1]}}

  		\str_case:VnF {\ganttPatternbar}
  		{%
  			{crosshatch}{\ganttbar[bar/.append~ style = {%
  							pattern       = {crosshatch},
  							pattern~ color = {color@gantt@crosshatch},
  							draw           = {color@gantt@frame}
  						}]{\ganttBarPlot}{\ganttPeriodStart}{\ganttPeriodEnd}}%

  			{striped}{\ganttbar[bar/.append~ style = {%
  							fill          = {color@gantt@stripe-one},
  							% the pattern needs to be applied after the filled color
              postaction    ={pattern={dfg~gantt~stripes}},
  							postaction    = {draw, semithick},
  							draw          = {color@gantt@frame}
  						}]{\ganttBarPlot}{\ganttPeriodStart}{\ganttPeriodEnd}}%

  			{alternative}{\ganttbar[bar/.append~ style = {%
  							fill          = {color@gantt@alternative},
  							draw          = {color@gantt@frame}
  						}]{\ganttBarPlot}{\ganttPeriodStart}{\ganttPeriodEnd}}%

  			{important}{\ganttbar[bar/.append~ style = {%
  							fill          = {color@gantt@important},
  							draw          = {color@gantt@frame}
  						}]{\ganttBarPlot}{\ganttPeriodStart}{\ganttPeriodEnd}}%
  		}
  		{ % default
  			{}{\ganttbar[bar/.append~ style = {%
  							fill          = {color@gantt@default},
  							draw          = {color@gantt@frame}
  						}]{\ganttBarPlot}{\ganttPeriodStart}{\ganttPeriodEnd}}%
  		}
		}%
  	\hypersetup{linkcolor=blue}}
}
