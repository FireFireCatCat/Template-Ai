% \subsection{Shared research-project example}
% Each compact project file supplies its own ID and status to this reusable
% example body. All project leaders and affiliations come from shared metadata.
%    \begin{macrocode}
\providecommand{\dfgExampleResearchProject}[2]{%
  \printProjectHead{#1}
  \section{Summary}
  This project investigates \getEntry[project]{#1}{name}. Its project leaders
  combine experimental and analytical approaches within the shared research
  programme of \thisCRC.
  \ifstrequal{#2}{C}{%
    \section{Project progress to date}
    The preceding funding period established the experimental models and
    shared datasets. The next phase tests causal mechanisms and validates
    their relevance across the participating projects.
  }{%
    \section{Research rationale}
    Preliminary observations motivate a new testable hypothesis. The project
    establishes its experimental framework and independent validation strategy
    during the requested funding period.
  }
  \projectPublicationsHeading
  \projectNocite{FAIR2016}
  \printProjectBibliography[heading=none]
  \section{Project plan}
  \begin{aims}
    \addAim{1} Establish reproducible experimental and analytical workflows.
    \addAim{2} Validate the findings in complementary models and datasets.
  \end{aims}
  \begin{workpackages}
    \addWP{wp1}{
      name = {Experimental framework},
      description = {Establish models, controls, and quality criteria},
      periodStart = {1}, periodEnd = {7}, style = {default}
    }
    Define the controls, sampling strategy, and analysis workflow for \getAim{1}.
    \addWP{wp2}{
      name = {Validation and integration},
      description = {Validate results and integrate consortium datasets},
      periodStart = {6}, periodEnd = {16}, style = {important}
    }
    Test robustness and share the validated results for \getAim{2}.
  \end{workpackages}
  \printPlot{{Gantt}{#1}}
  \section{Relevance of sex, gender and/or diversity in the research project}
  Include relevant biological variables in sampling and analysis; document
  the rationale for each model and the limits of generalisation.
  \section{Role within the Collaborative Research Centre}
  Share methods, data, and validation resources with the linked projects.
  \printPlot{{ProjectCollaboration}{#1}}
  \section{Differentiation from other funded projects}
  The proposed work addresses the CRC-specific hypothesis and does not
  duplicate personnel or experiments supported by other grants.
  \section{Project funding}
  \addEntry[funding]{RequestedFunding}{
    ref-project-id = {#1}, funding-type = {staff}, category = {PhD},
    percentage = {65},
    quantity = {year1=1,year2=1,year3=1,year4=1,year5=1}
  }
  \addEntry[funding]{RequestedFunding}{
    ref-project-id = {#1}, funding-type = {costs}, category = {consumables},
    sum = {year1=1000,year2=2000,year3=2000,year4=2000,year5=1000}
  }
  \printTable{{RequestedFunding}{#1}}
  The doctoral researcher performs the experiments and integrates the data.
  Consumables cover sample preparation, assays, and independent validation.
  \printProjectTail
}
