% In final documents, \pkg{biblatex-ext-oa} can mark open-access publications
% directly in the bibliography.  Draft documents do not load the package, so
% they avoid DOI API checks and related warnings.  The DOI API backend is useful,
% but \pkg{biblatex-ext-oa-doiapi} and the |doiapi| option can only be used with
% LuaLaTeX.  With LuaTeX binaries from version 1.17.0 onwards, the LuaSocket
% module |socket.http| is exposed only when LuaTeX is started with the
% command-line option |--socket|.  If we always passed |doiapi=true| in final
% mode, a normal final compile without |--socket| would abort while loading
% \pkg{biblatex-ext-oa-doiapi}.
%
% After a user opts in with a contact address, the guard asks LuaTeX whether
% |require("socket.http")| succeeds.  The result is written back into the
% temporary expl3 string |\l_tmpa_str| as the literal text |true| or |false|.
% The Lua code is written without TeX-relevant whitespace, because expl3
% ignores spaces while tokenising this part of the class source; semicolons
% keep the Lua syntax unambiguous after docstrip has generated the |.cls| file.
%
% Automatic lookup is enabled only when LuaSocket is available and the user has
% supplied a non-empty \refKey{doiAPIMail}.  The address is passed to
% \cs{SetDOIAPIMail}; the class never sends a placeholder or maintainer address
% on behalf of its users.  If either prerequisite is missing, the class emits a
% specific warning and loads \pkg{biblatex-ext-oa} with |doiapi=false| so manual
% BibTeX annotations such as |doi+an:default = {=openaccess}| continue to work.
%
% The TikZ symbol package draws the open-access symbols.  The |oanet| symbol is
% the open-access symbol from open-access.net (https://open-access.net/), logo
% by Medien + Design, Center for Digital Systems, Competence Center for
% E-Learning and Multimedia, Freie Universität Berlin, CC BY 4.0
% (https://creativecommons.org/licenses/by/4.0/).
%    \begin{macrocode}
\cs_new_protected:Npn \@@_biblatex_oa_load_without_api:
  {
    \RequirePackage[
      doiapi=false,
      symbolpackage=tikz,
      symbol=oanet]{biblatex-ext-oa}
  }

\bool_if:NT \l_@@_class_final_bool
  {
    \tl_if_blank:VTF \l_@@_custom_doi_api_mail_tl
      {
        \msg_info:nn { dfg } { biblatex-ext-oa-doiapi-email-missing }
        \@@_biblatex_oa_load_without_api:
      }
      {
        \str_set:Nx \l_tmpa_str
          {
            \directlua
              {if(pcall(require,"socket.http"))then;tex.sprint("true");else;tex.sprint("false");end}
          }
        \str_if_eq:VnTF \l_tmpa_str { true }
          {
            \RequirePackage[
              doiapi=true,
              symbolpackage=tikz,
              symbol=oanet]{biblatex-ext-oa}
            \ExecuteBibliographyOptions{openaccess=doiapi}
            \exp_args:NV \SetDOIAPIMail \l_@@_custom_doi_api_mail_tl
          }
          {
            \msg_warning:nn { dfg } { biblatex-ext-oa-doiapi-unavailable }
            \@@_biblatex_oa_load_without_api:
          }
      }
  }
% A project-text build with publication processing disabled must not require a
% matching biber run merely to keep inline source references readable.  Replace
% the common single-citation commands with quiet key markers; enabling
% |fastcompile-project-show-publications| restores biblatex's normal commands unchanged.
\bool_if:nTF
  {
    \l_@@_class_fastcompile_project_bool
    && ! \l_@@_class_fastcompile_project_show_publications_bool
  }
  {
    % Do not register bibliography data sources or parse a stale full-build
    % .bbl.  Keep biblatex's ordinary initialisation and refsection setup, but
    % replace its data-file stage with the minimum empty-section state.
    \cs_set_protected:Npn \blx@bblfile
      {
        \blx@secinit
        \blx@generate@bbl@mdfivesum@notfound
        \global\togglefalse{blx@bbldone}
        \csnumgdef{blx@labelnumber@\the\c@refsection}{0}
      }
    \NewDocumentCommand{\dfgFastCitation}{m}
      { {\color{black-50}\scriptsize\ttfamily [#1]} }
    \RenewDocumentCommand{\autocite}{s o o m}
      { \dfgFastCitation{#4} }
    \RenewDocumentCommand{\cite}{s o o m}
      { \dfgFastCitation{#4} }
    \RenewDocumentCommand{\parencite}{s o o m}
      { \dfgFastCitation{#4} }
    \RenewDocumentCommand{\textcite}{s o o m}
      { \dfgFastCitation{#4} }
    \RenewDocumentCommand{\footcite}{s o o m}
      { \dfgFastCitation{#4} }
    \RenewDocumentCommand{\smartcite}{s o o m}
      { \dfgFastCitation{#4} }
    \RenewDocumentCommand{\nocite}{m} { }
    % Ignore citation requests restored from auxiliary files produced by a full
    % proposal build.  The fast source commands above do not write replacements.
    \cs_set_protected:Npn \abx@aux@cite   #1#2   { }
    \cs_set_protected:Npn \abx@aux@segm   #1#2#3 { }
    \cs_set_protected:Npn \abx@aux@nocite #1#2   { }
    % This mode deliberately has no bibliography work, so do not advertise a
    % biber rerun in the end-of-document logreq record.
    \AtEndDocument
    {
      \global\let\blx@rerun@biber\relax
      \global\togglefalse{blx@runbiber}
    }
  }
  {
    \bool_if:NF \l_@@_class_documentation_bool
    {
    \addbibresource{bib/dfg-base.bib}
    % The conversion workflow stores bibliography entries that still need
    % review separately.  Load that file when present without requiring it for
    % normal template installations.
    \IfFileExists{bib/conversion-missing.bib}
      {\addbibresource{bib/conversion-missing.bib}}
      {}
    \addbibresource{bib/dfg-strings.bib}
    }
  }
%    \end{macrocode}
% The \cs{AtEveryBibitem} hook strips fields that are irrelevant for a
% funding proposal (URL, month, note, ISSN/ISBN, language) from every
% entry, keeping the reference list compact.  These fields are cleared
% during output only; the |.bib| source files are unchanged.
% A second part of the hook selects the full-entry bold face. The frame and
% project bibliography wrappers set a local keyword only while printing
% their list; biblatex groups each item, so the font change does not leak into the
% following entry.  The hook runs after \cs{bibfont} and before the entry's
% fields are printed.
%    \begin{macrocode}
\tl_new:N \l_@@_bibentry_highlight_keyword_tl
\AtEveryBibitem{
  \clearfield{url}
  \clearfield{month}
  \clearfield{note}
  \clearfield{issn}
  \clearfield{isbn}
  \clearlist{language}
  \tl_if_empty:NF \l_@@_bibentry_highlight_keyword_tl
  {
    \exp_args:NV \ifkeyword \l_@@_bibentry_highlight_keyword_tl
      {\bfseries}{}
  }}
%    \end{macrocode}
% \subsection{Shared authorship annotations}
%
% The |annote| field in |.bib| entries supports two special values:
% |equal| (for equal-first-author contributions) and |sharedlast| (for
% shared last authorship).  When present, \cs{mkbibnamefamily} appends
% an asterisk |*| after the family name via \cs{addendumasterisk}.
% The asterisk is only printed inside bibliography environments
% (\cs{ifbibliography}), not in inline citations.
%
% Use in |.bib|: add |addendum = equal| or |addendum = sharedlast| (no |{}|) to the affected author's annotation field.
%    \begin{macrocode}
\newcommand{\addendumasterisk}{\ifbibliography{*}{}}
\newcommand{\addendumhashtag}{\ifbibliography{\textsuperscript{\#}{}}}
% There is also the possibility that authors share the last authorship.
% with the bib-string `lastShared` we can get it work.
\renewcommand*{\mkbibnamefamily}[1]{%
  \ifitemannotation{equal} % first check for equal contribution
  {#1\addendumasterisk}% add a * for those authors
  {
  	% Then we check for "shared last authorship"
  	\ifitemannotation{sharedlast}%
  	{#1\addendumhashtag}% adding a symbol
  	{#1}% do nothing for any one else.
  }}
%    \end{macrocode}
%
%  \begin{macrocode}
