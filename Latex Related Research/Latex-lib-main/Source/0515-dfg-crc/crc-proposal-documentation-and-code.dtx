\cs_new_protected:Npn \@@_rfs_make_name_cell:
{
  \bool_set_false:N \l_@@_rfs_name_incomplete_bool
  \str_if_eq:VnTF \l_@@_rfs_lastname_tl { TBA }
  {
    \tl_set:Nn \l_@@_rfs_plain_name_tl { TBA }
    \tl_set:Nn \l_@@_rfs_description_name_tl { TBA }
    \tl_set:Nn \l_tmpa_tl { TBA }
  }
  {
    \tl_if_blank:VT \l_@@_rfs_lastname_tl
    {
      \@@_rfs_warn_missing:n { lastname~or~resolvable~ref-person-id }
      \tl_set:Nn \l_@@_rfs_lastname_tl
      {
        \bool_if:NTF \l_@@_class_fastcompile_bool
          { \@@_rfs_error_text:n {lastname} }
          { \@@_rfs_error_text:n {name} }
      }
      \bool_set_true:N \l_@@_rfs_name_incomplete_bool
    }
    \tl_if_blank:VT \l_@@_rfs_firstname_tl
    {
      \@@_rfs_warn_missing:n { firstname }
      \tl_set:Nn \l_@@_rfs_firstname_tl { \@@_rfs_missing_text:n {firstname} }
      \bool_set_true:N \l_@@_rfs_name_incomplete_bool
    }
    \tl_set:Ne \l_@@_rfs_plain_name_tl
      {
        \exp_not:V \l_@@_rfs_lastname_tl,\exp_not:N \space
        \exp_not:V \l_@@_rfs_firstname_tl
      }
    \tl_clear:N \l_@@_rfs_description_name_tl
    \tl_if_blank:VF \l_@@_rfs_degree_tl
      {
        \tl_put_right:Ne \l_@@_rfs_description_name_tl
          { \exp_not:V \l_@@_rfs_degree_tl \exp_not:N \space }
      }
    \tl_put_right:Ne \l_@@_rfs_description_name_tl
    {
      \exp_not:V \l_@@_rfs_firstname_tl \exp_not:N \space
      \exp_not:V \l_@@_rfs_lastname_tl
    }
    \tl_set:NV \l_tmpa_tl \l_@@_rfs_plain_name_tl
    \tl_if_blank:VF \l_@@_rfs_degree_tl
    {
      \tl_put_right:Ne \l_tmpa_tl
        { ,\exp_not:N \space \exp_not:V \l_@@_rfs_degree_tl }
    }
    \bool_if:NT \l_@@_rfs_person_resolved_bool
    {
      \str_if_eq:VnT \l_@@_rfs_funding_status_tl { existing }
      {
        \tl_set:Ne \l_tmpa_tl
        {
          \exp_not:N \textbf { \exp_not:V \l_@@_rfs_lastname_tl },
          \exp_not:N \space \exp_not:V \l_@@_rfs_firstname_tl
        }
        \tl_if_blank:VF \l_@@_rfs_degree_tl
        {
          \tl_put_right:Ne \l_tmpa_tl
            { ,\exp_not:N \space \exp_not:V \l_@@_rfs_degree_tl }
        }
      }
    }
  }
  \tl_if_blank:VF \l_@@_rfs_position_tl
  {
    \tl_put_right:Ne \l_tmpa_tl
    {
      \exp_not:N \newline
      (\exp_not:V \l_@@_rfs_position_tl)
    }
  }
  \bool_if:NF \l_@@_rfs_person_resolved_bool
  {
    \tl_if_blank:VF \l_@@_rfs_ref_person_tl
    {
      \bool_set_true:N \l_@@_rfs_name_incomplete_bool
      \tl_put_right:Ne \l_tmpa_tl
      {
        \exp_not:N \space
        \exp_not:N \@@_rfs_error_text:n
          { \exp_not:V \l_@@_rfs_ref_person_tl }
      }
    }
  }
  \tl_clear:N \l_@@_rfs_name_cell_tl
  \bool_if:NT \l_@@_rfs_name_incomplete_bool
  { \tl_put_right:Nn \l_@@_rfs_name_cell_tl { \SetCell{bg=tableNoValue} } }
  \bool_if:NTF \l_@@_rfs_person_resolved_bool
  {
    \tl_put_right:Ne \l_@@_rfs_name_cell_tl
    {
      \exp_not:N \hyperlink { pi:\exp_not:V \l_@@_rfs_ref_person_tl }
      {
        \exp_not:N \textcolor { referencePI }
        {
          \exp_not:N \dfgShowCalculatedTag{RequestedFundingStaffTable}
            {RequestedFundingStaff,person}
            {\exp_not:V \l_tmpa_tl}
        }
      }
    }
  }
  {
    \tl_put_right:Ne \l_@@_rfs_name_cell_tl
    {
      \exp_not:N \dfgShowCalculatedTag{RequestedFundingStaffTable}
        {RequestedFundingStaff,person}
        {\exp_not:V \l_tmpa_tl}
    }
  }
}

\cs_new_protected:Npn \@@_rfs_render_row:nnnN #1#2#3#4
