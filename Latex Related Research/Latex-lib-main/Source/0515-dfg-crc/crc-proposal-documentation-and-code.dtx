\cs_new_protected:Npn \@@_oes_resolve_person_fallbacks:
{
  \tl_if_blank:VF \l_@@_oes_person_tl
  {
    \DTLifdbexists{person}
    {
      \DTLgetvalueforkey{\l_tmpa_tl}{id}{person}{id}
        {\l_@@_oes_person_tl}
      \DTLifnullorempty{\l_tmpa_tl}
      {
        \msg_warning:nnee { dfg } { requested-staff-unresolved-person }
          { \pOESProject } { \l_@@_oes_person_tl }
      }
      {
        \tl_if_blank:VT \l_@@_oes_category_tl
        {
          \DTLgetvalueforkey{\l_tmpa_tl}{position}{person}{id}
            {\l_@@_oes_person_tl}
          \DTLifnullorempty{\l_tmpa_tl}
            { }
            { \tl_set:NV \l_@@_oes_category_tl \l_tmpa_tl }
        }
        \bool_lazy_all:nT
        {
          { \tl_if_blank_p:V \l_@@_oes_institutions_tl }
          { \tl_if_blank_p:V \l_@@_oes_affiliation_tl }
        }
        {
          \DTLgetvalueforkey{\l_tmpa_tl}{ref-institution-id}{person}{id}
            {\l_@@_oes_person_tl}
          \DTLifnullorempty{\l_tmpa_tl}
            { }
            { \tl_set:NV \l_@@_oes_institutions_tl \l_tmpa_tl }
          \tl_if_blank:VT \l_@@_oes_institutions_tl
          {
            \DTLgetvalueforkey{\l_tmpa_tl}{ref-affiliation-id}{person}{id}
              {\l_@@_oes_person_tl}
            \DTLifnullorempty{\l_tmpa_tl}
              { }
              { \tl_set:NV \l_@@_oes_affiliation_tl \l_tmpa_tl }
          }
        }
      }
    }
    {
      \msg_warning:nnee { dfg } { requested-staff-unresolved-person }
        { \pOESProject } { \l_@@_oes_person_tl }
    }
  }
}

\cs_new_protected:Npn \@@_oes_register_affiliation:n #1
{
  \tl_set:Ne \l_@@_oes_registered_affiliation_tl {#1}
  \tl_trim_spaces:N \l_@@_oes_registered_affiliation_tl
  \tl_if_blank:VF \l_@@_oes_registered_affiliation_tl
  {
    \seq_if_in:NVF \l_@@_oes_affiliation_seq
      \l_@@_oes_registered_affiliation_tl
    {
      \tl_clear:N \l_@@_oes_affiliation_name_tl
      \tl_clear:N \l_@@_oes_affiliation_abbreviation_tl
      \DTLifdbexists{affiliation}
      {
        \DTLgetvalueforkey{\l_@@_oes_affiliation_name_tl}
          {name}{affiliation}{id}{\l_@@_oes_registered_affiliation_tl}
        \DTLifnullorempty{\l_@@_oes_affiliation_name_tl}
        {
          \msg_warning:nnee { dfg } { requested-staff-unresolved-affiliation }
            { OverviewExistingStaff }
            { \l_@@_oes_registered_affiliation_tl }
          \tl_set:NV \l_@@_oes_affiliation_name_tl
            \l_@@_oes_registered_affiliation_tl
          \tl_set:NV \l_@@_oes_affiliation_abbreviation_tl
            \l_@@_oes_registered_affiliation_tl
        }
        {
          \DTLgetvalueforkey{\l_@@_oes_affiliation_abbreviation_tl}
            {abbreviation}{affiliation}{id}
            {\l_@@_oes_registered_affiliation_tl}
          \DTLifnullorempty{\l_@@_oes_affiliation_abbreviation_tl}
          {
            \msg_warning:nne { dfg } { requested-staff-missing-abbreviation }
              { \l_@@_oes_registered_affiliation_tl }
            \tl_set:NV \l_@@_oes_affiliation_abbreviation_tl
              \l_@@_oes_affiliation_name_tl
          }
          { }
        }
      }
      {
        \msg_warning:nnee { dfg } { requested-staff-unresolved-affiliation }
          { OverviewExistingStaff }
          { \l_@@_oes_registered_affiliation_tl }
        \tl_set:NV \l_@@_oes_affiliation_name_tl
          \l_@@_oes_registered_affiliation_tl
        \tl_set:NV \l_@@_oes_affiliation_abbreviation_tl
          \l_@@_oes_registered_affiliation_tl
      }
      \seq_put_right:NV \l_@@_oes_affiliation_seq
        \l_@@_oes_registered_affiliation_tl
      \prop_put:NVV \l_@@_oes_affiliation_name_prop
        \l_@@_oes_registered_affiliation_tl \l_@@_oes_affiliation_name_tl
      \prop_put:NVV \l_@@_oes_affiliation_abbreviation_prop
        \l_@@_oes_registered_affiliation_tl
        \l_@@_oes_affiliation_abbreviation_tl
    }
  }
}

\cs_new_protected:Npn \@@_oes_count_affiliation:n #1
{
  \tl_set:Ne \l_@@_oes_candidate_affiliation_tl {#1}
  \tl_trim_spaces:N \l_@@_oes_candidate_affiliation_tl
  \tl_if_blank:VF \l_@@_oes_candidate_affiliation_tl
  {
    \prop_if_in:NVF \l_@@_oes_row_affiliation_seen_prop
      \l_@@_oes_candidate_affiliation_tl
    {
      \prop_put:NVn \l_@@_oes_row_affiliation_seen_prop
        \l_@@_oes_candidate_affiliation_tl {1}
      \@@_oes_register_affiliation:n
        { \l_@@_oes_candidate_affiliation_tl }
      \tl_set:Nx \l_tmpb_tl
        { \l_@@_oes_category_tl / \l_@@_oes_candidate_affiliation_tl }
      \prop_get:NVNTF \l_@@_oes_count_prop \l_tmpb_tl \l_tmpc_tl
      { \int_set:Nn \l_tmpa_int { \l_tmpc_tl + 1 } }
      { \int_set:Nn \l_tmpa_int { 1 } }
      \prop_put:NVx \l_@@_oes_count_prop \l_tmpb_tl
        { \int_use:N \l_tmpa_int }
    }
  }
}

\cs_new_protected:Npn \@@_oes_collect_current:
{
  \DTLifnullorempty{\pOESPerson}
    { \tl_clear:N \l_@@_oes_person_tl }
    { \tl_set:Ne \l_@@_oes_person_tl {\pOESPerson} }
  \DTLifnullorempty{\pOESCategory}
    { \tl_clear:N \l_@@_oes_category_tl }
    { \tl_set:Ne \l_@@_oes_category_tl {\pOESCategory} }
  \DTLifnullorempty{\pOESInstitutions}
    { \tl_clear:N \l_@@_oes_institutions_tl }
    { \tl_set:Ne \l_@@_oes_institutions_tl {\pOESInstitutions} }
  \DTLifnullorempty{\pOESAffiliation}
    { \tl_clear:N \l_@@_oes_affiliation_tl }
    { \tl_set:Ne \l_@@_oes_affiliation_tl {\pOESAffiliation} }
  \@@_oes_resolve_person_fallbacks:
  \str_case:VnF \l_@@_oes_category_tl
  {
    { prof }        { \tl_set:Nn \l_@@_oes_category_tl { prof } }
    { prof-W2 }     { \tl_set:Nn \l_@@_oes_category_tl { prof } }
    { prof-W3 }     { \tl_set:Nn \l_@@_oes_category_tl { prof } }
    { groupLeader } { \tl_set:Nn \l_@@_oes_category_tl { groupLeader } }
    { postDoc }     { \tl_set:Nn \l_@@_oes_category_tl { postDoc } }
    { PhD }         { \tl_set:Nn \l_@@_oes_category_tl { PhD } }
    { medDoc }      { \tl_set:Nn \l_@@_oes_category_tl { research } }
    { research }    { \tl_set:Nn \l_@@_oes_category_tl { research } }
    { nonResearch } { \tl_set:Nn \l_@@_oes_category_tl { nonResearch } }
    { student }     { \tl_set:Nn \l_@@_oes_category_tl { student } }
    { assistant }   { \tl_set:Nn \l_@@_oes_category_tl { student } }
  }
  { \tl_clear:N \l_@@_oes_category_tl }
  \tl_if_blank:VF \l_@@_oes_category_tl
  {
    \int_incr:N \l_@@_oes_record_count_int
    \prop_clear:N \l_@@_oes_row_affiliation_seen_prop
    \tl_if_blank:VTF \l_@@_oes_institutions_tl
    {
      \tl_if_blank:VTF \l_@@_oes_affiliation_tl
      {
        \msg_warning:nne { dfg } { existing-staff-no-organisation }
          { \pOESProject / \pOESLastname }
      }
      { \@@_oes_count_affiliation:n { \l_@@_oes_affiliation_tl } }
    }
    {
      \clist_set:NV \l_tmpa_clist \l_@@_oes_institutions_tl
      \clist_map_inline:Nn \l_tmpa_clist
      {
        \tl_clear:N \l_tmpa_tl
        \DTLifdbexists{institution}
        {
          \DTLgetvalueforkey{\l_tmpa_tl}
            {ref-affiliation-id}{institution}{id}{##1}
        }
        { }
        \DTLifnullorempty{\l_tmpa_tl}
        {
          \msg_warning:nnee { dfg } { requested-staff-unresolved-institution }
            { OverviewExistingStaff } {##1}
        }
        { \@@_oes_count_affiliation:n { \l_tmpa_tl } }
      }
    }
  }
}

\cs_new_protected:Npn \@@_oes_append_empty_cells:n #1
{
  \int_step_inline:nn {#1}
    { \tl_put_right:Nn \l_@@_oes_table_body_tl { & } }
