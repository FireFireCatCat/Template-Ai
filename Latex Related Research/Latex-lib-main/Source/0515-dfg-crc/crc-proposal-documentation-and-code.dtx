  }
  \str_if_eq:VnTF \l_@@_rfs_funding_status_tl { requested }
  {
    \tl_set:Nn \l_@@_rfs_commitment_cell_tl
      { \SetCell{bg=tableNoValue} }
    \tl_set:Nn \l_@@_rfs_funding_source_cell_tl
      { \SetCell{bg=tableNoValue} }
  }
  {
    \@@_rfs_make_cell:NnN \l_@@_rfs_commitment_tl
      { commitment } \l_@@_rfs_commitment_cell_tl
    \@@_rfs_make_cell:NnN \l_@@_rfs_funding_source_tl
      { funding-source } \l_@@_rfs_funding_source_cell_tl
    \tl_if_blank:VF \l_@@_rfs_commitment_tl
    {
      \tl_set:Ne \l_@@_rfs_commitment_cell_tl
      {
        \exp_not:N \dfgShowTag
          {\exp_not:V \l_@@_rfs_project_tl/
           \int_use:N \l_@@_rfs_display_number_int}
          {commitment}{\exp_not:V \l_@@_rfs_commitment_cell_tl}
          [RequestedFundingStaff]
      }
    }
    \tl_if_blank:VF \l_@@_rfs_funding_source_tl
    {
      \tl_set:Ne \l_@@_rfs_funding_source_cell_tl
      {
        \exp_not:N \dfgShowTag
          {\exp_not:V \l_@@_rfs_project_tl/
           \int_use:N \l_@@_rfs_display_number_int}
          {funding-source}{\exp_not:V \l_@@_rfs_funding_source_cell_tl}
          [RequestedFundingStaff]
      }
    }
  }
  \str_if_eq:VnTF \l_@@_rfs_funding_status_tl { existing }
  {
    \tl_set:Nn \l_@@_rfs_category_cell_tl
      { \SetCell{bg=tableNoValue} }
  }
  {
    \tl_if_blank:VTF \l_@@_rfs_category_tl
    {
      \@@_rfs_warn_missing:n { category }
      \tl_set:Nn \l_@@_rfs_category_cell_tl
        { \SetCell{bg=tableNoValue}\@@_rfs_missing_text:n {category} }
    }
    {
      \prop_get:NVNTF \g_@@_dfg_category_names_prop
        \l_@@_rfs_category_tl \l_@@_rfs_category_cell_tl
      { }
      {
        \tl_set:Ne \l_@@_rfs_category_cell_tl
          { \exp_not:N \@@_rfs_error_text:n { \exp_not:V \l_@@_rfs_category_tl } }
      }
    }
  }
  \tl_if_in:VnF \l_@@_rfs_category_cell_tl { \SetCell }
  {
    \tl_set:Ne \l_@@_rfs_category_cell_tl
    {
      \exp_not:N \dfgShowCalculatedTag{RequestedFundingStaffTable}
        {RequestedFundingStaff,person}
        {\exp_not:V \l_@@_rfs_category_cell_tl}
    }
  }
  \int_compare:nNnTF {#1} = {1}
  {
    \tl_set:Ne \l_@@_rfs_group_cell_tl
    {
      \exp_not:N \SetCell [ r=#2 ] { l }
      { \exp_not:n {#3} } &
    }
  }
  { \tl_set:Nn \l_@@_rfs_group_cell_tl { & } }
  \tl_put_right:Ne \l_@@_rfs_table_body_tl
  {
    \exp_not:V \l_@@_rfs_group_cell_tl
    \int_use:N \l_@@_rfs_display_number_int .
    & \exp_not:V \l_@@_rfs_name_cell_tl
    & \exp_not:V \l_@@_rfs_field_cell_tl
    & \exp_not:V \l_@@_rfs_department_cell_tl
    & \exp_not:V \l_@@_rfs_commitment_cell_tl
    & \exp_not:V \l_@@_rfs_category_cell_tl
    & \exp_not:V \l_@@_rfs_funding_source_cell_tl
    \\
  }
  \tl_if_blank:VT \l_@@_rfs_description_tl
  {
    \@@_rfs_warn_missing:n { description }
    \tl_set:Nn \l_@@_rfs_description_tl
      { \textcolor{error}{Description~not~provided.} }
  }
  \tl_put_right:Ne #4
  {
    \exp_not:N \item
      [\exp_not:N \textbf
        { \int_use:N \l_@@_rfs_display_number_int. }]
    \exp_not:N \textbf
      { \exp_not:N \dfgShowCalculatedTag{RequestedFundingStaffTable}
          {RequestedFundingStaff,person}
          {\exp_not:V \l_@@_rfs_description_name_tl} }
    \space
    \exp_not:N \dfgShowTag
      {\exp_not:V \l_@@_rfs_project_tl/
       \int_use:N \l_@@_rfs_display_number_int}
      {description}{\exp_not:V \l_@@_rfs_description_tl}
      [RequestedFundingStaff]
  }
}

\cs_new_protected:Npn \@@_rfs_render_group:NnN #1#2#3
