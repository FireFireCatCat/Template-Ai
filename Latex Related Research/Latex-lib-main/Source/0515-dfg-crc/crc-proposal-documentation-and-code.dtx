  {
    \DTLgetvalueforkey{\l_@@_rfs_project_status_tl}
      {project-status}{project}{id}{#1}
  }
  { }
  \str_if_eq:VnTF \l_@@_rfs_project_status_tl { E }
  {
    \tl_set:Nn \l_@@_rfs_existing_group_label_tl {Existing~staff}
    \tl_set:Nn \l_@@_rfs_requested_group_label_tl
      {Staff~funded~with~approved~grant~money}
    \tl_set:Nn \l_@@_rfs_existing_description_heading_tl
      {Job~descriptions~of~staff~(supported~through~existing~funds):}
    \tl_set:Nn \l_@@_rfs_requested_description_heading_tl
      {Job~descriptions~of~staff~(funded~with~approved~grant~money):}
  }
  {
    \tl_set:Nn \l_@@_rfs_existing_group_label_tl {Existing~staff}
    \tl_set:Nn \l_@@_rfs_requested_group_label_tl {Requested~staff}
