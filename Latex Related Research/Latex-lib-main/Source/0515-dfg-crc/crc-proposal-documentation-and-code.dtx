          { \tl_put_right:Nn \l_@@_projects_table_legend_tl { ;~ } }
        \tl_put_right:Nx \l_@@_projects_table_legend_tl
        {
          \exp_not:N \textbf { \exp_not:V \l_tmpa_tl }
          \c_space_tl = \c_space_tl
          \exp_not:V \l_tmpb_tl
        }
      }
    }
    \tl_if_blank:VF \l_@@_projects_table_legend_tl
    {
      \par\vspace{.15\baselineskip}
      {\tiny\RaggedRight\setlength{\parskip}{0pt}\noindent
        \textit{Institution~abbreviations:}\space
        \tl_use:N \l_@@_projects_table_legend_tl
        \par
      }
    }
  }
}


