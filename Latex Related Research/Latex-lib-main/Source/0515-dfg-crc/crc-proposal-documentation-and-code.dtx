%    \end{macrocode}
% This will get you the percentage of a certain position, gender and phase.
% Mainly for the table below, but can be used anywhere.
%    \begin{macrocode}
\NewDocumentCommand{\getPositionGenderPhasePercentage}{ O{person} m m m}
{
  % #1: database
  % #2: position
  % #3: gender
  % #4: phase

  \dfg_total_position_set:Nnnn \l_@@_total_int {#1} {#2} {#4}

  % --- number of the requested gender ---------------------------
  \dfg_count_position_set:Nnnnn \l_@@_tmp_int {#1}{#2}{#3}{#4}

  % --- avoid division by zero ----------------------------------
  \dfgShowCalculatedTag{getPositionGenderPhasePercentage}{#1}
  {
    \int_compare:nNnTF { \l_@@_total_int } = { 0 }
    { 0 }
    {
      % --- integer percentage (rounded) ------------------------
      \int_set:Nn \l_@@_percent_int
      { \fp_eval:n { round( 100 * \l_@@_tmp_int / \l_@@_total_int ) } }

      % print the integer together with the percent sign
      \int_use:N \l_@@_percent_int
    }
  }
}
%    \end{macrocode}
% The following command is meant to get the overall percentage of a certain
% gender.
% It goes into the final total row of the table, but it also can be used
% elsewhere with any funding phase you want.
%    \begin{macrocode}
\NewDocumentCommand{\getGenderPhasePercentage}{ O{person} m m  }
{
  % #1: database
  % #2: gender
  % #3: phase

  \int_zero:N \l_@@_percent_int
  \int_zero:N \l_@@_tmp_int
  \int_zero:N \l_@@_tmp_total_int

  \dfg_total_position_gender_set:Nnn \l_@@_tmp_total_int {#1} {#3}


  % % --- number of the requested gender ---------------------------
  \dfg_total_gender_set:Nnnn \l_@@_tmp_gender_int {#1}{#2}{#3}

  % --- avoid division by zero ----------------------------------
  \dfgShowCalculatedTag{getGenderPhasePercentage}{#1}
  {
    \int_compare:nNnTF { \l_@@_tmp_total_int } = { 0 }
    { 0 }
    {
      % --- integer percentage (rounded) ------------------------
      \int_set:Nn \l_@@_percent_int
      { \fp_eval:n { round( 100 * \l_@@_tmp_gender_int / \l_@@_tmp_total_int ) } }

      % print the integer together with the percent sign
      \int_use:N \l_@@_percent_int
    }
  }
  % \par Gender: #2--
  % Phase: #3--
  % Count: \int_use:N \l_@@_tmp_gender_int --
  % Count Total:\int_use:N \l_@@_tmp_total_int\par------------
}
%    \end{macrocode}
% Finally the table which is mostly calculated automatically based on the person-database.
%    \begin{macrocode}
\bool_new:N \l_@@_gender_leaders_all_sexes_bool
\tl_new:N \l_@@_gender_leaders_database_tl
\tl_new:N \l_@@_gender_leaders_unknown_options_tl
\clist_new:N \l_@@_gender_leaders_unknown_options_clist
\keys_define:nn {dfg/gender-leaders}
{
  all-sexes .bool_set:N = \l_@@_gender_leaders_all_sexes_bool,
  all-sexes .default:n = true,
  database .tl_set:N = \l_@@_gender_leaders_database_tl,
}
\NewDocumentCommand{\GenderEqualityProjectLeadersTable}{ O{} }
{
  \group_begin:
  \bool_set_false:N \l_@@_gender_leaders_all_sexes_bool
  \tl_set:Nn \l_@@_gender_leaders_database_tl {GenderEqualityProjectLeaders}
  \keys_set_known:nnN {dfg/gender-leaders} {#1}
    \l_@@_gender_leaders_unknown_options_tl
  \tl_if_blank:VF \l_@@_gender_leaders_unknown_options_tl
  {
    % Preserve the old bare database argument, including when combined with
    % a new display flag. Unknown key=value pairs still receive key errors.
    \clist_set:NV \l_@@_gender_leaders_unknown_options_clist
      \l_@@_gender_leaders_unknown_options_tl
    \int_compare:nNnTF
      {\clist_count:N \l_@@_gender_leaders_unknown_options_clist} = {1}
    {
      \exp_args:NV \tl_if_in:nnTF \l_@@_gender_leaders_unknown_options_tl {=}
      {
        \exp_args:NnV \keys_set:nn {dfg/gender-leaders}
          \l_@@_gender_leaders_unknown_options_tl
      }
      {
        \tl_set:Ne \l_@@_gender_leaders_database_tl
          {\clist_item:Nn \l_@@_gender_leaders_unknown_options_clist {1}}
      }
    }
    {
      \exp_args:NnV \keys_set:nn {dfg/gender-leaders}
        \l_@@_gender_leaders_unknown_options_tl
    }
  }
  \bool_if:NTF \l_@@_gender_leaders_all_sexes_bool
    { \exp_args:NV \@@_gender_leaders_all:n \l_@@_gender_leaders_database_tl }
    { \exp_args:NV \@@_gender_leaders_female:n \l_@@_gender_leaders_database_tl }
  \group_end:
}
