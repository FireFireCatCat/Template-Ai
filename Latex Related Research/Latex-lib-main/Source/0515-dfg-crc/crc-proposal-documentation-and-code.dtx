% Unstarred PI references disambiguate shared surnames across all PI records
% with the first given-name initial, for example K.~Schneider and C.~Schneider.
% If that initial is shared as well, use the full given name. Starred references
% and explicit display text retain their existing behavior, as do unique names.
% Project-first references inherit this formatting through \cs{getPI}.
% Recompute from the current metadata so additions are reflected immediately.
%    \begin{macrocode}
\tl_new:N \l_@@_pi_lastname_tl
\tl_new:N \l_@@_pi_firstname_tl
\tl_new:N \l_@@_pi_initial_tl
\tl_new:N \l_@@_pi_candidate_lastname_tl
\tl_new:N \l_@@_pi_candidate_firstname_tl
\tl_new:N \l_@@_pi_candidate_initial_tl
\clist_new:N \l_@@_pi_candidate_roles_clist
\bool_new:N \l_@@_pi_candidate_is_pi_bool
\int_new:N \l_@@_pi_same_lastname_int
\int_new:N \l_@@_pi_same_initial_int

% Count matching PI surnames and first initials across the current metadata.
\cs_new_protected:Npn \@@_pi_count_name_matches:
  {
    \int_zero:N \l_@@_pi_same_lastname_int
    \int_zero:N \l_@@_pi_same_initial_int
    \DTLforeach*{person}
      {
        \dfgDisambiguationName=lastname,
        \dfgDisambiguationFirstname=firstname,
        \dfgDisambiguationRoles=role
      }
      {
        \clist_set:Nx \l_@@_pi_candidate_roles_clist {\dfgDisambiguationRoles}
        \bool_set_false:N \l_@@_pi_candidate_is_pi_bool
        \clist_if_in:NnT \l_@@_pi_candidate_roles_clist {PI}
          {\bool_set_true:N \l_@@_pi_candidate_is_pi_bool}
        \clist_if_in:NnT \l_@@_pi_candidate_roles_clist {Co-PI}
          {\bool_set_true:N \l_@@_pi_candidate_is_pi_bool}
        \bool_if:NT \l_@@_pi_candidate_is_pi_bool
          {
            \tl_set:Nx \l_@@_pi_candidate_lastname_tl {\dfgDisambiguationName}
            \tl_if_eq:NNT \l_@@_pi_lastname_tl \l_@@_pi_candidate_lastname_tl
              {
                \int_incr:N \l_@@_pi_same_lastname_int
                \tl_set:Nx \l_@@_pi_candidate_firstname_tl {\dfgDisambiguationFirstname}
                \tl_trim_spaces:N \l_@@_pi_candidate_firstname_tl
                \tl_set:Nx \l_@@_pi_candidate_initial_tl
                  {\tl_head:V \l_@@_pi_candidate_firstname_tl}
                \tl_if_eq:NNT \l_@@_pi_initial_tl \l_@@_pi_candidate_initial_tl
                  {\int_incr:N \l_@@_pi_same_initial_int}
              }
          }
      }
  }

% Render the name inside the PI hyperlink. #1 is the star, #2 the person ID.
% The caller has already fetched and validated the name fields.
\cs_new_protected:Npn \@@_pi_reference_name:nn #1#2
  {
    \group_begin:
    \IfBooleanTF{#1}
      {\dfgShowTag{#2}{firstname}{\thePersonFirstName}[person]\space}
      {
        \tl_set:Nx \l_@@_pi_lastname_tl {\thePersonName}
        \tl_set:Nx \l_@@_pi_firstname_tl {\thePersonFirstName}
        \tl_trim_spaces:N \l_@@_pi_firstname_tl
        \tl_set:Nx \l_@@_pi_initial_tl {\tl_head:V \l_@@_pi_firstname_tl}
        \@@_pi_count_name_matches:
        \int_compare:nNnTF {\l_@@_pi_same_lastname_int} > {1}
          {
            \int_compare:nNnTF {\l_@@_pi_same_initial_int} > {1}
              {\dfgShowTag{#2}{firstname}{\thePersonFirstName}[person]}
              {\tl_use:N \l_@@_pi_initial_tl.}
            \nobreakspace
          }
          {
            \bool_if:NT \l_@@_custom_pi_reference_firstname_bool
              {\dfgShowTag{#2}{firstname}{\thePersonFirstName}[person]\space}
          }
