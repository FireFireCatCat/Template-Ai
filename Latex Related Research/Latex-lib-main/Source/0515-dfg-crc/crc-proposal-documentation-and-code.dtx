% \paragraph{Keyset \textbf{gantt}}
% Each row in a |gantt-\meta{project}| database describes one Gantt bar.
% Bars share their \refKey{id} with the corresponding work-package label, so
% \cs{addWP} automatically creates a matching Gantt entry when called.
%
% \refKey{periodStart} and \refKey{periodEnd} are quarter numbers (1--16 for a standard
% 5-year CRC period).  Setting both to the same value suppresses the bar,
% allowing a work-package item to exist in the list without occupying space
% in the chart.
%
% \refKey{style} selects one of five visual styles for the bar.  Unknown styles
% fall back to |default| with a warning, so the chart always compiles.
%    \begin{macrocode}
\keys_define:nn { gantt }{
  id          .code:n     =  \DTLnewdbentry{\l_@@_database_name_tl}{id}{#1},
  id          .value_required:n = true,
  name        .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{name}{#1},
  description .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{description}{#1},
  periodStart .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{periodStart}{#1},
  periodEnd   .code:n = \DTLnewdbentry{\l_@@_database_name_tl}{periodEnd}{#1},
  style       .choices:nn =  { crosshatch,striped,important,alternative,default }
  	{\DTLnewdbentry{\l_@@_database_name_tl}{style}{#1}},
  style / unknown .code:n = {
      \msg_warning:nnnnn { dfg } { invalid-value-fallback }{#1}
      {crosshatch,~striped,~important,~alternative,~default}{default}
  		\DTLnewdbentry{\l_@@_database_name_tl}{style}{default}
  	},
}
%    \end{macrocode}
% \subsection{Core data-access commands}
%
% The following commands form the primary user-facing API for reading
% and writing the datatool databases.  Together with the keyset
% definitions above they provide a strongly-typed, validated interface
% that prevents malformed data from silently entering the proposal.
%
% \paragraph{\cs{dfgShowTag} and \cs{dfgShowCalculatedTag}}
% Direct values use |db:id:field|; aggregates use the concise form
% |calc:command [db]|.  Successive labels alternate between two vertical levels.
% The complete marker has zero width, height, and depth in both prose and tables,
% so annotations cannot change line spacing or table-row height.  When
% \refKey{showtags-tables} is false, the wrapper returns its value unchanged
% while a |tblr| cell is being rendered.  The begin-document specialisation
% keeps the normal |showtags=false| path as cheap as the unannotated output.
% In fast-project mode, skipped metadata prevents resolving the destination
% row of a reference chain; the annotation records its source row and full
% requested field path instead.
%
%    \begin{macrocode}
\NewDocumentCommand{\dfgShowTag}{ m m m o }
{%
  % #1: id
  % #2: field of database
  % #3: value from database field
  % #4: custom field (optional, e.g. database name)
  \bool_if:NTF \l_@@_class_showtags_bool
  { \texorpdfstring{\@@_show_tag_direct:nnnn {#1}{#2}{#3}{#4}}{#3} }
  {#3}%
}

\NewDocumentCommand{\dfgShowCalculatedTag}{ m m +m }
{%
  % #1: calculation command or label
  % #2: contributing database(s)
  % #3: calculated value
  \bool_if:NTF \l_@@_class_showtags_bool
  { \texorpdfstring{\@@_show_tag_value:nn { calc:#1~[#2] } {#3}}{#3} }
  {#3}%
}

\cs_new_protected:Npn \@@_show_tag_direct:nnnn #1#2#3#4
{
  \IfNoValueTF{#4}
    { \@@_show_tag_value:nn { #1:#2 } {#3} }
    { \@@_show_tag_value:nn { #4:#1:#2 } {#3} }
}

\cs_new_protected:Npn \@@_show_tag_value:nn #1#2
{
  \bool_if:nTF
    { \g_@@_tblr_inside_bool && ! \l_@@_class_showtags_tables_bool }
    {#2}
    { \@@_show_tag_overlay:nn {#1}{#2} }
}

\bool_new:N \g_@@_show_tag_upper_bool
\bool_new:N \l_@@_show_tag_leftward_bool
\dim_new:N \l_@@_show_tag_raise_dim

\cs_new_protected:Npn \@@_show_tag_overlay:nn #1#2
{
  % #1: preformatted provenance label
  % #2: displayed value
  \group_begin:
    \bool_if:NTF \g_@@_show_tag_upper_bool
      { \dim_set:Nn \l_@@_show_tag_raise_dim { 1.30em } }
      { \dim_set:Nn \l_@@_show_tag_raise_dim { .9em } }
    \bool_gset_inverse:N \g_@@_show_tag_upper_bool
    \leavevmode
    \smash{%
      \vbox to \z@ {%
			\vss
			\color{color@tags@line}%
      \bool_if:NTF \l_@@_show_tag_leftward_bool
      {%
        \llap{%
          \raise \l_@@_show_tag_raise_dim \hbox{%
            \fontsize{4}{0}\selectfont
            \ttfamily
            #1\,%
          }%
          \vrule
        }%
      }
      {%
        \rlap{%
          \vrule
          \raise \l_@@_show_tag_raise_dim \hbox{%
            \fontsize{4}{0}\selectfont
            \ttfamily
            \,%
            #1%
          }%
        }%
      }%
      }%
    }%
    \textcolor{color@tags@font}{#2}%
  \group_end:
}

% Aggregated monetary tables use full euro amounts.  Guarded tagged cells must
% invoke \cs{TblrNum} explicitly so they still use the current column's
% |table-format| for a common SI field width; outside tables \cs{num} provides
% ordinary inline output.  Marginalia temporarily clear the table-context
% boolean and therefore remain unpadded.  The informational
% existing-instrumentation cost and the animal-housing rate are formatted
% separately because their source units and precision differ from aggregated
% funding values.
\cs_new_protected:Npn \@@_show_table_number:n #1
{
  \bool_if:NTF \g_@@_tblr_inside_bool
    { \TblrNum{#1} }
    { \num{#1} }
}

\cs_new_protected:Npn \@@_show_eur:n #1
{
  \bool_if:NTF \g_@@_tblr_inside_bool
    { \TblrNum{#1} }
    {
      \num[
        round-mode = places,
        round-precision = 0
      ]{#1}
    }
}

% Existing-instrumentation costs are supplied in thousands of EUR and are not
% included in any funding aggregate.  Match the DFG table's one-decimal
% precision while still suppressing a redundant trailing zero.
\cs_new_protected:Npn \@@_show_existing_instrumentation_cost:n #1
{
  \bool_if:NTF \g_@@_tblr_inside_bool
    { \TblrNum{#1} }
    {
      \num[
        round-mode = places,
        round-precision = 1
      ]{#1}
    }
}

\cs_new_protected:Npn \@@_show_calculated_number:nnN #1#2#3
{
  \dfgShowCalculatedTag{#1}{#2}
  { \exp_args:NV \@@_show_eur:n #3 }
}

\AtBeginDocument{%
  \bool_if:NTF \l_@@_class_showtags_bool
  {%
    \RenewDocumentCommand{\dfgShowTag}{ m m m o }
    { \texorpdfstring{\@@_show_tag_direct:nnnn {#1}{#2}{#3}{#4}}{#3} }%
    \RenewDocumentCommand{\dfgShowCalculatedTag}{ m m +m }
    { \texorpdfstring{\@@_show_tag_value:nn { calc:#1~[#2] } {#3}}{#3} }%
  }
  {%
    \RenewDocumentCommand{\dfgShowTag}{ m m m o }
    {#3}%
    \RenewDocumentCommand{\dfgShowCalculatedTag}{ m m +m }
    {#3}%
  }%
}

