        {##2} \l_tmpb_tl
      \str_compare:eNeTF
        { \str_casefold:V \l_tmpa_tl }
        >
        { \str_casefold:V \l_tmpb_tl }
        { \sort_return_swapped: }
        { \sort_return_same: }
