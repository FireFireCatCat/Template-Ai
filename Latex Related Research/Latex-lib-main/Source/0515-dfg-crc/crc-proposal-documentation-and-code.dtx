{
  \clist_clear:N \l_@@_project_results_excluded_clist
  \prop_get:NnNT \g_@@_project_results_aux_prop {#1} \l_tmpa_tl
  {
    \clist_set:NV \l_@@_project_results_excluded_clist \l_tmpa_tl
  }
}

