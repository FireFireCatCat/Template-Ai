% Another helper command to retrieve the information about a PI and
% his/her/their involvement within the project.
%    \begin{macrocode}
% --------------------------------------------------------------------------
% PI contract information
% --------------------------------------------------------------------------

\seq_new:N   \l_@@_contract_pi_ids_seq
\seq_new:N   \l_@@_contract_true_pi_ids_seq
\seq_new:N   \l_@@_contract_false_pi_ids_seq
\clist_new:N \l_@@_contract_answers_clist
\tl_new:N    \l_@@_contract_answer_tl
\tl_new:N    \l_@@_contract_field_list_tl

\NewDocumentCommand{\dfgPIcontractInformation}{ o m }
 {
  % #1: optional comma-separated PI ids
  %     If omitted, use the current value of \tmpProjectPIids.
  % #2: question id, e.g. C1 / C2 / C3 / C4
  \IfNoValueTF {#1}
   {
    \@@_pi_contract_information:Vn \tmpProjectPIids {#2}
   }
   {
    \@@_pi_contract_information:nn {#1} {#2}
   }
 }

\cs_new_protected:Npn \@@_pi_contract_information:nn #1#2
 {
  % #1: comma-separated PI ids
  % #2: question id, e.g. C1 / C2 / C3 / C4

  \def\tmpLocalDB{person}%
  \seq_set_from_clist:Nn \l_@@_contract_pi_ids_seq {#1}

  \str_case:nn {#2}
   {
    {C1}
     {
      \item
      Is~the~employment~of~the~
      \bool_if:NTF \l_@@_project_one_PI_bool
       { project~leader~at~the~institution~ }
       { project~leaders~at~the~institutions~ }%
      indicated~contractually~secured~for~the~duration~of~
      the~proposed~funding~period?\space
      \@@_pi_contract_yes_no:n {#2}%
     }

    {C2}
     {
      \item
      \bool_if:NTF \l_@@_project_one_PI_bool
       { Does~the~above~mentioned~person~hold~a~fixed-term~position? }
       { Do~any~of~the~above~mentioned~persons~hold~fixed-term~positions? }%
      \space
      \@@_pi_contract_yes_no:n {#2}%

      \clist_if_in:NnT \l_@@_contract_answers_clist {yes}
       {
        \begin{contractinformation}
          \item End~date~of~fixed-term~contract:\space
          \@@_pi_contract_field_list:nN {C2a} \l_@@_contract_true_pi_ids_seq

          \item Further~employment~is~planned~until:\space
          \@@_pi_contract_field_list:nN {C2b} \l_@@_contract_true_pi_ids_seq
        \end{contractinformation}
       }
     }

    {C3}
     {
      \item
      \bool_if:NTF \l_@@_project_one_PI_bool
       { Will~the~above~mentioned~person~ }
       { Will~one~or~more~of~the~above-mentioned~persons~ }%
      retire~during~the~proposed~funding~period?\space
      \@@_pi_contract_yes_no:n {#2}%

      \clist_if_in:NnT \l_@@_contract_answers_clist {yes}
       {
        \begin{contractinformation}
          \item Anticipated~retirement~date:\space
          \@@_pi_contract_field_list:nN {C3a} \l_@@_contract_true_pi_ids_seq
        \end{contractinformation}
       }
     }

    {C4}
     {
      \item
      Funding~for~the~position~of~the~
      \bool_if:NTF \l_@@_project_one_PI_bool
       { project~leader~at~the~institution~ }
       { project~leaders~at~the~institutions~ }%
      indicated~is~covered~by~core~support~(state~funds~or~similar):\space
      \@@_pi_contract_yes_no:n {#2}%

      \clist_if_in:NnT \l_@@_contract_answers_clist {no}
       {
        \begin{contractinformation}
          \item Type~and~source~of~funding:\space
          \@@_pi_contract_field_list:nN {C4a} \l_@@_contract_false_pi_ids_seq
        \end{contractinformation}
       }
     }
   }
 }

\cs_generate_variant:Nn \@@_pi_contract_information:nn { Vn }


\cs_new_protected:Npn \@@_pi_contract_yes_no:n #1
 {
  % #1: question id, e.g. C1 / C2 / C3 / C4

  \clist_clear:N \l_@@_contract_answers_clist
  \seq_clear:N   \l_@@_contract_true_pi_ids_seq
  \seq_clear:N   \l_@@_contract_false_pi_ids_seq
  \tl_clear:N    \l_@@_contract_answer_tl

  \bool_set_true:N \l_tmpa_bool

  \seq_map_inline:Nn \l_@@_contract_pi_ids_seq
   {
    \bool_if:NTF \l_tmpa_bool
     { \bool_set_false:N \l_tmpa_bool }
     { \tl_put_right:Nn \l_@@_contract_answer_tl {,~} }%

    \DTLgetvalueforkey{\theLastName}{lastname}{person}{id}{##1}%

    \compareEntry{##1}{#1}{yes}
     {
      \tl_put_right:Nn \l_@@_contract_answer_tl
        { \dfgShowTag{##1}{#1}{\textbf{yes}}[person] }%
      \clist_put_right:Nn \l_@@_contract_answers_clist {true}%
      \seq_put_right:Nn   \l_@@_contract_true_pi_ids_seq {##1}%
     }
     {
      \tl_put_right:Nn \l_@@_contract_answer_tl
        { \dfgShowTag{##1}{#1}{\textbf{no}}[person] }%
      \clist_put_right:Nn \l_@@_contract_answers_clist {false}%
      \seq_put_right:Nn   \l_@@_contract_false_pi_ids_seq {##1}%
     }

    \bool_if:NF \l_@@_project_one_PI_bool
     {
      \tl_put_right:Nx \l_@@_contract_answer_tl
       {
        \exp_not:n {~(}
        \exp_not:N \dfgShowTag{##1}{lastname}
          {\exp_not:V \theLastName}[person]
        \exp_not:n {)}
       }%
     }
   }

  \tl_use:N \l_@@_contract_answer_tl
 }


\cs_new_protected:Npn \@@_pi_contract_field_list:nN #1#2
 {
  % #1: field id, e.g. C2a / C2b / C3a / C4a
  % #2: sequence variable containing the PI ids for which the field is relevant

  \tl_clear:N \l_@@_contract_field_list_tl
  \bool_set_true:N \l_tmpa_bool

  \seq_map_inline:Nn #2
   {
    \bool_if:NTF \l_tmpa_bool
     { \bool_set_false:N \l_tmpa_bool }
     { \tl_put_right:Nn \l_@@_contract_field_list_tl {,~} }%

    \getEntry*[person]{##1}
     {
      \theFieldValue = #1,
      \theLastName   = lastname
     }%

    \tl_put_right:Nx \l_@@_contract_field_list_tl
     {
      \exp_not:N \textbf
      {
        \exp_not:N \dfgShowTag{##1}{#1}
          {\exp_not:V \theFieldValue}[person]
      }
      \int_compare:nNnT { \seq_count:N #2 } > {1}
       {
        \exp_not:n {~(}
        \exp_not:N \dfgShowTag{##1}{lastname}
          {\exp_not:V \theLastName}[person]
        \exp_not:n {)}
       }
     }%
   }

  \tl_use:N \l_@@_contract_field_list_tl
 }


