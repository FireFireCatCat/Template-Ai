  \tl_clear:N \l_@@_rfs_existing_descriptions_tl
  \tl_clear:N \l_@@_rfs_requested_descriptions_tl
  \DTLifdbexists{RequestedFundingStaff}
  {
    \DTLforeach[\DTLiseq{#1}{\pRFSProject}]
      {RequestedFundingStaff}
    {
      \pRFSProject=ref-project-id,
      \pRFSFundingStatus=funding-status,
      \pRFSStaffType=staff-type,
      \pRFSRefPerson=ref-person-id,
      \pRFSFirstname=firstname,
      \pRFSLastname=lastname,
      \pRFSDegree=academic-degree,
      \pRFSPosition=positionText,
      \pRFSField=field-of-research,
      \pRFSRefInstitution=ref-institution-id,
      \pRFSRefAffiliation=ref-affiliation-id,
      \pRFSDepartment=department,
      \pRFSCommitment=commitment,
      \pRFSCategory=category,
      \pRFSFundingSource=funding-source,
      \pRFSDescription=description
    }
    { \@@_rfs_collect_current: }
    \int_set:Nn \l_@@_rfs_record_count_int
    {
      \seq_count:N \l_@@_rfs_existing_research_seq
      + \seq_count:N \l_@@_rfs_existing_nonresearch_seq
      + \seq_count:N \l_@@_rfs_requested_research_seq
      + \seq_count:N \l_@@_rfs_requested_nonresearch_seq
    }
    \int_compare:nNnTF { \l_@@_rfs_record_count_int } = {0}
    { \@@_rfs_no_data:n {#1} }
    {
      \int_zero:N \l_@@_rfs_display_number_int
      \@@_rfs_render_status:NNnN
        \l_@@_rfs_existing_research_seq
        \l_@@_rfs_existing_nonresearch_seq
        {\tl_use:N \l_@@_rfs_existing_group_label_tl}
        \l_@@_rfs_existing_descriptions_tl
      \@@_rfs_render_status:NNnN
        \l_@@_rfs_requested_research_seq
        \l_@@_rfs_requested_nonresearch_seq
        {\tl_use:N \l_@@_rfs_requested_group_label_tl}
        \l_@@_rfs_requested_descriptions_tl
      \begin{tblr}[
        theme=requestedFundingStaff,
        long,
        postsep=0pt,
        expand=\l_@@_rfs_table_body_tl
      ]{
        colsep=2pt,
        width=\textwidth,
        hline{1,Z}={1pt,fg=tableOuterLines},
        hline{2}={1pt,fg=tableOuterLines},
        stretch=.8,
        rowsep=.500pt,
        colspec={X[1.1,l]
                 X[.42,c] % no
                 X[2.18,l] % Name
                 X[1.4,l] % field
                 X[1.5,c] % department
                 X[1.05,c] % proj com.
                 X[1.1,c] % category
                 X[.95,c] % funding
                 },
        column{1}={font=\footnotesize\bfseries,valign=m},
        column{2}={halign=c},
        rows={font=\footnotesize,valign=t},
        rowhead=1,
        row{1}={bg=tableHeadingsBG,fg=tableHeadingsFont,
          font=\scriptsize\bfseries,guard},
        cell{1}{1-8}={halign=c,valign=m}
      }
        & {No.}
        & {Name,~academic\\degree,~position}
        & {Field~of\\research}
        & {Departm.~of\\(non-)univers.\\institution}
        & {Project\\commitm.~(h/wk)}
        & Category
        & {Funding\\source} \\
        \l_@@_rfs_table_body_tl
      \end{tblr}
      \@@_rfs_print_legend:
      \tl_if_empty:NF \l_@@_rfs_existing_descriptions_tl
      {
        \par\medskip\noindent
        {\tl_use:N \l_@@_rfs_existing_description_heading_tl}\par\nobreak
        {\normalfont\normalsize\setlength{\parskip}{0pt}
          \begin{itemize}[
            label={},
            labelindent=0pt,
            labelwidth=1.5em,
            labelsep=.5em,
            leftmargin=2em,
            align=left,
            beginpenalty=10000]
            \tl_use:N \l_@@_rfs_existing_descriptions_tl
          \end{itemize}}
      }
      \tl_if_empty:NF \l_@@_rfs_requested_descriptions_tl
      {
        %\par\medskip\noindent
        {\tl_use:N \l_@@_rfs_requested_description_heading_tl}\par\nobreak
        {\normalfont\normalsize\setlength{\parskip}{0pt}
          \begin{itemize}[
            label={},
            labelindent=0pt,
            labelwidth=1.5em,
            labelsep=.5em,
            leftmargin=2em,
            align=left,
            beginpenalty=10000]
            \tl_use:N \l_@@_rfs_requested_descriptions_tl
          \end{itemize}}
      }
    }
  }
  { \@@_rfs_no_data:n {#1} }
  \group_end:
}
