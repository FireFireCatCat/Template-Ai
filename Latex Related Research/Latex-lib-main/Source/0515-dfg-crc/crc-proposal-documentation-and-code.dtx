% \subsection{TOC entry and work-package helpers}
%
% \cs{dfgTOCprojectPart}\marg{letter}\marg{title} adds a bold chapter-level
% entry to the table of contents coloured in the project colour (|projectA|
% for letter A, etc.).  Call it immediately before the project's
% \cs{chapter} command.
%
%    \begin{macrocode}
\NewDocumentCommand{\dfgTOCprojectPart}{m O{Project~area} m}{
  % #1: project       (kann leer sein)
  % #2: pre-freetext  (default: "Project area")
  % #3: free text     (kann leer sein)
  \bool_if:NF \l_@@_class_fastcompile_project_bool
  {
    \addtocentrydefault{chapter}
      { \tl_if_blank:nF {#1} { \texorpdfstring{\getProjectColor{#1}#1}{} } }
    {
      #2\c_space_tl
      \tl_if_blank:nF {#1} { \texorpdfstring{\getProjectColor{#1}#1}{#1} ~--~ #3 }
    }
  }
}
