% \paragraph{unknown-key and invalid-value}
% These two messages are the default handlers wired into the
% |unknown .code:n| and |\meta{choice} / unknown .code:n| slots of every
% \cs{keys\_define:nn} block.  They give the user immediate feedback in
% the log whenever a key name is misspelled or a value is outside the
% permitted set, instead of silently ignoring the input or producing a
% cryptic low-level TeX error.
%    \begin{macrocode}
\msg_new:nnn { dfg } { unknown-key }
{
  Key~ '\l_keys_path_str'~ is~ unknown~ and~ being~ ignored.~^^J^^J
  You~passed~the~value~'#1'~ to~ that~ key.~^^J
  Check~the~key~spelling~and~the~keys~documented~for~this~family.~^^J
  The~value~was~supplied~\msg_line_context:.
}
%    \end{macrocode}
%   Warning issued when a key receives a value outside its set of
%   permitted alternatives.  This message is the standard fallback for
%   keys defined with the \refPkg{l3keys} \texttt{.choices:nn} property
%   when their |/unknown| handler delegates to the dispatcher
%   \cs{person\_questions\_invalid:n}.  The two arguments are the rejected
%   value and a comma-separated list of the values that would have been
%   accepted.  The full key path is taken from \cs{l\_keys\_path\_str}, so
%   the warning identifies not only the offending value but also which
%   key was being set when the error occurred -- useful when the same
%   value name (such as |yes| or |1|) is plausible for several keys but
%   only valid for some of them.  The warning does not stop processing;
%   the database field is simply not created for the rejected value, and
%   subsequent keys in the same \refCom{addEntry} call continue to be parsed.
%   Diagnostics list input values users can supply, not internal variable
%   names. List-valued keys report each rejected item separately, preserving
%   valid items. Format checks use |invalid-format| with examples; handlers
%   that replace an invalid choice use |invalid-value-fallback| and name the
%   replacement. Date warnings explicitly state that the input is retained.
%    \begin{macrocode}
\msg_new:nnn { dfg } { invalid-value }
{
  Invalid~value~'#1'~for~key~'\l_keys_path_str'.~^^J^^J
  Allowed~values~are:~'#2'.~^^J
  This~value~is~ignored.~^^J
  The~value~was~supplied~\msg_line_context:.
}
\msg_new:nnn { dfg } { invalid-value-fallback }
{
  Invalid~value~'#1'~for~key~'\l_keys_path_str'.~^^J^^J
  Allowed~values~are:~'#2'.~^^J
  Using~'#3'~instead.~^^J
  The~value~was~supplied~\msg_line_context:.
}
\msg_new:nnn { dfg } { invalid-format }
{
  Invalid~value~'#1'~for~key~'\l_keys_path_str'.~^^J^^J
  Expected~#2.~This~value~is~ignored.~^^J
  The~value~was~supplied~\msg_line_context:.
}
\msg_new:nnn { dfg } { unknown-name }
{
  Unknown~#1~'#2'.~^^J
  Allowed~values~are:~'#3'.~^^J
  A~mismatch~marker~is~printed.~^^J
  The~value~was~used~\msg_line_context:.
}
\msg_new:nnn { dfg } { unknown-institution-order }
{
  Invalid~order~'#1'~for~ParticipatingInstitutions.~^^J
  Allowed~values~are:~'alpha,~count'.~Using~'alpha'~instead.~^^J
  The~order~was~supplied~\msg_line_context:.
}
\msg_new:nnn { dfg } { invalid-project-count-area }
{
  No~active,~list-considered~projects~were~found~for~area~'#1'~in~
  \string\getProjectCount;~printing~0.
}
\msg_new:nnn { dfg } { collaboration-focus-not-found }
{
  Cannot~draw~the~project~collaboration~plot:~focus~project~'#1'~is~not~an~
  eligible~row~of~the~project~database.
}
\msg_new:nnn { dfg } { collaboration-target-not-found }
{
  Ignoring~collaboration~'#1--#2':~project~'#2'~is~not~an~eligible~row~of~
  the~project~database.
}
\msg_new:nnn { dfg } { plot-current-project-missing }
{
  Cannot~print~the~'#1'~plot:~no~current~project~has~been~set.~Start~a~
  project~first,~or~pass~an~explicit~project~ID.
}
%    \end{macrocode}
%
%   Warning issued when a date-typed key receives a value that does not
%   match the ISO-8601 calendar-date shape \texttt{YYYY-MM-DD}.  Used by
%   the contract-information helper \cs{dfg\_contract\_date:nn} for the
%   fields \refKey{C2a}, \refKey{C2b}, and \refKey{C3a}, all of which
%   are expected to hold dates.  The two arguments are the field name
%   and the offending value.  The check is purely structural: it
%   verifies that the value consists of four digits, a hyphen, two
%   digits, a hyphen, and two digits, but it does not validate the
%   resulting date as a real calendar entry (so \texttt{2025-13-45}
%   passes the format check).  When the warning fires, the supplied
%   value is still recorded in the database so the typeset output makes
%   the malformed entry visible; this trades log-cleanliness for ease
%   of locating the source of the problem in the rendered document.
%    \begin{macrocode}
\msg_new:nnn { dfg } { invalid-date }
{
  Invalid~date~'#2'~for~key~'\l_keys_path_str'~(field~'#1').~^^J
  Expected~YYYY-MM-DD,~for~example~2026-10-11,~or~an~empty~value.~^^J
  The~supplied~value~is~retained;~correct~its~format~in~the~source.~^^J
  The~value~was~supplied~\msg_line_context:.
}
%    \end{macrocode}
% \paragraph{Requested-funding staff diagnostics}
% The staff roster is deliberately permissive at output time: incomplete or
% unresolved records remain visible in the document while these messages make
% the underlying metadata problem searchable in the log.
