% \subsection{DFG salary and animal-housing defaults}
%
% The DFG specifies standardised all-in salary costs (\emph{Personalmittel})
% per position category. The salary defaults use the 2027 rates. These constants are
% used in the requested-funding staff tables to calculate yearly personnel
% costs from FTE counts.
%
% The values are updated annually and published by the DFG.  Their canonical
% defaults are keys in the |dfg/custom| key family.  Override them together
% with the other proposal settings in |dfg-customization.tex|:
% \begin{dispListing*}{title={Overriding salary and animal-housing rates}}
%   \changeSettings{
%     salary@postDoc      = 90000,
%     animalHousing@mouse = 0.80,
%   }
% \end{dispListing*}
%
% Source: \url{https://www.dfg.de/resource/blob/408716/60-12-2027-de.pdf}
% (DFG personnel rates for 2027, form 60.12, version 01/27).
%
% Use \cs{getValue} with the setting key, for example
% |\num{\getValue{animalHousing@mouse}}|, to read these rates in text.
% The expandable \cs{dfgSalaryProf}, \cs{dfgSalaryGroupLeader},
% \cs{dfgSalaryPostDoc}, \cs{dfgSalaryMedDoc}, \cs{dfgSalaryPhD},
% \cs{dfgSalaryResearch}, \cs{dfgSalaryNonResearch},
% \cs{dfgSalaryStudent}, \cs{dfgSalaryAssistant}, \cs{dfgMouseHousing},
% \cs{dfgMouseHousingGnotobiotic}, and \cs{dfgRatHousing} accessors remain
% available for compatibility.  They expand to the corresponding setting.
