\cs_new_protected:Npn \@@_institutions_list:nnn #1#2#3
{
 \bool_if:NTF \l_@@_class_fastcompile_project_bool
 { \dfgFastReference{#2} }
 {
 \DTLifdbexists{#1}{
  % Parse key names rather than comparing tokens: options forwarded by
  % keys_set_known may have string catcodes. Boolean values also allow a
  % leading setting to override an older trailing flag.
  \bool_set_false:N \l_@@_institution_abbreviation_bool
  \bool_set_false:N \l_@@_narrow_bool
  \bool_set_false:N \l_@@_noaddr_bool
  \bool_set_false:N \l_@@_nozip_bool
  \bool_set_false:N \l_@@_noloc_bool
  \keys_set:nn { @@ / institution-list } {#3}
  \bool_if:NTF \l_@@_narrow_bool
  {
    \tl_set:Nn \l_@@_sep_tl {,~}
    \tl_set:Nn \l_@@_inst_sep_tl {;~}
  }
  {
    \tl_set:Nn \l_@@_sep_tl {\newline}
    \tl_set:Nn \l_@@_inst_sep_tl {\par\medskip}
  }
  \datatool_if_has_key:nnTF {affiliation}{country}
  { \bool_set_true:N \l_@@_has_country_bool }
  { \bool_set_false:N \l_@@_has_country_bool }

  % --- get list of institution ids for this person --------------------
  \DTLgetvalueforkey{\theInstitutionListValue}{ref-institution-id}{#1}{id}{#2}
  \seq_set_from_clist:NV \l_@@_inst_ids_seq \theInstitutionListValue

  % --- iterate --------------------------------------------------------
  \bool_set_true:N \l_tmpa_bool
  \seq_map_inline:Nn \l_@@_inst_ids_seq
  {
  	\bool_if:NTF \l_tmpa_bool
  	{ \bool_set_false:N \l_tmpa_bool }
  	{ \tl_use:N \l_@@_inst_sep_tl }
  	\_@@_one_institution:n {##1}
  }
}
   {
     Database~ \texttt{#1}~ missing.
     \msg_warning:nne { dfg } { database-not-found }{ #1 }
   }
 }
}

% Compatibility spelling for older proposal sources.
