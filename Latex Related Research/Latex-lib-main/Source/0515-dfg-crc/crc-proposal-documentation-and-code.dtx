% To get the interim sum printed in the margin area we use a custom command.
% Table rows are denser than the package's default collision distance, so these
% notes use fixed placement with no collision padding. This keeps every total
% on its row anchor instead of accumulating a downward displacement.  The
% leader is placed before the value in the right margin and after the value in
% the left margin, keeping it adjacent to the table on both page sides. You can
% switch the notes off using the customization section.
%    \begin{macrocode}
\NewDocumentCommand{\printMarginalia}{O{\hrulefill}m}
{
  \bool_if:NT \l_@@_class_showmarginalia_bool
  {\bool_set_false:N \g_@@_tblr_inside_bool
	\bool_set_true:N \l_@@_show_tag_leftward_bool
    \marginalia[type=fixed,ysep=0pt]
    {
      \int_if_odd:nTF { \marginaliapage }
        { #1#2 }
        { #2#1 }
    }
	\bool_set_false:N \l_@@_show_tag_leftward_bool
  	\bool_set_true:N \g_@@_tblr_inside_bool
  }
}
%    \end{macrocode}
