% \paragraph{Project overview table}
% \cs{projectOverviewTable} produces the compact project list used on the
% proposal's final page.  Current and new projects remain in project-number
% order; ending projects (status |E|) are moved to the end.  The status marker
% is omitted for current projects and printed after the project number for all
% other statuses.
%
% Project-leader names are resolved while the table body is assembled.  This
% avoids repeating database lookups during tabularray's measuring and rendering
% passes.  All three headings use the canonical dark blue at a larger size;
% the cell-specific rule ensures that the first heading (``Project'') is not
% overridden by the first-column styling.  The final-page source can therefore
% remain deliberately small:
% |\pagestyle{empty}| followed by |\printTable{projectOverview}|.
%    \begin{macrocode}
\tl_new:N  \l_@@_project_overview_body_tl
\tl_new:N  \l_@@_project_overview_ending_body_tl
\tl_new:N  \l_@@_project_overview_id_tl
\tl_new:N  \l_@@_project_overview_number_tl
\tl_new:N  \l_@@_project_overview_name_tl
\tl_new:N  \l_@@_project_overview_status_tl
\tl_new:N  \l_@@_project_overview_consider_for_lists_tl
\tl_new:N  \l_@@_project_overview_person_ids_tl
\tl_new:N  \l_@@_project_overview_leaders_tl
\tl_new:N  \l_@@_project_overview_project_cell_tl
\seq_new:N \l_@@_project_overview_person_seq

\cs_new_protected:Npn \@@_project_overview_set_leaders:n #1
{
  \tl_clear:N \l_@@_project_overview_leaders_tl
  \seq_set_from_clist:Nn \l_@@_project_overview_person_seq {#1}
  \seq_map_indexed_inline:Nn \l_@@_project_overview_person_seq
  {
    \DTLgetvalueforkey{\l_tmpa_tl}{firstname}{person}{id}{##2}
    \DTLgetvalueforkey{\l_tmpb_tl}{lastname}{person}{id}{##2}
    \int_compare:nNnT {##1} > {1}
      { \tl_put_right:Nn \l_@@_project_overview_leaders_tl { \newline } }
    \tl_if_blank:VF \l_tmpa_tl
    {
      \tl_put_right:Ne \l_@@_project_overview_leaders_tl
      {
        \exp_not:N \dfgShowTag {##2}{firstname}
          {\exp_not:V \l_tmpa_tl}[person]
        \exp_not:N \space
      }
    }
    \tl_put_right:Ne \l_@@_project_overview_leaders_tl
    {
      \exp_not:N \hyperlink { pi:\exp_not:n {##2} }
      {
        \exp_not:N \textbf
        {
          \exp_not:N \color { referencePI }
          \exp_not:N \dfgShowTag {##2}{lastname}
            {\exp_not:V \l_tmpb_tl}[person]
        }
      }
    }
  }
}

\cs_new_protected:Npn \@@_project_overview_append_row:N #1
{
  \exp_args:NV \@@_project_overview_set_leaders:n
    \l_@@_project_overview_person_ids_tl
  \tl_set:Ne \l_@@_project_overview_project_cell_tl
  {
    \exp_not:N \getProject
      { \exp_not:V \l_@@_project_overview_id_tl }
  }
  \str_if_eq:VnF \l_@@_project_overview_status_tl { C }
  {
    \tl_if_blank:VF \l_@@_project_overview_status_tl
    {
      \tl_put_right:Ne \l_@@_project_overview_project_cell_tl
      {
        \exp_not:N \,
        \exp_not:N \dfgShowTag
          {\exp_not:V \l_@@_project_overview_id_tl}{project-status}
          {\exp_not:V \l_@@_project_overview_status_tl}[project]
      }
    }
  }
  \tl_put_right:Ne #1
  {
    { \exp_not:V \l_@@_project_overview_project_cell_tl }
    & {
      \exp_not:N \dfgShowTag
        {\exp_not:V \l_@@_project_overview_id_tl}{name}
        {\exp_not:V \l_@@_project_overview_name_tl}[project]
    }
    & { \exp_not:V \l_@@_project_overview_leaders_tl }
    \exp_not:N \\
  }
}

\cs_new_protected:Npn \@@_project_overview_collect:
{
  \DTLsort{number}{project}
  \DTLforeach*{project}
  {
    \l_@@_project_overview_id_tl         = id,
    \l_@@_project_overview_number_tl     = number,
    \l_@@_project_overview_name_tl       = name,
    \l_@@_project_overview_status_tl     = project-status,
    \l_@@_project_overview_consider_for_lists_tl = consider-for-lists,
    \l_@@_project_overview_person_ids_tl = ref-person-id
  }
  {
    \str_if_eq:VnF \l_@@_project_overview_consider_for_lists_tl { false }
    {
      \str_if_eq:VnTF \l_@@_project_overview_status_tl { E }
        { \@@_project_overview_append_row:N \l_@@_project_overview_ending_body_tl }
        { \@@_project_overview_append_row:N \l_@@_project_overview_body_tl }
    }
  }
  \tl_put_right:NV \l_@@_project_overview_body_tl
    \l_@@_project_overview_ending_body_tl
}

