          \IfBooleanTF{#1}
            {\clist_set:Nn \l_@@_project_pi_properties_clist {firstname,lastname}}
            {\clist_set:Nn \l_@@_project_pi_properties_clist {lastname}}
        }
    }
    {\clist_set:Nn \l_@@_project_pi_properties_clist {#2}}
  \bool_if:NTF \l_@@_class_fastcompile_project_bool
    {\@@_fast_project_reference:n {#3}}
    {
      \clist_clear:N \l_@@_person_clist
      \DTLgetvalueforkey{\l_@@_person_id_clist}
        {ref-person-id}{project}{id}{#3}
      \DTLifnullorempty{\l_@@_person_id_clist}
        {\clist_clear:N \l_@@_person_id_clist}{}
      \clist_map_variable:NNn \l_@@_person_id_clist \l_tmpa_clist
        {
          \DTLgetvalueforkey{\tmpPIacademicdegree}{academicdegree}{person}{id}{\l_tmpa_clist}
          \DTLgetvalueforkey{\tmpPIfirstname}{firstname}{person}{id}{\l_tmpa_clist}
          \DTLgetvalueforkey{\tmpPIlastname}{lastname}{person}{id}{\l_tmpa_clist}
          \tl_clear:N \l_@@_project_pi_name_tl
          \clist_if_in:NnT \l_@@_project_pi_properties_clist {academicdegree}
            {
              \tl_put_right:Ne \l_@@_project_pi_name_tl
                {\dfgShowTag{\l_tmpa_clist}{academicdegree}{\tmpPIacademicdegree}[person]\addnbthinspace}
            }
          \clist_if_in:NnT \l_@@_project_pi_properties_clist {firstname}
            {
              \tl_put_right:Ne \l_@@_project_pi_name_tl
                {\dfgShowTag{\l_tmpa_clist}{firstname}{\tmpPIfirstname}[person]\space}
            }
          \clist_if_in:NnT \l_@@_project_pi_properties_clist {lastname}
            {
              \tl_put_right:Ne \l_@@_project_pi_name_tl
                {\dfgShowTag{\l_tmpa_clist}{lastname}{\tmpPIlastname}[person]}
            }
          % Reuse getPI's target, reference styling, and missing-person handling.
          % Freeze the ID and selected fields before advancing the metadata loop.
          \tl_if_empty:NF \l_@@_project_pi_name_tl
            {
              \clist_put_right:Ne \l_@@_person_clist
                {
                  \exp_not:N \getPI {\exp_not:V \l_tmpa_clist}
                    [\exp_not:V \l_@@_project_pi_name_tl]
                }
            }
        }
      \IfBooleanTF{#1}
        {
          \IfNoValueTF{#4}
            {\clist_use:Nnnn \l_@@_person_clist {~and~} {,~} {~and~}}
            {\clist_use:Nnnn \l_@@_person_clist {#4} {,~} {#4}}
        }
        {
          \IfNoValueTF{#4}
            {\clist_use:Nn \l_@@_person_clist {\,/\,}}
            {\clist_use:Nn \l_@@_person_clist {#4}}
        }
    }
  \group_end:
}
