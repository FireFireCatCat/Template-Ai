{
  \clist_map_inline:Nn #1
  {
    \str_if_eq:nnF {##1} {none}
    { \clist_put_right:Nn \l_@@_project_results_all_clist {##1} }
  }
}

\cs_new_protected:Npn \@@_project_results_register:
{
  \clist_clear:N \l_@@_project_results_all_clist
  \@@_project_results_collect:N \l_@@_project_results_quality_assured_clist
  \@@_project_results_collect:N \l_@@_project_results_other_clist
  \@@_project_results_collect:N \l_@@_project_results_patents_clist
  \clist_remove_duplicates:N \l_@@_project_results_all_clist
  \clist_set_eq:NN
    \l_@@_project_results_excluded_clist
    \l_@@_project_results_all_clist
  \iow_now:Ne \@auxout
  {
    \exp_not:N \dfgProjectResultsAux
    { \exp_not:V \l__tmp_current_project_tl }
    { \exp_not:V \l_@@_project_results_all_clist }
  }
}

