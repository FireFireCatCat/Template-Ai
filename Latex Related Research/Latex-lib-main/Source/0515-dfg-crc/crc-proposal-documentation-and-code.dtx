}

\cs_new_protected:Npn \@@_funding_calculate_staff_sums:
{
  \str_if_eq:VnT \l_@@_funding_cache_type_tl { staff }
  {
    \bool_set_false:N \l_@@_funding_calculation_needed_bool
    \@@_funding_calculation_needed:NN
      \l_@@_funding_cache_sum_one_tl \l_@@_funding_cache_quantity_one_tl
    \@@_funding_calculation_needed:NN
      \l_@@_funding_cache_sum_two_tl \l_@@_funding_cache_quantity_two_tl
    \@@_funding_calculation_needed:NN
      \l_@@_funding_cache_sum_three_tl \l_@@_funding_cache_quantity_three_tl
    \@@_funding_calculation_needed:NN
      \l_@@_funding_cache_sum_four_tl \l_@@_funding_cache_quantity_four_tl
    \@@_funding_calculation_needed:NN
      \l_@@_funding_cache_sum_five_tl \l_@@_funding_cache_quantity_five_tl
    \bool_if:NT \l_@@_funding_calculation_needed_bool
    {
      \bool_set_true:N \l_@@_funding_calculation_ready_bool
      \prop_get:NVNTF \g_@@_funding_salary_commands_prop
        \l_@@_funding_cache_category_tl \l_@@_funding_salary_command_tl
      {
        \cs_if_exist:cTF { \l_@@_funding_salary_command_tl }
        { \tl_set:Nx \l_@@_funding_salary_value_tl
          { \use:c { \l_@@_funding_salary_command_tl } } }
        { \bool_set_false:N \l_@@_funding_calculation_ready_bool }
      }
      { \bool_set_false:N \l_@@_funding_calculation_ready_bool }
      \exp_args:NnV \regex_match:nnF
        { \A \d+ (?: \. \d+ )? \Z }
        \l_@@_funding_cache_percentage_tl
      { \bool_set_false:N \l_@@_funding_calculation_ready_bool }
      \exp_args:NnV \regex_match:nnF
        { \A \d+ (?: \. \d+ )? \Z }
        \l_@@_funding_salary_value_tl
      { \bool_set_false:N \l_@@_funding_calculation_ready_bool }
      \bool_lazy_all:nT
      {
        { \bool_if_p:N \l_@@_funding_calculation_store_bool }
        { ! \bool_if_p:N \l_@@_funding_calculation_ready_bool }
      }
      {
        \msg_warning:nne { dfg } { funding-staff-cost-unavailable }
        {
          project~'\l_@@_funding_cache_project_tl',~category~
          '\l_@@_funding_cache_category_tl',~percentage~
          '\l_@@_funding_cache_percentage_tl'
        }
      }
      \@@_funding_calculate_one:NNnn
        \l_@@_funding_cache_sum_one_tl
        \l_@@_funding_cache_quantity_one_tl { sum-year1 } { 0.5 }
      \@@_funding_calculate_one:NNnn
        \l_@@_funding_cache_sum_two_tl
        \l_@@_funding_cache_quantity_two_tl { sum-year2 } { 1 }
      \@@_funding_calculate_one:NNnn
        \l_@@_funding_cache_sum_three_tl
        \l_@@_funding_cache_quantity_three_tl { sum-year3 } { 1 }
      \@@_funding_calculate_one:NNnn
        \l_@@_funding_cache_sum_four_tl
        \l_@@_funding_cache_quantity_four_tl { sum-year4 } { 1 }
      \@@_funding_calculate_one:NNnn
        \l_@@_funding_cache_sum_five_tl
        \l_@@_funding_cache_quantity_five_tl { sum-year5 } { 0.5 }
    }
  }
}

