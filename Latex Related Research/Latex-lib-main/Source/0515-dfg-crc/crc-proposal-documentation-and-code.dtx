% Generic warning for any database field that is null or empty when
% \refCom{getEntry} tries to retrieve it.  The check is deliberately suppressed
% during the tabularray cell-measuring pass (|\lTblrMeasuringBool| is |true|)
% to prevent each cell from generating duplicate log entries — tabularray
% renders each cell twice for width calculation before the final output pass.
%
%    \begin{macrocode}
\msg_new:nnn { dfg } { missing-key }
{DB:~'#1';~ID:~'#2';~null/empty:~'#3'.^^J^^J
