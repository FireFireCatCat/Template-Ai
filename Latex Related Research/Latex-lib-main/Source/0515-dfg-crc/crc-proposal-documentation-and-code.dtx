}


% \subsection{Preamble end: global metadata extraction and hyperref}
%
% The \cs{AfterEndPreamble} hook fires after all user preamble code
% (including |dfg-customization.tex| and all \cs{addEntry} calls) but
% before \cs{begin}|{document}|.  This is the earliest point at which
% the |meta| database is guaranteed to be fully populated.
%
% The block extracts the five core CRC fields into named macros
% (\cs{theCRCname}, \cs{theCRCnumber}, \cs{theCRCaffiliation}, etc.)
% that are used in headers, footers, and the hyperref PDF metadata.  It
% treats |meta.ref-affiliation-id| as a comma-separated list: the public
% affiliation macros contain human-readable name and location lists, while
% \cs{theApplicantID} retains the normalized id list for database filters.  It
% also derives \cs{theFundingPeriodNumeralPrevious} by subtracting 1 from
% \cs{theFundingPeriodNumeral}, which is used in the gender equality tables
% to reference the previous funding period.
%
% The \cs{hypersetup} call here (rather than in the preamble) avoids
% needing the user to duplicate CRC metadata in a separate hypersetup block.
\clist_new:N \l_@@_applicant_affiliation_id_clist
\seq_new:N \l_@@_applicant_affiliation_name_seq
\seq_new:N \l_@@_applicant_affiliation_location_seq
\seq_new:N \l_@@_other_applicant_affiliation_name_seq
\tl_new:N \l_@@_applicant_affiliation_name_tl
\tl_new:N \l_@@_applicant_affiliation_location_tl

\cs_new_protected:Npn \@@_set_applicant_affiliation_metadata:
{
  \DTLifnullorempty{\theApplicantID}
    { \clist_clear:N \l_@@_applicant_affiliation_id_clist }
    {
      \clist_set:Nx \l_@@_applicant_affiliation_id_clist
        { \theApplicantID }
      \clist_remove_duplicates:N \l_@@_applicant_affiliation_id_clist
    }
  \tl_set:Nx \l_tmpa_tl
    { \clist_use:Nn \l_@@_applicant_affiliation_id_clist {,} }
  \cs_set:Npx \theApplicantID { \exp_not:V \l_tmpa_tl }
  \cs_set_eq:NN \theAffiliationValue \theApplicantID
  \seq_clear:N \l_@@_applicant_affiliation_name_seq
  \seq_clear:N \l_@@_applicant_affiliation_location_seq
  \clist_map_inline:Nn \l_@@_applicant_affiliation_id_clist
  {
    \DTLifdbexists{affiliation}
    {
      \DTLgetvalueforkey{\l_@@_applicant_affiliation_name_tl}
        {name}{affiliation}{id}{##1}
      \DTLgetvalueforkey{\l_@@_applicant_affiliation_location_tl}
        {location}{affiliation}{id}{##1}
    }
    {
      \tl_set:Nn \l_@@_applicant_affiliation_name_tl {##1}
      \tl_clear:N \l_@@_applicant_affiliation_location_tl
    }
    \DTLifnullorempty{\l_@@_applicant_affiliation_name_tl}
      { \tl_set:Nn \l_@@_applicant_affiliation_name_tl {##1} }
      { }
