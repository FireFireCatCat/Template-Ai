%  Generic memoized \cs{DTLsumforkeys}
%    \begin{macrocode}
\prop_new:N \g_@@_dtlsum_cache_prop
%    \end{macrocode}
% Memoized form WITH filter:
%   |\@@_dtlsum_filtered:nnnnN {db}{filter-key}{filter-value}{cols}{result-cs}|
% This computes |\DTLsumforkeys[\DTLiseq{\pTmp}{value}][\pTmp=key]{db}{cols}{result}|
%    \begin{macrocode}

\cs_new_protected:Npn \@@_dtlsum_filtered:nnnnN #1#2#3#4#5 {
  \tl_set:Nx \l_tmpa_tl
  { #1 || \tl_to_str:n {#2} || \tl_to_str:n {#3} || \tl_to_str:n {#4} }
  \prop_get:NVNTF \g_@@_dtlsum_cache_prop \l_tmpa_tl \l_tmpb_tl
  { \cs_set_eq:NN #5 \l_tmpb_tl }
  {%
  	\DTLsumforkeys[\DTLiseq{\pCacheKey}{#3}][\pCacheKey=#2]{#1}{#4}{#5}%
  	\prop_gput:NVV \g_@@_dtlsum_cache_prop \l_tmpa_tl #5
  }
}

% Memoized form WITHOUT filter:
%   \@@_dtlsum_all:nnN {db}{cols}{result-cs}
\cs_new_protected:Npn \@@_dtlsum_all:nnN #1#2#3 {
  \tl_set:Nx \l_tmpa_tl
  { #1 || NOFILTER || \tl_to_str:n {#2} }
  \prop_get:NVNTF \g_@@_dtlsum_cache_prop \l_tmpa_tl \l_tmpb_tl
  { \cs_set_eq:NN #3 \l_tmpb_tl }
  {%
  	\DTLsumforkeys{#1}{#2}{#3}%
  	\prop_gput:NVV \g_@@_dtlsum_cache_prop \l_tmpa_tl #3
  }
}

