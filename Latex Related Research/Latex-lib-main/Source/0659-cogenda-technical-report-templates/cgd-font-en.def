% cgd-font-en.def : western font definitions
% vim:ft=tex

%%%% Font definition
% The upstream template names optional local fonts. The catalogue starter uses
% TeX Live's bundled equivalents so the example is deterministic in the
% pinned build image; replace these declarations when installing custom fonts.
\setmainfont{DejaVu Serif}
\setmathfont{latinmodern-math.otf}
\setmathfont[range=\mathup/{num,latin,Latin,greek,Greek}]{latinmodern-math.otf}
\setmathfont[range=\int]{latinmodern-math.otf}
\setsansfont{DejaVu Sans}
\setmonofont[
  ItalicFont={DejaVu Sans Mono},
  ItalicFeatures = {FakeSlant=0.2},
  BoldFont={DejaVu Sans Mono},
  BoldItalicFont={DejaVu Sans Mono},
  BoldItalicFeatures = {FakeSlant=0.2}
]{DejaVu Sans Mono}
\newfontface\LightMono{DejaVu Sans Mono}
