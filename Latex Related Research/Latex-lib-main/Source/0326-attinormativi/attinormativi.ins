\endpreamble

\postamble

End of file attinormativi.cls.
\endpostamble

\askforoverwritefalse

\generate{\file{attinormativi.cls}{\from{attinormativi.dtx}{class}}}

\obeyspaces
\Msg{*********************************************************************}
\Msg{*}
\Msg{* Per completare l'installazione della classe attinormativi:}
\Msg{*}
\Msg{* 1. Copiare il file `attinormativi.cls' nella stessa cartella}
\Msg{*    del proprio documento, oppure in una directory TEXMF locale:}
\Msg{*      TEXMFHOME/tex/latex/attinormativi/}
\Msg{*    e aggiornare il database dei file con: mktexlsr}
\Msg{*}
\Msg{* 2. Per generare la documentazione in PDF eseguire:}
\Msg{*      lualatex attinormativi.dtx}
\Msg{*    (sono necessarie due o tre passate per indici e rimandi)}
\Msg{*}
\Msg{* Per maggiori informazioni consultare la documentazione in:}
\Msg{*      attinormativi.pdf}
\Msg{*}
\Msg{*********************************************************************}

\endinput
