% Helper CS for split graph frames
\cs_new_protected:Npn \@IfGraphSplit #1#2 {
  \bool_if:NTF \l_@@_graphfill_bool {
    #2
  }{
    \tl_if_empty:NTF \l_@@_graphpos_tl {#2}{#1}
  }
}

% Helper CS to compute graphic dimensions and position
\cs_new_protected:Npn \@ComputeGraphDims {
  \bool_if:NTF \l_@@_graphfill_bool {
    \pgfmathsetmacro\@shx{0}
    \pgfmathsetmacro\@shy{0}
    \pgfmathsetmacro\@dx{\@PW/1cm}
    \pgfmathsetmacro\@dy{\@PH/1cm}
  }{
    \pgfmathsetmacro\@shx{\gridunit/1cm}
    \pgfmathsetmacro\@shy{4\gridunit/1cm}
    \pgfmathsetmacro\@dx{(\@PW-\gridunit)/1cm}
    \pgfmathsetmacro\@dy{(\@PH-4*\gridunit)/1cm}
  }
  \@IfGraphSplit{
    \pgfmathsetmacro\@oy{\gridunit/1cm}
    \pgfmathsetmacro\@prop{\fp_to_decimal:N\l_@@_graphprop_fp}
    \str_case:VnF \l_@@_graphpos_tl {
      { l } {
        \pgfmathsetmacro\@dx{\@prop*(\@PW-\beamer@leftmargin-\beamer@rightmargin)/1cm}
        \pgfmathsetmacro\@shx{\beamer@leftmargin/1cm}
        \pgfmathsetmacro\@dy{\@PH/1cm-2*\@oy}
        \pgfmathsetmacro\@shy{\@oy}
      }
      { r } {
        \pgfmathsetmacro\@dx{\@prop*(\@PW-\beamer@leftmargin-\beamer@rightmargin)/1cm}
        \pgfmathsetmacro\@shx{\@PW/1cm-\beamer@rightmargin/1cm-\@dx}
        \pgfmathsetmacro\@dy{\@PH/1cm-2*\@oy}
        \pgfmathsetmacro\@shy{\@oy}
      }
      { t } {
        \pgfmathsetmacro\@dx{(\@PW-\beamer@leftmargin-\beamer@rightmargin)/1cm}
        \pgfmathsetmacro\@shx{\beamer@leftmargin/1cm}
        \pgfmathsetmacro\@dy{\@prop*(\@PH/1cm-2*\@oy)}
        \pgfmathsetmacro\@shy{\@PH/1cm-\@oy-\@dy}
      }
      { b } {
        \pgfmathsetmacro\@dx{(\@PW-\beamer@leftmargin-\beamer@rightmargin)/1cm}
        \pgfmathsetmacro\@shx{\beamer@leftmargin/1cm}
        \pgfmathsetmacro\@dy{\@prop*(\@PH/1cm-2*\@oy)}
        \pgfmathsetmacro\@shy{\@oy}
      }
    }{ \msg_error:nnn { ugentdocs } { unknown~graphpos } { \l_@@_graphpos_tl } }
  }{}
}

% Helper CS to determine title width
\cs_new_protected:Npn \@ComputeTitleDims {
  \fp_compare:nNnTF {\l_@@_graphprop_fp} > {0.5} {
    \tl_clear:N \l_@@_graphpos_tl
  }{
    \tl_set:Nn \l_@@_graphpos_tl {r}
  }
  \tl_if_empty:NTF \l_@@_titlebgimg_tl {
    \pgfmathsetlength{\@titletextwidth}{\@PW-3\gridunit}%
  }{
    \fp_compare:nNnTF {\l_@@_graphprop_fp} > {0.5} {
      \pgfmathsetlength{\@titletextwidth}{\@PW-3\gridunit}%
    }{
      \pgfmathsetmacro\@titleprop{\fp_to_decimal:N\l_@@_graphprop_fp}%
      \pgfmathsetlength{\@titletextwidth}{\@PW-\@titleprop*(\@PW-\gridunit)-3\gridunit}%
    }
  }
}

% Helper CS to set inverse or normal text for graphic frames
\cs_new_protected:Npn \@SetInverse {
  \@IfGraphSplit { \@@_setinverse:n {false} } { \@@_setinverse:n {true} }
}

% Helper CS to set frame title dimensions and position
\dim_new:N \l_@@_tempdima_dim
\dim_new:N \l_@@_tempdimb_dim
\dim_new:N \l_@@_vskip_dim
\bool_new:N \l_@@_dovskip_bool
\cs_new_protected:Npn \@SetFrameTitleDims {
  \bool_set_false:N \l_@@_dovskip_bool
  \@IfGraphSplit {
    \str_case:VnF \l_@@_graphpos_tl {
      { l } {
        \dim_set:Nn \l_@@_graphdim_dim { \fp_to_decimal:N \l_@@_graphprop_fp \textwidth }
        \dim_set:Nn \l_@@_tempdima_dim { \l_@@_graphdim_dim + \gridunit }
        \dim_set:Nn \l_@@_tempdimb_dim { \textwidth - \l_@@_tempdima_dim }
      }
      { r } {
        \dim_set:Nn \l_@@_graphdim_dim { \fp_to_decimal:N \l_@@_graphprop_fp \textwidth }
        \dim_set:Nn \l_@@_tempdima_dim { 0em }
        \dim_set:Nn \l_@@_tempdimb_dim { \textwidth - \l_@@_graphdim_dim - \gridunit }
      }
      { t } {
        \dim_set:Nn \l_@@_tempdima_dim { 0em }
        \dim_set:Nn \l_@@_tempdimb_dim { \textwidth }
        \bool_set_true:N \l_@@_dovskip_bool
        \dim_set:Nn \l_@@_vskip_dim { \fp_to_decimal:N \l_@@_graphprop_fp \textheight + \gridunit }
      }
      { b } {
        \dim_set:Nn \l_@@_tempdima_dim { 0em }
        \dim_set:Nn \l_@@_tempdimb_dim { \textwidth }
      }
    }{
      \dim_set:Nn \l_@@_tempdima_dim { 0em }
      \dim_set:Nn \l_@@_tempdimb_dim { \textwidth }
    }
  }{
    \dim_set:Nn \l_@@_tempdima_dim { 0em }
    \dim_set:Nn \l_@@_tempdimb_dim { \textwidth }
  }
  \bool_if:NT \l_@@_dovskip_bool { \vskip \l_@@_vskip_dim }
  \@tempdima=\l_@@_tempdima_dim
  \@tempdimb=\l_@@_tempdimb_dim
}

