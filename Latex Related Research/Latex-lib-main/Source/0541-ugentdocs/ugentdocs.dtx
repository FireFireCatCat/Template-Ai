% \subsubsection{Fonts}
% \label{S:usage:cffcl:fonts}
% UGent Panno Text and its Medium and SemiLight variants should always be
% installed\watchout -- and the document compiled using \LuaLaTeX{} or \XeLaTeX{}
% -- as they are used in the logo's.
% For the document itself, it is recommended to use UGent Panno Text as well,
% which is why it is set by default through
% the |\trysetsansfont[UGentPannoText-Normal]{UGent Panno Text}[...]{}| block
% below. However, Arial is also a valid official alternative and can override
% UGent Panno Text by adding the |\trysetsansfont[Arial]{Arial}[...]{}| block below to the
% beginning of your document or your customization file.
% UGent uses Arial as default for Word and PowerPoint templates
% as these are distributed outside Ghent University.
% This is not applicable for \LaTeX{} however, as PDFs are always generated,
% usually with fonts embedded.
% Thus, UGent Panno Text is the default everywhere.
%
% \begin{verbatim}
% \trysetsansfont[UGentPannoText-Normal]{UGent Panno Text}[
%   BoldFont            = *,
%   BoldFeatures        = {FakeBold=2.5},
%   ItalicFont          = *,
%   ItalicFeatures      = {FakeSlant=0.15},
%   BoldItalicFont      = *,
%   BoldItalicFeatures  = {FakeBold=2.5, FakeSlant=0.15},
% ]{}
% \tryoverridemathfont[UGentPannoText-Normal]{UGent Panno Text}{>}
% \end{verbatim}
%
% \begin{verbatim}
% \trysetsansfont[Arial]{Arial}[
%   BoldFont            = *,
%   BoldFeatures        = {FakeBold=2.5},
%   ItalicFont          = *,
%   ItalicFeatures      = {FakeSlant=0.15},
%   BoldItalicFont      = *,
%   BoldItalicFeatures  = {FakeBold=2.5, FakeSlant=0.15},
% ]{}
% \tryoverridemathfont[Arial]{Arial}{}
% \end{verbatim}
%
% To support automatically loading fonts from file or by name (whichever is found first),
% the fontspec functions are extended here with a |try| prefix.
%
% For example:\\
% |\trysetsansfont[<Font File>]{<Font Name>}[<Font Features>]{<False Code>}|\\
% first tries to find the font by a |<Font File>|, which can be, e.g.,
% |Arial| (searches for |.ttf| or |.otf|) or |Arial.ttf|.
% It searches in the main document root directory or working directory first,
% then a |fonts/| subdirectory,
% then it searches the system installed fonts by |<Font Name>|.
% If it doesn't find the font in either of those places, the |<False Code>| is run.
% The |<Font Features>| are the same you would normally use in
% |\setsansfont{<Font>}[<Font Features>]|.
% These set of functions enable the use of online editors such as Inscrive or Overleaf
% with uploaded font files.
%
% Since both the official fonts are sans-serif, we use the |unicode-math| package
% with the Noto Sans Math font if available, and the DejaVu Math TeX Gyre
% font otherwise. You can override these fonts by using:\\
% |\trysetmathfont[<Font File>]{<Font Name>}[<Font Features>]{<False Code>}|.
%
% If you want to set the letters and numbers of the math font to a different font,
% use the\\
% |\tryoverridemathfont[<Font File>]{<Font Name>}[<Font Features>]{<False Code>}|\\
% macro. This is executed by default when loading the fonts at class load.\\
% Use |\tryoverridemathfont{}{}| to use the math font's own glyphs.
%
% \iffalse
%<*clo>
% Fonts
\RequirePackage{iftex}
\iftutex
\ExplSyntaxOn
\tl_new:N \g_@@_mathletter_font_tl
\tl_new:N \g_@@_mathletter_opts_tl
\tl_new:N \l_@@_try_name_tl
\tl_new:N \l_@@_try_opts_tl
\bool_new:N \l_@@_try_found_bool

% Override letters and numbers from math font with font #1
\cs_new_protected:Npn \@@_math_letters:nn #1#2 {
  \tl_if_empty:nF {#1} {
    \setmathfont {#1} [ #2
    range = { up/{latin,Latin,num}, sfup/{latin,Latin,num} } ]
    \setmathfont {#1} [ #2 FakeSlant = 0.15 ,
    range = { it/{latin,Latin}, sfit/{latin,Latin} } ]
    \setmathfont {#1} [ #2 FakeBold = 2.5 ,
    range = { bfup/{latin,Latin,num}, bfsfup/{latin,Latin,num} } ]
    \setmathfont {#1} [ #2 FakeBold = 2.5 , FakeSlant = 0.15 ,
    range = { bfit/{latin,Latin}, bfsfit/{latin,Latin} } ]
  }
}
\cs_generate_variant:Nn \@@_math_letters:nn { VV }


% Probe directory #1 for file #2, as given or with a font extension
\cs_new_protected:Npn \@@_try_file:nn #1#2 {
  \tl_map_inline:nn { {} {.otf} {.ttf} {.OTF} {.TTF} } {
    \bool_if:NF \l_@@_try_found_bool {
      \file_if_exist:nT { #1 #2 ##1 } {
        \tl_set:Nn \l_@@_try_name_tl { #2 ##1 }
        \tl_if_empty:nF {#1} { \tl_set:Nn \l_@@_try_opts_tl { Path = #1 , } }
        \bool_set_true:N \l_@@_try_found_bool
      }
    }
  }
}
\cs_generate_variant:Nn \@@_try_file:nn { ne }

% Find a font: file #1 in the doc dir or fonts/, else system font #2
\cs_new_protected:Npn \@@_try_font:nn #1#2 {
  \bool_set_false:N \l_@@_try_found_bool
  \tl_clear:N \l_@@_try_opts_tl
  \tl_if_blank:nF {#1} {
    \tl_map_inline:nn { {} {fonts/} } {
      \@@_try_file:nn {##1} {#1}
      \@@_try_file:ne {##1} { \str_lowercase:n {#1} }
      \@@_try_file:ne {##1} { \str_uppercase:n {#1} }
    }
  }
  \bool_if:NF \l_@@_try_found_bool {
    \IfFontExistsTF {#2} {
      \tl_set:Nn \l_@@_try_name_tl {#2}
      \bool_set_true:N \l_@@_try_found_bool
    } { }
  }
}

% #1 load command, #2 file, #3 name, #4 fontspec options, #5 false code
\cs_new_protected:Npn \@@_load:nnnn #1#2#3#4 { #1 {#2} [ #3 #4 ] }
\cs_generate_variant:Nn \@@_load:nnnn { nVVn }
\cs_new_protected:Npn \@@_try_load:nnnnn #1#2#3#4#5 {
  \@@_try_font:nn {#2} {#3}
  \bool_if:NTF \l_@@_try_found_bool {
    \@@_load:nVVn {#1} \l_@@_try_name_tl \l_@@_try_opts_tl {#4}
  }{
    #5
  }
}

% \trysetsansfont[<file>]{<name>}[<fontspec options>]{<false code>}
\NewDocumentCommand \trysetsansfont { O{} m O{} m }
{ \@@_try_load:nnnnn { \setsansfont } {#1} {#2} {#3} {#4} }
% \trynewfontfamily<cs>[<file>]{<name>}[<fontspec options>]{<false code>}
\NewDocumentCommand \trynewfontfamily { m O{} m O{} m }
{ \@@_try_load:nnnnn { \newfontfamily #1 } {#2} {#3} {#4} {#5} }
% \trynewfontface<cs>[<file>]{<name>}[<fontspec options>]{<false code>}
\NewDocumentCommand \trynewfontface { m O{} m O{} m }
{ \@@_try_load:nnnnn { \newfontface #1 } {#2} {#3} {#4} {#5} }
% \trysetmathfont[<file>]{<name>}[<fontspec options>]{<false code>}
\NewDocumentCommand \trysetmathfont { O{} m O{} m }
{ \@@_try_load:nnnnn { \setmathfont } {#1} {#2} {#3} {#4} }

% Override numbers/letters from math font with specified font
\NewDocumentCommand \overridemathfont { m } {
  \tl_gset:Nn \g_@@_mathletter_font_tl {#1}
  \tl_gclear:N \g_@@_mathletter_opts_tl
}
% \tryoverridemathfont[<file>]{<name>}{<false code>}
\NewDocumentCommand \tryoverridemathfont { O{} m m } {
  \@@_try_font:nn {#1} {#2}
  \bool_if:NTF \l_@@_try_found_bool {
    \tl_gset_eq:NN \g_@@_mathletter_font_tl \l_@@_try_name_tl
    \tl_gset_eq:NN \g_@@_mathletter_opts_tl \l_@@_try_opts_tl
  } {#3}
}
\@onlypreamble \overridemathfont
\@onlypreamble \tryoverridemathfont

\AddToHook { begindocument / before } {
  \@@_math_letters:VV \g_@@_mathletter_font_tl \g_@@_mathletter_opts_tl
}
\ExplSyntaxOff

\newcommand{\@loadfonts}{
  \RequirePackage{fontspec}
  \trysetsansfont[UGentPannoText-Normal]{UGent Panno Text}[
    BoldFont            = *,
    BoldFeatures        = {FakeBold=2.5},
    ItalicFont          = *,
    ItalicFeatures      = {FakeSlant=0.15},
    BoldItalicFont      = *,
    BoldItalicFeatures  = {FakeBold=2.5, FakeSlant=0.15},
  ]{%
    \trysetsansfont[Arial]{Arial}[
      BoldFont            = *,
      BoldFeatures        = {FakeBold=2.5},
      ItalicFont          = *,
      ItalicFeatures      = {FakeSlant=0.15},
      BoldItalicFont      = *,
     BoldItalicFeatures  = {FakeBold=2.5, FakeSlant=0.15},
    ]{%
      \PackageWarning{ugentdocs}
      {Neither UGent Panno Text nor Arial are installed, no font set!}%
    }%
  }
  \tryoverridemathfont[UGentPannoText-Normal]{UGent Panno Text}{%
    \tryoverridemathfont[Arial]{Arial}{}%
  }

  \RequirePackage
  [mathrm = sym,mathup = sym,mathbf = sym,mathit = sym, mathsf = sym]
  {unicode-math}
  \trysetmathfont[NotoSansMath-Regular]{Noto Sans Math}[Scale = 0.9]{%
    \trysetmathfont{DejaVuMathTeXGyre}[DejaVu Math TeX Gyre]{}%
  }

  \renewcommand{\familydefault}{\sfdefault}
}

\AtBeginDocument{
  \trynewfontface\logotextface
  [UGentPannoText-Medium]{UGent Panno Text Medium}[LetterSpace=-0.75]{%
    \PackageError{ugentdocs}
    {UGent Panno Text Medium is required for logo typesetting}
    {See the ugentdocs manual}
  }
  \trynewfontface\logosubtextface
  [UGentPannoText-SemiLight]{UGent Panno Text SemiLight}[LetterSpace=0.1]{%
    \PackageError{ugentdocs}
    {UGent Panno Text SemiLight is required for logo typesetting}
    {See the ugentdocs manual}
  }
}
\else
\PackageError{ugentdocs}{Only LuaLaTeX or XeLaTeX is supported for compilation}
{See the ugentdocs manual}
\fi

% Small caps for fontspec fonts
\newcommand\fakesc[1]{\textschelper#1 \relax\relax}
\def\textschelper#1 #2\relax{%
  \textschelphelp#1\relax\relax%
  \if\relax#2\relax\else\ \textschelper#2\relax\fi%
}
\def\Hscale{.83}\def\Vscale{.72}\def\Cscale{1.00}
\def\textschelphelp#1#2\relax{%
  \ifnum`#1=\lccode`#1\relax\scalebox{\Hscale}[\Vscale]{\char\uccode`#1}\else%
  \scalebox{\Cscale}[1]{#1}\fi%
  \ifx\relax#2\relax\else\textschelphelp#2\relax\fi}

