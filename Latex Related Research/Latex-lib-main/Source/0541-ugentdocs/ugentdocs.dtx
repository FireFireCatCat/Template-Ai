%
% When the faculty is specified, the |\@faculty| and |\@facultyacronym|
% tags are set. You can retrieve these similar to the \LaTeX{}-native |\@title| tag by
% wrapping it in |\makeatletter| and |\makeatother| (required due to the |@| sign).
% For example:
% \begin{itemize}
%   \item |\makeatletter\@faculty\makeatother|:
%     \makeatletter\@faculty\makeatother
%   \item |\makeatletter\@facultyacronym\makeatother|:
%     \makeatletter\@facultyacronym\makeatother
% \end{itemize}
% \DescribeMacro[common]{\faculty}
%   \marg{name}
%   \margintag{tag}\\
%   Overrides the faculty tag |\@faculty| with the |name| entered.
%   Overrides the name only, no logos or colours!
%   To use for, e.g., faculty services like ``Directie ICT'' for letters or beamer slides.
%
% \iffalse
%<*clo>
\ExplSyntaxOn
\NewDocumentCommand{\@faculty}{O{}}{%
  \ifx\@fselector\@empty\else
  \translatekey[#1]{faculty}{}%
  \tl_set:Nx \l_@@_lookup_key_tl { \languagename {} : facultyof }
  \tl_if_empty:eF { \prop_item:NV \g_@@_dict_keyvals_prop \l_@@_lookup_key_tl }
  {~\translatekey[#1]{facultyof}}%
  {~\translatekey[#1,expand]{org-\@fselector}}%
  \fi
}

\newcommand*{\faculty}[1]{%
  \RenewDocumentCommand{\@faculty}{O{}}{
    \str_case:nnF {##1}{
