% \DescribeMacro[bama-phd-rp]{\runwordcount}
%   Runs |texcount| using |shell-escape| (see code below), which
%   automatically counts the words and sets the |\@wordcount| tag.
%   Command arguments that expand to more text (e.g., a |\translatekey| call)
%   only count the arguments, so results may be inaccurate,
%   but it's the best we have.\\
%   You should also run your compiler with the flag '|--shell-escape|'.
%   For notes on how to do this for your editor or compiler, visit
%   \href
%   {https://tex.stackexchange.com/questions/598818/how-can-i-enable-shell-escape}
%   {the TeX StackExchange wiki}.\\
%   \watchout Enabling |shell-escape| potentially risks the execution of
%   malicious code from dubious packages.
%   Be sure to only use reputable packages and
%   disable |shell-escape| when not used.
%   The packages required by the |ugentdocs| classes \emph{should} be safe,
%   but better safe than sorry\ldots
%    \begin{macrocode}
%<*bama|phd|rp>
\ExplSyntaxOn
\cs_new:Nn \@@_runwordcount: {
  \ShellEscape{texcount~-1~-sum~-merge~-q~\jobname.tex~>~\jobname.wc}
