%
% \DescribeMacro[ex]{\answerspace}
%   \oarg{style=grid/lines/none}
%   \oarg{lines=number of lines}\\
%   Creates an answer space with an outline box.
%   If |lines| is not specified,
%   it will fill the remainder of the page (or create a full page).
%   If the number of |lines| exceeds the remaining page capacity,
%   it continues on the next page.
%   The line or grid spacing dimension can be set using
%   |\answerspacing{<length>}|.
%   Specifying no |style| optional argument just prints the outline box,
%   whilst |style=grid| produces a |darkgray| dotted grid,
%   and |style=lines| produces a |darkgray| lined box.
% \iffalse
%<*ex>
\ExplSyntaxOn
\NewDocumentCommand{\answerspacing}{m}{
  \dim_set:Nn \l_@@_anslinestep_dim {#1}
}

\zref@addprops{savepos}{abspage}
\dim_new:N \l_@@_anslinestep_dim
\dim_new:N \l_@@_ansytop_dim
\dim_new:N \l_@@_ansybottom_dim

\dim_new:N \l_@@_anstolerancesnap_dim
\dim_set:Nn \l_@@_anstolerancesnap_dim {1cm}
\dim_new:N \l_@@_ansgapstop_dim
\dim_set:Nn \l_@@_ansgapstop_dim {0.2cm}
\dim_new:N \l_@@_textleft_dim

\int_new:N \g_@@_anscounter_int
\int_new:N \l_@@_anstargetpage_int
\dim_new:N \l_@@_cury_dim
\dim_new:N \l_@@_needed_dim
\dim_new:N \l_@@_available_dim
\bool_new:N \l_@@_ansattop_bool
\tl_new:N \l_@@_ansstyle_tl
\int_new:N \l_@@_nlines_int


% Set dimensions of linestep and where top starts and bottom ends
\AtBeginDocument{
  \dim_set:Nn \l_@@_anslinestep_dim {\baselineskip}
  \dim_set:Nn \l_@@_ansytop_dim
    { \paperheight - 1in - \voffset - \topmargin - \headheight - \headsep }
  \group_begin:
    \small
    \dim_gset:Nn \g_tmpa_dim { \box_ht:N \strutbox }
  \group_end:
  \dim_set:Nn \l_@@_ansybottom_dim
    { \l_@@_ansytop_dim - \textheight - \footskip + \g_tmpa_dim + \footruleskip }
}

% Set style of grid and lines
\tikzset{
  answer-grid/.style  =
    { densely~dotted, darkgray, step = \l_@@_anslinestep_dim },
  answer-lines/.style =
    { densely~dotted, darkgray, xstep = \paperwidth, ystep = \l_@@_anslinestep_dim },
  answer-/.style      =
    { draw = none },
}

% Helper CS: #1 rounded down to a whole number of line steps
\cs_new:Nn \_@@_trim_span:n {
  \l_@@_anslinestep_dim *
  \int_div_truncate:nn { \dim_to_decimal_in_sp:n {#1} }
    { \dim_to_decimal_in_sp:n { \l_@@_anslinestep_dim } }
}

% Answer boxes 1: contained/inline box.
% #1 = height, #2 = style
\cs_new_protected:Nn \_@@_draw_inline_ansgrid:nn {
  \par\noindent
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\textwidth,#1);
    \draw [answer-#2] (0,0) grid (\textwidth,#1);
    \draw [thick] (0,0) rectangle (\textwidth,#1);
  \end{tikzpicture}
  \par
}
\cs_generate_variant:Nn \_@@_draw_inline_ansgrid:nn { nV }

% Answer boxes 2: extending down to footer rule.
% #1 = target abspage, #2 = y top, #3 = y pattern anchor, #4 = style
\cs_new_protected:Nn \_@@_shipout_ansgrid:nnnn {
  \int_compare:nNnT { \value{abspage} } = {#1} {
    \dim_set:Nn \l_@@_textleft_dim
    { 1in + \hoffset + \int_if_odd:nTF { \value{page} } { \oddsidemargin } { \evensidemargin } }
    \put (0,-\paperheight) {
      \begin{tikzpicture}
        \path (0,0) (\paperwidth,\paperheight);
        \begin{scope}
          \clip (\l_@@_textleft_dim,\l_@@_ansybottom_dim)
            rectangle (\l_@@_textleft_dim+\textwidth,#2);
          \draw [answer-#4, shift={(\l_@@_textleft_dim,#3)}]
            (0,-\textheight) grid (\textwidth,\textheight);
        \end{scope}
        \draw [thick] (\l_@@_textleft_dim,\l_@@_ansybottom_dim)
        |- (\l_@@_textleft_dim+\textwidth,#2) -- ++(0,\l_@@_ansybottom_dim-#2);
      \end{tikzpicture}
    }
  }
}

\keys_define:nn { ugentdocs/answerspace } {
  style .tl_set:N  = \l_@@_ansstyle_tl ,
  lines .int_set:N = \l_@@_nlines_int ,
}

\NewDocumentCommand{\answerspace}{O{}}{%
  \keys_set:nn { ugentdocs/answerspace } { style = , lines = 0, #1 }
  \par
  \int_gincr:N \g_@@_anscounter_int
  \zsavepos{answerspace-\int_use:N\g_@@_anscounter_int}%
  \dim_set:Nn \l_@@_cury_dim { \zposy{answerspace-\int_use:N\g_@@_anscounter_int} sp }
  \int_set:Nn \l_@@_anstargetpage_int {
    \zref@extract{answerspace-\int_use:N\g_@@_anscounter_int}{abspage}
  }
  \bool_set:Nn \l_@@_ansattop_bool{
    \dim_compare_p:nNn { \l_@@_ansytop_dim - \l_@@_cury_dim } < { 0.05cm }
  }
  \dim_sub:Nn \l_@@_cury_dim { \l_@@_ansgapstop_dim }
  \dim_set:Nn \l_@@_needed_dim {
    \int_if_zero:nTF { \l_@@_nlines_int }{
      \_@@_trim_span:n { \l_@@_cury_dim - \l_@@_ansybottom_dim }
    }{
      \l_@@_anslinestep_dim * \l_@@_nlines_int
    }
  }

  \bool_while_do:nn { \dim_compare_p:nNn { \l_@@_needed_dim } > { 0pt } } {
    \dim_set:Nn \l_@@_available_dim
      { \_@@_trim_span:n { \l_@@_cury_dim - \l_@@_ansybottom_dim } }
    \dim_compare:nNnTF { \l_@@_available_dim - \l_@@_needed_dim } < { \l_@@_anstolerancesnap_dim }{
      % Ansbox doesn't fit
      \exp_args:Nnx \AddToHook {shipout/background} {
        \_@@_shipout_ansgrid:nnnn
        { \int_use:N \l_@@_anstargetpage_int } % target page
        { \dim_eval:n { % y top
            \bool_if:NTF \l_@@_ansattop_bool{
              \l_@@_ansytop_dim
            }{
              \l_@@_ansybottom_dim + \l_@@_available_dim
            }
          }
        }
        { \dim_eval:n { % y pattern anchor
            \bool_if:NTF \l_@@_ansattop_bool {
              \l_@@_ansytop_dim
            }{
              \l_@@_ansybottom_dim
            }
          }
        }
        { \l_@@_ansstyle_tl } % pattern style (grid/lines)
      }
      \nointerlineskip\null
      \clearpage
      \int_incr:N \l_@@_anstargetpage_int
      \dim_sub:Nn \l_@@_needed_dim { \l_@@_available_dim }
      \dim_set_eq:NN \l_@@_cury_dim \l_@@_ansytop_dim
      \bool_set_true:N \l_@@_ansattop_bool
    }{
      % Ansbox fits, just inline
      \_@@_draw_inline_ansgrid:nV { \dim_use:N \l_@@_needed_dim } \l_@@_ansstyle_tl
      \dim_zero:N \l_@@_needed_dim
    }
  }
}
