  \@setfaclogotext
  \pgfmathsetmacro{\@flogoscale}{#1/3/\@logounit}
  \pgfmathsetmacro{\@flogoxshift}{-#3*(3*\@logounit+\@ftextw)*\@flogoscale}

  \begin{scope}[  y=1pt, x=1pt, inner~sep=0pt, outer~sep=0pt,
    shift={(\@flogoxshift, 0.0cm)},yscale=\@flogoscale,xscale=\@flogoscale,
    every~node/.append~style={scale=\@flogoscale, color=#2} ]
    %\draw[step=\@logounit,black,thin] (0,0) grid (3*\@logounit+\@ftextw,3*\@logounit); % logo grid
    \begin{scope}[shift={(\@logounit,\@logounit)},every~path/.append~style={fill=#2}]
      \@ficonpath
    \end{scope}

    \path (0,0) rectangle (3*\@logounit+\@ftextw,3*\@logounit);

    \node[  anchor=south~west, align=flush~left,
    text~width=\@ftextw+\@ftextmarginextra,
    font = \logotextface\fontsize{13.6pt}{12.4pt}\selectfont]
    at (\@logounit+\@ficonw+\@flogospace,\@logounit)
    {\spaceskip=0.0825cm%
      \nohyphens{\@flogotext}};

    \node[  anchor=south~west, align=flush~left,
    text~width=\@ftextw,
    font=\logosubtextface\fontsize{7.45pt}{8pt}\selectfont]
    at (\@logounit+\@ficonw+\@flogospace+0.019cm,\@logounit-0.34cm)
    {\spaceskip=0.054cm%
      \@flogosubtext};
  \end{scope}
  \fi
}
