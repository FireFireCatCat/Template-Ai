% \subsubsection{Inset text and quotes}
% \label{S:usage:macros:inset}
%
% \DescribeMacro[bama-phd-crs-rp]{\insettext}
%   \marg{title}
%   \marg{content}\\
%   Formats the |title| and |content| into a text box. By default, the colours are\\
%   faculty-based (|insetboxcolor|).\\
%   Examples:\\
%
% \newcommand{\insettext}[2]{
% \begin{adjustbox}{center}
%   \begin{tikzpicture}
%   \node[align=flush left, text width=\linewidth-6mm, inner sep=3mm] (body) {#2};
%   \ifblank{#1}{}{%
%     \node[align=flush left, text width=\linewidth-6mm, inner sep=3mm,
%     fill=insetboxcolor, text=white, font=\bfseries,
%     above=0pt of body, anchor=south] (title) {#1};
%   }%
%   \begin{scope}[on background layer]
%   \ifblank{#1}{%
%     \node[fill=insetboxcolor!10, fit=(body), inner sep=0mm] {};
%   }{%
%     \node[fill=insetboxcolor!10, fit=(body)(title), inner sep=0mm] {};
%   }%
%   \end{scope}
%   \end{tikzpicture}
% \end{adjustbox}
%}
% |\insettext{An example title}{This is the content.}|\\
% \insettext{An example title}{This is the content.}
% |\insettext{}{This is the content without a title.}|\\
% \insettext{}{This is the content without a title.}
% |\colorlet{insetboxcolor}{ugent@accent}|\\
% |\insettext{An example title}{This is the content.}|\\
% \begingroup\colorlet{insetboxcolor}{ugent@accent}
% \insettext{An example title}{This is the content.}
% \endgroup
%
% Implementation:
%    \begin{macrocode}
%<*bama|phd|crs|rp>
\newcommand{\insettext}[2]{
  \par\noindent
  \begin{adjustbox}{center}%
    \begin{tikzpicture}%
      \node[align=flush left, text width=\linewidth-6mm, inner sep=3mm] (body) {#2};
      \ifblank{#1}{}{%
        \node[align=flush left, text width=\linewidth-6mm, inner sep=3mm,
        fill=insetboxcolor, text=white, font=\bfseries,
        above=0pt of body, anchor=south] (title) {#1};
      }%
      \begin{scope}[on background layer]
      \ifblank{#1}{%
        \node[fill=insetboxcolor!10, fit=(body), inner sep=0mm] {};
      }{%
        \node[fill=insetboxcolor!10, fit=(body)(title), inner sep=0mm] {};
      }%
      \end{scope}
    \end{tikzpicture}%
  \end{adjustbox}%
  \par
}
%</bama|phd|crs|rp>
%    \end{macrocode}
%
% \DescribeMacro[bama-phd-crs-rp]{\insetquote}
%   \marg{quote}
%   \marg{citation}\\
%   Formats the |quote| and |citation| into a text box using |insettext|.
%   By default, the colours are faculty-based (|insetboxcolor|).\\
%   Example:\\
%   |\insetquote{I feel quite hungry!}{Some dude from Bohemia named Henry}|\\
%
% \makeatletter
% \newlength{\@quotetextwidth}
% \newlength{\@quoteinnerxsep}
% \setlength{\@quoteinnerxsep}{10mm}
%
% \newcommand{\@insetquotepicture}[2]{
% \begin{tikzpicture}[baseline]
% \node[align=#1, text width=\@quotetextwidth,
% inner xsep=\@quoteinnerxsep, inner ysep=6mm] (qtext) {#2};
% \node[font=\Huge, anchor=north west] at (qtext.north west) {``};
% \node[font=\Huge, anchor=south east] at (qtext.south east) {''};
% \end{tikzpicture}
% }
%
% \newcommand{\insetquote}[2]{
% \insettext{}{%
%   \settowidth{\@quotetextwidth}{#1}%
%   \ifdim\@quotetextwidth>\dimexpr\linewidth-6mm-2\@quoteinnerxsep\relax
%   \setlength{\@quotetextwidth}{\dimexpr\linewidth-6mm-2\@quoteinnerxsep\relax}%
%   \@insetquotepicture{justify}{#1}\par
%   \else
%   \begin{center}
%     \@insetquotepicture{center}{#1}\par
%   \end{center}
%   \fi
%   \ifblank{#2}{}{\raggedleft #2\par}%
% }%
% }
% \makeatother
%
% \insetquote{I feel quite hungry!}{Some dude from Bohemia named Henry}
%
% Implementation:
%    \begin{macrocode}
%<*bama|phd|crs|rp>
\newlength{\@quotetextwidth}
\newlength{\@quoteinnerxsep}
\setlength{\@quoteinnerxsep}{10mm}

\newcommand{\@insetquotepicture}[2]{
  \begin{tikzpicture}[baseline]
    \node[align=#1, text width=\@quotetextwidth,
    inner xsep=\@quoteinnerxsep, inner ysep=6mm] (qtext) {#2};
    \node[font=\Huge, anchor=north west] at (qtext.north west) {``};
    \node[font=\Huge, anchor=south east] at (qtext.south east) {''};
  \end{tikzpicture}
}

\newcommand{\insetquote}[2]{
  \insettext{}{%
    \settowidth{\@quotetextwidth}{#1}%
    \ifdim\@quotetextwidth>\dimexpr\linewidth-6mm-2\@quoteinnerxsep\relax
    \setlength{\@quotetextwidth}{\dimexpr\linewidth-6mm-2\@quoteinnerxsep\relax}%
    \@insetquotepicture{justify}{#1}\par
    \else
    \begin{center}
      \@insetquotepicture{center}{#1}\par
    \end{center}
    \fi
    \ifblank{#2}{}{\raggedleft #2\par}%
  }%
}
%</bama|phd|crs|rp>
%    \end{macrocode}
