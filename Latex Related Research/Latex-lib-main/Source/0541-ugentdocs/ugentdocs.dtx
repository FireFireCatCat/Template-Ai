\setlength\@PH{297mm}
\@setgridunit
\RequirePackage[heightrounded,paperwidth=\@PW,paperheight=\@PH,
                top=2.54cm, bottom=2.54cm, left=2\gridunit, right=2\gridunit]{geometry}
