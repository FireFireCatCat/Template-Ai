% GRAPHIC FRAME ---------------------------------------------------------------
\NewEnviron{graphicframe}[3][]{%
  \begin{frame}[#1]{#2}{#3}
    \@IfGraphSplit {
      \str_case:VnF \l_@@_graphpos_tl {
        { l } {
          \fp_set:Nn \l_@@_bodyfrac_fp
          { 1 - \l_@@_graphprop_fp - \gridunit/\textwidth }
          \begin{minipage}[t]{\fp_to_decimal:N\l_@@_graphprop_fp\textwidth}
            \hspace{0pt}
          \end{minipage}%
          \hspace{\gridunit}%
          \begin{minipage}[t]{\fp_to_decimal:N\l_@@_bodyfrac_fp\textwidth}
            \BODY
          \end{minipage}%
        }
        { r } {
          \fp_set:Nn \l_@@_bodyfrac_fp
          { 1 - \l_@@_graphprop_fp - \gridunit/\textwidth }
          \begin{minipage}[t]{\fp_to_decimal:N\l_@@_bodyfrac_fp\textwidth}
            \BODY
          \end{minipage}%
          \hspace{\gridunit}%
          \begin{minipage}[t]{\fp_to_decimal:N\l_@@_graphprop_fp\textwidth}
            \hspace{0pt}
          \end{minipage}%
        }
        { t } {
          \begin{minipage}[t]{\textwidth}
            \BODY
          \end{minipage}%
        }
        { b } {
          \begin{minipage}[t]{\textwidth}
            \BODY
          \end{minipage}%
        }
      }
      { \msg_error:nnn { ugentdocs } { unknown~graphpos } { \l_@@_graphpos_tl } }
    }{
      \BODY
    }
  \end{frame}
}


