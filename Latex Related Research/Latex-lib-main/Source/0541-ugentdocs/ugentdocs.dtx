\tl_new:N \l_@@_embargoenddate_tl

\msg_new:nnn { ugentdocs }
{ embargo-start-without-end }
{ An~embargo~start~date~was~given,~but~no~end~date}
\msg_new:nnn { ugentdocs }
{ embargo-end-without-start }
{ An~embargo~end~date~was~given,~but~no~start~date}

\keys_define:nn { ugentdocs/embargo } {
  start .tl_set:N = \l_@@_embargostartdate_tl ,
  end   .tl_set:N = \l_@@_embargoenddate_tl ,
}

\NewDocumentCommand{\embargo}{O{}}{
  \bool_set_true:N \l_@@_embargo_bool
  \tl_clear:N \l_@@_embargostartdate_tl
  \tl_clear:N \l_@@_embargoenddate_tl
  \keys_set:nn { ugentdocs/embargo } { #1 }
  \tl_if_empty:NTF \l_@@_embargostartdate_tl {
    \tl_if_empty:NF \l_@@_embargoenddate_tl {
      \msg_error:nn { ugentdocs } { embargo-end-without-start }
    }
  }{
    \tl_if_empty:NTF \l_@@_embargoenddate_tl {
      \msg_error:nn { ugentdocs } { embargo-start-without-end }
    }{
      \bool_set_true:N \l_@@_embargotemp_bool
      \regex_replace_all:nnN {\s} {\c{space}} \l_@@_embargostartdate_tl
      \regex_replace_all:nnN {\s} {\c{space}} \l_@@_embargoenddate_tl
      \@@_embargostoredate:NN \@embargotempstart \l_@@_embargostartdate_tl
      \@@_embargostoredate:NN \@embargotempend \l_@@_embargoenddate_tl
    }
  }
}

\tl_new:N \l_@@_embargodatetmp_tl
\cs_new_protected:Nn \@@_embargostoredate:NN {
  \tl_set:Nx \l_@@_embargodatetmp_tl {#2}
  \exp_args:Nnx \regex_match:nnTF {^\d{4}-\d{2}-\d{2}$} {\l_@@_embargodatetmp_tl} %$
  {
    \tl_gset:Nx #1 {
      \exp_not:N \DTMdisplaydate
      { \exp_args:NV \tl_range:nnn \l_@@_embargodatetmp_tl {1} {4} }
      { \exp_args:NV \tl_range:nnn \l_@@_embargodatetmp_tl {6} {7} }
      { \exp_args:NV \tl_range:nnn \l_@@_embargodatetmp_tl {9} {10} }
      {-1}
    }
  }{
    \tl_gset_eq:NN #1 #2
  }
}

\tl_new:N \l_@@_embargotemp_tl
\seq_new:N \l_@@_embargosplit_seq
\cs_new:Nn \_@@_embargosubstitute:nN {
