\tl_new:N  \l_@@_authorfirst_tl
\tl_new:N  \l_@@_authorsup_tl
\tl_new:N \l_@@_authororcid_tl

\cs_new_protected:Nn \@@_orcidlink:n {
  \cs_if_exist:NTF \href {
    \exp_args:Ne \href { \tl_to_str:n { https://orcid.org/#1 } }
    { \XeTeXLinkBox { \tikz[baseline=0pt]{\orcidicon {1.6ex} {orcidcolor} {0}} } }
  }{
    \tikz[baseline=0pt]{\orcidicon {1.6ex} {orcidcolor} {0}}
  }
}
\cs_new_protected:Nn \@@_printauthorlist: {
  \seq_clear:N \l_@@_authorentries_seq
  \seq_map_indexed_inline:Nn \g_@@_authorsurnames_seq {
    % Name
    \tl_set:Nn \l_@@_surname_tl {##2}
    \tl_set:Nx \l_@@_firstname_tl { \seq_item:Nn \g_@@_authorfirstnames_seq {##1} }
    \tl_if_empty:NF \l_@@_firstname_tl {
      \tl_set:Nx \l_@@_firstname_tl
      { \exp_not:N \textcolor { firstnamecolor } { \exp_not:V \l_@@_firstname_tl } }
    }
    \@@_buildformattedname:
    \tl_set_eq:NN \l_@@_authorentry_tl \l_@@_formattedname_tl

     % Superscript
    \tl_set:Nx \l_@@_authorsup_tl { \seq_item:Nn \g_@@_authoraffs_seq {##1} }
    \seq_if_in:NnT \g_@@_authorcorr_seq {##1} {
      \tl_if_empty:NF \l_@@_authorsup_tl { \tl_put_right:Nn \l_@@_authorsup_tl {,} }
      \tl_put_right:Nn \l_@@_authorsup_tl { * }
    }
    \tl_if_empty:NF \l_@@_authorsup_tl {
      \tl_put_right:Nx \l_@@_authorentry_tl
      { \exp_not:N \textsuperscript { \exp_not:V \l_@@_authorsup_tl } }
    }
    % ORCID
    \tl_set:Nx \l_@@_authororcid_tl { \seq_item:Nn \g_@@_authororcids_seq {##1} }
    \tl_if_blank:VF \l_@@_authororcid_tl {
      \tl_put_right:Nx \l_@@_authorentry_tl {
        \exp_not:N \,
        \exp_not:N \@@_orcidlink:n { \exp_not:V \l_@@_authororcid_tl }
      }
    }
    \seq_put_right:NV \l_@@_authorentries_seq \l_@@_authorentry_tl
  }
  \seq_use:Nnnn \l_@@_authorentries_seq{~\&~}{,~}{\translatekey{andlist}~}
}

% Print author footnote
\seq_new:N \l_@@_fnemails_seq
\seq_new:N \l_@@_fnorcids_seq
\tl_new:N  \l_@@_fnname_tl
\str_new:N \l_@@_orcidurl_str

\cs_new_protected:Nn \@@_printauthorfootnote: {
  \seq_clear:N \l_@@_fnemails_seq
  \seq_clear:N \l_@@_fnorcids_seq
  \seq_map_indexed_inline:Nn \g_@@_authoremails_seq {
    % name
    \tl_set:Nx \l_@@_fnname_tl { \seq_item:Nn \g_@@_authorfirstnames_seq {##1} }
    \tl_if_empty:NF \l_@@_fnname_tl {
      \tl_set:Nx \l_@@_fnname_tl { \tl_head:N \l_@@_fnname_tl . ~ }
    }
    \tl_put_right:Nx \l_@@_fnname_tl { \seq_item:Nn \g_@@_authorsurnames_seq {##1} }
    % email
    \tl_if_blank:nF {##2} {
      \seq_put_right:Nx \l_@@_fnemails_seq
      { \exp_not:n {##2} ~ ( \exp_not:V \l_@@_fnname_tl ) }
    }
    % ORCID
    \tl_set:Nx \l_tmpa_tl { \seq_item:Nn \g_@@_authororcids_seq {##1} }
    \tl_if_blank:VF \l_tmpa_tl {
      \str_set:Nx \l_@@_orcidurl_str { https://orcid.org/ \l_tmpa_tl }
      \seq_put_right:Nx \l_@@_fnorcids_seq {
        \cs_if_exist:NTF \href{
          \exp_not:N \href { \l_@@_orcidurl_str } { \exp_not:V \l_tmpa_tl }
        }{
          \exp_not:V \l_tmpa_tl
        }
        {}~ ( \exp_not:V \l_@@_fnname_tl )
      }
    }
  }
  \bool_lazy_all:nF {
    { \seq_if_empty_p:N \g_@@_authorcorr_seq }
    { \seq_if_empty_p:N \l_@@_fnemails_seq }
    { \seq_if_empty_p:N \l_@@_fnorcids_seq }
  }{
    \group_begin:
    \cs_set_eq:NN \thefootnote \relax % unnumbered
    \cs_set:Npn \@makefntext ##1
    { \dim_zero:N \parindent \noindent ##1 }
    \footnotetext {
      \seq_if_empty:NF \g_@@_authorcorr_seq {
        \textsuperscript{*} ~ \translatekey{corrauthor}. \par
      }
      \seq_if_empty:NF \l_@@_fnemails_seq {
        \translatekey{emails}: ~
        \seq_use:Nn \l_@@_fnemails_seq { , ~ } . \par
      }
      \seq_if_empty:NF \l_@@_fnorcids_seq {
        ORCID: ~ \seq_use:Nn \l_@@_fnorcids_seq { , ~ } . \par
      }
    }
    \group_end:
  }
}

