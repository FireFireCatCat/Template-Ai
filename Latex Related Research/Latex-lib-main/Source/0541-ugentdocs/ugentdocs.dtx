% \newpage
% \subsection{Copyright notices}
% \label{S:style:copyright}
%
% This section defines the copyright notices of
% the |bama|, |phd|, |course|, |report|, and |article| classes.
% These can be overridden using the |\copyrightnotices| macro
% (see Section \ref{S:usage:macros:data}).
%
% For the |bama| class, the autograph fields code is not shown here,
% since it is too complex to customize.
% \iffalse
%<*bama>
\ExplSyntaxOn
\cs_new:Nn \@@_sigblock:nn {
  \begin{minipage}[t]{\linewidth}
    \centering
    \rule{0pt}{1.25cm}\\
    \rule{0.8\linewidth}{0.4pt}\\[0.3em]
    #2\\
    {\small\itshape #1}
  \end{minipage}
}

\int_new:N \l_@@_sigcount_int

\cs_new:Nn \@@_sigrow_step:nn {
  \int_incr:N \l_@@_sigcount_int
  \@@_sigblock:nn {#1} {#2}
  \int_compare:nNnTF {\int_mod:nn {\l_@@_sigcount_int}{2}} = {1}
  { & }
  { \tabularnewline[2em] }
}

\tl_new:N \l_@@_sigrow_tl
\seq_new:N \l_@@_sigpairs_seq

\cs_new:Nn \@@_siggroup:Nn {
  \int_compare:nNnTF {\seq_count:N #1} = {1}
  {
    \noindent
    \begin{tabularx}{\textwidth}{@{}X@{\hspace{1.5cm}}X@{}}
      \seq_map_inline:Nn #1 { \@@_sigblock:nn {#2} {##1} } & \tabularnewline
    \end{tabularx}
  }{
    \seq_clear:N \l_@@_sigpairs_seq
    \int_zero:N \l_@@_sigcount_int
    \tl_clear:N \l_@@_sigrow_tl
    \seq_map_inline:Nn #1 {
      \int_incr:N \l_@@_sigcount_int
      \int_compare:nNnTF {\int_mod:nn {\l_@@_sigcount_int}{2}} = {1}
      {
        \tl_set:Nn \l_@@_sigrow_tl { \@@_sigblock:nn {#2} {##1} }
      }{
        \seq_put_right:Nx \l_@@_sigpairs_seq
        { \exp_not:V \l_@@_sigrow_tl & \exp_not:n { \@@_sigblock:nn {#2} {##1} } }
        \tl_clear:N \l_@@_sigrow_tl
      }
    }
    \tl_if_empty:NF \l_@@_sigrow_tl {
      \seq_put_right:Nx \l_@@_sigpairs_seq { \exp_not:V \l_@@_sigrow_tl & }
    }
    \noindent
    \begin{tabularx}{\textwidth}{@{}X@{\hspace{1.5cm}}X@{}}
      \seq_use:Nn \l_@@_sigpairs_seq { \tabularnewline[2em] }
    \end{tabularx}
  }
}

\cs_new:Nn \@@_autographpage: {
  \seq_if_empty:NF \g_@@_authors_seq {
    \translatekey{the-de}~\getseqcaption[lowercase]{authors}{}, \par\vskip 1em
    \@@_siggroup:Nn \g_@@_authors_seq { } % Sub-name key not implemented
  }
  \vskip 2em
  \seq_if_empty:NF \g_@@_allsupervisors_seq {
    \translatekey{the-de}~\getseqcaption[lowercase]{allsupervisors}{}
    \ifseqempty{tutors}{}{~\translatekey[lowercase]{and}~\getseqcaption[lowercase]{tutors}{}}, \par\vskip 1em
    \@@_siggroup:Nn \g_@@_allsupervisorstutors_seq { } % Sub-name key not implemented
  }
}
\ExplSyntaxOff
%</bama>
% \fi
% The copyright notices of the |bama| class include
% the |\@bamadisclaimer| in both English and Dutch for an English dissertation,
% a line with the location and date, and the autograph page:
%    \begin{macrocode}
%<*bama>
\ExplSyntaxOn
\renewcommand{\@copyrightnotices}{%
  \clearpage
  \str_if_eq:VnTF \l_@@_language_tl {dutch} {
    \@bamadisclaimer
  }{
    \begingroup % Has to be with selectlanguage for the date translation
    \selectlanguage{dutch}
    \@bamadisclaimer
    \endgroup
    \\[\baselineskip]
    \selectlanguage{english}
