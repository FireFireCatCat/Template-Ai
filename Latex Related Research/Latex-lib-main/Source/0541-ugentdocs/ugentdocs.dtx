%
% The |article| class uses a simple title, no cover page is included.
% It includes a ``cover'' page containing the graphical abstract, highlights,
% and copyright notice (if those are given).
% The title page contains the title,
% author names with affiliations and ORCID badges,
% the affiliation list,
% optional grant message, and
% the article info and abstract table.
% A footnote is included with the author emails and ORCIDs.
%    \begin{macrocode}
%<*art>
\ExplSyntaxOn
\renewcommand\maketitle{%
  % First page (if applicable)
  \bool_lazy_or:nnT
    { ! \tl_if_empty_p:o { \@graphicalabstract } }
    { ! \tl_if_empty_p:N \g_@@_highlights_tl }
  { \thispagestyle{empty}
    \color{covertitlecolor}{
      \fontsize{20}{28}\selectfont\@title\par
    }
    \vskip 0.5\gridunit
    \color{coverdatacolor}{
      \fontsize{14}{17}\selectfont
      \printseq{authorlist}{~\&~}{,~}{\translatekey{andlist}~}
      \par
    }

    \tl_if_empty:oF { \@graphicalabstract }{
      \color{covertitlecolor}{
        \fontsize{20}{28}\selectfont
        \vskip\gridunit
        \translatekey{graphicalabstract}\par
      }
      \@graphicalabstract
    }
    \tl_if_empty:NF \g_@@_highlights_tl {
      \vskip\gridunit
      \color{covertitlecolor}{
        \fontsize{20}{28}\selectfont
        \translatekey{highlights}\par
      }
      \color{coverdatacolor}{
        \fontsize{14}{17}\selectfont
        \@@_printhighlights:
      }
    }
    \ifx\@copyrightnotices\@empty\else
    \null\vfill
    \@copyrightnotices
    \fi
  }
  \newpage
  \thispagestyle{titlepage}
  % Title
  \color{covertitlecolor}{\fontsize{20}{28}\selectfont\@title\par}
  % Author and affiliation list
  \vskip 0.5\gridunit
  \color{coverdatacolor}{
    \fontsize{14}{17}\selectfont
    \@@_printauthorlist:
    \par
    \vskip 0.5\gridunit
    \fontsize{10}{12}\selectfont
    \@@_printaffiliationlist:
    \ifx\@grants\@empty\else
      \vskip 0.25\gridunit
      {\translatekey{supportedby}~\@grants.}
    \fi
    \vskip 0.5\gridunit
    \hrule \medskip
    \noindent
     % Article info
    \begin{minipage}[t]{0.3\linewidth}
      \raggedright
      \fontsize{14}{17}\selectfont
      \translatekey[uppercase]{articleinfo} \par
      \smallskip \hrule \medskip
      \normalsize
      % keywords
      \clist_if_empty:NF \g_@@_keywords_clist {
        \textit{ \translatekey{keywords} } \par
        \clist_map_inline:Nn \g_@@_keywords_clist { ##1 \par }
        \medskip
      }
      % dates
      \tl_if_empty:oF {\@submitteddate} {
        \translatekey{submitted}~\@submitteddate \par
      }
      \tl_if_empty:oF {\@accepteddate} {
        \translatekey{accepted}~\@accepteddate \par
      }
      \tl_if_empty:oF {\@publisheddate} {
        \translatekey{published}~\@publisheddate \par
      }
      % journal
      \tl_if_empty:oF { \@journal } {
        \medskip
        \translatekey{published}~\translatekey[lowercase]{in}:
        {}~\textit{ \@journal } \par
      }
      % doi
      \tl_if_empty:oF { \@doi }{
        \medskip{DOI~
          \@ifpackageloaded{hyperref}{
            \exp_args:NV \href \l_@@_doiurl_str {\@doi}
          }{
            \@doi
          }
        }
      }
    \end{minipage}
    \hfill
    % Abstract
    \begin{minipage}[t]{0.65\linewidth}
      \fontsize{14}{17}\selectfont
      \translatekey[uppercase]{abstract} \par
      \smallskip \hrule \medskip
      \normalsize
      \@abstract
    \end{minipage}
    \par \medskip \hrule
  }
  \@@_printauthorfootnote:
}
