% Add author to sequences
\cs_new:Nn \@@_addauthor:nnnn {
  \tl_clear:N \l_@@_author_email_tl
  \tl_clear:N \l_@@_author_orcid_tl
  \bool_set_false:N \l_@@_author_iscorresponding_bool
  \keys_set:nn { ugentdocs / author } {#4}

  \@@_addto_affseq:n {#3} % must be before nameaffiliationseq

  \@@_addto_nameseq:nnn             {authors} {#1}{#2}
  \@@_addto_nameaffiliationseq:nnnV {authors} {#1}{#2}{\l_@@_affiltext_tl}
  \@@_addto_callseq:nnnnn           {authors} {#1}{#2}{#3}{#4}

  \tl_if_blank:VTF \l_@@_author_email_tl {
    \seq_gput_right:Nn \g_@@_authoremails_seq {}
  }{
    \@@_formatemail:V \l_@@_author_email_tl
    \seq_gput_right:NV \g_@@_authoremails_seq \l_@@_email_tl
  }
  \seq_gput_right:NV \g_@@_authororcids_seq \l_@@_author_orcid_tl
  \bool_if:NT \l_@@_author_iscorresponding_bool{
    \seq_gput_right:Nx \g_@@_authorcorr_seq
    { \seq_count:N \g_@@_authors_seq }
  }

  \@@_parsename:n {#2}
  \seq_gput_right:NV \g_@@_authorsurnames_seq   \l_@@_surname_tl
  \seq_gput_right:NV \g_@@_authorfirstnames_seq \l_@@_firstname_tl
  \seq_gput_right:Nx \g_@@_authorlist_seq {
    \exp_not:V \l_@@_surname_tl ,~\tl_head:N \l_@@_firstname_tl .
  }
}

\keys_define:nn { ugentdocs / author }{
  corresponding .bool_set:N = \l_@@_author_iscorresponding_bool,
  corresponding .default:n  = true,
  email         .tl_set:N   = \l_@@_author_email_tl,
  orcid         .tl_set:N   = \l_@@_author_orcid_tl,
}

