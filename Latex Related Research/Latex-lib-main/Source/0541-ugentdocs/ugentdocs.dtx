    \bool_gset_eq:Nc \g_@@_framenumber_bool { c_#1_bool }
  }{
    \bool_gset_eq:Nc \g_@@_framenumber_bool { c_ \g_@@_framenumberkey_tl _bool }
  }
}

% Helper CS to set frame style
% Args: background canvas, inverse text (true/false)
\cs_new_protected:Npn \@@_framestyle:nn #1#2 {
  \@@_setinverse:n {#2}
  \clist_map_inline:nn { title~page, section~page, subsection~page }
