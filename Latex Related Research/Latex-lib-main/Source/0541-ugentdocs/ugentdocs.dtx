% \subsubsection{Geometry}
% \label{S:usage:packages:geometry}
% The |geometry| package is used to set the paper size for the documents.
% Based on the paper width and height, we define the |\gridunit| length
% from the official grid layout. It is calculated by dividing the long paper edge
% by 7, and then again by 4. You can use this length in your own graphics, and
% you \emph{can} technically override it in your customization file using
% |\setlength\gridunit{<length>}|,
% although this is not recommended.
%
% \iffalse
%<*crs|bama|phd|rp|le|ex|bkc|bmr|art>
\newlength{\@PW}      % Paper width
\newlength{\@PH}      % Paper height
\newlength{\gridunit} % Grid unit layout
\newcommand*{\@setgridunit}{\pgfmathsetlength{\gridunit}{max(\@PW,\@PH)/7/4}}
%</crs|bama|phd|rp|le|ex|bkc|bmr|art>
% \fi
% \newlength{\gridunit}
% \pgfmathsetlength{\gridunit}{297mm/7/4}
