% \subsection{Headers and Footers}
% \label{S:style:headerfooter}
% The |fancyhdr| package is used to make the headers and footers.
% Using this, we can set left/centre/right (L/C/R) areas of the headers and footers.
%
% For the |course| class, we define separate headers and footers
% for two-sided and one-sided documents.
% For two-sided even pages, we put the page number in the left header,
% the chapter title in the right header, and ``Ghent University'' (translated)
% with the faculty acronym (e.g., FBW) in the left footer.
% For two-sided odd pages, we put the page number in the right header,
% the section title in the left header, the course version in the left footer,
% and the title of the course and short subtitle in the right footer.
% For one-sided courses, we put the chapter title in the left header,
% the page number in the right header, the course version in the left footer,
% ``Ghent University'' (translated) and the faculty abbreviation in the centre footer,
% and the course title in the right footer.
% For both document types, we set the header height to 13.7pt,
% and the footer and header rule or line thickness to 1 pt.
% Page numbering is in arabic for all pages.
% For a plain page style, i.e., the title page of a chapter or section,
% we only print the page number in the centre of the footer.
%
% The choices above results in the following code:
%
%    \begin{macrocode}
%<*crs>
\fancyhf{}
\if@twoside
  \fancyhead[LE]{\small\thepage}
  \fancyhead[RE]{\small\leftmark}
  \fancyfoot[LE]{
    \small\translatekey{org-ugent}
    \ifx\@fselector\@empty\else -- \@facultyacronym\fi
  }

  \fancyhead[LO]{\small\rightmark}
  \fancyhead[RO]{\small\thepage}
  \fancyfoot[LO]{
    \ifx\@courseversion\@empty\else
      \small\translatekey{version}~\@courseversion
    \fi
  }
  \fancyfoot[RO]{
    \small{\renewcommand{\\}[1][]{~}\@title{}}
    \ifdefvoid{\@shortsubtitle}{}{ --- \@shortsubtitle}
  }
\else
  \fancyhead[L]{\small\leftmark}
  \fancyhead[R]{\small\thepage}
  \fancyfoot[L]{
    \ifx\@courseversion\@empty\else
      \small\translatekey{version}~\@courseversion
    \fi
  }
  \fancyfoot[C]{
    \small\translatekey{org-ugent}
    \ifx\@fselector\@empty\else -- \@facultyacronym\fi
  }
  \fancyfoot[R]{
    \small{\renewcommand{\\}[1][]{~}\@title{}}
  }
\fi
\fancypagestyle{plain}{%
  \fancyhf{}
