%
% Next, we set the lengths based on the Office templates:
%    \begin{macrocode}
%<*phd|bkc|crs|bama|rp|ex>
\ExplSyntaxOn
\setlength\@B{3mm}
\bool_if:NTF \l_@@_bwphdcover_bool {
  % BW phd cover
  \setlength\@HBS{4\gridunit}
  \setlength\@HTS{0mm}
  \setlength\@BT{\@B}
  \setlength\@MS{0mm}
  \setlength\@MTLR{2\gridunit}
  \setlength\@MTTB{\gridunit}
  \setlength\@WD{0mm}
  \setlength\@HD{0mm}
  \setlength\@HT{2\@HBS}
}{
  % UGent cover
  \setlength\@HBS{4\gridunit}
  \tl_if_empty:NTF \l_@@_fselector_tl {
    \setlength\@HTS{0mm}
    \setlength\@BT{\@B}
  }{
    \setlength\@HTS{3\gridunit}
    \setlength\@BT{0mm}
  }
  \setlength\@MS{\gridunit}
  \setlength\@MTLR{\gridunit}
  \setlength\@MTTB{\gridunit}
  \setlength\@WD{12\gridunit}
  \setlength\@HD{10\gridunit}
  \pgfmathsetlength{\@HT}{0.5*\@PH+0.5*\@HBS-0.5*\@HTS+0.5*\@HD}
}
\ExplSyntaxOff
%</phd|bkc|crs|bama|rp|ex>
%    \end{macrocode}
%
% For the |bama|, |report|, and |exam|,
% the title position and text margin differ slightly:
%    \begin{macrocode}
%<*bama|rp|ex>
\ExplSyntaxOn
\setlength\@HT{0.9\@PH}

\bool_if:NTF \l_@@_coverbg_bool {
  \setlength\@MTLR{2\gridunit}
}{
  \setlength\@MTLR{\gridunit}
}
\ExplSyntaxOff
%</bama|rp|ex>
%    \end{macrocode}
%
% And the |course| data area width is slightly narrower:
%    \begin{macrocode}
%<*phd|bkc|crs>
\ExplSyntaxOn
\exp_args:Nx \str_case:nnF { \l_@@_covertype_tl } {
  { phd } { }
  { course } {
    \setlength\@WD{10\gridunit}
  }
}{
  \msg_error:nnx { ugentdocs } { cover~type~not~implemented } { \l_@@_covertype_tl }
}
\ExplSyntaxOff
%</phd|bkc|crs>
%    \end{macrocode}
%
%
% \subsubsection{Cover bodies}
% The cover body text itself differs between all classes,
% so we set it here. For the |bama| and |report| classes,
% the code was adapted from Joris Meys' LaTeX at UGent.
%
% \DescribeObject[custom]{\@coverbodybama}
%   The |bama| cover body consists of
%   the title, subtitle (if present),
%   word count (if given), confidentiality (if applicable),
%   author name(s), student nr. (one, if given),
%   (co/external) supervisors and tutor (if given),
%   the ``Submitted to\ldots'' text, and
%   the academic year:
%    \begin{macrocode}
%<*bama|rp>
\ExplSyntaxOn
\tl_new:N \l_@@_authortable_tl
\ExplSyntaxOff
%</bama|rp>
%<*bama>
\ExplSyntaxOn
\newcommand{\@coverbodybama}{
  \node[anchor=north~west, inner~sep=0pt, text~width=\@PW-\@MTLR-\gridunit,
  minimum~height=22.05cm, align=flush~left] at (\@MTLR,\@HT)
  {%
    \raggedright
    \begin{spacing}{2.5}
      {\fontsize{25}{30}\selectfont\color{covertitlecolor}\bfseries
        \MakeUppercase{\uline{\@title}}}
    \end{spacing}

    \vskip 1em

    {\fontsize{15}{18}\selectfont\color{covertitlecolor}
      \MakeUppercase{\@subtitle}}

    \vskip 1em

    \begingroup\color{coverdatacolor}
    \ifx\@wordcount\@empty\else
    \translatekey{wordcount}:~\@wordcount
    \fi

    \bool_if:NTF \l_@@_embargo_bool {
      \vskip 5em
      {\fontsize{15}{18}\selectfont\translatekey[uppercase]{confidential}}
      \vskip 5em
    }{
      \vskip 10em
    }

    \tl_set:Nx \l_@@_authortable_tl { \printseq{authorswaff}{\cr}{\cr}{\cr} }
    {\fontsize{15}{18}\selectfont
      \leavevmode\vbox{\halign{##\hfil&\hskip1em##\hfil\cr
          \l_@@_authortable_tl
          \cr}}
    }

    \ifx\@studentnr\@empty\else
    \par\translatekey{studentnr}:~\@studentnr
    \fi

    \vskip 1em

    {\fontsize{12}{15}\selectfont
      \getseqcaption{supervisors}{
        :~\printseq{supervisors}{~\&~}{,~}{\translatekey{andlist}~}\\}
    }

    {\fontsize{12}{15}\selectfont
      \getseqcaption{cosupervisors}{
        :~\printseq{cosupervisors}{~\&~}{,~}{\translatekey{andlist}~}\\}
    }

    {\fontsize{12}{15}\selectfont
      \getseqcaption{extsupervisors}{
        :~\printseq{extsupervisors}{~\&~}{,~}{\translatekey{andlist}~}\\}
    }

    \ifseqempty{tutors}{}{
      \vskip 1em
      {\fontsize{12}{15}\selectfont
        \getseqcaption{tutors}{}
        :~\printseq{tutors}{~\&~}{,~}{\translatekey{andlist}~}
      }
    }

    \vskip 1em
    {\@doctype{}~\translatekey[lowercase]{submittedto}%
      \ifx\@fselector\@empty\else{}%
        {}~\translatekey[lowercase]{the-de}~\@faculty{}~\translatekey[lowercase]{of}%
      \fi{}%
      {}~\translatekey{org-deugent},~\translatekey{bmfulfil}%
      {}~\printseq{degrees}{~\&~}{,~}{\translatekey{andlist}~}}

    \vskip 1em
    \translatekey{acyear}:~\@academicyear
    \endgroup
  };
}
\ExplSyntaxOff
%</bama>
%<rp|ex>\newcommand{\@coverbodybama}{}
%    \end{macrocode}
%
% \DescribeObject[custom]{\@coverbodyreport}
%   The |report| cover body consists of
%   the title, subtitle, and extra title (if present),
%   word count (if given),
%   author name(s), student nr. (one, if given),
%   lecturers (if given),
%   address (if given),
%   and the academic year (if given):
%    \begin{macrocode}
%<*rp>
\ExplSyntaxOn
\newcommand{\@coverbodyreport}{
  \node[anchor=north~west, inner~sep=0pt, text~width=\paperwidth-\@MTLR-\gridunit,
  minimum~height=22.05cm, align=flush~left] at (\@MTLR,\@HT)
  {%
    \raggedright
    \begin{spacing}{2.5}
      {\fontsize{25}{30}\selectfont\color{covertitlecolor}\bfseries
        \MakeUppercase{\uline{\@title}}}
    \end{spacing}

    \vskip 1em

    {\fontsize{15}{18}\selectfont\color{covertitlecolor}
      \MakeUppercase{\@subtitle}}

    \vskip 2em

    \begingroup\color{coverdatacolor}
    \ifx\@extra\@empty\else
    {\fontsize{12}{15}\selectfont\@extra}
    \fi

    \ifx\@wordcount\@empty\else
    \translatekey{wordcount}:~\@wordcount
    \fi

    \ifseqempty{authors}{
      \vskip 10em
    }{
      \vskip 5em
      \tl_set:Nx \l_@@_authortable_tl { \printseq{authorswaff}{\cr}{\cr}{\cr} }
      {\fontsize{12}{15}\selectfont
        \leavevmode\vbox{\halign{##\hfil&\hskip1em##\hfil\cr
            \l_@@_authortable_tl
            \cr}}
      }
      \ifx\@studentnr\@empty\else
      \translatekey{studentnr}:~\@studentnr
      \fi
      \vskip 5em
    }

    \ifseqempty{lecturers}{}{
      {\fontsize{12}{15}\selectfont
        \getseqcaption{lecturers}{}:~\printseq{lecturers}{~\&~}{,~}{\translatekey{andlist}~}}
      \vskip 2 em
    }

    \ifx\@address\@empty\else
    {\fontsize{12}{15}\selectfont\@address}
    \vskip 2 em
    \fi

    \ifx\@academicyear\@empty\else
    {\fontsize{12}{15}\selectfont\translatekey{acyear}:~\@academicyear}
    \fi
    \endgroup
  };
}
\ExplSyntaxOff
%</rp>
%<bama|ex>\newcommand{\@coverbodyreport}{}
%    \end{macrocode}
%
% \DescribeObject[custom]{\@coverbodyexam}
%   The |exam| cover body consists of
%   the course titles,
%   the exam part,
%   the course codes,
%   the exam series,
%   the exam date,
%   a fill-in section for the student's surname, name, and ID,
%   the exam duration, start time, and end time,
%   the examination room, lecturers, and degree:
%    \begin{macrocode}
%<*ex>
\ExplSyntaxOn
\newcommand{\@coverbodyexam}{
  % Top data
  \node[anchor=north~west,text~width={\paperwidth-\@MTLR-\gridunit},align=flush~left]
  at (\@MTLR,{\paperheight-\@HTS-\gridunit}) {%
    \color{covertitlecolor}{
      \fontsize{18}{22}\selectfont%
      \textsf{\textbf{\printseq{courses}{\\}{\\}{\\}}}\par
      \ifx\@exampart\@empty\else
        \textsf{\textbf{\@exampart}}\par
      \fi
      \fontsize{12}{18}\selectfont%
      \textsf{\printseq{coursecodes}{\\}{\\}{\\}}
    }
    \color{coverdatacolor}{
      \vskip 2em
      \fontsize{12}{18}\selectfont%
      \textsf{
        \ifx\@examseries\@empty{}~\else\translatekey{series}~\@examseries{}\fi
      }
      \vskip 2em
      \fontsize{14}{19}\selectfont%
      \textsf{\translatekey{exam}~\@date{}}
    }
  };

  % Fill-in of surname, name, and student ID
  \node[anchor=south~west,align=left,inner~sep=0pt]
  at (\@MTLR,18){%
    \fontsize{12}{18}\selectfont%
    \color{coverdatacolor}{%
      \textsf{\translatekey{lastname}}
    }
  };
  \foreach \nn in {0,1,...,33} {
    \draw[fill=white] (\@MTLR,17) ++({0.5*\nn},0) rectangle +(0.5,0.8);
  }

  \node[anchor=south~west,align=left,inner~sep=0pt]
  at (\@MTLR,16){%
    \fontsize{12}{18}\selectfont%
    \color{coverdatacolor}{%
      \textsf{\translatekey{firstname}}
    }
  };
  \foreach \nn in {0,1,...,23} {
    \draw[fill=white] (\@MTLR,15) ++({0.5*\nn},0) rectangle +(0.5,0.8);
  }

  \node[anchor=south~west,align=left,inner~sep=0pt]
  at (\@MTLR+26*0.5cm,16){%
    \fontsize{12}{18}\selectfont%
    \color{coverdatacolor}{%
      \textsf{\translatekey{studentnr}}
    }
  };
  \foreach \nn in {0,1,...,7} {
    \draw[fill=white] (\@MTLR+26*0.5cm,15) ++({0.5*\nn},0) rectangle +(0.5,0.8);
  }

  % Bottom data
  \node[anchor=south~west,align=flush~left,inner~sep=0pt,text~width={\paperwidth-\@MTLR-\gridunit}]
  at (\@MTLR,5\gridunit){%
    \color{coverdatacolor}{
      \fontsize{12}{21}\selectfont%
      \textsf{\translatekey{examduration}:~\@examduration}\\
      \textsf{\begin{tabular}{@{}rl}%
        \translatekey{examstart}:~& \@examstart\\
        \translatekey{examend}:~& \@examend
        \end{tabular}}
      \vskip 2em
      \textsf{\getseqcaption{rooms}{:
        {}~\printseq{rooms}{~\&~}{,~}{\translatekey{andlist}~}}}
      \vskip 2em
       \begin{tabular}{@{}l@{~\,}p{14.5cm}}
        \getseqcaption{lecturers}{
        & \textbf{\printseq{lecturers}{~\&~}{,~}{\translatekey{andlist}~}}}
      \end{tabular}
      \vskip 2em
      \textsf{\printseq{degrees}{\\}{\\}{\\}}
    }
  };
}
\ExplSyntaxOff
%</ex>
%<bama|rp>\newcommand{\@coverbodyexam}{}
%    \end{macrocode}
%
% \DescribeObject[custom]{\@coverbodycourse}
%   The |course| cover body consists of
%   the title, subtitle (if present),
%   lecturers (if given),
%   degrees (if given),
%   and the academic year:
%    \begin{macrocode}
%<*bkc|crs>
\newcommand\@coverbodycourse{
  \newlength\@parboxheight
  \newlength\@parboxwidth
  \pgfmathsetlength{\@parboxheight}{\@HD-2*\@MTTB}
  \pgfmathsetlength{\@parboxwidth}{\@WD-2*\@MTLR}

  \node[anchor=north west, inner sep=0pt, text=coverdatacolor]
  at (\@MS+\@MTLR, \@HBS+\@HD-\@MTTB) {
    \parbox[t][\@parboxheight][t]{\@parboxwidth}{
      \raggedright
      {\fontsize{35}{42}\selectfont\bfseries
        \MakeUppercase{\uline{\@title}}\par}
      %
      \ifx\@subtitle\@empty\else
        \vspace{5pt}
        \hyphenpenalty=100000
        {\fontsize{30}{36}\selectfont\bfseries
          \@subtitle}
      \fi
      \par
      \vfill
      \par
      {\fontsize{18}{22}\selectfont \printseq{lecturers}{\\}{\\}{\\}}%
      %
      \vskip 2 em
      %
      {\fontsize{15}{20}\selectfont
        \printseq{degrees}{\\}{\\}{\\}\\
        \translatekey{acyear}~\@academicyear}%
    }
  };
}
%</bkc|crs>
%    \end{macrocode}
%
% \DescribeObject[custom]{\@coverbodyphd}
%   The |phd| cover body consists of
%   the title, subtitle (if present),
%   author(s), supervisors, academic year,
%   and the ``Submitted to\ldots'' text.
%   A FBW variant of the PhD cover exists with only
%   the title, subtitle, and author(s) listed:
%    \begin{macrocode}
%<*bkc|phd>
\ExplSyntaxOn
\newcommand\@coverbodyphd{
  % Title, subtitle, author
  \bool_if:NTF \l_@@_bwphdcover_bool {
    \node[anchor=south~east, text~width=\@PW-2*\@MTLR, align=flush~right, text=covertitlecolor]
    at (\@PW-\@MTLR, \@HT) {
      {\fontsize{28}{30}\selectfont\bfseries\nohyphens{\@title}\par}%
      \ifx\@subtitle\@empty\else\vspace{4pt}\hyphenpenalty=100000%
      {\fontsize{20}{28}\selectfont\bfseries\@subtitle\par}%
      \fi%
      \vspace{30pt}\hyphenpenalty=100000%
      {\fontsize{20}{24}\selectfont\printseq{authors}{\\}{\\}{\\}}};
  }{
    \node[anchor=west, text~width=\@PW-2*\@MTLR-\@MS, align=flush~left, text=covertitlecolor]
    at (\@MS+\@MTLR, \@HT) {
      {\fontsize{28}{30}\selectfont\bfseries\nohyphens{\@title}\par}%
      \ifx\@subtitle\@empty\else\vspace{5pt}\hyphenpenalty=100000%
        {\fontsize{20}{28}\selectfont\bfseries\@subtitle\par}
      \fi
    };

    \node[anchor=north~west, text~width=\@WD-2*\@MTLR, align=flush~left, text=coverdatacolor]
    at (\@MS+\@MTLR, \@HBS+\@HD-\@MTTB) {
      {\fontsize{20}{24}\selectfont\bfseries\printseq{authors}{\\}{\\}{\\}}%
      \\[15pt]
      {\fontsize{14}{17}\selectfont\getseqcaption{supervisors}{:\newline}
        \printseq{supervisors}{\\}{\\}{\\}}%
      \\[15pt]
      {\fontsize{11}{15}\selectfont\translatekey{acyear}~\@academicyear}};

    \node[anchor=south~west, text~width=\@WD-2*\@MTLR, align=flush~left, text=coverdatacolor]
    at (\@MS+\@MTLR, \@HBS+\@MTTB){%
      \fontsize{11}{15}\selectfont\nohyphens{%
        \@doctype{}~\translatekey[lowercase]{submittedto}%
        \ifx\@fselector\@empty\else{}%
          {}~\translatekey[lowercase]{the-de}~\@faculty{}~\translatekey[lowercase]{of}%
        \fi{}%
        {}~\translatekey{org-deugent},%
        {}~\translatekey{phdfulfil}~\printseq{degrees}{~\&~}{,~}{\translatekey{andlist}~}}};
  }

  \bool_if:NT \l_@@_embargo_bool {
    \@printconfidentialcover
  }
}
\ExplSyntaxOff
%</bkc|phd>
%    \end{macrocode}

% \DescribeObject[custom]{\@printconfidentialcover}
%   Prints the confidentiality word for PhD covers.
%   This appears in the top right of the front cover:
%    \begin{macrocode}
%<*phd|bkc|crs>
\ExplSyntaxOn
\newcommand{\@printconfidentialcover}{
  \bool_if:NTF \l_@@_bwphdcover_bool {
    \node[anchor=north~east,font=\fontsize{15}{18}\selectfont,covertitlecolor]
    at (\@PW-\gridunit,\@PH-\gridunit)
    {\textbf{\translatekey[uppercase]{confidential}}};

  }{
    \node[anchor=north~east,font=\fontsize{15}{18}\selectfont,ugent@main]
    at (\@PW-\gridunit,\@PH-\gridunit)
    {\textbf{\translatekey[uppercase]{confidential}}};
  }
}
\ExplSyntaxOff
%</phd|bkc|crs>
%    \end{macrocode}
%
% \DescribeObject[custom]{\@coverbody}
%   Finally, the appropriate cover body is selected:
%    \begin{macrocode}
%<*phd|bkc|crs|bama|rp|ex>
\ExplSyntaxOn
\newcommand*\@coverbody{
  \exp_args:Nx \str_case:nnF { \l_@@_covertype_tl } {
    { phd }    { \@coverbodyphd }
    { course } { \@coverbodycourse }
    { bama }   { \@coverbodybama }
    { report } { \@coverbodyreport }
    { exam }   { \@coverbodyexam }
  }{
    \msg_error:nnx { ugentdocs } { cover~type~not~implemented } { \l_@@_covertype_tl }
  }
}
\ExplSyntaxOff
%</phd|bkc|crs|bama|rp|ex>
%    \end{macrocode}
%
%
% \subsubsection{Front and back covers}
% This section contains the visual layout or canvas of the covers.
% These are used in the |\maketitle| and |\makefinalpage| commands.
%
% \DescribeObject[custom]{\@frontcover}
%   The front cover of the document.
%
% For |bama|, |report|, and |exam|, this consists of
% the logo placements,
% an optional background colour area,
% the |\@coverbody|,
% and frontcoverlogos:
%    \begin{macrocode}
%<*bama|rp|ex>
\ExplSyntaxOn
\newcommand{\@frontcover}{
  \begin{tikzpicture}[inner~sep=0pt, outer~sep=0pt]
  \clip (0,0) rectangle (\@PW,\@PH);

  % Faculty logo
  \begin{scope}[shift={(0,\@PH-3*\gridunit)}]
    \faclogo{3*\gridunit}{ugent@\@fselector}{0}
  \end{scope}

  % Coloured background
  \bool_if:NT \l_@@_coverbg_bool {
    \fill[coverbgcolor] (\gridunit,4*\gridunit) rectangle (\@PW,\@PH-\@HTS);
    \begingroup
    \colorlet{hypercolor}{covertitlecolor}
  }

  % Cover body
  \@coverbody

  % UGent logo
  \begin{scope}[shift={(0,0)}]
    \ugentlogo{4*\gridunit}{ugent@main}{0}
  \end{scope}

  % Front cover logos
  \ifx\@frontcoverlogos\@empty\else
    \node[anchor=south~east, inner~sep=0pt,
      text~width=\paperwidth-(2+\@ugenttextw/\@logounit)*\gridunit,
      minimum~height=2*\gridunit, align=flush~right]
    at (\paperwidth-\gridunit,\gridunit)
      {\@frontcoverlogos};
  \fi

  \bool_if:NT \l_@@_coverbg_bool {
    \endgroup
  }
  \end{tikzpicture}
}
\ExplSyntaxOff
