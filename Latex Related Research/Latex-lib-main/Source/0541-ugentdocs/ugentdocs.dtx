\setlength\@PW{210mm}
\setlength\@PH{297mm}
\@setgridunit
\RequirePackage[heightrounded,paperwidth=\@PW,paperheight=\@PH,
                top=2.54cm, bottom=2.54cm, left=2\gridunit, right=2.97cm]{geometry}
%</crs|rp|ex>
%<*phd>
\setlength\@PW{160mm}
\setlength\@PH{240mm}
\@setgridunit
\RequirePackage[heightrounded,paperwidth=\@PW,paperheight=\@PH,
                top=2.54cm,bottom=2.54cm,inner=2cm,outer=2cm,twoside]
                {geometry}
%</phd>
%<*bama>
