%   \marg{Surname, Firstname}
%   \marg{affiliation}
%   \margintag{mandatory}
%   \margintag{authors\_seq}
%   \margintag{authorswaff\_seq}
%   \margintag{authoraffs\_seq}
%   \margintag{authorlist\_seq}
%   \margintag{authorscalls\_seq}
%   \margintag{authorcorr\_seq}
%   \margintag{authoremails\_seq}
%   \margintag{authororcids\_seq}
%   \margintag{authorsurnames\_seq}
%   \margintag{authorfirstnames\_seq}\\
%   This macro adds an author to the document.
%   The author name should be in BibTeX format (i.e., ``Surname, Firstname'').
%   Use multiple calls for multiple authors.\\
%   The affiliation can have multiple formats, e.g.,
%   start with a newline: '|\\|',
%   start with '|, |' for regular inline,
%   or even '|&|' for horizontal alignment in the |bama| \& |report| cover pages.
%   Optional argument |corresponding| sets the author as corresponding,
%   |email| specifies the author email, and |orcid| the ORCID.
%   These are stored in the |authorcorr|, |authoremails|,
%   and |authororcids| sequences.
%
%   The authors are used in
%   the |bama|, |report| (optional), and |phd| cover pages,
%   the |bama| autograph / copyright page,
%   the |article| graphical abstract and title page,
%   the |course| (optional) and |phd| colophon,
%   the |phd| title page, and the |bookcover| spine.
%   The |pdfauthor| tag of the hyperref package (if it is loaded),
%   is set using the |authorlist|
%   so that the PDF-document meta-information is correct.
%
%   The formatted author name (see Section~\ref{S:usage:nameseqparse}) is
%   stored with the title in the |authors| sequence
%   (e.g., ``prof. Firstname Surname'') and
%   the full name and title with affiliation
%   (e.g., ``prof. Firstname Surname, Ghent University'')
%   is stored in the |authorswaff| sequence.
%   The |authorlist| sequence stores ``Surname, F.'' formatted names
%   for printing of a citation-style list,
%   and the plain call --
%   e.g., |\author{prof.}{Surname, Firstname}{, Ghent University}|
%   -- is stored in the |authorscalls| sequence for usage later in the
%   |\generatebookcover| macro.\\%
%   These sequences can be used following the instructions
%   in Section~\ref{S:usage:nameseqparse}.
