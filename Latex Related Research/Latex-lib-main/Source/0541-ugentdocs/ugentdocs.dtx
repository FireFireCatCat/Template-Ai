    \seq_gput_right:Nn \g_@@_affiliations_seq {#1}
    \seq_gput_right:Nn \g_@@_affiliationscalls_seq { \affiliation {#1} }
    \int_set:Nn \l_@@_affindex_int { \seq_count:N \g_@@_affiliations_seq }
  }
}

% Helper CS for I) adding affiliation indexes II) setting affiltext
\cs_new_protected:Nn \@@_addaffindex: {
  \seq_put_right:Nx \l_@@_affidx_seq {
    \use:c { int_to_ \l_@@_affformat_tl :n } { \l_@@_affindex_int }
  }
  \tl_if_empty:NF \l_@@_affiltext_tl {
    \tl_put_right:NV \l_@@_affiltext_tl \l_@@_affsep_tl
  }
  \tl_put_right:Nx \l_@@_affiltext_tl {
    \seq_item:Nn \g_@@_affiliations_seq { \l_@@_affindex_int }
  }
}

% General add to affiliations helper
\cs_new_protected:Nn \@@_addto_affseq:n {
  \seq_clear:N \l_@@_affidx_seq
  \tl_clear:N \l_@@_affiltext_tl
  \regex_match:NnTF \c_@@_affkeys_regex {#1} {
    \clist_map_inline:nn {#1} {
      \regex_match:NnTF \c_@@_affnum_regex {##1}{
        \int_set:Nn \l_@@_affindex_int {##1}
      }{
        \int_set:Nn \l_@@_affindex_int { \int_from_alph:n {##1} }
      }
      \bool_lazy_or:nnTF
      { \int_compare_p:nNn \l_@@_affindex_int < 1 }
      { \int_compare_p:nNn \l_@@_affindex_int > { \seq_count:N \g_@@_affiliations_seq } }{
        \msg_error:nnee { ugentdocs } { unknown-affiliation }
        {##1} { \seq_count:N \g_@@_affiliations_seq }
      }{
        \@@_addaffindex:
      }
    }
    \tl_if_empty:NF \l_@@_affiltext_tl{
      \tl_put_left:Nn \l_@@_affiltext_tl { \l_@@_nameaffsep_tl }
    }
  }{
    \tl_if_blank:nF {#1}{
      \@@_addaffiliation:n {#1}
      \@@_addaffindex:
    }
  }
  \seq_gput_right:Nx \g_@@_authoraffs_seq { \seq_use:Nn \l_@@_affidx_seq {,} }
}

% Print affiliation list for articles
\cs_new_protected:Nn \@@_printaffiliationlist: {
  \seq_map_indexed_inline:Nn \g_@@_affiliations_seq {
