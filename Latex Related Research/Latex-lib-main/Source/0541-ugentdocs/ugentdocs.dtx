\def\ps@ugent@titlepage{%
  \setbeamercolor{title~in~title~page}{parent=palette~primary}
  \setbeamertemplate{footline}[empty]
  \@nameuse{ps@ugent}
}

\defbeamertemplate*{background~canvas}{title}[1] {%
  \@ComputeTitleDims
  \tl_gset:Nn \g_@@_logocolor_tl {ugent@main}
  \@@_setframenumber:n {false}
  \begin{tikzpicture}
    \clip (0,0) rectangle (\@PW,\@PH);
    \begin{scope}[shift={(0,\@PH-\@HTS)}]
      \faclogo{\@HTS}{ugent@faculty}{0}
    \end{scope}
    \def\@titlebgimg{#1}%
    \ifx\@titlebgimg\@empty
      \@rect[fill=ugent@main]{(\gridunit,\@HBS)}{(\@PW,\@PH-\@HTS)}
    \else
      \tl_if_empty:NTF \l_@@_graphpos_tl {
        \begin{scope}
          \@rect[clip]{(\gridunit,\@HBS)}{(\@PW,\@PH-\@HTS)}
          \node[align=center]
          at (0.5*\gridunit+0.5*\@PW,0.5*\@HBS+0.5*\@PH-0.5*\@HTS) {#1};
        \end{scope}
      }{
        \pgfmathsetmacro\@titlex{%
          \@PW/1cm-(1-\fp_to_decimal:N\l_@@_graphprop_fp)*(\@PW/1cm-\gridunit/1cm)%
        }%
        \@rect[fill=ugent@main]{(\gridunit,\@HBS)}{(\@titlex cm,\@PH-\@HTS)}
        \begin{scope}
          \@rect[clip]{(\@titlex cm,\@HBS)}{(\@PW,\@PH-\@HTS)}
          \node[align=center]
          at (0.5*\@titlex cm+0.5*\@PW,0.5*\@HBS+0.5*\@PH-0.5*\@HTS) {#1};
        \end{scope}
      }
    \fi
    \ugentlogo{\@HBS}{ugent@main}{0}
    \ifx\@titlelogos\@empty\else
      \node[anchor=south~west, inner~sep=0pt,
        text~width=\@PW-2\gridunit-\@ugenttextw/\@logounit*\gridunit,
        minimum~height=2\gridunit, align=flush~left]
      at (2\gridunit+\@ugenttextw/\@logounit*\gridunit,\gridunit)
        {\@titlelogos};
    \fi
  \end{tikzpicture}
}

\defbeamertemplate*{background~canvas}{section}[1] {%
  \tl_gset:Nn \g_@@_logocolor_tl {ugent@main}
  \@@_setframenumber:n {false}
  \@ComputeTitleDims
  \begin{tikzpicture}
    \clip (0,0) rectangle (\@PW,\@PH);
    \def\@titlebgimg{#1}%
    \ifx\@titlebgimg\@empty
      \@rect[fill=ugent@main]{(\gridunit,\@HBS)}{(\@PW,\@PH)}
    \else
      \tl_if_empty:NTF \l_@@_graphpos_tl {
        \begin{scope}
          \@rect[clip]{(\gridunit,\@HBS)}{(\@PW,\@PH)}
          \node[align=center] at (0.5*\gridunit+0.5*\@PW,0.5*\@HBS+0.5*\@PH) {#1};
        \end{scope}
      }{
        \pgfmathsetmacro\@titlex{%
          \@PW/1cm-(1-\fp_to_decimal:N\l_@@_graphprop_fp)*(\@PW/1cm-\gridunit/1cm)%
        }%
        \@rect[fill=ugent@main]{(\gridunit,\@HBS)}{(\@titlex cm,\@PH)}
        \begin{scope}
          \@rect[clip]{(\@titlex cm,\@HBS)}{(\@PW,\@PH)}
          \node[align=center] at (0.5*\@titlex cm+0.5*\@PW,0.5*\@HBS+0.5*\@PH) {#1};
        \end{scope}
      }
    \fi
