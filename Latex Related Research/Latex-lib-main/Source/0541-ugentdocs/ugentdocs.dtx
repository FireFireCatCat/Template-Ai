\subsection{Place, brightness, and textbox}
\begin{frame}[subsection]
  \subsectionpage
\end{frame}

\begin{frame}[logo=false,t]
  {Place}

  You can place any graphic material on the slide using\\[1ex]
  \qquad\cmd{place[node options] at (x,y) \{<graphic material>\}}\\[1ex]
  with
  \begin{itemize}
  \item $(x,y)$ the coordinates to insert the content, with the bottom left as origin $(0,0)$.
    The coordinates can be relative (0--1) to the slide dimensions if unit-less,
    or absolute in cm, pt,\ldots
  \item \texttt{node options} any options you want to hand over to the
    tikz node that is used to position the material, e.g., \texttt{anchor = south east}.
  \end{itemize}
  \medskip

  The next slide was created using:\\[1ex]
  \begin{codesnippet}[0.8\textwidth]
    \bframe[][plain,logo=false]\\
    \ind\cmd{place} at (0.5,0.5) \{\\
    \ind\ind\cmd{begin\{tikzpicture\}}\\
    \ind\ind\cmd{ugentlogo\{12\cmd{gridunit}\}\{ugent@main\}\{0\}}\\
    \ind\ind\cmd{end\{tikzpicture\}}\\
    \ind\}\\
    \eframe
  \end{codesnippet}
\end{frame}

\begin{frame}[logo=false,plain]{}{}
  \place at (0.5,0.5){
    \begin{tikzpicture}
      \ugentlogo{12\gridunit}{ugent@main}{0}
    \end{tikzpicture}
  }
\end{frame}

\begin{graphicframe}[graphicpos=r,graphicproportion=0.25,t,
graphic={
\brightness[-0.5]{\includegraphics[width=0.2\paperwidth]{example-image-a}}\\
\brightness[0]{\includegraphics[width=0.2\paperwidth]{example-image-a}}\\
\brightness[+0.5]{\includegraphics[width=0.2\paperwidth]{example-image-a}}
}
]
  {Brightness}

  You can lighten or darken a photograph using the following command\\[1ex]
  \qquad\cmd{brightness[s]\{<graphic material>\}}\\[1ex]
  with $s$ a value between -1 and 1 to specify the level of lightening ($>0$)
  or darkening ($<0$).

  To the right, you can see an image with brightness\\
   $-0.5$ (top), $0$ (middle), and $+0.5$ (bottom).
\end{graphicframe}

\begin{frame}[logo=false,t]
  {Textbox}

  You can insert a text box using:\\[1ex]
  \qquad\cmd{textbox[options]\{width\}\{height\}\{contents\}}

  Where the supported options are
  \begin{itemize}
  \item \texttt{fill = <colour>}: textbox colour
  \item \texttt{fill opacity = <0-1>}
  \item \texttt{text = <colour>}: text colour
  \item \texttt{text opacity = <0-1>}
  \item \texttt{align= <left/right/center/justify>}: text alignment
  \end{itemize}

  Some examples can be found in the next slides. E.g., the next one is created using:\\[1ex]
  \begin{codesnippet}[0.8\textwidth]
    \bframe[][graphic,logo=false]\\
    \ind\cmd{place[anchor = south east]} at (\cmd{paperwidth}-\cmd{gridunit},\cmd{gridunit}) \{\\
    \ind\ind\cmd{textbox}\{16cm\}\{10cm\}\{Some example text\}\\
    \ind\}\\
    \eframe
  \end{codesnippet}
\end{frame}

