  \keys_set:nn { ugentdocs/question } { #1 }
  \stepcounter{subquestion}
  \begingroup
    \noindent
    \advance\leftskip by 0.25cm\relax
    \parindent=0pt
    \noindent
    \bool_if:NT \l_@@_qhasweight_bool {
      \@@_qmarginlabel:n { \int_use:N \l_@@_qweight_int \l_@@_pointlabel_tl }
    }
    \@@_hanginglabel:n { \thesubquestion)~ }
    ~#2%
    \bool_if:NT \l_@@_qhasweight_bool {
      \@@_qoverview_write:nnn { 1 }
        { \thequestion\thesubquestion } { \int_use:N \l_@@_qweight_int }
    }
    \par
  \endgroup
}
