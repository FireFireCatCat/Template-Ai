% \newpage
% \subsection{Covers}
% \label{S:style:covers}
% The covers consist of layout dimensions based on the official grid layout,
% the cover body content,
% and the cover layout for plain and fancy covers.
% We will go over those in the sections below.
%
%
% \subsubsection{Cover dimensions}
% A few common dimensions are defined:
%    \begin{macrocode}
%<*phd|bkc|crs|bama|rp|ex>
\ExplSyntaxOn
\newlength{\@B}     % Bleed outside crop / cameraready
\newlength{\@HBS}   % Height bottom strip
\newlength{\@HTS}   % Height top strip
\newlength{\@MS}    % Margin Spine (front/back cover)
\newlength{\@MTLR}  % Margin Text Left Right
\newlength{\@MTTB}  % Margin Text Top Bottom
\newlength{\@HT}    % Height Title
\newlength{\@WD}    % Width Data area
\newlength{\@HD}    % Height Data area
\newlength{\@BT}    % Bleed Top
\newlength{\@WI}    % Width Image
\newlength{\@HI}    % Height Image
\ExplSyntaxOff
%</phd|bkc|crs|bama|rp|ex>
%    \end{macrocode}
%
% A scheme is given here as to what these dimensions represent
% based on the |\gridunit|:\\
%   \adjustbox{width=0.5\textwidth}{
%   \begin{tikzpicture}
%     \draw[dotted, fill=lightgray] (0, 32) grid (24, 0);
%     \draw[<->] (1, 0) -- (2, 0); \node at (1.5, 0.5) {gridunit};
%     \draw[fill=white] (2, 30) rectangle (22, 2);
%     \draw[fill=ugent@main, fill opacity=0.1] (3, 6) rectangle (22.5, 27);
%
%     \draw[loosely dashed, fill=white, fill opacity=0.3] (4, 15) rectangle (21, 24);
%     \node[scale=3] at (11, 19.5) {Text area (title)};
%
%     \draw[fill=ugent@main] (3, 6) rectangle (13, 14);
%
%     \draw[loosely dashed, fill=white, fill opacity=0.3] (4, 7) rectangle (12, 13);
%     \node[scale=2] at (8, 12) {Text area (in data area)};
%
%     \draw[<->] (18, 2) -- (18, 19.5);       \node at (17.5,19.5) {HT};
%     \draw[<->] (20.5, 27) -- (20.5, 27.75); \node at (21, 27.37) {BT};
%     \draw[<->] (20.5, 27) -- (20.5, 27.75); \node at (21, 27.37) {BT};
%     \draw[<->] (4, 27) -- (4, 30);          \node at (4.5, 28) {HTS};
%     \draw[<->] (4, 2) -- (4, 6);            \node at (4.5, 4) {HBS};
%     \draw[<->] (2, 21) -- (3, 21);          \node at (2.5, 21.5) {MS};
%     \draw[<->] (22, 26) -- (22.5, 26);      \node at (22.25, 26.5) {B};
%     \draw[<->] (4, 19) -- (3, 19);          \node at (3.5, 19.5) {MTLR};
%     \draw[<->] (21, 19) -- (22, 19);        \node at (21.5, 19.5) {MTLR};
%     \draw[<->] (4, 12) -- (3, 12);          \node at (3.5, 12.5) {MTLR};
%     \draw[<->] (13, 12) -- (12, 12);        \node at (12.5, 12.5) {MTLR};
%     \draw[<->] (2, 30) -- (22, 30);         \node at (2.5, 15) {PW};
%     \draw[<->] (2, 2) -- (2, 30);           \node at (12, 29.5) {PH};
%     \draw[<->] (10, 14) -- (10, 6);         \node at (9.5, 8.5) {HD};
%     \draw[<->] (13, 10) -- (3, 10);         \node at (4.5, 10.5) {WD};
%     \draw[<->] (7, 7) -- (7, 6);            \node at (6.5, 6.5) {MTTB};
%     \draw[<->] (7, 14) -- (7, 13);          \node at (6.5, 13.5) {MTTB};
%     \node[scale=1.5] at (12, 31.5) {A4 width};
%     \node[scale=1.5, rotate=-90] at (0.5, 15) {A4 height};
%   \end{tikzpicture}
