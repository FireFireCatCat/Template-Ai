\defbeamertemplate*{frametitle}{normal} {%
  \bool_if:NTF \l_@@_graphgiven_bool {\@SetInverse}{}%
  \vskip\gridunit%
  \@SetFrameTitleDims
  \hskip\@tempdima%
  \begin{beamercolorbox}[wd=\@tempdimb]{\@@_beamercolor:n {frametitle}}%
    \usebeamerfont{frametitle}\MakeUppercase{\insertframetitle}\\[0.5ex]%
    \ifx\insertframesubtitle\@empty%
    {\usebeamerfont{framesubtitle}%
      \usebeamercolor[fg]{\@@_beamercolor:n {framesubtitle}}~\strut\par}%
    \vskip-1ex%
    \else%
    {\usebeamerfont{framesubtitle}%
      \usebeamercolor[fg]{\@@_beamercolor:n {framesubtitle}}%
      \insertframesubtitle\strut\par}%
    \fi%
    \if@tempswa\else\vskip-.3cm\fi%
  \end{beamercolorbox}%
}
