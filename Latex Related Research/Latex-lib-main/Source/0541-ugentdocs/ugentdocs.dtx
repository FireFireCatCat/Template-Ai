  }
  \\[\baselineskip]
  \@location,~\@date
  \\[\baselineskip]
  \@@_autographpage:

  \vspace*{\stretch{1}}
  \clearpage
}
\newcommand{\@bamadisclaimer}{
  {\translatekey{the-de}~\getseqcaption[lowercase]{authors}{}
    {}~\translatekey[lowercase]{and}~\getseqcaption[lowercase]{allsupervisors}{}}
  \bool_if:NTF \l_@@_embargo_bool {
    \bool_if:NTF \l_@@_embargotemp_bool {
      {~\@embargotempwithdates}
    }{
      {~\translatekey{embargofullbama}}
    }
  }{
    {~\translatekey{arrbama}}
  }
}
\ExplSyntaxOff
%</bama>
%    \end{macrocode}
%
% For a |phd|, it contains the colophon page, which consists of
% the author contact information,
% the title of the dissertation in Dutch (for English dissertations),
% the cover image designer,
% the scientific integrity clause,
% any applicable grants,
% the confidentiality or copyright notice itself,
% and the citation format, ISBN, and DOI (where applicable):
%    \begin{macrocode}
%<*phd>
\ExplSyntaxOn
\renewcommand{\@copyrightnotices}{%
  \noindent\begin{minipage}[b]{\textwidth}
    \textbf{Contact}\\
    \smallskip
    \printseq{authorswaff}{~|~}{~|~}{~|~}\\
    \@address
    \str_if_eq:VnF \l_@@_language_tl {dutch} {
      \\[\baselineskip]
      \textbf{Titel~van~het~doctoraat~in~het~Nederlands:}\\
      {\renewcommand{\\}[1][]{~}\@titel{}\ifx\@subtitel\@empty\else{}:~\@subtitel\fi}
    }
    \ifx\@coverdesigner\@empty\else
    \\[\baselineskip]
    \textbf{\translatekey{coverdesigner}:}\\
    \@coverdesigner
    \fi
    %
    \\[\baselineskip]
    \translatekey{integrityclause}
    %
    \ifx\@grants\@empty\else
    \\[\baselineskip]
    {\translatekey{supportedby}~\@grants.}
    \fi
    \bool_if:NTF \l_@@_embargo_bool {
      \\[\baselineskip]
      {\textbf{\translatekey{confidentiality}}}\\
      \bool_if:NTF \l_@@_embargotemp_bool {
        \@embargotempwithdates
      }{
        \translatekey{embargofullphd}
      }
    }{
      \\[\baselineskip]
      \textbf{\translatekey{crdisclaimer}~\textcopyright{}~\the\year}\\
      {\translatekey{arrphd}}%
    }
    \\[\baselineskip]
    {\textbf{\translatekey{pleaserefer}:}\\
      \printseq{authorlist}{~\&~}{,~}{\translatekey{andlist}~}~(\the\year).~
      {\renewcommand{\\}[1][]{~}\@title{}\ifx\@subtitle\@empty\else{}:~\@subtitle\fi}.
      {}~\@doctype{}.~Ghent~University,~Belgium.}%
    \ifx\@isbn\@empty\else
    \\[\baselineskip]{\small ISBN~\@isbn}%
    \fi
    \ifdefempty{\@doi}{}{
      \ifx\@isbn\@empty\\[\baselineskip]\else\\\fi
      {\small DOI~
        \@ifpackageloaded{hyperref}{
          \exp_args:NV \href \l_@@_doiurl_str {\@doi}
          }{
          \@doi
          }
      }
    }
  \end{minipage}
}
