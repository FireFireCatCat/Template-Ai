%</art>
% \fi
%
% The section style is the same for all documents:
% \DescribeObject[custom]{\@titlestylesection}
%   Plain bold and black section titles.
%   Automatically set at the beginning of the document.
%
%   Implementation:
%
%    \begin{macrocode}
%<*phd|crs|bama|rp|art>
\newcommand{\@titlestylesection}{
  \titleformat{\section}
  [block] % shape
  {\fontsize{14}{17} \selectfont \bfseries } % format
  {\thesection \ } % the label
  { 0ex } %separator space
  { ##1 } %before code
  { } %after code

  % Change the spacing above the chapter. This is left - above - below
  \titlespacing*{\section}{0pt}{6pt}{0pt}
}
%</phd|crs|bama|rp|art>
%    \end{macrocode}
%
% \iffalse
%<*phd|crs|bama|rp|art>
\AtBeginDocument{
  \@titlestylechapter
  \@titlestylesection
  \apptocmd{\appendix}{\@titlestyleappendix}{}{}
}
%</phd|crs|bama|rp|art>
% \fi
