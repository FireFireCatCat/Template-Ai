\beginsong{Harbour Light}[
  by={Your Name},
  cr={Original lyrics; replace before publishing.},
  index={The harbour keeps a patient light}]
\beginverse
\[C]The harbour keeps a \[F]patient light
along the tide-worn \[G]stone;
It marks the way for \[C]evening boats
and makes the dark their \[G]own.
\endverse
\beginchorus
\[F]Carry the tune through the \[C]daylight,
\[G]carry it home \[C]tonight.
\endchorus
\beginverse
^Morning turns the water ^gold,
and gulls begin to ^rise;
The same small lamp is ^folded up
inside the waking ^skies.
\endverse
\endsong

\beginsong{Morning Signal}[
  by={Your Name},
  cr={Original lyrics; replace before publishing.}]
\beginverse
\[G]First light finds the \[C]window,
and turns the room to \[D]gold.
\[G]A quiet line of \[C]music
is waiting to be \[D]told.
\endverse
\endsong
