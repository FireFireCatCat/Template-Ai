\newlength{\drop}

\newcommand*{\titleTMB}[3][]{\begingroup% Three Men in a Boat
\centering
$\bullet$ \\
{\small \tamilfont ஆதியே துணை} \\[0.1\textheight]
\setlength{\unitlength}{0.9\textwidth}
\rule{\unitlength}{1.6pt}\vspace*{-\baselineskip}\vspace*{2pt}
\rule{\unitlength}{0.4pt}\\[\baselineskip]
\ifthenelse{\equal{#1}{}}
           { {\Huge \tamilfont #2}\\[\baselineskip] } % No optional argument
           {
             {\Huge \tamilfont #2}\\[\baselineskip]
             {\LARGE \tamilfont #1}\\[0.2\baselineskip]  % With optional argument
           }
\rule{\unitlength}{0.4pt}\vspace*{-\baselineskip}\vspace{3.2pt}
\rule{\unitlength}{1.6pt}\\[\baselineskip]
\vfill
{\LARGE \tamilfont #3}\\[\baselineskip]
\vspace*{\drop}
\endgroup}

