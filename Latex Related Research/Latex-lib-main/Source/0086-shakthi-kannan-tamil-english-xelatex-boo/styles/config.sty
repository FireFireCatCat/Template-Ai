\newcommand{\formatchaptertitle}[1]{%
  \parbox[t]{\dimexpr\textwidth-10pt}{\raggedright\LARGE\scshape#1}}

\definecolor{gray75}{gray}{0.75}
\newcommand{\hsp}{\hspace{20pt}}
\ifthenelse{\boolean{bulletchapters}}%
      {% Add bullet before chapter title
      \titleformat{\chapter}[block]
                  {\huge\bfseries}
                  {\centering\small$\bullet$ \\{\small \tamilfont ஆதியே துணை}\\\huge\bfseries\thechapter\hsp\textcolor{gray75}{|}\hsp}
                  {0pt}
                  {\formatchaptertitle}
      }
      {% default
      \titleformat{\chapter}[block]
                  {\huge\bfseries}
                  {\thechapter\hsp\textcolor{gray75}{|}\hsp}
                  {0pt}
                  {\formatchaptertitle}
      }

