\newcommand{\addornament}[2][]{\begingroup
  \vfill
  \begin{center}
    \ifthenelse{\equal{#1}{}}
               { \psvectorian[]{#2} } % No scaling
               { \psvectorian[scale=#1]{#2} }
  \end{center}
  \vfill
\endgroup}

\newcommand{\vectorframelandscape}[1]{
  \begin{pspicture}(0,0)(9,9)
    \rput[tl](-2,12.5){\psvectorian[width=3cm]{63}}
    \rput[tr](11,12.5){\psvectorian[width=3cm,mirror]{63}}
    \rput[B](4.5,1.5){
      \includegraphics[width=.9\linewidth]{#1}
    }
    \rput[bl](-2,-5){\psvectorian[width=3cm,flip]{63}}
    \rput[br](11,-5){\psvectorian[width=3cm,flip,mirror]{63}}
  \end{pspicture}
}

\newcommand{\vectorframeportrait}[1]{
  \begin{pspicture}(0,0)(9,9)
    \rput[tl](-2,12.5){\psvectorian[width=3cm]{63}}
    \rput[tr](11,12.5){\psvectorian[width=3cm,mirror]{63}}
    \rput[B](4.5,-1){
      \includegraphics[width=8cm]{#1}
    }
    \rput[bl](-2,-5){\psvectorian[width=3cm,flip]{63}}
    \rput[br](11,-5){\psvectorian[width=3cm,flip,mirror]{63}}
  \end{pspicture}
}

