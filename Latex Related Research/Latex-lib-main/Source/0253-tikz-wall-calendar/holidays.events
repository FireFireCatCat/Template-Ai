% Real 2026 events for the tikz-kalender starter (see main.tex). Loaded via
% the `events` class option (docsvlist over \RN@events@files, appending
% ".events" and \InputIfFileExists-ing it) -- this file, not main.tex, is
% where \period and \event are actually valid (the class's own \event macro
% raises a ClassError if called anywhere else).
\period{2026-07-01}{2026-08-31}[name=Summer break]
\event{2026-01-01}{New Year's Day}
\event{2026-02-14}{Valentine's Day}
\event*{2026-03-08}{Team offsite}
\event{2026-05-01}{Labour Day}
\event*{2026-06-15}{Project deadline}
\event{2026-10-31}{Halloween}
\event{2026-12-25}{Christmas Day}
\event{2026-12-31}{New Year's Eve}
