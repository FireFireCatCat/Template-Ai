{"id":"jmlr","name":"jmlr","aliases":[],"caption":"Class files for the Journal of Machine Learning Research","authors":[{"id":"talbot","active":true}],"copyright":[{"owner":"Nicola Talbot","year":"2006-2022"}],"license":"lppl1.3","version":{"number":"1.30","date":"2022-02-09"},"descriptions":[{"language":null,"text":"<p>\n      The jmlr bundle provides a class for authors (<tt>jmlr<\u002ftt>) and a\n      class for production editors (<tt>jmlrbook<\u002ftt>).\n    <\u002fp>\n  <p>\n      The <tt>jmlrbook<\u002ftt> class can be used to combine articles\n      written using the jmlr class into a book. The class uses the\n      <ref refid=\"combine\">combine<\u002fref> class and the\n      <ref refid=\"hyperref\">hyperref<\u002fref> package to produce either a\n      colour hyperlinked book for on-line viewing or a greyscale\n      nonhyperlinked book for printing.\n    <\u002fp>\n  <p>\n      Production editors can use\n      <a href=\"https://www.dickimaw-books.com/software/makejmlrbookgui\">makejmlrbookgui<\u002fref>\n      to help build the proceedings from the articles.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Readme","href":"ctan:/macros/latex/contrib/jmlr/README"},{"language":null,"details":"Package documentation","href":"ctan:/macros/latex/contrib/jmlr/jmlr.pdf"}],"bugs":"https://www.dickimaw-books.com/bugtracker.php?category=jmlr","ctan":{"path":"/macros/latex/contrib/jmlr","file":true},"install":"/macros/latex/contrib/jmlr.tds.zip","miktex":"jmlr","texlive":"jmlr","topics":["journalpub","class"]}