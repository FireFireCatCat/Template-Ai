{"id":"zbmath-review-template","name":"zbmath-review-template","aliases":[],"caption":"Template for a zbMATH Open review","authors":[{"id":"beckenbach","active":true}],"copyright":[{"owner":"FIZ Karlsruhe GmbH","year":"2021"}],"license":["cc-by-sa-4","gpl3"],"version":{"number":"2.1","date":"2021-06-24"},"descriptions":[{"language":null,"text":"<p>\n      This package contains a template for\n      <a href=\"https://zbmath.org/\">zbMATH Open<\u002fref> reviews.\n      It will show what your review will look like on\n      <a href=\"https://zbmath.org/\">zbMATH Open<\u002fref> and you can\n      test whether your LaTeX-Code will compile on our system.\n    <\u002fp>\n  <p>\n      The template has to be compiled using <ref refid=\"xetex\">XeLaTeX<\u002fref>\n      and relies on\n      <ref refid=\"koma-script\">scrartcl<\u002fref>,\n      <ref refid=\"koma-script\">scrlayer-scrpage<\u002fref>,\n      <ref refid=\"amsfonts\">amsfonts<\u002fref>,\n      <ref refid=\"amsfonts\">amssymb<\u002fref>,\n      <ref refid=\"amsmath\">amsmath<\u002fref>,\n      <ref refid=\"babel\">babel<\u002fref>,\n      <ref refid=\"enumitem\">enumitem<\u002fref>,\n      <ref refid=\"etoolbox\">etoolbox<\u002fref>,\n      <ref refid=\"fontspec\">fontspec<\u002fref>,\n      <ref refid=\"gensymb\">gensymb<\u002fref>,\n      <ref refid=\"geometry\">geometry<\u002fref>,\n      <ref refid=\"graphicx\">graphicx<\u002fref>,\n      <ref refid=\"mathrsfs\">mathrsfs<\u002fref>,\n      <ref refid=\"mathtools\">mathtools<\u002fref>,\n      <ref refid=\"stmaryrd\">stmaryrd<\u002fref>,\n      <ref refid=\"textcomp\">textcomp<\u002fref>,\n      <ref refid=\"tikz-cd\">tikz-cd<\u002fref>,\n      <ref refid=\"xcolor\">xcolor<\u002fref>, and\n      <ref refid=\"xparse\">xparse<\u002fref>.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Readme","href":"ctan:/macros/xetex/latex/zbmath-review-template/README.md"},{"language":null,"details":"Package documentation","href":"ctan:/macros/xetex/latex/zbmath-review-template/zb-manual.pdf"}],"ctan":{"path":"/macros/xetex/latex/zbmath-review-template","file":true},"miktex":"zbmath-review-template","texlive":"zbmath-review-template","topics":["xetex","doc-templ"]}