{"id":"rsc","name":"RSC","aliases":[],"caption":"BibTeX style for use with RSC journals","authors":[{"id":"wright","active":true}],"copyright":[{"owner":"Joseph Wright","year":"2006-2008"}],"license":"lppl1.3","version":{"number":"3.1f","date":"2016-08-22"},"descriptions":[{"language":null,"text":"<p>\n      The rsc package provides a BibTeX style in accordance with the\n      requirements of the Royal Society of Chemistry. It was originally\n      based on the file <ref refid=\"chem-journal\">pccp.bst<\u002fref>, but\n      also implements a number of styles from the\n      <ref refid=\"achemso\">achemso<\u002fref> package. The package is now\n      a stub for the\n      <ref refid=\"chemstyle\">chemstyle<\u002fref> package, which the author\n      developed to unify the writing of articles with a chemistry content.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Package documentation","href":"ctan:/macros/latex/contrib/rsc/rsc.pdf"},{"language":null,"details":"Readme","href":"ctan:/macros/latex/contrib/rsc/README.md"}],"ctan":{"path":"/macros/latex/contrib/rsc","file":true},"install":"/macros/latex/contrib/rsc.tds.zip","miktex":"rsc","texlive":"rsc","topics":["chemistry","journalpub"]}