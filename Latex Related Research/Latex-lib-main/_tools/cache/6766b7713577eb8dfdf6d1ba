{"id":"fbs","name":"fbs","aliases":[],"caption":"BibTeX style for Frontiers in Bioscience","authors":[{"id":"suckale","active":true}],"copyright":[],"license":"lppl1","version":{"number":"","date":"2008-03-12"},"descriptions":[{"language":null,"text":"<p>\n      A BibTeX style file made with\n      <ref refid=\"custom-bib\">custom-bib<\u002fref> to fit Frontiers in\n      Bioscience requirements:\n    <\u002fp>\n  <ul>\n    <li>\n\tall authors, no et al, full author names, initials\n\tabbreviated;\n      <\u002fli>\n    <li>\n\tonly abbreviated journal name italicised, no\n\tabbreviation dots;\n      <\u002fli>\n    <li>\n\tonly year, no month, at end of reference; and\n      <\u002fli>\n    <li>\n\tDOI excluded, ISSN excluded.\n      <\u002fli>\n  <\u002ful>"}],"ctan":{"path":"/biblio/bibtex/contrib/misc/fbs.bst","file":true},"miktex":"fbs","texlive":"fbs","topics":["journalpub","biology","bibtex-supp"]}