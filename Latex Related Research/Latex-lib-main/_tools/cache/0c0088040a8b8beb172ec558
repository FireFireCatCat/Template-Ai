{"id":"seminar","name":"seminar","aliases":[],"caption":"Make overhead slides","authors":[{"id":"voss","active":true},{"id":"zandt","active":false},{"id":"girou","active":false},{"id":"rahtz","active":false}],"copyright":[{"owner":"Timothy Van Zandt","year":"1993, 1994"}],"license":"lppl1.2","version":{"number":"1.63a","date":""},"descriptions":[{"language":null,"text":"<p>\n      A class that produces overhead slides (transparencies), with many\n      facilities. The class requires availability of the\n      <ref refid=\"fancybox\">fancybox<\u002fref> package.\n    <\u002fp>\n  <p>\n      Seminar is also the basis of other classes, such as\n      <ref refid=\"prosper\">prosper<\u002fref>. In fact, seminar is not\n      nowadays reckoned a good basis for a presentation – users\n      are advised to use more recent classes such as\n      <ref refid=\"powerdot\">powerdot<\u002fref> or\n      <ref refid=\"beamer\">beamer<\u002fref>, both of which are tuned to\n      21st-century presentation styles.\n    <\u002fp>\n  <p>\n      Note that the seminar distribution relies on the\n      <ref refid=\"xcomment\">xcomment<\u002fref> package, which was once\n      part of the bundle, but now has a separate existence.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Package documentation","href":"ctan:/macros/latex/contrib/seminar/doc/seminar-doc.pdf"},{"language":null,"details":"Readme","href":"ctan:/macros/latex/contrib/seminar/README"}],"ctan":{"path":"/macros/latex/contrib/seminar","file":true},"miktex":"seminar","texlive":"seminar","topics":["tagged-pdf-unsupported","presentation"],"also":["foiltex","slidenotes"]}