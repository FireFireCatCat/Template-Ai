{"id":"elpres","name":"elpres","aliases":[],"caption":"A simple class for electronic presentations","authors":[{"id":"kiefel","active":true}],"copyright":[],"license":"lppl","version":{"number":"1.1","date":"2024-05-29"},"descriptions":[{"language":null,"text":"<p>\n      The elpres class is intended to be used for presentations on a\n      screen or with a beamer/projector. It is derived from LaTeX’s\n      article class and can be used with LaTeX, pdfLaTeX, and\n      LuaLaTeX. The default <q>virtual paper size<\u002fq> of presentations\n      generated by this class corresponds to a 4:3 (width:height)\n      aspect ratio. Other aspect ratios for widescreen monitors\n      (16:9, 16:10) may be selected.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Example of use","href":"ctan:/macros/latex/contrib/elpres/doc/elpres-example.pdf"},{"language":null,"details":"Package documentation","href":"ctan:/macros/latex/contrib/elpres/doc/elpres-manual.pdf"},{"language":null,"details":"Readme","href":"ctan:/macros/latex/contrib/elpres/README.md"}],"home":"http://vkiefel.de/elpres.html","ctan":{"path":"/macros/latex/contrib/elpres","file":true},"miktex":"elpres","texlive":"elpres","topics":["presentation","class"]}