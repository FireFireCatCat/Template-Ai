{"id":"prosper","name":"prosper","aliases":[],"caption":"LaTeX class for high quality slides","authors":[{"id":"goualard","active":true}],"copyright":[],"license":"lppl1.2","version":{"number":"1.0h","date":""},"descriptions":[{"language":null,"text":"<p>\n      Prosper is a LaTeX class for writing transparencies. It is written\n      as an extension of the <ref refid=\"seminar\">seminar<\u002fref> class\n      by Timothy Van Zandt.\n    <\u002fp>\n  <p>\n      Prosper offers a friendly environment for creating slides for both\n      presentations with an overhead projector and a video projector.\n      Slides prepared for a presentation with a computer and a video\n      projector may integrate animation effects, incremental display,\n      and so on. Various visual styles are supported (including some\n      that mimic PowerPoint) and others are being contributed.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"A brief example of usage","href":"ctan:/macros/latex/contrib/prosper/doc/prosper-tour.pdf"},{"language":null,"details":"Package Readme","href":"ctan:/macros/latex/contrib/prosper/README"},{"language":null,"details":"Package documentation","href":"ctan:/macros/latex/contrib/prosper/doc/prosper-doc.pdf"}],"repository":"https://prosper.sourceforge.net/","ctan":{"path":"/macros/latex/contrib/prosper","file":true},"miktex":"prosper","texlive":"prosper","topics":["presentation","tagged-pdf-unsupported"],"also":["ifmslide","ha-prosper"]}