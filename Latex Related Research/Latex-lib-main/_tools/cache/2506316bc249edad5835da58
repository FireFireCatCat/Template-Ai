{"id":"zztex","name":"ZzTeX","aliases":[],"caption":"A full-featured TeX macro package for producing books, journals, and manuals","authors":[{"id":"anagnostopoulos","active":true}],"copyright":[{"owner":"Paul C. Anagnostopoulos","year":"1989-2020"}],"license":"mit","version":{"number":"17.7","date":""},"descriptions":[{"language":null,"text":"<p>\n      The ZzTeX macro package is a full-featured TeX macro package\n      specially designed for producing books, journals, and manuals.\n      Development of the package began in 1989.\n      Since then, about 500 textbooks and journals have been produced\n      with it for a variety of publishers.\n      Numerous authors have used the package to produce\n      subsequent editions of their books.\n    <\u002fp>\n  <p>\n      ZzTeX runs under Plain TeX.\n    <\u002fp>\n  <p>\n      The only documentation available for the package is contained\n      in the <tt>zz*.dat<\u002ftt> files that accompany the TeX files.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"TUGboat paper","href":"https://tug.org/TUGboat/tb13-4/tb37anag.pdf"},{"language":null,"details":"Readme","href":"ctan:/macros/plain/contrib/zztex/README"}],"home":"https://www.windfall.com","ctan":{"path":"/macros/plain/contrib/zztex","file":true},"miktex":"zztex","texlive":"zztex","topics":["journalpub","book-pub"]}