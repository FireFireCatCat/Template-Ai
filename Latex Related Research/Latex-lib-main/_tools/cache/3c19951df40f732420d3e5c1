{"id":"maine-thesis","name":"maine-thesis","aliases":[],"caption":"A document class for University of Maine graduate theses","authors":[{"id":"bock-c","active":true},{"id":"springuel","active":true}],"copyright":[],"license":"lppl1.3c","version":{"number":"2.0.6","date":"2025-12-29"},"descriptions":[{"language":null,"text":"<p>\n      The <tt>maine-thesis<\u002ftt> class provides support for the\n      formatting requirements for graduate theses of the\n      Graduate School at The University of Maine.\n      It sets default parameters for the report class,\n      modifies captions, references, and the table of contents,\n      and makes specific environments available.\n    <\u002fp>\n  <p>\n      The <tt>maine-thesis<\u002ftt> class reflects the\n      <a href=\"https://umaine.edu/graduate/students/progress/thesis-resources/\">guidelines<\u002fref>\n      published by the Graduate School at The University of Maine.\n      The Graduate School at the University of Maine does not\n      provide official support for any thesis style class or template.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Example of use","href":"ctan:/macros/latex/contrib/maine-thesis/maine-thesis-example.pdf"},{"language":null,"details":"Package documentation","href":"ctan:/macros/latex/contrib/maine-thesis/maine-thesis.pdf"},{"language":null,"details":"Readme","href":"ctan:/macros/latex/contrib/maine-thesis/README.md"}],"support":"https://gitlab.com/maine-thesis/maine-thesis/-/work_items","repository":"https://gitlab.com/maine-thesis/maine-thesis","ctan":{"path":"/macros/latex/contrib/maine-thesis","file":true},"miktex":"maine-thesis","texlive":"maine-thesis","topics":["dissertation","std-conform","class"]}