{"id":"enslyonreview","name":"ENSLyonReview","aliases":[],"caption":"A LaTeX class for M2 Biosciences bibliographic reviews at ENS de Lyon","authors":[{"id":"mbaye","active":true}],"copyright":[{"owner":"Adama Mbaye","year":"2026"}],"license":"lppl1.3c","version":{"number":"1.1","date":"2026-09-10"},"descriptions":[{"language":null,"text":"<p>\n      This LaTeX class reproduces the format required for the\n      <i>Analyse bibliographique<\u002fi> review of the M2 Biosciences\n      Master at ENS de Lyon (course coordinator: François Roudier):\n      full-width title block with abstract and keywords,\n      two-column body, running header/footer, figure/table/box floats,\n      and a numbered bibliography with <q>of special/outstanding\n      interest<\u002fq> annotations – built on\n      <ref refid=\"biblatex\">biblatex<\u002fref>+<ref refid=\"biber\">biber<\u002fref>\n      for real, clickable, auto-numbered citations.\n      Sibling package to <ref refid=\"enslyonstage\">enslyonstage<\u002fref>\n      (M1/M2 internship reports).\n      The worked example reproduces, with permission, \n      <i>Antiviral restriction factors in immunity and disease<\u002fi>\n      by Erika Larrahondo Rodríguez, a real, previously approved M2 review.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Example of use","href":"ctan:/macros/latex/contrib/enslyonreview/enslyonreview-exemple.pdf"},{"language":null,"details":"Readme","href":"ctan:/macros/latex/contrib/enslyonreview/README.md"},{"language":"fr","details":"User guide","href":"ctan:/macros/latex/contrib/enslyonreview/enslyonreview.pdf"}],"repository":"https://github.com/adamambayeens-eng/enslyonreview","ctan":{"path":"/macros/latex/contrib/enslyonreview","file":true},"miktex":"enslyonreview","texlive":"enslyonreview","topics":["std-conform","doc-templ","journalpub","french","class"]}