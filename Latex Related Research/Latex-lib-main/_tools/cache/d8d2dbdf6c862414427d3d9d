{"id":"einfart","name":"einfart","aliases":[],"caption":"Write your articles in a simple and clear way","authors":[{"id":"xu","active":true}],"copyright":[{"owner":"Jinwen XU","year":"2021-2026"}],"license":"lppl1.3c","version":{"number":"","date":"2026-02-20"},"descriptions":[{"language":null,"text":"<p>\n      This package provides a LaTeX class for typesetting articles\n      with a simple and clear design.\n    <\u002fp>\n  <p>\n      Currently, it has native support for Chinese (simplified and\n      traditional), English, French, German, Italian, Japanese,\n      Portuguese (European and Brazilian), Russian and Spanish\n      typesetting.\n      It compiles with either XeLaTeX or LuaLaTeX.\n    <\u002fp>\n  <p>\n      This is part of the <ref refid=\"minimalist\">minimalist<\u002fref>\n      class series and depends on <tt>minimalist.sty<\u002ftt> from\n      the <ref refid=\"minimalist\">minimalist<\u002fref> package.\n    <\u002fp>\n  <p>\n      The package name <q>einfart<\u002fq> is taken from the German word\n      <q>einfach<\u002fq> (<q>simple<\u002fq>), combined with the first three letters\n      of <q>Artikel<\u002fq> (<q>article<\u002fq>).\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Example of use (style “flow”)","href":"ctan:/macros/unicodetex/latex/einfart/demo/einfart-demo-style-flow.pdf"},{"language":null,"details":"Example of use (style “ClassicThesis”)","href":"ctan:/macros/unicodetex/latex/einfart/demo/einfart-demo-style-classicthesis.pdf"},{"language":null,"details":"Example of use (style “default”)","href":"ctan:/macros/unicodetex/latex/einfart/demo/einfart-demo-style-default.pdf"},{"language":null,"details":"Example of use (style “classical”)","href":"ctan:/macros/unicodetex/latex/einfart/demo/einfart-demo-style-classical.pdf"},{"language":null,"details":"Example of use (style “plain”)","href":"ctan:/macros/unicodetex/latex/einfart/demo/einfart-demo-style-plain.pdf"},{"language":null,"details":"Example of use (style “stream”)","href":"ctan:/macros/unicodetex/latex/einfart/demo/einfart-demo-style-stream.pdf"},{"language":null,"details":"Readme","href":"ctan:/macros/unicodetex/latex/einfart/README.md"}],"repository":"https://github.com/Jinwen-XU/minimalist/tree/main/einfart","ctan":{"path":"/macros/unicodetex/latex/einfart","file":true},"miktex":"einfart","texlive":"einfart","topics":["class","multilingual","article-like"],"also":["minimalist"]}