{"id":"context-taspresent","name":"context-taspresent","aliases":[],"caption":"Simple presentations using ConTeXt","authors":[{"id":"schmitz","active":true}],"copyright":[{"owner":"Thomas A. Schmitz","year":"2007"}],"license":"gpl2","version":{"number":"","date":"2007-07-15"},"descriptions":[{"language":null,"text":"<p>\n      The modules provided in this bundle provide an easy-to-use,\n      consistent, interface for writing simple presentations with\n      ConTeXt. The modules provide for changes to presentation style\n      without change of the source; provision is made for\n      configurability.\n    <\u002fp>\n  <p>\n      The modules do not offer any interactive features in the frames\n      presented.\n    <\u002fp>\n  <p>\n      Please note that this package is considered obsolete: the author’s\n      <tt>context-simpleslides<\u002ftt> (not on CTAN)\n      should be used in new work.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Package manual","href":"ctan:/obsolete/macros/context/contrib/context-taspresent/doc/context/third/taspresent/taspresent-manual.pdf"},{"language":null,"details":"Readme","href":"ctan:/obsolete/macros/context/contrib/context-taspresent/doc/context/third/taspresent/readme"}],"ctan":{"path":"/obsolete/macros/context/contrib/context-taspresent","file":true},"topics":["obsolete","presentation","context"]}