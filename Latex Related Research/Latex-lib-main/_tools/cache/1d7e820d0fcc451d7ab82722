{"id":"fancymag","name":"fancymag","aliases":[],"caption":"A LuaLaTeX package for academic magazines and scientific","authors":[{"id":"halder","active":true},{"id":"ghosh","active":true}],"copyright":[],"license":["ofl","lppl1.3c"],"version":{"number":"1.0","date":""},"descriptions":[{"language":null,"text":"<p>\n    <tt>fancymag<\u002ftt> is a LaTeX package designed to provide\n      enhanced typographic styling for academic and editorial documents. It\n      integrates a selection of freely licensed display fonts to help authors create\n      visually appealing layouts for magazines, scientific books, and other\n      publication-quality material.\n    <\u002fp>\n  <p>\n      The package must be compiled with <tt>LuaLaTeX<\u002ftt> and depends on\n      OpenType fonts included in the package. To function correctly,\n      the accompanying <tt>fonts/<\u002ftt> and <tt>img/<\u002ftt> directories must be present,\n      as described in the documentation.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Readme","href":"ctan:/macros/luatex/latex//fancymag/README.md"},{"language":null,"details":"Package documentation","href":"ctan:/macros/luatex/latex//fancymag/fancymag-doc.pdf"}],"ctan":{"path":"/macros/luatex/latex/fancymag","file":true},"miktex":"fancymag","texlive":"fancymag","topics":["luatex","magazine"]}