        <div class="dt">
          <a href="/pkg/europasscv">Europasscv</a>
        </div>
        <div class="dd">
          Unofficial class for the new version of the Europass curriculum vitae.
        </div>
     
        <div class="dt">
          <a href="/pkg/europasscv2025">Europasscv2025</a>
        </div>
        <div class="dd">
          Unofficial class for the 2025 version of the Europass curriculum vitae.
        </div>
     
        <div class="dt">
          <a href="/pkg/europecv">EuropeCV</a>
