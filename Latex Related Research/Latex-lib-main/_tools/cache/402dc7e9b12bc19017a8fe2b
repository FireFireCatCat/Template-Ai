    <h1>CV</h1>
    <p>This topic contains packages to typeset a curriculum vitae or resumé.</p>
    <div><img src="/teaser/topic/cv" class="topic-image" /></div>
    <div class="pkg-cols">
      
        <div class="dt">
          <a href="/pkg/atsresume">Atsresume</a>
        </div>
        <div class="dd">
          A one-column resume class with PDF text that applicant tracking systems can.
        </div>
     
        <div class="dt">
          <a href="/pkg/bewerbung">Bewerbung</a>
        </div>
        <div class="dd">
          Typesetting job applications.
        </div>
     
        <div class="dt">
          <a href="/pkg/biblatex-cv">Bib<span class="t-logo">L<span class="a">a</span>T<span class="e">e</span>X</span>-cv</a>
        </div>
        <div class="dd">
          Create a CV from <span class="t-logo"><span class="sc">Bib</span><span class="t">T</span><span class="e">e</span>X</span> files.
        </div>
     
        <div class="dt">
          <a href="/pkg/curriculum-vitae">Curriculum-vitae</a>
        </div>
        <div class="dd">
          Lightweight class for CVs.
        </div>
     
        <div class="dt">
          <a href="/pkg/currvita">Currvita</a>
        </div>
