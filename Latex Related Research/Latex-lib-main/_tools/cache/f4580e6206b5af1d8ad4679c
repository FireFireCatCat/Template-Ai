{"id":"texpower","name":"TeXPower","aliases":[],"caption":"Create dynamic online presentations with LaTeX","authors":[{"id":"nordhaug","active":true},{"id":"lehmke","active":true}],"copyright":[{"owner":"Stephan Lehmke","year":"1999-2004"}],"license":"gpl","version":{"number":"0.2","date":""},"descriptions":[{"language":null,"text":"<p>\n      TeXPower is a bundle of packages intended to provide an\n      all-inclusive environment for designing pdf screen presentations\n      to be viewed in full-screen mode, especially for\n      projecting <q>online<\u002fq> with a video beamer. For some of its core\n      functions, it uses code derived from\n      <ref refid=\"ppower4\">ppower4<\u002fref> packages.\n    <\u002fp>\n  <p>\n      It is, however, not a complete environment in itself: it relies\n      on an existing class for preparing slides (such as\n      <ref refid=\"foiltex\">foiltex<\u002fref> or\n      <ref refid=\"seminar\">seminar<\u002fref>) or another package such as\n      <ref refid=\"pdfslide\">pdfslide<\u002fref>.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Readme","href":"ctan:/macros/latex/contrib/texpower/README"},{"language":null,"details":"Manual","href":"ctan:/macros/latex/contrib/texpower/manual.pdf"},{"language":null,"details":"Package demo","href":"https://texpower.sourceforge.net/doc/fulldemo.pdf"}],"repository":"https://texpower.sourceforge.net/","ctan":{"path":"/macros/latex/contrib/texpower","file":true},"miktex":"texpower","texlive":"texpower","topics":["presentation"],"also":["prosper","beamer"]}