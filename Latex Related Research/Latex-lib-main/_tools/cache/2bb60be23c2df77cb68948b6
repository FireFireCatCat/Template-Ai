{"id":"lucidcv","name":"Lucid CV","aliases":[],"caption":"ATS-safe customizable LuaLaTeX template for modern resumes/CVs","authors":[{"id":"goldschmidt","active":true}],"copyright":[{"owner":"Patrik Goldschmidt","year":"2026"}],"license":["mit","lppl1.3c","ofl"],"version":{"number":"1.0.0","date":""},"descriptions":[{"language":null,"text":"<p>\n     Lucid CV (lucidcv) is a modern LuaLaTeX class for single- and two-column\n     resumes (CVs) whose PDF output stays machine-readable. It is based on the\n     PlushCV design and rewritten. Word spaces are real space characters and icons\n     extract as nothing, so Applicant Tracking Systems (ATSs) and PDF text\n     extractors read the text back in order. The output is tagged PDF/A-2b. Colors,\n     fonts, sizes and spacing can be customized, and the bundled test suite\n     (available on GitHub) checks extraction with several PDF engines and layout\n     variants.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Package documentation","href":"ctan:/macros/luatex/latex/lucidcv/lucidcv-doc.pdf"},{"language":null,"details":"Readme","href":"ctan:/macros/luatex/latex/lucidcv/README.md"}],"bugs":"https://github.com/xGoldy/lucidcv/issues","repository":"https://github.com/xGoldy/lucidcv","development":"https://github.com/xGoldy/lucidcv/pulls","ctan":{"path":"/macros/luatex/latex/lucidcv","file":true},"miktex":"lucidcv","texlive":"lucidcv","topics":["doc-templ","use-luatex"]}