{"id":"yplan","name":"yplan","aliases":[],"caption":"Daily planner type calendar","authors":[{"id":"nickalls","active":true},{"id":"harders","active":false}],"copyright":[],"license":"lppl1","descriptions":[{"language":null,"text":"<p>\n      Prints two six-monthly vertical-type daily planner (i.e.,\n      months along the top, days downwards), with each 6-month period\n      fitting onto a single A4 (or US letter) sheet. The package\n      offers support for English, French, German, Spanish and\n      Portuguese.\n    <\u002fp>\n  <p>\n      The previous scheme of annual updates has now been abandoned, in\n      favour of a Perl script <em>yplan<\u002fem> that generates a year’s\n      planner automatically. (The last manually-generated LaTeX file\n      remains on the archive.)\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Details of the LaTeX code","href":"ctan:/macros/latex/contrib/yplan/yplan00.txt"},{"language":null,"details":"Details of the Perl script","href":"ctan:/macros/latex/contrib/yplan/yplan.txt"}],"ctan":{"path":"/macros/latex/contrib/yplan","file":true},"miktex":"yplan","texlive":"yplan","topics":["calendar"]}