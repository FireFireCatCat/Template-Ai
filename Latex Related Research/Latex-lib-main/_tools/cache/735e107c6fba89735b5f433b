{"id":"achemso","name":"achemso","aliases":[],"caption":"Support for American Chemical Society journal submissions","authors":[{"id":"dahlgren","active":false},{"id":"wright","active":true}],"copyright":[{"owner":"Mats Dahlgren","year":"1996-1998"},{"owner":"Joseph Wright","year":"2008-2022, 2024, 2025"}],"license":["lppl1.3c","other-free"],"version":{"number":"3.14","date":"2025-09-22"},"descriptions":[{"language":null,"text":"<p>\n      The bundle provides a BibTeX style file following the requirements of\n      the American Chemical Society (ACS), and a package to pass settings to the\n      BibTeX style. It also includes a class which was used for submission support in\n      the past.\n    <\u002fp>\n  <p>\n      All of this material is largely of historical interest and is retained for stability.\n      For new material, the <ref refid=\"biblatex-chem\">chem-acs<\u002fref> style is available\n      for bibliographies, and a short template for the ACS website is better suited to submission.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Readme","href":"ctan:/macros/latex/contrib/achemso/README.md"},{"language":null,"details":"Package documentation","href":"ctan:/macros/latex/contrib/achemso/achemso.pdf"},{"language":null,"details":"Example of use","href":"ctan:/macros/latex/contrib/achemso/achemso-demo.pdf"}],"repository":"https://github.com/josephwright/achemso","ctan":{"path":"/macros/latex/contrib/achemso","file":true},"install":"/macros/latex/contrib/achemso.tds.zip","miktex":"achemso","texlive":"achemso","topics":["class","bibtex-supp","tagged-pdf-partially","chemistry","journalpub"]}