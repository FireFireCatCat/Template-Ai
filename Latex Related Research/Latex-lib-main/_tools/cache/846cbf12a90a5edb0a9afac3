{"id":"exam-ltr","name":"exam-ltr","aliases":[],"caption":"A LaTeX package for creating professional exams","authors":[{"id":"aljaroudi","active":true}],"copyright":[{"owner":"Nadeer Aljaroudi","year":"2026"}],"license":"lppl1.3c","version":{"number":"1.0","date":""},"descriptions":[{"language":null,"text":"<p>\n      The <i>exam-ltr<\u002fi> package provides a comprehensive framework for creating\n      professional exams and academic assessments in LaTeX. It supports\n      8 question types: Multiple Choice, True/False, Fill in the Blank,\n          Ordering, Matching, Essay, Short Answer, and Reading Passage.\n    <\u002fp>\n  <p>\n      Key features:\n    <\u002fp>\n  <ul>\n    <li>Automatic answer key generation in teacher mode<\u002fli>\n    <li>Smart randomization of options and matching items<\u002fli>\n    <li>Metadata display (marks, difficulty, type)<\u002fli>\n    <li>Dual-mode output (student/teacher versions)<\u002fli>\n  <\u002ful>\n  <p>\n      Compatible with pdfLaTeX, LuaLaTeX, and XeLaTeX.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Readme","href":"ctan:/macros/latex/contrib/exam-ltr/README.md"},{"language":null,"details":"Package documentation","href":"ctan:/macros/latex/contrib/exam-ltr/exam-ltr.pdf"}],"ctan":{"path":"/macros/latex/contrib/exam-ltr","file":true},"miktex":"exam-ltr","texlive":"exam-ltr","topics":["exercise","teaching","exam"],"also":["exam-rtl"]}