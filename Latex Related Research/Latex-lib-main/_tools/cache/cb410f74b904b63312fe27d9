{"id":"ugentdocs","name":"ugentdocs","aliases":[],"caption":"House style document classes for Ghent University","authors":[{"id":"ongena","active":true}],"copyright":[{"owner":"Seppe Ongena","year":"2026"}],"license":"lppl1.3c","version":{"number":"1.0.0","date":""},"descriptions":[{"language":null,"text":"<p>\n      This package implements the house style of Ghent University\n      (version 2025, following the official style guide) for\n      bachelor’s, master’s, and PhD dissertations, research articles,\n      reports, exams, letters, course notes, and beamer slides, and\n      generates print-ready book covers for PhD dissertations and\n      courses.\n    <\u002fp>\n  <p>\n      Dictionaries / lexicons for Dutch and English are included,\n      users can add their own for other languages.\n    <\u002fp>\n  <p>\n      The package requires LuaLaTeX or XeLaTeX for loading\n      the official UGent fonts used in the logos.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Package documentation","href":"ctan:/macros/unicodetex/latex/ugentdocs/ugentdocs.pdf"},{"language":null,"details":"Readme","href":"ctan:/macros/unicodetex/latex/ugentdocs/README.md"}],"support":"https://github.com/SeppeOngena/ugentdocs/discussions","announce":"https://github.com/SeppeOngena/ugentdocs/releases.atom","bugs":"https://github.com/SeppeOngena/ugentdocs/issues","repository":"https://github.com/SeppeOngena/ugentdocs/","development":"https://github.com/SeppeOngena/ugentdocs/blob/HEAD/CONTRIBUTING.md","ctan":{"path":"/macros/unicodetex/latex/ugentdocs","file":true},"topics":["exam","use-luatex","letter","course-material","report-like","notes","dissertation","presentation","dutch","use-xetex","std-conform","article-like","class"]}