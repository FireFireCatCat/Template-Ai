{"id":"apa","name":"APA","aliases":[{"id":"apa5","name":"apa5"}],"caption":"American Psychological Association format","authors":[{"id":"protopapas","active":true}],"copyright":[],"license":"lppl","version":{"number":"1.3.4","date":""},"descriptions":[{"language":null,"text":"<p>\n      A LaTeX class to format text according to the American\n      Psychological Association Publication Manual (5th ed.)\n      specifications for manuscripts or to the APA journal look found\n      in journals like the Journal of Experimental Psychology etc.\n      In addition, it provides regular LaTeX-like output with a few\n      enhancements and APA-motivated changes.\n    <\u002fp>\n  <p>\n      Note that the <ref refid=\"apa7\">apa7<\u002fref> class\n      (covering the 7th edition of the manual) and\n      <ref refid=\"apa6\">apa6<\u002fref> (covering the 6th edition of\n      the manual) are now commonly in use.\n    <p/>\n    <ref refid=\"apacite\">Apacite<\u002fref>, which used to work with this\n      class, has been updated for use with <ref refid=\"apa6\">apa6<\u002fref>.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Class documentation","href":"ctan:/macros/latex/contrib/apa/apacls.html"},{"language":null,"details":"Readme","href":"ctan:/macros/latex/contrib/apa/README"},{"language":null,"details":"Outline of the class","href":"ctan:/macros/latex/contrib/apa/apacls.txt"},{"language":null,"details":"Outline of list facilities","href":"ctan:/macros/latex/contrib/apa/apaenum.txt"}],"home":"http://users.uoa.gr/~aprotopapas/CV/apacls.html","ctan":{"path":"/macros/latex/contrib/apa","file":true},"miktex":"apa","texlive":"apa","topics":["class","psychology","journalpub","apa"],"also":["mslapa"]}