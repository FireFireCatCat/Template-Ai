{"id":"nanicolle","name":"nanicolle","aliases":[],"caption":"Typesetting herbarium specimen labels","authors":[{"id":"yang-y","active":true}],"copyright":[{"owner":"Yuchang Yang","year":"2016-2020"}],"license":"lppl1.3c","version":{"number":"2.03y","date":"2020-08-31"},"descriptions":[{"language":null,"text":"<p>\n      This package provides a LaTeX class <tt>nanicolle.cls<\u002ftt>\n      for typesetting collection labels and identification labels\n      in Chinese style or in western style\n      for plant herbarium specimens.\n    <\u002fp>\n  <p>\n      So far, documents using this class can only be compiled\n      with <ref refid=\"xetex\">XeLaTeX<\u002fref>.\n    <\u002fp>\n  <p>\n      Note:\n      The name of the package is a compound of the\n      Japanese <q>nani<\u002fq> (meaning <q>what<\u002fq>) and a truncated form\n      of the English <q>collect<\u002fq>, thus expressing the ideas\n      of identification/classification (taxonomy) and collection.\n    <\u002fp>"}],"documentation":[{"language":null,"details":"Readme","href":"ctan:/macros/xetex/latex/nanicolle/README.md"},{"language":"zh","details":"Example of use (Chinese)","href":"ctan:/macros/xetex/latex/nanicolle/nanicolle-ex-zh.pdf"},{"language":"zh","details":"Package documentation (Chinese)","href":"ctan:/macros/xetex/latex/nanicolle/nanicolle-doc-zh.pdf"},{"language":null,"details":"Example of use (English)","href":"ctan:/macros/xetex/latex/nanicolle/nanicolle-ex-en.pdf"},{"language":null,"details":"Package documentation (English)","href":"ctan:/macros/xetex/latex/nanicolle/nanicolle-doc-en.pdf"}],"bugs":"https://github.com/Mikumikunisiteageru/nanicolle/issues","repository":"https://github.com/Mikumikunisiteageru/nanicolle","ctan":{"path":"/macros/xetex/latex/nanicolle","file":true},"miktex":"nanicolle","texlive":"nanicolle","topics":["covers","chinese","labels","class","xetex","biology"]}